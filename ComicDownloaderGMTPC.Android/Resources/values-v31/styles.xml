<?xml version="1.0" encoding="utf-8" ?>
<resources>

  <style name="MyTheme">
  </style>

  <!-- Theme Splash Android 12+ (API 31+): Dành riêng cho SplashActivity.
       TUYỆT ĐỐI KHÔNG DÙNG windowSplashScreenAnimatedIcon với raster PNG lớn vì sẽ gây crash ClassCastException trên ColorOS (Oppo K9x) / MIUI!
       Sử dụng windowSplashScreenBackground và để hệ thống hiển thị app icon tự nhiên -->
  <style name="MyTheme.Splash" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowActionBar">false</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowBackground">@drawable/splash_screen</item>
    <item name="android:windowSplashScreenBackground">@color/splash_background</item>
  </style>

  <!-- Theme App Android 12+: Dành cho MainActivity sau khi vào app -->
  <style name="MyTheme.App" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowActionBar">false</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowBackground">@color/app_background</item>
  </style>

  <style name="MyTheme.NoActionBar" parent="MyTheme.App" />

</resources>
