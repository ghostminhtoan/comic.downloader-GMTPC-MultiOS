<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ComicDownloaderGMTPC"
             x:Class="ComicDownloaderGMTPC.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        
        <!-- Style chuẩn toàn hệ thống cho NumericUpDown: Số hiển thị rõ nét, căn giữa, mũi tên tự nhiên -->
        <Style Selector="NumericUpDown">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <!-- Style chuẩn toàn hệ thống cho TextBox nhập liệu & đường dẫn -->
        <Style Selector="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <!-- Style chuẩn cho ComboBox -->
        <Style Selector="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </Application.Styles>
</Application>