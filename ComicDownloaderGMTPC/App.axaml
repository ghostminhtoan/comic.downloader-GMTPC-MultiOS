<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ComicDownloaderGMTPC"
             x:Class="ComicDownloaderGMTPC.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        
        <!-- Style chuẩn toàn hệ thống cho NumericUpDown: Số hiển thị rõ nét, căn giữa, mũi tên tự nhiên -->
        <Style Selector="NumericUpDown">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <!-- Style chuẩn toàn hệ thống cho TextBox nhập liệu & đường dẫn -->
        <Style Selector="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <!-- Style chuẩn cho ComboBox -->
        <Style Selector="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <!-- Cho phép các Header của TabControl tự động xuống hàng (Wrap) linh hoạt trên màn hình hẹp / Android và tối ưu không gian -->
        <Style Selector="TabControl">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter>
        </Style>

        <!-- Tối ưu không gian các TabItem: thanh thoát, gọn gàng, tăng diện tích hiển thị nội dung truyện -->
        <Style Selector="TabItem">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,2,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- Style ScrollBar chuẩn toàn hệ thống: Gọn gàng, width to dạng núm kéo bán nguyệt chuẩn Comic Screen -->
        <Style Selector="ScrollBar:vertical">
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.2" />
                    <DoubleTransition Property="MinWidth" Duration="0:0:0.2" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb">
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Width" Value="6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MaxHeight" Value="48" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="#64748B" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.2" />
                    <DoubleTransition Property="MinWidth" Duration="0:0:0.2" />
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Khi phóng to (khi cuộn hoặc hover hoặc được kích hoạt scroll-active) - Núm kéo Comic Screen to và gọn gàng -->
        <Style Selector="ScrollBar:vertical.scroll-active, ScrollViewer.scroll-active /template/ ScrollBar:vertical, ScrollBar:vertical:pointerover">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ScrollBar:vertical.scroll-active /template/ Thumb, ScrollViewer.scroll-active /template/ ScrollBar:vertical /template/ Thumb, ScrollBar:vertical:pointerover /template/ Thumb">
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Width" Value="32" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="MaxHeight" Value="56" />
            <Setter Property="CornerRadius" Value="20, 0, 0, 20" />
            <Setter Property="Background" Value="#38BDF8" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb:pressed">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Width" Value="36" />
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="MaxHeight" Value="60" />
            <Setter Property="CornerRadius" Value="22, 0, 0, 22" />
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style Selector="ScrollBar:horizontal">
            <Setter Property="MinHeight" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
        <Style Selector="ScrollBar:horizontal /template/ Thumb">
            <Setter Property="MinHeight" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#475569" />
        </Style>
        <Style Selector="ScrollBar:horizontal /template/ Thumb:pointerover">
            <Setter Property="Background" Value="#38BDF8" />
        </Style>
        <Style Selector="ScrollBar:horizontal /template/ Thumb:pressed">
            <Setter Property="Background" Value="#0284C7" />
        </Style>
    </Application.Styles>
</Application>