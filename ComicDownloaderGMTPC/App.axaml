<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ComicDownloaderGMTPC"
             x:Class="ComicDownloaderGMTPC.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        
        <!-- Tối ưu NumericUpDown và ButtonSpinner toàn hệ thống: Chống che khuất số, nút mũi tên gọn gàng -->
        <Style Selector="NumericUpDown">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style Selector="NumericUpDown /template/ ButtonSpinner">
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="Width" Value="22" />
        </Style>

        <Style Selector="ButtonSpinner /template/ RepeatButton">
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Padding" Value="1,0" />
        </Style>
    </Application.Styles>
</Application>