<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ComicDownloaderGMTPC.ViewModels"
             xmlns:models="using:ComicDownloaderGMTPC.Models"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="1920"
             x:Class="ComicDownloaderGMTPC.Views.ComicReaderControl"
             x:DataType="vm:ComicReaderViewModel"
             Background="{Binding ReaderBackgroundColor}">

    <UserControl.Styles>
        <!-- Style chuẩn cho CheckBox màu Cyan kiểu ComicScreen -->
        <Style Selector="CheckBox.comicCheck">
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <!-- Style chuẩn cho Slider màu Cyan kiểu ComicScreen -->
        <Style Selector="Slider.comicSlider">
            <Setter Property="Foreground" Value="#4FC3F7" />
            <Setter Property="Background" Value="#475569" />
        </Style>
        <!-- Style cho nút trên thanh công cụ 1-5 / 6-10 -->
        <Style Selector="Button.toolbarBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.toolbarBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#334FC3F7" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="RootReaderGrid" Background="{Binding ReaderBackgroundColor}">

        <!-- ========================================================================= -->
        <!-- 1. VÙNG ĐỌC TRUYỆN CHÍNH (SCROLL DỌC WEBTOON & LẬT TRANG MANGA)           -->
        <!-- ========================================================================= -->
        <Panel x:Name="ReaderViewportPanel" Background="{Binding ReaderBackgroundColor}">

            <!-- A. CHẾ ĐỘ CUỘN (SCROLL MODE - DỌC WEBTOON & NGANG LIÊN TIẾP) -->
            <ListBox x:Name="ReaderPagesListBox"
                     IsVisible="{Binding IsScrollMode}"
                     Classes.horizontalMode="{Binding IsHorizontalScrollMode}"
                     ItemsSource="{Binding Pages}"
                     Background="{Binding ReaderBackgroundColor}"
                     BorderThickness="0"
                     Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="{Binding PageScrollOrientation}" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBox.horizontalMode VirtualizingStackPanel">
                        <Setter Property="Orientation" Value="Horizontal" />
                    </Style>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ReaderPageItem">
                        <Panel HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Width="{Binding DisplayWidth}"
                               Height="{Binding DisplayHeight}"
                               Margin="{Binding PageMargin}"
                               MinHeight="240"
                               ClipToBounds="True"
                               AttachedToVisualTree="OnPageContainerAttached">
                            <!-- Khung chờ khi trang đang giải mã -->
                            <Border Background="#0B1120" BorderBrush="#1E293B" BorderThickness="0,0,0,1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    IsVisible="{Binding !HasImage}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                    <TextBlock Text="{Binding DisplayPageNumber, StringFormat='⏳ Đang tải trang {0}...'}"
                                               Foreground="#4FC3F7" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" Foreground="#64748B" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Ảnh trang truyện -->
                            <Image Source="{Binding Image}"
                                   IsVisible="{Binding HasImage}"
                                   Stretch="{Binding ImageStretch}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                        </Panel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- B. CHẾ ĐỘ LẬT TRANG (FLIP MODE - HỖ TRỢ 1 TRANG / 2 TRANG & RTL) -->
            <ScrollViewer x:Name="FlipModeScrollViewer"
                          IsVisible="{Binding IsFlipMode}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="{Binding ReaderBackgroundColor}">
                <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                    <LayoutTransformControl.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}" />
                    </LayoutTransformControl.LayoutTransform>

                    <UniformGrid Columns="{Binding FlipGridColumns}" Rows="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Trang Trái (hoặc Trang Đơn) -->
                        <Panel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{Binding FlipPageMargin}">
                            <Border Background="#0B1120" MinWidth="260" MinHeight="360" CornerRadius="6"
                                    IsVisible="{Binding LeftFlipPage.HasImage, Converter={x:Static BoolConverters.Not}, FallbackValue=True}">
                                <TextBlock Text="⏳ Đang nạp trang..." Foreground="#4FC3F7" FontSize="14" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Image Source="{Binding LeftFlipPage.Image}"
                                   Width="{Binding FlipDisplayWidth}"
                                   Height="{Binding FlipDisplayHeight}"
                                   Stretch="{Binding FlipImageStretch}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                        </Panel>

                        <!-- Trang Phải (chỉ hiện khi bật 2 Trang Kép) -->
                        <Panel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{Binding FlipPageMargin}"
                               IsVisible="{Binding HasSecondaryPage}">
                            <Image Source="{Binding RightFlipPage.Image}"
                                   Width="{Binding FlipDisplayWidth}"
                                   Height="{Binding FlipDisplayHeight}"
                                   Stretch="{Binding FlipImageStretch}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                        </Panel>
                    </UniformGrid>
                </LayoutTransformControl>
            </ScrollViewer>

            <!-- C. LỚP PHỦ ĐỘ SÁNG ẢNH (IMAGE BRIGHTNESS OVERLAY) -->
            <Border IsVisible="{Binding IsImageBrightnessOverlayVisible}"
                    Background="{Binding ImageBrightnessOverlayColor}"
                    Opacity="{Binding ImageBrightnessOverlayOpacity}"
                    IsHitTestVisible="False" />

            <!-- D. LỚP PHỦ LỌC ÁNH SÁNG XANH BẢO VỆ MẮT (BLUE LIGHT FILTER OVERLAY) -->
            <Border IsVisible="{Binding IsBlueLightOverlayVisible}"
                    Background="#FF8F00"
                    Opacity="{Binding BlueLightOverlayOpacity}"
                    IsHitTestVisible="False" />

            <!-- E. BADGE CHỈ SỐ TRANG MINI GÓC DƯỚI PHẢI (HIỆN KHI ẨN OVERLAY) -->
            <Border IsVisible="{Binding !IsOverlayVisible}"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,14,10" Padding="10,4" CornerRadius="10"
                    Background="#B30B0F19" BorderBrush="#334155" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding ChapterTitle}" Foreground="#94A3B8" FontSize="11" MaxWidth="170" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="•" Foreground="#475569" FontSize="11" />
                    <TextBlock Text="{Binding ComicScreenPageBadgeText}" Foreground="#4FC3F7" FontSize="11" FontWeight="Bold" />
                </StackPanel>
            </Border>

            <!-- F. TOAST THÔNG BÁO TRẠNG THÁI NHANH -->
            <Border IsVisible="{Binding IsStatusToastVisible}"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,118,0,0" Padding="14,8" CornerRadius="20"
                    Background="#E6111827" BorderBrush="#4FC3F7" BorderThickness="1.2"
                    ZIndex="2800">
                <TextBlock Text="{Binding StatusToastText}" Foreground="#F8FAFC" FontSize="12.5" FontWeight="Bold" />
            </Border>
        </Panel>

        <!-- ========================================================================= -->
        <!-- 2. LỚP PHỦ TÙY CHỌN KIỂU COMICSCREEN (BUTTON 1-5 & SWIPE SANG BUTTON 6-10) -->
        <!-- ========================================================================= -->
        <Grid x:Name="OverlayRootGrid"
              IsVisible="{Binding IsStandardOverlayBarsVisible}"
              RowDefinitions="Auto, *, Auto"
              ZIndex="2000">

            <!-- ================================================================= -->
            <!-- TOP CONTAINER: HEADER BAR + DẢI 10 NÚT VUỐT NGANG (1-5 ↔ 6-10)    -->
            <!-- ================================================================= -->
            <StackPanel Grid.Row="0" Orientation="Vertical">

                <!-- HÀNG 1: HEADER BAR KIỂU COMICSCREEN (←, ☰, Tên Truyện/Trang, ↻, ⋮) -->
                <Border Background="#E6181C22"
                        BorderBrush="#2E3642"
                        BorderThickness="0,0,0,1"
                        Padding="8,6">
                    <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto">
                        <!-- Nút Thoát Đọc -->
                        <Button Grid.Column="0"
                                Command="{Binding CloseReaderCommand}"
                                Background="#DC2626" Foreground="#FFFFFF"
                                Padding="9,5" CornerRadius="6" Margin="0,0,6,0"
                                ToolTip.Tip="Đóng trình đọc (Back / Esc)">
                            <TextBlock Text="←" FontSize="15" FontWeight="ExtraBold" />
                        </Button>

                        <!-- Nút Menu Danh sách Chương (☰) -->
                        <Button Grid.Column="1"
                                Command="{Binding ToggleChapterDrawerCommand}"
                                Background="Transparent" Foreground="#F8FAFC"
                                Padding="8,5" CornerRadius="6" Margin="0,0,8,0"
                                ToolTip.Tip="Chọn chương / Mục lục PDF">
                            <TextBlock Text="☰" FontSize="18" FontWeight="Bold" />
                        </Button>

                        <!-- Tiêu đề 2 dòng chuẩn ComicScreen (Tên bộ truyện + Tên chương/file ảnh) -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding ComicTitle}"
                                       Foreground="#FFFFFF" FontSize="14.5" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding HeaderSubTitleText}"
                                       Foreground="#CBD5E1" FontSize="11.5"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Nút Tải lại trang (↻) -->
                        <Button Grid.Column="3"
                                Command="{Binding ReloadCurrentChapterCommand}"
                                Background="Transparent" Foreground="#F8FAFC"
                                Padding="10,5" CornerRadius="6" Margin="4,0,2,0"
                                ToolTip.Tip="Tải lại chương hiện tại">
                            <TextBlock Text="↻" FontSize="18" FontWeight="Bold" />
                        </Button>

                        <!-- Nút Menu Mở rộng (⋮) -->
                        <Button Grid.Column="4"
                                Command="{Binding ToggleMoreMenuCommand}"
                                Background="Transparent" Foreground="#F8FAFC"
                                Padding="10,5" CornerRadius="6"
                                ToolTip.Tip="Tùy chọn mở rộng (Phóng to / Toàn màn hình)">
                            <TextBlock Text="⋮" FontSize="18" FontWeight="ExtraBold" />
                        </Button>
                    </Grid>
                </Border>

                <!-- HÀNG 2: THANH 5 NÚT VUỐT NGANG (BUTTON 1-5 ↔ SWIPE SANG BUTTON 6-10) -->
                <Border x:Name="SwipeableToolbarBorder"
                        Background="#D920252D"
                        BorderBrush="#374151"
                        BorderThickness="0,0,0,1"
                        Padding="6,4"
                        ToolTip.Tip="Vuốt ngang (Swipe trái/phải) trên thanh này để chuyển giữa Button 1-5 và Button 6-10">
                    <Grid ColumnDefinitions="*, Auto">

                        <!-- TRANG 1: BUTTON 1 -> BUTTON 5 -->
                        <UniformGrid Grid.Column="0"
                                     Columns="5" Rows="1"
                                     IsVisible="{Binding IsToolbarPageOne}">

                            <!-- BUTTON 1: Page scrolling -->
                            <Button Classes="toolbarBtn"
                                    Command="{Binding OpenPageScrollingPopupCommand}"
                                    ToolTip.Tip="Button 1: Page scrolling (Chế độ cuộn / lật trang)">
                                <Border Width="36" Height="30" BorderBrush="#E2E8F0" BorderThickness="1.8" CornerRadius="4"
                                        Background="#1E293B">
                                    <TextBlock Text="{Binding Button1IconBadgeText}"
                                               Foreground="#FFFFFF" FontSize="12" FontWeight="ExtraBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Button>

                            <!-- BUTTON 2: Orientation Lock (Xoay màn hình) -->
                            <Button Classes="toolbarBtn"
                                    Command="{Binding CycleOrientationLockCommand}"
                                    ToolTip.Tip="Button 2: Khóa xoay màn hình (Auto / Ngang / Dọc)">
                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="28" Height="28" BorderBrush="{Binding Button2IconTint}" BorderThickness="1.8"
                                            CornerRadius="5" Background="#1E293B" RenderTransform="rotate(-20deg)">
                                        <TextBlock Text="🔒" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding OrientationBadgeText}" Foreground="{Binding Button2IconTint}"
                                               FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- BUTTON 3: Page layout (1 trang / 2 trang / Auto) -->
                            <Button Classes="toolbarBtn"
                                    Command="{Binding OpenPageLayoutPopupCommand}"
                                    ToolTip.Tip="Button 3: Page layout (Bố cục 1 trang / 2 trang / Auto)">
                                <Border Width="36" Height="30" BorderBrush="#E2E8F0" BorderThickness="1.8" CornerRadius="4"
                                        Background="#1E293B">
                                    <Grid ColumnDefinitions="*, Auto, *">
                                        <Border Grid.Column="1" Width="1.2" Background="#64748B" Margin="0,3" />
                                        <TextBlock Grid.ColumnSpan="3" Text="{Binding Button3BadgeText}"
                                                   Foreground="#4FC3F7" FontSize="11" FontWeight="ExtraBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- BUTTON 4: Margin / Crop (Cắt lề trang truyện) -->
                            <Button Classes="toolbarBtn"
                                    Command="{Binding OpenMarginEditorCommand}"
                                    ToolTip.Tip="Button 4: Margin / Crop (Cắt lề trắng trang truyện)">
                                <Grid Width="34" Height="30">
                                    <Border BorderBrush="{Binding Button4IconTint}" BorderThickness="1.8" CornerRadius="3" Margin="2" />
                                    <Border BorderBrush="#E91E63" BorderThickness="1.5" Margin="7" />
                                </Grid>
                            </Button>

                            <!-- BUTTON 5: Brightness (Độ sáng & Màu nền) -->
                            <Button Classes="toolbarBtn"
                                    Command="{Binding OpenBrightnessPopupCommand}"
                                    ToolTip.Tip="Button 5: Brightness (Độ sáng, Màu nền, Giữ sáng màn hình, Lọc ánh sáng xanh)">
                                <TextBlock Text="☀" Foreground="#F8FAFC" FontSize="22" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </UniformGrid>

                        <!-- TRANG 2: BUTTON 6 -> BUTTON 10 (HIỆN KHI SWIPE SANG PHẢI/TRÁI HOẶC BẤM MŨI TÊN) -->
                        <UniformGrid Grid.Column="0"
                                     Columns="5" Rows="1"
                                     IsVisible="{Binding IsToolbarPageTwo}">

                            <!-- BUTTON 6: Pinch Zoom & Smart Zoom & Fit Mode -->
                            <Button Classes="toolbarBtn"
                                    Command="{Binding OpenZoomPopupCommand}"
                                    ToolTip.Tip="Button 6: Zoom &amp; Chế độ Fit khung hình (Fit Width / Fit Height / Stretch Full / Zoom 40%..400%)">
                                <Grid Width="34" Height="30">
                                    <TextBlock Text="🔍" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border Background="#4FC3F7" CornerRadius="3" Padding="2,0"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2">
                                        <TextBlock Text="{Binding FitModeBadgeText}" Foreground="#0F172A" FontSize="8.5" FontWeight="ExtraBold" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- BUTTON 7: Filter (Bộ lọc hình ảnh) -->
                            <Button Classes="toolbarBtn"
                                    Command="{Binding OpenFilterPopupCommand}"
                                    ToolTip.Tip="Button 7: Filter (Gray Scale, Auto Contrast, Upscaling, Sharpen, Invert, Blue Light)">
                                <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🪄" Foreground="{Binding Button7IconTint}" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Text="✨" Foreground="{Binding Button7IconTint}" FontSize="11" VerticalAlignment="Top" />
                                </StackPanel>
                            </Button>

                            <!-- BUTTON 8: Page spacing (Khoảng cách giữa các trang) -->
                            <Button Classes="toolbarBtn"
                                    Command="{Binding OpenPageSpacingPopupCommand}"
                                    ToolTip.Tip="Button 8: Page spacing (Điều chỉnh khoảng cách giữa các trang)">
                                <StackPanel Spacing="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="28">
                                    <Border Height="2.2" Background="{Binding Button8IconTint}" CornerRadius="1" />
                                    <TextBlock Text="⇕" Foreground="{Binding Button8IconTint}" FontSize="13" FontWeight="ExtraBold"
                                               HorizontalAlignment="Center" Margin="0,-2" />
                                    <Border Height="2.2" Background="{Binding Button8IconTint}" CornerRadius="1" />
                                </StackPanel>
                            </Button>

                            <!-- BUTTON 9: Add bookmark (Thêm dấu trang) -->
                            <Button Classes="toolbarBtn"
                                    Command="{Binding OpenAddBookmarkPopupCommand}"
                                    ToolTip.Tip="Button 9: Add bookmark (Thêm dấu trang kèm ghi chú Memo)">
                                <Grid Width="34" Height="30">
                                    <TextBlock Text="🔖" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border Background="#4FC3F7" CornerRadius="7" Width="14" Height="14"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2">
                                        <TextBlock Text="+" Foreground="#0F172A" FontSize="11" FontWeight="ExtraBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- BUTTON 10: Bookmark list (Danh sách dấu trang) -->
                            <Button Classes="toolbarBtn"
                                    Command="{Binding OpenBookmarkListPopupCommand}"
                                    ToolTip.Tip="Button 10: Danh sách dấu trang đã lưu">
                                <Grid Width="36" Height="30">
                                    <TextBlock Text="🔖" FontSize="19" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" />
                                    <TextBlock Text="≡" Foreground="#4FC3F7" FontSize="15" FontWeight="ExtraBold"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,1" />
                                </Grid>
                            </Button>
                        </UniformGrid>

                        <!-- NÚT MŨI TÊN CHUYỂN NHANH GIỮA BUTTON 1-5 VÀ 6-10 -->
                        <Button Grid.Column="1"
                                Command="{Binding ToggleToolbarPageCommand}"
                                Background="#283140"
                                BorderBrush="#475569" BorderThickness="1"
                                Foreground="#CBD5E1"
                                Padding="8,4" CornerRadius="6" Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Chuyển qua lại giữa cụm nút 1-5 và 6-10 (hoặc vuốt ngang trên thanh công cụ)">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ToolbarPageIndicatorText}" Foreground="#4FC3F7" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ToolbarArrowIconText}" Foreground="#F8FAFC" FontSize="13" FontWeight="ExtraBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ================================================================= -->
            <!-- VÙNG GIỮA: CHỨA CÁC POPUP TÙY CHỌN COMICSCREEN (BUTTON 1..10)     -->
            <!-- ================================================================= -->
            <Panel Grid.Row="1">

                <!-- Lớp nền trong suốt để đóng Popup đang mở khi chạm ra ngoài -->
                <Button IsVisible="{Binding HasActivePopup}"
                        Command="{Binding CloseAllPopupsCommand}"
                        Background="#33000000"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#33000000" />
                        </Style>
                    </Button.Styles>
                </Button>

                <!-- ============================================================= -->
                <!-- POPUP BUTTON 1: PAGE SCROLLING (3x2 GRID NHƯ ẢNH CHỤP)        -->
                <!-- ============================================================= -->
                <Border IsVisible="{Binding IsPageScrollingPopupOpen}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="340"
                        Background="#F222262E"
                        BorderBrush="#475569" BorderThickness="1"
                        CornerRadius="6" Padding="16,14"
                        BoxShadow="0 10 30 0 #AA000000">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Page scrolling" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" />

                        <UniformGrid Columns="3" Rows="2">
                            <!-- 0: Right (Flip LTR) -->
                            <Button Command="{Binding SelectPageScrollingModeCommand}" CommandParameter="0"
                                    Background="{Binding ScrollMode0Bg}" BorderBrush="{Binding ScrollMode0Border}" BorderThickness="1.5"
                                    CornerRadius="4" Margin="4" Padding="8,10" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <Border Width="38" Height="30" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="3">
                                        <TextBlock Text="→" Foreground="#FFFFFF" FontSize="15" FontWeight="ExtraBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Right" Foreground="#E2E8F0" FontSize="11.5" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 1: Left (Flip RTL) -->
                            <Button Command="{Binding SelectPageScrollingModeCommand}" CommandParameter="1"
                                    Background="{Binding ScrollMode1Bg}" BorderBrush="{Binding ScrollMode1Border}" BorderThickness="1.5"
                                    CornerRadius="4" Margin="4" Padding="8,10" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <Border Width="38" Height="30" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="3">
                                        <TextBlock Text="←" Foreground="#FFFFFF" FontSize="15" FontWeight="ExtraBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Left" Foreground="#E2E8F0" FontSize="11.5" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 2: Right + Vertical (Scroll RTL) -->
                            <Button Command="{Binding SelectPageScrollingModeCommand}" CommandParameter="2"
                                    Background="{Binding ScrollMode2Bg}" BorderBrush="{Binding ScrollMode2Border}" BorderThickness="1.5"
                                    CornerRadius="4" Margin="4" Padding="8,10" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <Border Width="38" Height="30" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="3">
                                        <TextBlock Text="R↓" Foreground="#FFFFFF" FontSize="13" FontWeight="ExtraBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Right" Foreground="#E2E8F0" FontSize="11.5" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 3: Right Slide -->
                            <Button Command="{Binding SelectPageScrollingModeCommand}" CommandParameter="3"
                                    Background="{Binding ScrollMode3Bg}" BorderBrush="{Binding ScrollMode3Border}" BorderThickness="1.5"
                                    CornerRadius="4" Margin="4" Padding="8,10" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <Border Width="38" Height="30" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="3">
                                        <TextBlock Text="S→" Foreground="#FFFFFF" FontSize="13" FontWeight="ExtraBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Right" Foreground="#E2E8F0" FontSize="11.5" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 4: Left Slide -->
                            <Button Command="{Binding SelectPageScrollingModeCommand}" CommandParameter="4"
                                    Background="{Binding ScrollMode4Bg}" BorderBrush="{Binding ScrollMode4Border}" BorderThickness="1.5"
                                    CornerRadius="4" Margin="4" Padding="8,10" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <Border Width="38" Height="30" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="3">
                                        <TextBlock Text="←S" Foreground="#FFFFFF" FontSize="13" FontWeight="ExtraBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Left" Foreground="#E2E8F0" FontSize="11.5" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 5: Left + Vertical (Webtoon Scroll LTR) -->
                            <Button Command="{Binding SelectPageScrollingModeCommand}" CommandParameter="5"
                                    Background="{Binding ScrollMode5Bg}" BorderBrush="{Binding ScrollMode5Border}" BorderThickness="1.5"
                                    CornerRadius="4" Margin="4" Padding="8,10" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <Border Width="38" Height="30" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="3">
                                        <TextBlock Text="↓L" Foreground="#FFFFFF" FontSize="13" FontWeight="ExtraBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Left" Foreground="#E2E8F0" FontSize="11.5" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ============================================================= -->
                <!-- POPUP BUTTON 3: PAGE LAYOUT (4 CỘT NHƯ ẢNH CHỤP)              -->
                <!-- ============================================================= -->
                <Border IsVisible="{Binding IsPageLayoutPopupOpen}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="360"
                        Background="#F222262E"
                        BorderBrush="#475569" BorderThickness="1"
                        CornerRadius="6" Padding="14,14"
                        BoxShadow="0 10 30 0 #AA000000">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Page layout" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" />

                        <UniformGrid Columns="4" Rows="1">
                            <!-- 0: Off -->
                            <Button Command="{Binding SelectPageLayoutModeCommand}" CommandParameter="0"
                                    Background="{Binding LayoutMode0Bg}" BorderBrush="{Binding LayoutMode0Border}" BorderThickness="1.5"
                                    CornerRadius="4" Margin="3" Padding="4,10" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <Border Width="34" Height="28" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="3">
                                        <TextBlock Text="▢" Foreground="#FFFFFF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Off" Foreground="#E2E8F0" FontSize="10.5" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 1: Single page -->
                            <Button Command="{Binding SelectPageLayoutModeCommand}" CommandParameter="1"
                                    Background="{Binding LayoutMode1Bg}" BorderBrush="{Binding LayoutMode1Border}" BorderThickness="1.5"
                                    CornerRadius="4" Margin="3" Padding="4,10" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <Border Width="34" Height="28" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="3">
                                        <TextBlock Text="1│2" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Single page" Foreground="#E2E8F0" FontSize="10.5" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 2: Dual pages -->
                            <Button Command="{Binding SelectPageLayoutModeCommand}" CommandParameter="2"
                                    Background="{Binding LayoutMode2Bg}" BorderBrush="{Binding LayoutMode2Border}" BorderThickness="1.5"
                                    CornerRadius="4" Margin="3" Padding="4,10" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <Border Width="34" Height="28" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="3">
                                        <TextBlock Text="📖" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Dual pages" Foreground="#E2E8F0" FontSize="10.5" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- 3: Auto -->
                            <Button Command="{Binding SelectPageLayoutModeCommand}" CommandParameter="3"
                                    Background="{Binding LayoutMode3Bg}" BorderBrush="{Binding LayoutMode3Border}" BorderThickness="1.5"
                                    CornerRadius="4" Margin="3" Padding="4,10" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <Border Width="34" Height="28" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="3">
                                        <TextBlock Text="A" Foreground="#FFFFFF" FontSize="14" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Auto" Foreground="#E2E8F0" FontSize="10.5" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ============================================================= -->
                <!-- POPUP BUTTON 5: BRIGHTNESS (ĐỘ SÁNG, MÀU NỀN, LỌC ÁNH SÁNG XANH) -->
                <!-- ============================================================= -->
                <Border IsVisible="{Binding IsBrightnessPopupOpen}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="350"
                        Background="#F222262E"
                        BorderBrush="#475569" BorderThickness="1"
                        CornerRadius="6" Padding="16,14"
                        BoxShadow="0 10 30 0 #AA000000">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Brightness" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />

                        <!-- 1. Auto System Brightness -->
                        <Grid ColumnDefinitions="*, Auto">
                            <CheckBox Grid.Column="0" Classes="comicCheck"
                                      IsChecked="{Binding IsAutoSystemBrightness}"
                                      Content="Auto System Brightness" />
                            <TextBlock Grid.Column="1" Text="{Binding SystemBrightnessText}"
                                       Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                        <Slider Classes="comicSlider"
                                Minimum="2" Maximum="100"
                                Value="{Binding SystemBrightnessPercent}" />

                        <!-- 2. Background & Keep screen -->
                        <Grid ColumnDefinitions="*, *" Margin="0,4">
                            <Button Grid.Column="0"
                                    Command="{Binding CycleBackgroundColorCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="2,4"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="22" Height="22"
                                            Background="{Binding ReaderBackgroundColor}"
                                            BorderBrush="#94A3B8" BorderThickness="1.5" CornerRadius="3" />
                                    <TextBlock Text="Background" Foreground="#F1F5F9" FontSize="13.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <CheckBox Grid.Column="1" Classes="comicCheck"
                                      IsChecked="{Binding IsKeepScreenOn}"
                                      Content="Keep screen"
                                      HorizontalAlignment="Left" />
                        </Grid>

                        <!-- 3. Image Brightness -->
                        <Grid ColumnDefinitions="*, Auto">
                            <CheckBox Grid.Column="0" Classes="comicCheck"
                                      IsChecked="{Binding IsImageBrightnessEnabled}"
                                      Content="Image Brightness" />
                            <TextBlock Grid.Column="1" Text="{Binding ImageBrightnessText}"
                                       Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                        <Slider Classes="comicSlider"
                                Minimum="15" Maximum="140"
                                Value="{Binding ImageBrightnessValue}" />

                        <!-- 4. Saturation -->
                        <Grid ColumnDefinitions="*, Auto">
                            <CheckBox Grid.Column="0" Classes="comicCheck"
                                      IsChecked="{Binding IsSaturationEnabled}"
                                      Content="Saturation" />
                            <TextBlock Grid.Column="1" Text="{Binding SaturationText}"
                                       Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                        <Slider Classes="comicSlider"
                                Minimum="0" Maximum="200"
                                Value="{Binding SaturationValue}" />

                        <!-- 5. Blue Light -->
                        <Grid ColumnDefinitions="*, Auto">
                            <CheckBox Grid.Column="0" Classes="comicCheck"
                                      IsChecked="{Binding IsBlueLightEnabled}"
                                      Content="Blue Light" />
                            <TextBlock Grid.Column="1" Text="{Binding BlueLightText}"
                                       Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                        <Slider Classes="comicSlider"
                                Minimum="0" Maximum="100"
                                Value="{Binding BlueLightValue}" />

                        <!-- Nút DEFAULT -->
                        <Button Command="{Binding ResetBrightnessDefaultsCommand}"
                                Background="#374151" Foreground="#F8FAFC" FontWeight="Bold"
                                Padding="16,7" CornerRadius="4" Margin="0,6,0,0"
                                HorizontalAlignment="Left">
                            <TextBlock Text="DEFAULT" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ============================================================= -->
                <!-- POPUP BUTTON 6: ZOOM & KHUNG HÌNH (SMART ZOOM & FIT PRESETS)  -->
                <!-- ============================================================= -->
                <Border IsVisible="{Binding IsZoomPopupOpen}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="360"
                        Background="#F222262E"
                        BorderBrush="#475569" BorderThickness="1"
                        CornerRadius="8" Padding="16,14"
                        BoxShadow="0 10 30 0 #AA000000">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="🔍 Thu Phóng &amp; Khung Hình" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding ZoomPercentText}" Foreground="#4FC3F7" FontSize="14" FontWeight="Bold" />
                        </Grid>

                        <!-- Thanh kéo Zoom 40% -> 400% -->
                        <Slider Classes="comicSlider"
                                Minimum="0.4" Maximum="4.0"
                                Value="{Binding ZoomLevel}"
                                SmallChange="0.05" LargeChange="0.2" />

                        <!-- Nút Presets Zoom -->
                        <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="6">
                            <Button Grid.Column="0" Command="{Binding SetZoomPresetCommand}" CommandParameter="1.0"
                                    Background="#1E293B" Foreground="#E2E8F0" Padding="4,6" CornerRadius="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <TextBlock Text="100%" FontSize="11" FontWeight="Bold" />
                            </Button>
                            <Button Grid.Column="1" Command="{Binding SetZoomPresetCommand}" CommandParameter="1.5"
                                    Background="#1E293B" Foreground="#E2E8F0" Padding="4,6" CornerRadius="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <TextBlock Text="150%" FontSize="11" FontWeight="Bold" />
                            </Button>
                            <Button Grid.Column="2" Command="{Binding SetZoomPresetCommand}" CommandParameter="2.0"
                                    Background="#1E293B" Foreground="#E2E8F0" Padding="4,6" CornerRadius="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <TextBlock Text="200%" FontSize="11" FontWeight="Bold" />
                            </Button>
                            <Button Grid.Column="3" Command="{Binding SetZoomPresetCommand}" CommandParameter="3.0"
                                    Background="#1E293B" Foreground="#E2E8F0" Padding="4,6" CornerRadius="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <TextBlock Text="300%" FontSize="11" FontWeight="Bold" />
                            </Button>
                        </Grid>

                        <Border Height="1" Background="#334155" Margin="0,2" />

                        <!-- Chế độ Vừa khung hình (Fit Modes) -->
                        <TextBlock Text="📐 Chế độ vừa khung màn hình:" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" />
                        <UniformGrid Columns="3" Rows="2">
                            <!-- Fit Width -->
                            <Button Command="{Binding SetFitModeCommand}" CommandParameter="FitWidth"
                                    Background="#1E293B" BorderBrush="#4FC3F7" BorderThickness="1"
                                    Foreground="#FFFFFF" Padding="4,7" CornerRadius="4" Margin="2" HorizontalAlignment="Stretch">
                                <TextBlock Text="↔ Fit Width" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Button>
                            <!-- Fit Height -->
                            <Button Command="{Binding SetFitModeCommand}" CommandParameter="FitHeight"
                                    Background="#1E293B" BorderBrush="#4FC3F7" BorderThickness="1"
                                    Foreground="#FFFFFF" Padding="4,7" CornerRadius="4" Margin="2" HorizontalAlignment="Stretch">
                                <TextBlock Text="↕ Fit Height" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Button>
                            <!-- Fit Screen -->
                            <Button Command="{Binding SetFitModeCommand}" CommandParameter="FitScreen"
                                    Background="#1E293B" BorderBrush="#4FC3F7" BorderThickness="1"
                                    Foreground="#FFFFFF" Padding="4,7" CornerRadius="4" Margin="2" HorizontalAlignment="Stretch">
                                <TextBlock Text="⛶ Fit Screen" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Button>
                            <!-- Stretch Full -->
                            <Button Command="{Binding SetFitModeCommand}" CommandParameter="StretchFull"
                                    Background="#1E293B" BorderBrush="#E91E63" BorderThickness="1"
                                    Foreground="#FFFFFF" Padding="4,7" CornerRadius="4" Margin="2" HorizontalAlignment="Stretch">
                                <TextBlock Text="🗖 Stretch Full" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Button>
                            <!-- Original 1:1 -->
                            <Button Command="{Binding SetFitModeCommand}" CommandParameter="Original"
                                    Background="#1E293B" BorderBrush="#64748B" BorderThickness="1"
                                    Foreground="#FFFFFF" Padding="4,7" CornerRadius="4" Margin="2" HorizontalAlignment="Stretch">
                                <TextBlock Text="1:1 Gốc" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Button>
                            <!-- Smart Double-Tap -->
                            <Button Command="{Binding SmartDoubleTapZoomCommand}"
                                    Background="#065F46" BorderBrush="#10B981" BorderThickness="1"
                                    Foreground="#A7F3D0" Padding="4,7" CornerRadius="4" Margin="2" HorizontalAlignment="Stretch">
                                <TextBlock Text="👆 Đúp Zoom 2x" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Button>
                        </UniformGrid>

                        <Border Height="1" Background="#334155" Margin="0,2" />

                        <!-- Tự động cuộn trang (Auto-Scroll Hands-Free) -->
                        <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                            <Button Grid.Column="0" Command="{Binding ToggleAutoScrollCommand}"
                                    Background="{Binding AutoScrollButtonBg}" Foreground="#FFFFFF"
                                    Padding="10,6" CornerRadius="4" FontWeight="Bold">
                                <TextBlock Text="{Binding AutoScrollButtonText}" FontSize="12" />
                            </Button>
                            <Slider Grid.Column="1" Classes="comicSlider"
                                    Minimum="1" Maximum="10" Margin="10,0"
                                    Value="{Binding AutoScrollSpeed}"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding AutoScrollSpeed, StringFormat='Tốc độ: {0:0}'}"
                                       Foreground="#94A3B8" FontSize="11.5" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============================================================= -->
                <!-- POPUP BUTTON 7: FILTER (6 CHECKBOX NHƯ ẢNH CHỤP)              -->
                <!-- ============================================================= -->
                <Border IsVisible="{Binding IsFilterPopupOpen}"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,12,0,0" Width="230"
                        Background="#F222262E"
                        BorderBrush="#475569" BorderThickness="1"
                        CornerRadius="6" Padding="14,10"
                        BoxShadow="0 10 25 0 #AA000000">
                    <StackPanel Spacing="2">
                        <CheckBox Classes="comicCheck" IsChecked="{Binding IsGrayScale}" Content="Gray Scale" />
                        <CheckBox Classes="comicCheck" IsChecked="{Binding IsAutoContrast}" Content="Auto Contrast" />
                        <CheckBox Classes="comicCheck" IsChecked="{Binding IsUpscaling}" Content="Upscaling" />
                        <CheckBox Classes="comicCheck" IsChecked="{Binding IsSharpenFilter}" Content="Sharpen Filter" />
                        <CheckBox Classes="comicCheck" IsChecked="{Binding IsInvertColor}" Content="Invert Color" />
                        <CheckBox Classes="comicCheck" IsChecked="{Binding IsBlueLightEnabled}" Content="Blue Light" />
                    </StackPanel>
                </Border>

                <!-- ============================================================= -->
                <!-- POPUP BUTTON 8: PAGE SPACING (NHƯ ẢNH CHỤP)                   -->
                <!-- ============================================================= -->
                <Border IsVisible="{Binding IsPageSpacingPopupOpen}"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,12,0,0" Width="280"
                        Background="#F222262E"
                        BorderBrush="#475569" BorderThickness="1"
                        CornerRadius="6" Padding="14,10"
                        BoxShadow="0 10 25 0 #AA000000">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*, Auto">
                            <CheckBox Grid.Column="0" Classes="comicCheck"
                                      IsChecked="{Binding IsPageSpacingEnabled}"
                                      Content="Page spacing" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding PageSpacingFormattedText}"
                                       Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Slider Classes="comicSlider"
                                Minimum="-30" Maximum="50"
                                Value="{Binding PageSpacingPercent}" />
                    </StackPanel>
                </Border>

                <!-- ============================================================= -->
                <!-- POPUP BUTTON 9: ADD BOOKMARK (NHƯ ẢNH CHỤP)                   -->
                <!-- ============================================================= -->
                <Border IsVisible="{Binding IsAddBookmarkPopupOpen}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="340"
                        Background="#F522262E"
                        BorderBrush="#475569" BorderThickness="1"
                        CornerRadius="6" Padding="18,16"
                        BoxShadow="0 10 30 0 #AA000000">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Add bookmark" Foreground="#FFFFFF" FontSize="17" FontWeight="Bold" />

                        <TextBox Text="{Binding BookmarkMemoInput}"
                                 PlaceholderText="Memo"
                                 Background="#181C22"
                                 Foreground="#FFFFFF"
                                 BorderBrush="#4FC3F7"
                                 BorderThickness="0,0,0,2"
                                 CornerRadius="2"
                                 FontSize="13.5"
                                 Padding="6,6" />

                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding AddBookmarkLeftInfoText}"
                                       Foreground="#94A3B8" FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AddBookmarkRightInfoText}"
                                       Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="16" Margin="0,4,0,0">
                            <Button Command="{Binding CancelAddBookmarkCommand}"
                                    Background="Transparent" Foreground="#4FC3F7" FontWeight="Bold"
                                    Padding="10,6">
                                <TextBlock Text="CANCEL" FontSize="13" />
                            </Button>
                            <Button Command="{Binding ConfirmAddBookmarkCommand}"
                                    Background="Transparent" Foreground="#4FC3F7" FontWeight="Bold"
                                    Padding="10,6">
                                <TextBlock Text="OK" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============================================================= -->
                <!-- POPUP BUTTON 10: BOOKMARK LIST PANEL NỬA DƯỚI MÀN HÌNH        -->
                <!-- ============================================================= -->
                <Border IsVisible="{Binding IsBookmarkListPopupOpen}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                        MinHeight="240" MaxHeight="380"
                        Background="#E611161D"
                        BorderBrush="#334155" BorderThickness="0,1,0,0"
                        Padding="14,10">
                    <Grid RowDefinitions="Auto, *">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                            <TextBlock Grid.Column="0" Text="🔖 Bookmarks"
                                       Foreground="#94A3B8" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Command="{Binding CloseBookmarkListPopupCommand}"
                                    Background="Transparent" Foreground="#FACC15" FontWeight="Bold"
                                    Padding="8,4">
                                <TextBlock Text="CLOSE" FontSize="13" />
                            </Button>
                        </Grid>

                        <Panel Grid.Row="1">
                            <TextBlock IsVisible="{Binding !HasBookmarks}"
                                       Text="Chưa có dấu trang nào. Nhấn nút 🔖+ (Button 9) để lưu trang đang đọc."
                                       Foreground="#64748B" FontSize="12.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <ScrollViewer IsVisible="{Binding HasBookmarks}" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Bookmarks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ReaderBookmarkItem">
                                            <Border BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="2,6">
                                                <Grid ColumnDefinitions="*, Auto, Auto">
                                                    <Button Grid.Column="0"
                                                            Command="{Binding $parent[UserControl].((vm:ComicReaderViewModel)DataContext).JumpToBookmarkCommand}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderThickness="0"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                            Padding="4,4">
                                                        <TextBlock Text="{Binding LeftDisplayText}"
                                                                   Foreground="#4FC3F7" FontSize="13.5" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Button>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding RightDisplayText}"
                                                               Foreground="#81D4FA" FontSize="13"
                                                               VerticalAlignment="Center" Margin="10,0" />

                                                    <Button Grid.Column="2"
                                                            Command="{Binding $parent[UserControl].((vm:ComicReaderViewModel)DataContext).DeleteBookmarkCommand}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" Foreground="#64748B"
                                                            Padding="6,2" ToolTip.Tip="Xóa dấu trang này">
                                                        <TextBlock Text="✕" FontSize="12" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Panel>
                    </Grid>
                </Border>

                <!-- ============================================================= -->
                <!-- POPUP MENU CHƯƠNG & MỤC LỤC PDF (KHI BẤM NÚT ☰ GÓC TRÁI TRÊN) -->
                <!-- ============================================================= -->
                <Border IsVisible="{Binding IsChapterDrawerOpen}"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="8,6,0,0" Width="320"
                        Background="#F5181C22"
                        BorderBrush="#4FC3F7" BorderThickness="1"
                        CornerRadius="6" Padding="12"
                        BoxShadow="0 10 30 0 #AA000000">
                    <StackPanel Spacing="10">
                        <TextBlock Text="📚 Danh sách Chương &amp; Điều hướng" Foreground="#4FC3F7" FontSize="13.5" FontWeight="Bold" />

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="6">
                            <Button Grid.Column="0" Command="{Binding PrevChapterCommand}"
                                    IsEnabled="{Binding CanGoPrevChapter}"
                                    Background="#1E293B" Foreground="#E2E8F0" Padding="8,6" CornerRadius="5"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <TextBlock Text="⏮ Chương trước" FontSize="11.5" FontWeight="SemiBold" />
                            </Button>
                            <Button Grid.Column="1" Command="{Binding NextChapterCommand}"
                                    IsEnabled="{Binding CanGoNextChapter}"
                                    Background="#1E293B" Foreground="#E2E8F0" Padding="8,6" CornerRadius="5"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <TextBlock Text="Chương sau ⏭" FontSize="11.5" FontWeight="SemiBold" />
                            </Button>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Chọn chương:" Foreground="#94A3B8" FontSize="11.5" />
                            <ComboBox ItemsSource="{Binding ChapterList}"
                                      SelectedItem="{Binding CurrentChapter}"
                                      HorizontalAlignment="Stretch" Height="34"
                                      Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#4FC3F7" FontSize="12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:LibraryChapterItem">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ProgressStatusText}" Foreground="#94A3B8" FontSize="10.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4" IsVisible="{Binding HasPdfBookmarks}">
                            <TextBlock Text="📑 Mục lục PDF:" Foreground="#FB7185" FontSize="11.5" FontWeight="Bold" />
                            <ComboBox ItemsSource="{Binding PdfBookmarks}"
                                      SelectedItem="{Binding SelectedPdfBookmark}"
                                      HorizontalAlignment="Stretch" Height="34"
                                      Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#E11D48" FontSize="12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:PdfBookmarkItem">
                                        <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============================================================= -->
                <!-- POPUP MENU MỞ RỘNG (KHI BẤM NÚT ⋮ GÓC PHẢI TRÊN)              -->
                <!-- ============================================================= -->
                <Border IsVisible="{Binding IsMoreMenuOpen}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,6,8,0" Width="230"
                        Background="#F5181C22"
                        BorderBrush="#475569" BorderThickness="1"
                        CornerRadius="6" Padding="12"
                        BoxShadow="0 10 30 0 #AA000000">
                    <StackPanel Spacing="8">
                        <TextBlock Text="⚙ Tùy chọn hiển thị" Foreground="#94A3B8" FontSize="12" FontWeight="Bold" />

                        <!-- Phóng to / Thu nhỏ -->
                        <Grid ColumnDefinitions="*, Auto, *, Auto" ColumnSpacing="4">
                            <Button Grid.Column="0" Command="{Binding ZoomOutCommand}"
                                    Background="#1E293B" Foreground="#E2E8F0" Padding="6,5" CornerRadius="4" HorizontalContentAlignment="Center">
                                <TextBlock Text="🔍-" FontSize="11.5" FontWeight="Bold" />
                            </Button>
                            <TextBlock Grid.Column="1" Text="{Binding ZoomPercentText}" Foreground="#4FC3F7" FontSize="12" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="4,0" />
                            <Button Grid.Column="2" Command="{Binding ZoomInCommand}"
                                    Background="#1E293B" Foreground="#E2E8F0" Padding="6,5" CornerRadius="4" HorizontalContentAlignment="Center">
                                <TextBlock Text="🔍+" FontSize="11.5" FontWeight="Bold" />
                            </Button>
                            <Button Grid.Column="3" Command="{Binding ResetZoomCommand}"
                                    Background="#1E293B" Foreground="#10B981" Padding="8,5" CornerRadius="4">
                                <TextBlock Text="100%" FontSize="11" FontWeight="Bold" />
                            </Button>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="6">
                            <Button Grid.Column="0" Command="{Binding FirstPageCommand}"
                                    IsEnabled="{Binding CanGoPrevPage}"
                                    Background="#1E293B" Foreground="#E2E8F0" Padding="6,6" CornerRadius="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <TextBlock Text="⏮ Trang đầu" FontSize="11.5" />
                            </Button>
                            <Button Grid.Column="1" Command="{Binding LastPageCommand}"
                                    IsEnabled="{Binding CanGoNextPage}"
                                    Background="#1E293B" Foreground="#E2E8F0" Padding="6,6" CornerRadius="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <TextBlock Text="Trang cuối ⏭" FontSize="11.5" />
                            </Button>
                        </Grid>

                        <Button Command="{Binding ToggleFullScreenCommand}"
                                Background="#1E293B" BorderBrush="#4FC3F7" BorderThickness="1"
                                Foreground="#4FC3F7" FontWeight="Bold"
                                Padding="8,6" CornerRadius="5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                            <TextBlock Text="{Binding FullScreenButtonText}" FontSize="11.5" />
                        </Button>
                    </StackPanel>
                </Border>
            </Panel>

            <!-- ================================================================= -->
            <!-- BOTTOM CONTAINER: SỐ TRANG NỔI (12-13 / 13) + THANH TRƯỢT CYAN    -->
            <!-- ================================================================= -->
            <StackPanel Grid.Row="2" Orientation="Vertical" Spacing="6">

                <!-- Badge hiển thị số trang căn giữa phía trên thanh trượt (giống hệt ảnh A. button 1-5.jpg) -->
                <Border Background="#CC20252D"
                        CornerRadius="6"
                        Padding="14,5"
                        HorizontalAlignment="Center"
                        IsHitTestVisible="False">
                    <TextBlock Text="{Binding ComicScreenPageBadgeText}"
                               Foreground="#FFFFFF"
                               FontSize="15"
                               FontWeight="Bold" />
                </Border>

                <!-- Filmstrip Thumbnail Preview nổi khi rê/kéo Slider -->
                <Border IsVisible="{Binding IsScrubberPreviewVisible}"
                        Background="#E60F172A" BorderBrush="#4FC3F7" BorderThickness="1.5"
                        CornerRadius="6" Padding="6" Margin="0,0,0,2"
                        HorizontalAlignment="Center" BoxShadow="0 4 16 0 #CC000000"
                        IsHitTestVisible="False">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <Border Width="100" Height="140" Background="#1E293B" CornerRadius="4" ClipToBounds="True">
                            <Image Source="{Binding ScrubberPreviewPage.Image}" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="{Binding ScrubberPreviewPage.DisplayPageNumber, StringFormat='Trang {0}'}"
                                   Foreground="#4FC3F7" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Thanh trượt trang (Seekbar Cyan) -->
                <Border x:Name="BottomOverlayBar"
                        Background="#E6181C22"
                        BorderBrush="#2E3642"
                        BorderThickness="0,1,0,0"
                        Padding="12,8">
                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                        <Button Grid.Column="0"
                                Command="{Binding PrevChapterCommand}"
                                IsEnabled="{Binding CanGoPrevChapter}"
                                Background="Transparent" Foreground="#94A3B8"
                                Padding="8,4" Margin="0,0,6,0"
                                ToolTip.Tip="Chương trước">
                            <TextBlock Text="⏮" FontSize="14" />
                        </Button>

                        <Slider x:Name="PageScrubberSlider"
                                Grid.Column="1"
                                Classes="comicSlider"
                                Minimum="0"
                                Maximum="{Binding MaxPageIndex}"
                                Value="{Binding CurrentPageIndex, Mode=OneWay}"
                                SmallChange="1" LargeChange="5"
                                VerticalAlignment="Center" />

                        <Button Grid.Column="2"
                                Command="{Binding NextChapterCommand}"
                                IsEnabled="{Binding CanGoNextChapter}"
                                Background="Transparent" Foreground="#94A3B8"
                                Padding="8,4" Margin="6,0,0,0"
                                ToolTip.Tip="Chương tiếp theo">
                            <TextBlock Text="⏭" FontSize="14" />
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ========================================================================= -->
        <!-- 3. GIAO DIỆN CẮT LỀ TOÀN MÀN HÌNH (BUTTON 4: MARGIN / CROP EDITOR)        -->
        <!-- ========================================================================= -->
        <Grid x:Name="MarginCropEditorGrid"
              IsVisible="{Binding IsMarginEditorOpen}"
              RowDefinitions="*, Auto"
              Background="#26000000"
              ZIndex="2500">

            <!-- Vùng khung cắt màu hồng (#E91E63) với lưới 3x3 và 4 góc kéo -->
            <Panel x:Name="MarginCropInteractivePanel" Grid.Row="0" Background="Transparent">
                <!-- Thông số lề hiện tại ở cạnh trên -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,12,0,0" Padding="12,5" CornerRadius="14"
                        Background="#CC111827" BorderBrush="#E91E63" BorderThickness="1">
                    <TextBlock Text="{Binding MarginStatusSummaryText}"
                               Foreground="#F8FAFC" FontSize="11.5" FontWeight="SemiBold" />
                </Border>

                <!-- Khung cắt chính màu hồng #E91E63 giống hệt button 4 margin.jpg -->
                <Border Margin="{Binding CropFrameMargin}"
                        BorderBrush="#E91E63"
                        BorderThickness="2">
                    <Grid RowDefinitions="*, *, *" ColumnDefinitions="*, *, *">
                        <!-- Lưới chia 3 dọc & ngang -->
                        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" BorderBrush="#99E91E63" BorderThickness="0,0,1,0" />
                        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" BorderBrush="#99E91E63" BorderThickness="0,0,1,0" />
                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" BorderBrush="#99E91E63" BorderThickness="0,0,0,1" />
                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" BorderBrush="#99E91E63" BorderThickness="0,0,0,1" />

                        <!-- 4 Góc chữ L dày màu hồng (#E91E63) -->
                        <Border Grid.Row="0" Grid.Column="0" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top"
                                BorderBrush="#E91E63" BorderThickness="5,5,0,0" Margin="-2,-2,0,0" />
                        <Border Grid.Row="0" Grid.Column="2" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top"
                                BorderBrush="#E91E63" BorderThickness="0,5,5,0" Margin="0,-2,-2,0" />
                        <Border Grid.Row="2" Grid.Column="0" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                BorderBrush="#E91E63" BorderThickness="5,0,0,5" Margin="-2,0,0,-2" />
                        <Border Grid.Row="2" Grid.Column="2" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                BorderBrush="#E91E63" BorderThickness="0,0,5,5" Margin="0,0,-2,-2" />
                    </Grid>
                </Border>
            </Panel>

            <!-- Thanh 5 nút dưới cùng của Margin Editor: Auto | Vertical | Horizontal | Reset | Apply -->
            <Border Grid.Row="1"
                    Background="#F2181C22"
                    BorderBrush="#334155"
                    BorderThickness="0,1,0,0"
                    Padding="6,6">
                <UniformGrid Columns="5" Rows="1">
                    <!-- 1. Auto -->
                    <Button Classes="toolbarBtn" Command="{Binding MarginAutoTrimCommand}">
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                            <TextBlock Text="✨" FontSize="17" HorizontalAlignment="Center" />
                            <TextBlock Text="Auto" Foreground="#E2E8F0" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 2. Vertical -->
                    <Button Classes="toolbarBtn" Command="{Binding MarginCycleVerticalCommand}">
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                            <TextBlock Text="⇕" Foreground="#FFFFFF" FontSize="17" FontWeight="ExtraBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Vertical" Foreground="#E2E8F0" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 3. Horizontal -->
                    <Button Classes="toolbarBtn" Command="{Binding MarginCycleHorizontalCommand}">
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                            <TextBlock Text="⇔" Foreground="#FFFFFF" FontSize="17" FontWeight="ExtraBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Horizontal" Foreground="#E2E8F0" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 4. Reset -->
                    <Button Classes="toolbarBtn" Command="{Binding MarginResetCommand}">
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                            <TextBlock Text="↺" Foreground="#FFFFFF" FontSize="17" FontWeight="ExtraBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Reset" Foreground="#E2E8F0" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 5. Apply -->
                    <Button Classes="toolbarBtn" Command="{Binding MarginApplyCommand}">
                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                            <TextBlock Text="✓" Foreground="#4FC3F7" FontSize="17" FontWeight="ExtraBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Apply" Foreground="#4FC3F7" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
