<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ComicDownloaderGMTPC.ViewModels"
             xmlns:models="using:ComicDownloaderGMTPC.Models"
             xmlns:views="using:ComicDownloaderGMTPC.Views"
             mc:Ignorable="d" d:DesignWidth="1150" d:DesignHeight="700"
             x:Class="ComicDownloaderGMTPC.Views.LibraryView"
             x:DataType="vm:LibraryViewModel"
             Background="#0B0F19">

    <Grid>
        <!-- ========================================================================= -->
        <!-- 1. GIAO DIỆN HỆ THỐNG SUBTAB CHUẨN COMICSCREEN (STORAGE, DIR, HIST, BM)    -->
        <!-- ========================================================================= -->
        <Grid RowDefinitions="Auto, Auto, Auto, *" Margin="4,4,4,4">

            <!-- THANH TIÊU ĐỀ TRÊN CÙNG: TÊN VÀ TRẠNG THÁI -->
            <Border Grid.Row="0" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="📚 THƯ VIỆN" Foreground="#38BDF8" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#10B981" FontSize="11" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- KHUNG 1: CỤM NÚT TIỆN ÍCH NẰM BÊN TRÊN HÀNG STORAGE, DIRECTORY... -->
            <Border Grid.Row="1" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,0,4">
                <WrapPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Command="{Binding AddStorageFolderCommand}"
                            Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1"
                            Foreground="#38BDF8" FontWeight="SemiBold"
                            Padding="9,3" Height="28" CornerRadius="5" Margin="0,0,5,2"
                            ToolTip.Tip="Ghim thêm thư mục mới vào Subtab Storage">
                        <TextBlock Text="➕ Thêm Thư Mục" FontSize="10.5" VerticalAlignment="Center" />
                    </Button>

                    <Button Command="{Binding OpenCbzFileDirectCommand}"
                            Background="#7C3AED" Foreground="#FFFFFF" FontWeight="Bold"
                            Padding="9,3" Height="28" CornerRadius="5" Margin="0,0,5,2"
                            ToolTip.Tip="Mở nhanh 1 file .cbz, .zip hoặc .pdf bất kỳ để đọc ngay">
                        <TextBlock Text="📦 Mở File CBZ/ZIP/PDF" FontSize="10.5" VerticalAlignment="Center" />
                    </Button>

                    <Button Command="{Binding ToggleSeparateReaderWindowCommand}"
                            Background="{Binding SeparateWindowModeBackground}"
                            BorderBrush="#10B981" BorderThickness="1"
                            Foreground="#FFFFFF" Padding="9,3" Height="28" CornerRadius="5" Margin="0,0,5,2"
                            ToolTip.Tip="Bật để mở trình đọc ở Cửa sổ FullScreen độc lập (trên Android sẽ tách thành thẻ riêng trong Recents)">
                        <TextBlock Text="{Binding SeparateWindowModeText}" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />
                    </Button>

                    <Button Command="{Binding OpenCacheDataModalCommand}"
                            Background="#1E293B" BorderBrush="#06B6D4" BorderThickness="1"
                            Foreground="#06B6D4" FontWeight="SemiBold"
                            Padding="9,3" Height="28" CornerRadius="5" Margin="0,0,5,2"
                            ToolTip.Tip="Quản lý bộ nhớ đệm ảnh bìa, tệp nén, dấu trang và lịch sử đọc truyện của Thư viện">
                        <TextBlock Text="💾 Bộ nhớ đệm" FontSize="10.5" VerticalAlignment="Center" />
                    </Button>

                    <Button Command="{Binding ScanLibraryCommand}"
                            IsEnabled="{Binding !IsScanning}"
                            Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold"
                            Padding="9,3" Height="28" CornerRadius="5" Margin="0,0,0,2"
                            ToolTip.Tip="Quét lại thư viện truyện">
                        <TextBlock Text="🔄 Quét" FontSize="10.5" VerticalAlignment="Center" />
                    </Button>
                </WrapPanel>
            </Border>

            <!-- THANH SUBTAB 4 MỤC CHUẨN 100% COMICSCREEN: Storage, Directory, History, Bookmark -->
            <Border Grid.Row="2" Background="#161F30" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Margin="0,0,0,6" Height="44">
                <Grid ColumnDefinitions="*, *, *, *">
                    <!-- 1. STORAGE TAB -->
                    <Button Grid.Column="0" Command="{Binding SelectSubTabCommand}" CommandParameter="Storage"
                            Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0">
                        <Grid RowDefinitions="*, 3">
                            <TextBlock Grid.Row="0" Text="Storage" Foreground="{Binding StorageTabForeground}" FontWeight="{Binding StorageTabFontWeight}"
                                       FontSize="13.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Grid.Row="1" Background="{Binding StorageTabLineBackground}" HorizontalAlignment="Stretch" />
                        </Grid>
                    </Button>

                    <!-- 2. DIRECTORY TAB -->
                    <Button Grid.Column="1" Command="{Binding SelectSubTabCommand}" CommandParameter="Directory"
                            Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0">
                        <Grid RowDefinitions="*, 3">
                            <TextBlock Grid.Row="0" Text="Directory" Foreground="{Binding DirectoryTabForeground}" FontWeight="{Binding DirectoryTabFontWeight}"
                                       FontSize="13.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Grid.Row="1" Background="{Binding DirectoryTabLineBackground}" HorizontalAlignment="Stretch" />
                        </Grid>
                    </Button>

                    <!-- 3. HISTORY TAB -->
                    <Button Grid.Column="2" Command="{Binding SelectSubTabCommand}" CommandParameter="History"
                            Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0">
                        <Grid RowDefinitions="*, 3">
                            <TextBlock Grid.Row="0" Text="History" Foreground="{Binding HistoryTabForeground}" FontWeight="{Binding HistoryTabFontWeight}"
                                       FontSize="13.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Grid.Row="1" Background="{Binding HistoryTabLineBackground}" HorizontalAlignment="Stretch" />
                        </Grid>
                    </Button>

                    <!-- 4. BOOKMARK TAB -->
                    <Button Grid.Column="3" Command="{Binding SelectSubTabCommand}" CommandParameter="Bookmark"
                            Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0">
                        <Grid RowDefinitions="*, 3">
                            <TextBlock Grid.Row="0" Text="Bookmark" Foreground="{Binding BookmarkTabForeground}" FontWeight="{Binding BookmarkTabFontWeight}"
                                       FontSize="13.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Grid.Row="1" Background="{Binding BookmarkTabLineBackground}" HorizontalAlignment="Stretch" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- NỘI DUNG 4 SUBTAB -->
            <Panel Grid.Row="3">

                <!-- ========================================================================= -->
                <!-- SUBTAB 1: STORAGE (VỊ TRÍ LƯU TRỮ - CHUẨN ẢNH 1)                          -->
                <!-- ========================================================================= -->
                <Grid IsVisible="{Binding IsStorageTabActive}" MinHeight="450">
                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="6">
                        <ListBox ItemsSource="{Binding StorageItems}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="4,4,4,90">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:StorageItemModel">
                                    <Border Background="#131C31" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="12,10" Margin="0,1">
                                        <Grid ColumnDefinitions="46, *, Auto">
                                            <!-- Icon -->
                                            <TextBlock Grid.Column="0" Text="{Binding IconText}" Foreground="{Binding IconColor}"
                                                       FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Left" />

                                            <!-- Tên & Đường dẫn -->
                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" Foreground="#94A3B8" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Cụm hành động / Xóa ghim -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).SelectStorageItemCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold"
                                                        Padding="10,5" CornerRadius="5">
                                                    <TextBlock Text="Mở ➔" FontSize="11" />
                                                </Button>

                                                <Button IsVisible="{Binding IsPinned}"
                                                        Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).RemovePinnedFolderCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="#EF4444" Foreground="#FFFFFF"
                                                        Padding="7,5" CornerRadius="5" ToolTip.Tip="Bỏ ghim thư mục này khỏi Storage">
                                                    <TextBlock Text="✕" FontSize="11" FontWeight="Bold" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- NÚT NỔI FAB (FLOATING ACTION BUTTON) Ở GÓC DƯỚI BÊN PHẢI (CHUẨN ẢNH 1 - MỞ TRUYỆN MỚI MỞ GẦN NHẤT) -->
                    <Button Command="{Binding OpenMostRecentComicCommand}"
                            Width="56" Height="56" CornerRadius="28"
                            Background="#0284C7" BorderBrush="#38BDF8" BorderThickness="2"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,16,16" ZIndex="100"
                            ClipToBounds="False"
                            ToolTip.Tip="Mở truyện đọc gần đây nhất">
                        <TextBlock Text="🕒" FontSize="22" Foreground="#FFFFFF" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>

                <!-- ========================================================================= -->
                <!-- SUBTAB 2: DIRECTORY (DUYỆT THƯ MỤC TRỰC QUAN - CHUẨN ẢNH 2)               -->
                <!-- ========================================================================= -->
                <Grid IsVisible="{Binding IsDirectoryTabActive}" RowDefinitions="Auto, Auto, Auto, *">

                    <!-- KHUNG 2: THANH CÔNG CỤ TÁC VỤ (EDIT, RECENT, VIEW, SORT) LUÔN GHIM BÊN DƯỚI HÀNG STORAGE, DIRECTORY -->
                    <Border Grid.Row="0" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,0,6" Height="42">
                        <Grid ColumnDefinitions="*, *, *, *">
                            <!-- EDIT: Ghim / Đặt thư viện -->
                            <Button Grid.Column="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Button.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuItem Header="📌 Ghim thư mục này vào Storage"
                                                  Command="{Binding PinCurrentDirectoryToStorageCommand}" />
                                        <MenuItem Header="📁 Đặt làm Thư viện chính"
                                                  Command="{Binding SetCurrentDirectoryAsLibraryRootCommand}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="⚙️" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Edit" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- RECENT: Về truyện đọc gần nhất -->
                            <Button Grid.Column="1" Command="{Binding SelectSubTabCommand}" CommandParameter="History"
                                    Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="🕒" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Recent" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- VIEW: Chế độ hiển thị -->
                            <Button Grid.Column="2" Command="{Binding ToggleDirectoryViewModeCommand}"
                                    Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding DirectoryViewModeIcon}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DirectoryViewModeText}" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- SORT: Sắp xếp -->
                            <Button Grid.Column="3" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Button.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuItem Header="Tên (A ➔ Z)" Command="{Binding SortDirectoryCommand}" CommandParameter="NameAsc" />
                                        <MenuItem Header="Tên (Z ➔ A)" Command="{Binding SortDirectoryCommand}" CommandParameter="NameDesc" />
                                        <MenuItem Header="Ngày mới nhất" Command="{Binding SortDirectoryCommand}" CommandParameter="DateDesc" />
                                        <MenuItem Header="Dung lượng lớn nhất" Command="{Binding SortDirectoryCommand}" CommandParameter="SizeDesc" />
                                    </MenuFlyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="🔀" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Sort" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- BREADCRUMB THANH ĐIỀU HƯỚNG TRÊN CÙNG -->
                    <Border Grid.Row="1" Background="#131C31" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <!-- Nút Lên 1 cấp và Nút Đọc truyện xuyên suốt toàn bộ folder ở ngay bên dưới -->
                            <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="4" Margin="0,0,8,0">
                                <Button Command="{Binding NavigateUpDirectoryCommand}"
                                        Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1"
                                        Foreground="#38BDF8" FontWeight="Bold"
                                        Padding="10,4" CornerRadius="5" HorizontalAlignment="Stretch">
                                    <TextBlock Text="⬆ Lên 1 cấp" FontSize="11" HorizontalAlignment="Center" />
                                </Button>
                                <Button Command="{Binding ReadCurrentDirectoryCommand}"
                                        Background="#0284C7" BorderBrush="#38BDF8" BorderThickness="1"
                                        Foreground="White" FontWeight="Bold"
                                        Padding="10,4" CornerRadius="5" HorizontalAlignment="Stretch"
                                        ToolTip.Tip="Đọc truyện xuyên suốt toàn bộ thư mục này">
                                    <TextBlock Text="📖 Đọc truyện" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                                </Button>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding CurrentDirectoryPath}"
                                       Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11.5"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                            <Button Grid.Column="2" Command="{Binding RefreshCurrentDirectoryCommand}"
                                    Background="#1E293B" Foreground="#94A3B8" Padding="8,4" CornerRadius="5"
                                    ToolTip.Tip="Làm mới thư mục">
                                <TextBlock Text="🔄" FontSize="11" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- BANNER / NÚT MỞ ĐỌC THƯ MỤC TRUYỆN ĐA TẦNG (CHƯƠNG / BỘ TRUYỆN / FILE TRUYỆN) -->
                    <Border Grid.Row="2" IsVisible="{Binding HasReadableCurrentDirectory}"
                            Background="#064E3B" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="6"
                            Padding="10,6" Margin="0,0,0,6">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="📖" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CurrentDirectoryReadableStatus}" Foreground="#34D399" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding ReadCurrentDirectoryCommand}"
                                    Background="#10B981" Foreground="#0F172A" FontWeight="ExtraBold"
                                    Padding="12,5" CornerRadius="5">
                                <TextBlock Text="MỞ ĐỌC NGAY ➔" FontSize="11" FontWeight="Bold" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- DANH SÁCH ITEMS THƯ MỤC, FILE TRUYỆN VÀ FILE ẢNH ĐƠN LẺ ĐA TẦNG (HỖ TRỢ CẢ THUMBNAIL LIST VÀ GRID VIEW CHUẨN COMIC SCREEN) -->
                    <Border Grid.Row="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="4">
                        <Panel>
                            <!-- 1. CHẾ ĐỘ DANH SÁCH (THUMBNAIL LIST - CHUẨN ẢNH 1 COMIC SCREEN, XEM TRỌN VẸN FULL TÊN) -->
                            <ListBox ItemsSource="{Binding DirectoryItems}"
                                     IsVisible="{Binding IsDirectoryListView}"
                                     SelectionMode="Single"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,1" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:DirectoryItemModel">
                                        <!-- Dùng Border thay Button để chống mất ContextMenu khi Hold rồi buông tay trên Android -->
                                        <Border Background="#131C31" BorderBrush="#1E293B" BorderThickness="0,0,0,1"
                                                CornerRadius="4" Padding="8,6" HorizontalAlignment="Stretch"
                                                Cursor="Hand"
                                                Tapped="OnDirectoryItemTapped"
                                                PointerPressed="OnDirectoryItemPointerPressed"
                                                PointerReleased="OnDirectoryItemPointerReleased">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <!-- Nếu là Thư mục: Nút Mở để duyệt và Nút Đọc toàn bộ thư mục -->
                                                    <MenuItem Header="📂 Mở"
                                                              IsVisible="{Binding IsFolder}"
                                                              Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).SelectDirectoryItemCommand}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="📖 Đọc truyện (Toàn bộ thư mục)"
                                                              IsVisible="{Binding IsFolder}"
                                                              Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ReadEntireFolderCommand}"
                                                              CommandParameter="{Binding FullPath}" />

                                                    <!-- Nếu là File truyện: Nút Đọc truyện -->
                                                    <MenuItem Header="📖 Đọc truyện"
                                                              IsVisible="{Binding !IsFolder}"
                                                              Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).SelectDirectoryItemCommand}"
                                                              CommandParameter="{Binding}" />

                                                    <Separator Background="#1E293B" Height="1" Margin="2,3" />
                                                    <MenuItem Header="🔄 Xóa vị trí đọc dở"
                                                              Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ClearComicResumeCommand}"
                                                              CommandParameter="{Binding}" />
                                                    <MenuItem Header="📑 Xóa dấu trang truyện này"
                                                              Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ClearComicBookmarksCommand}"
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid ColumnDefinitions="52, *, Auto, Auto">
                                                <!-- Cột 1: Ảnh bìa chữ nhật đứng chuẩn ComicScreen -->
                                                <Border Grid.Column="0" Width="50" Height="70" CornerRadius="4" Background="#090D16" ClipToBounds="True">
                                                    <Panel>
                                                        <!-- Placeholder Icon nếu chưa nạp xong Cover -->
                                                        <TextBlock Text="{Binding IconText}" Foreground="{Binding IconColor}"
                                                                   FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   IsVisible="{Binding !HasCover}" />
                                                        <!-- Cover Bitmap thật đã được giải mã -->
                                                        <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                                               IsVisible="{Binding HasCover}" />
                                                    </Panel>
                                                </Border>

                                                <!-- Cột 2: Tên file đầy đủ (TextWrapping='Wrap') + Ngày tháng -->
                                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" Margin="10,0,8,0">
                                                    <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding LastModifiedDateText}" Foreground="#94A3B8" FontSize="10.5"
                                                               IsVisible="{Binding LastModifiedDateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                </StackPanel>

                                                <!-- Cột 3: Dung lượng và Tiến độ đọc (% và số trang) -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2" MinWidth="75">
                                                    <TextBlock Text="{Binding FileSizeText}" Foreground="#94A3B8" FontSize="10.5"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding ReadingProgressText}" Foreground="#38BDF8" FontSize="10.5" FontWeight="SemiBold"
                                                               HorizontalAlignment="Right" TextAlignment="Right"
                                                               IsVisible="{Binding HasReadingProgress}" />
                                                </StackPanel>

                                                <!-- Cột 4: Nút menu 3 chấm để mở ContextMenu trực tiếp cho cảm ứng Android -->
                                                <Button Grid.Column="3"
                                                        Background="Transparent" BorderThickness="0"
                                                        Padding="8,6" Margin="4,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Click="OnDirectoryItemMenuButtonClick">
                                                    <TextBlock Text="⋮" Foreground="#94A3B8" FontSize="16" FontWeight="Bold" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 2. CHẾ ĐỘ LƯỚI Ô (GRID VIEW - CHUẨN ẢNH 2 COMIC SCREEN) -->
                            <ScrollViewer IsVisible="{Binding IsDirectoryGridView}"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding DirectoryItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DirectoryItemModel">
                                            <Border Width="114" Height="170" Margin="4" Padding="0"
                                                    Background="#131C31" BorderBrush="#1E293B" BorderThickness="1"
                                                    CornerRadius="6" ClipToBounds="True" Cursor="Hand"
                                                    Tapped="OnDirectoryItemTapped"
                                                    PointerPressed="OnDirectoryItemPointerPressed"
                                                    PointerReleased="OnDirectoryItemPointerReleased">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <!-- Nếu là Thư mục: Nút Mở để duyệt và Nút Đọc toàn bộ thư mục -->
                                                        <MenuItem Header="📂 Mở"
                                                                  IsVisible="{Binding IsFolder}"
                                                                  Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).SelectDirectoryItemCommand}"
                                                                  CommandParameter="{Binding}" />
                                                        <MenuItem Header="📖 Đọc truyện (Toàn bộ thư mục)"
                                                                  IsVisible="{Binding IsFolder}"
                                                                  Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ReadEntireFolderCommand}"
                                                                  CommandParameter="{Binding FullPath}" />

                                                        <!-- Nếu là File truyện: Nút Đọc truyện -->
                                                        <MenuItem Header="📖 Đọc truyện"
                                                                  IsVisible="{Binding !IsFolder}"
                                                                  Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).SelectDirectoryItemCommand}"
                                                                  CommandParameter="{Binding}" />

                                                        <Separator Background="#1E293B" Height="1" Margin="2,3" />
                                                        <MenuItem Header="🔄 Xóa vị trí đọc dở"
                                                                  Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ClearComicResumeCommand}"
                                                                  CommandParameter="{Binding}" />
                                                        <MenuItem Header="📑 Xóa dấu trang truyện này"
                                                                  Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ClearComicBookmarksCommand}"
                                                                  CommandParameter="{Binding}" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <!-- Nền ảnh bìa lớn toàn ô -->
                                                    <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                        <TextBlock Text="{Binding IconText}" Foreground="{Binding IconColor}"
                                                                   FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   IsVisible="{Binding !HasCover}" />
                                                        <Image Source="{Binding Cover}" Stretch="UniformToFill"
                                                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                               IsVisible="{Binding HasCover}" />
                                                    </Panel>

                                                    <!-- Nút 3 chấm mở menu góc trên phải cho cảm ứng Android -->
                                                    <Button Background="#99090D16" BorderThickness="0" CornerRadius="4"
                                                            Padding="6,3" Margin="0,4,4,0"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Click="OnDirectoryItemMenuButtonClick">
                                                        <TextBlock Text="⋮" Foreground="#E2E8F0" FontSize="14" FontWeight="Bold" />
                                                    </Button>

                                                    <!-- Dải thông tin mờ ở đáy thẻ (Tên file, Dung lượng, Tiến độ) -->
                                                    <Border Background="#E6090D16" VerticalAlignment="Bottom"
                                                            Padding="6,4" HorizontalAlignment="Stretch">
                                                        <StackPanel Spacing="1">
                                                            <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding ItemCountOrSize}" Foreground="#94A3B8" FontSize="9.5"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Border>
                                                </Panel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Khung báo trạng thái đang nạp thư mục (chống đơ UI trên MicroSD) -->
                            <Border Background="#C00F172A"
                                    IsVisible="{Binding IsDirectoryLoading}"
                                    CornerRadius="6"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                    <TextBlock Text="⏳ Đang mở thư mục..."
                                               Foreground="#38BDF8" FontSize="14" FontWeight="Bold"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Panel>
                    </Border>
                </Grid>

                <!-- ========================================================================= -->
                <!-- SUBTAB 3: HISTORY (LỊCH SỬ ĐỌC TOÀN HỆ THỐNG - CHUẨN ẢNH 3)              -->
                <!-- ========================================================================= -->
                <Grid IsVisible="{Binding IsHistoryTabActive}" RowDefinitions="Auto, *">
                    <!-- Thanh tiêu đề phụ: Số lượng và Nút xóa toàn bộ -->
                    <Border Grid.Row="0" Background="#131C31" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                <TextBlock Text="📖 LỊCH SỬ ĐỌC GẦN ĐÂY" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" />
                                <TextBlock Text="{Binding HistoryItems.Count, StringFormat='{}{0} mục'}" Foreground="#94A3B8" FontSize="11" />
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding ClearAllHistoryCommand}"
                                    Background="#334155" Foreground="#F87171" FontWeight="SemiBold"
                                    Padding="8,3" CornerRadius="5">
                                <TextBlock Text="🗑️ Xóa Lịch Sử" FontSize="10.5" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Danh sách mục lịch sử -->
                    <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="4">
                        <ListBox ItemsSource="{Binding HistoryItems}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:HistoryItemModel">
                                    <Border Background="#131C31" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="10,8" Margin="0,1">
                                        <Grid ColumnDefinitions="64, 10, *, Auto">
                                            <!-- Bìa truyện thu nhỏ -->
                                            <Border Grid.Column="0" Width="64" Height="90" CornerRadius="4" Background="#090D16" ClipToBounds="True">
                                                <Panel>
                                                    <TextBlock Text="📖" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="#64748B" />
                                                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                                </Panel>
                                            </Border>

                                            <!-- Chi tiết: Tên, dung lượng, ngày, progress bar hồng rực -->
                                            <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis" />

                                                <TextBlock Text="{Binding ChapterOrSubTitle}" Foreground="#94A3B8" FontSize="10.5"
                                                           IsVisible="{Binding HasChapterOrSubTitle}" TextTrimming="CharacterEllipsis" />

                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding FileSizeText}" Foreground="#94A3B8" FontSize="10" />
                                                    <TextBlock Grid.Column="2" Text="{Binding LastReadDateText}" Foreground="#94A3B8" FontSize="10" />
                                                </Grid>

                                                <!-- Thanh Progress bar hồng/cyan chuẩn ComicScreen -->
                                                <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100"
                                                             Height="4" CornerRadius="2" Foreground="{Binding ProgressBarColor}"
                                                             Background="#090D16" Margin="0,2" />

                                                <!-- Tiến độ số trang và % -->
                                                <TextBlock Text="{Binding ProgressText}" Foreground="#CBD5E1" FontSize="10.5" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <!-- Cụm hành động / Menu ⋮ -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <Button Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).OpenHistoryItemCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold"
                                                        Padding="9,5" CornerRadius="5" Margin="0,0,4,0">
                                                    <TextBlock Text="▶ Đọc" FontSize="10.5" />
                                                </Button>

                                                <Button Background="Transparent" BorderThickness="0" Padding="6,4">
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="Bottom">
                                                            <MenuItem Header="▶ Đọc tiếp"
                                                                      Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).OpenHistoryItemCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="📂 Mở thư mục chứa"
                                                                      Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).OpenHistoryItemFolderCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <Separator Background="#1E293B" Height="1" Margin="2,3" />
                                                            <MenuItem Header="🔄 Xóa vị trí đọc dở"
                                                                      Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ClearComicResumeCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="📑 Xóa dấu trang truyện này"
                                                                      Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ClearComicBookmarksCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <Separator Background="#1E293B" Height="1" Margin="2,3" />
                                                            <MenuItem Header="🗑️ Xóa khỏi lịch sử"
                                                                      Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).RemoveHistoryItemCommand}"
                                                                      CommandParameter="{Binding}" />
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                    <TextBlock Text="⋮" FontSize="18" Foreground="#CBD5E1" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>

                <!-- ========================================================================= -->
                <!-- SUBTAB 4: BOOKMARK (DẤU TRANG GOM NHÓM - CHUẨN ẢNH 4)                    -->
                <!-- ========================================================================= -->
                <Grid IsVisible="{Binding IsBookmarkTabActive}" RowDefinitions="Auto, *">
                    <!-- Thanh tiêu đề phụ: Nút xóa toàn bộ -->
                    <Border Grid.Row="0" Background="#131C31" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                <TextBlock Text="📑 DẤU TRANG ĐÃ LƯU" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" />
                                <TextBlock Text="{Binding BookmarkGroups.Count, StringFormat='{}{0} bộ truyện'}" Foreground="#94A3B8" FontSize="11" />
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding ClearAllBookmarksCommand}"
                                    Background="#334155" Foreground="#F87171" FontWeight="SemiBold"
                                    Padding="8,3" CornerRadius="5">
                                <TextBlock Text="🗑️ Xóa Toàn Bộ" FontSize="10.5" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Danh sách Bookmark gom nhóm theo bộ truyện -->
                    <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="4">
                        <ListBox ItemsSource="{Binding BookmarkGroups}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:BookmarkGroupModel">
                                    <StackPanel Margin="0,2,0,8">
                                        <!-- Header Tên bộ truyện màu Cyan kèm nút Xóa toàn bộ dấu trang bộ này -->
                                        <Border Background="#1A2436" BorderBrush="#2D3B55" BorderThickness="0,0,0,1" Padding="10,6">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding ComicTitle}" Foreground="#38BDF8" FontWeight="Bold" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).ClearComicBookmarksCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0" Padding="6,2"
                                                        ToolTip.Tip="Xóa toàn bộ dấu trang của bộ truyện này">
                                                    <TextBlock Text="🗑️ Xóa dấu trang bộ này" Foreground="#F87171" FontSize="10.5" FontWeight="SemiBold" />
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- Các mục bookmark con bên trong bộ truyện -->
                                        <ItemsControl ItemsSource="{Binding Bookmarks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:BookmarkItemDisplayModel">
                                                    <Border Background="#131C31" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="10,7" Margin="0,1">
                                                        <Grid ColumnDefinitions="*, Auto">
                                                            <!-- Nội dung: Tên chương, Số trang lớn, %, Ngày, Memo -->
                                                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ChapterTitle}" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold"
                                                                           TextWrapping="Wrap" />

                                                                <Grid ColumnDefinitions="Auto, Auto, *">
                                                                    <!-- Số trang lớn chuẩn ảnh 4 (ví dụ 747 / 6558) -->
                                                                    <TextBlock Grid.Column="0" Text="{Binding PageProgressText}" Foreground="#FFFFFF"
                                                                               FontSize="15" FontWeight="Bold" />

                                                                    <!-- Tỷ lệ % (ví dụ 11%) -->
                                                                    <TextBlock Grid.Column="1" Text="{Binding PercentText}" Foreground="#94A3B8"
                                                                               FontSize="11.5" Margin="14,2,0,0" />

                                                                    <!-- Ngày giờ lưu (ví dụ 2026-10-11 09:51) -->
                                                                    <TextBlock Grid.Column="2" Text="{Binding DateText}" Foreground="#94A3B8"
                                                                               FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                </Grid>

                                                                <!-- Memo ghi chú (nếu có, ví dụ "cover") -->
                                                                <TextBlock Text="{Binding Memo}" Foreground="#C084FC" FontSize="11" FontStyle="Italic"
                                                                           IsVisible="{Binding HasMemo}" />
                                                            </StackPanel>

                                                            <!-- Cụm nút mở / Menu ⋮ -->
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                <Button Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).OpenBookmarkCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold"
                                                                        Padding="9,5" CornerRadius="5" Margin="0,0,4,0">
                                                                    <TextBlock Text="▶ Nhảy tới" FontSize="10.5" />
                                                                </Button>

                                                                <Button Background="Transparent" BorderThickness="0" Padding="6,4">
                                                                    <Button.Flyout>
                                                                        <MenuFlyout Placement="Bottom">
                                                                            <MenuItem Header="▶ Nhảy tới trang này"
                                                                                      Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).OpenBookmarkCommand}"
                                                                                      CommandParameter="{Binding}" />
                                                                            <MenuItem Header="🗑️ Xóa bookmark"
                                                                                      Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).RemoveBookmarkCommand}"
                                                                                      CommandParameter="{Binding}" />
                                                                        </MenuFlyout>
                                                                    </Button.Flyout>
                                                                    <TextBlock Text="⋮" FontSize="18" Foreground="#CBD5E1" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Panel>
        </Grid>

        <!-- ========================================================================= -->
        <!-- 2. LỚP PHỦ ĐỌC TRUYỆN NỘI TUYẾN (KHI CHỌN ĐỌC TRÊN MÀN HÌNH CHÍNH)        -->
        <!-- ========================================================================= -->
        <Border IsVisible="{Binding IsInlineReaderVisible}"
                Background="#05080F"
                ZIndex="3500"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Panel>
                <views:ComicReaderControl DataContext="{Binding InlineReaderVm}" />

                <!-- Nút nổi tách nhanh sang Cửa sổ / Task Độc lập (Đa nhiệm Android) -->
                <Button Command="{Binding PopOutInlineReaderCommand}"
                        IsVisible="{Binding InlineReaderVm.IsOverlayVisible, FallbackValue=True}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,56,16,0" ZIndex="3700"
                        Background="#7C3AED" BorderBrush="#C084FC" BorderThickness="1.2"
                        Foreground="#FFFFFF" FontWeight="Bold"
                        Padding="12,6" CornerRadius="16"
                        ToolTip.Tip="Tách trình đọc đang mở sang một Cửa sổ / Task FullScreen độc lập (2 thẻ riêng biệt trong Đa nhiệm Android)">
                    <TextBlock Text="🗗 Tách Cửa Sổ Riêng (Đa Nhiệm)" FontSize="11" />
                </Button>
            </Panel>
        </Border>

        <!-- ========================================================================= -->
        <!-- 3. MODAL QUẢN LÝ BỘ NHỚ ĐỆM & DỮ LIỆU THƯ VIỆN (RESPONSIVE 100%)           -->
        <!-- ========================================================================= -->
        <Border IsVisible="{Binding IsCacheDataModalOpen}"
                Background="#B005080F"
                ZIndex="4000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Panel>
                <Border MaxWidth="540" MaxHeight="620"
                        Background="#0D131F" BorderBrush="#06B6D4" BorderThickness="1.5"
                        CornerRadius="10" Padding="14,12"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10,14"
                        BoxShadow="0 15 40 0 #DD000000">
                    <Grid RowDefinitions="Auto, Auto, *, Auto" RowSpacing="10">
                        <!-- HEADER MODAL -->
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="💾 Quản lý bộ nhớ đệm thư viện (Cache &amp; Data)" Foreground="#38BDF8" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock Text="Bộ nhớ đệm ảnh bìa, tệp nén (.zip, .rar, .pdf), dấu trang và lịch sử đọc"
                                           Foreground="#64748B" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding CloseCacheDataModalCommand}"
                                    Width="30" Height="30" Padding="0" CornerRadius="6"
                                    Background="#1E293B" Foreground="#94A3B8"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    ToolTip.Tip="Đóng">
                                <TextBlock Text="✕" FontSize="13" FontWeight="Bold" />
                            </Button>
                        </Grid>

                        <!-- THANH TỔNG HỢP DUNG LƯỢNG -->
                        <Border Grid.Row="1" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="7" Padding="10,6">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="Hỗ trợ: .zip, .cbz, .rar, .cbr, .pdf, .mobi (azw, azw3, prc)"
                                           Foreground="#94A3B8" FontSize="10.5" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0" />
                                <Border Grid.Column="1" Background="#1E293B" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalCacheSummaryText, StringFormat='Tổng: {0}'}"
                                               Foreground="#10B981" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- DANH SÁCH CÁC MỤC BỘ NHỚ ĐỆM & DỮ LIỆU THƯ VIỆN -->
                        <Border Grid.Row="2" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="6">
                                    <!-- NHÓM 1: ẢNH BÌA THU NHỎ (THUMBNAILS) -->
                                    <TextBlock Text="🖼️ BỘ NHỚ ĐỆM ẢNH BÌA (THUMBNAILS)" Foreground="#38BDF8" FontSize="10.5" FontWeight="Bold" Margin="4,2,0,0" />

                                    <!-- ITEM 1: SET THUMBNAILS STORAGE -->
                                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="7" Padding="10,7">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <TextBlock Grid.Column="0" Text="🖼️" FontSize="17" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="Set thumbnails storage" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ThumbnailStorageSummaryText}" Foreground="#38BDF8" FontSize="10.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Command="{Binding OpenThumbnailQuotaDialogCommand}"
                                                    Background="#1E293B" Foreground="#38BDF8" BorderBrush="#38BDF8" BorderThickness="1"
                                                    CornerRadius="6" Padding="9,4" FontWeight="SemiBold" FontSize="10.5"
                                                    Content="Đổi hạn mức ⚙" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>

                                    <!-- ITEM 2: CLEAR THUMBNAILS -->
                                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="7" Padding="10,7">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <TextBlock Grid.Column="0" Text="🧹" FontSize="17" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="Clear Thumbnails" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="Xóa toàn bộ ảnh bìa thu nhỏ đã lưu trong thư viện" Foreground="#94A3B8" FontSize="10.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Command="{Binding ClearThumbnailsCommand}"
                                                    Background="#1E293B" Foreground="#F59E0B" BorderBrush="#F59E0B" BorderThickness="1"
                                                    CornerRadius="6" Padding="10,4" FontWeight="SemiBold" FontSize="10.5"
                                                    Content="Xóa" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>

                                    <!-- NHÓM 2: TỆP NÉN & TÀI LIỆU (ZIP FILE CACHE) -->
                                    <TextBlock Text="🗜️ BỘ NHỚ ĐỆM TỆP NÉN &amp; TÀI LIỆU (ZIP FILE CACHE)" Foreground="#38BDF8" FontSize="10.5" FontWeight="Bold" Margin="4,4,0,0" />

                                    <!-- ITEM 3: SET ZIP-FILE CACHE STORAGE (CHỌN DUNG LƯỢNG ZIP CACHE) -->
                                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="7" Padding="10,7">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <TextBlock Grid.Column="0" Text="🗜️" FontSize="17" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="Set zip-file cache storage" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ZipCacheStorageSummaryText}" Foreground="#38BDF8" FontSize="10.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Command="{Binding OpenZipQuotaDialogCommand}"
                                                    Background="#1E293B" Foreground="#38BDF8" BorderBrush="#38BDF8" BorderThickness="1"
                                                    CornerRadius="6" Padding="9,4" FontWeight="SemiBold" FontSize="10.5"
                                                    Content="Đổi dung lượng ⚙" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>

                                    <!-- ITEM 4: CLEAR ZIP-FILE CACHE (XÓA DUNG LƯỢNG ZIP CACHE) -->
                                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="7" Padding="10,7">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <TextBlock Grid.Column="0" Text="📦" FontSize="17" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="Clear zip-file cache" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ArchiveCacheSummaryText, StringFormat='Xóa toàn bộ cache giải nén tệp: {0} (.zip, .cbz, .rar, .cbr, .pdf, .mobi)'}"
                                                           Foreground="#94A3B8" FontSize="10.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Command="{Binding ClearArchiveCacheCommand}"
                                                    Background="#1E293B" Foreground="#F59E0B" BorderBrush="#F59E0B" BorderThickness="1"
                                                    CornerRadius="6" Padding="10,4" FontWeight="SemiBold" FontSize="10.5"
                                                    Content="Xóa" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>

                                    <!-- ITEM 5: SET ZIP-FILE CACHE RETENTION PERIOD -->
                                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="7" Padding="10,7">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <TextBlock Grid.Column="0" Text="⏳" FontSize="17" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="Set zip-file cache retention period" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding RetentionPeriodSummaryText, StringFormat='Thời hạn lưu đệm: {0}'}" Foreground="#38BDF8" FontSize="10.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Command="{Binding OpenRetentionDialogCommand}"
                                                    Background="#1E293B" Foreground="#38BDF8" BorderBrush="#38BDF8" BorderThickness="1"
                                                    CornerRadius="6" Padding="9,4" FontWeight="SemiBold" FontSize="10.5"
                                                    Content="Đổi thời hạn ⚙" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>

                                    <!-- NHÓM 3: DỮ LIỆU ĐỌC DỞ & LỊCH SỬ THƯ VIỆN -->
                                    <TextBlock Text="🔖 DỮ LIỆU ĐỌC &amp; DẤU TRANG THƯ VIỆN" Foreground="#38BDF8" FontSize="10.5" FontWeight="Bold" Margin="4,4,0,0" />

                                    <!-- ITEM 6: CLEAR RESUME CACHE -->
                                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="7" Padding="10,7">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <TextBlock Grid.Column="0" Text="🔖" FontSize="17" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="Clear resume cache" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="Xóa vị trí và mốc trang đang đọc dở của tất cả truyện" Foreground="#94A3B8" FontSize="10.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Command="{Binding ClearResumeCacheCommand}"
                                                    Background="#1E293B" Foreground="#F59E0B" BorderBrush="#F59E0B" BorderThickness="1"
                                                    CornerRadius="6" Padding="10,4" FontWeight="SemiBold" FontSize="10.5"
                                                    Content="Xóa" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>

                                    <!-- ITEM 7: CLEAR BOOKMARKS -->
                                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="7" Padding="10,7">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <TextBlock Grid.Column="0" Text="⭐" FontSize="17" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="Clear bookmarks" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="Xóa toàn bộ các trang đã đánh dấu yêu thích" Foreground="#94A3B8" FontSize="10.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Command="{Binding ClearBookmarksCommand}"
                                                    Background="#1E293B" Foreground="#F59E0B" BorderBrush="#F59E0B" BorderThickness="1"
                                                    CornerRadius="6" Padding="10,4" FontWeight="SemiBold" FontSize="10.5"
                                                    Content="Xóa" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>

                                    <!-- ITEM 8: CLEAR HISTORY -->
                                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="7" Padding="10,7">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <TextBlock Grid.Column="0" Text="🕒" FontSize="17" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="Clear history" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="Xóa toàn bộ danh sách lịch sử đọc truyện gần đây" Foreground="#94A3B8" FontSize="10.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Command="{Binding ClearHistoryCommand}"
                                                    Background="#1E293B" Foreground="#F59E0B" BorderBrush="#F59E0B" BorderThickness="1"
                                                    CornerRadius="6" Padding="10,4" FontWeight="SemiBold" FontSize="10.5"
                                                    Content="Xóa" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>

                                    <!-- ITEM 9: CLEAR ALL LIBRARY DATA -->
                                    <Border Background="#1F1517" BorderBrush="#EF4444" BorderThickness="1.2" CornerRadius="7" Padding="10,7">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <TextBlock Grid.Column="0" Text="💥" FontSize="17" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="Clear library data" Foreground="#F87171" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" />
                                                <TextBlock Text="Xóa sạch toàn bộ dữ liệu đọc (vị trí dở, dấu trang, lịch sử)"
                                                           Foreground="#E2E8F0" FontSize="10.5" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Command="{Binding ClearAllCacheCommand}"
                                                    Background="#DC2626" Foreground="#FFFFFF"
                                                    CornerRadius="6" Padding="10,5" FontWeight="Bold" FontSize="11"
                                                    Content="Xóa tất cả ⚠️" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- FOOTER -->
                        <Grid Grid.Row="3" ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="💡 Thay đổi hạn mức hoặc dọn dẹp sẽ có hiệu lực ngay lập tức."
                                       Foreground="#64748B" FontSize="10.5" FontStyle="Italic" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0" />
                            <Button Grid.Column="1" Command="{Binding CloseCacheDataModalCommand}"
                                    Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold"
                                    Padding="16,6" CornerRadius="6" Content="Đóng" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- DIALOG MODAL CHỌN HẠN MỨC THUMBNAIL (RESPONSIVE) -->
                <Border IsVisible="{Binding IsThumbnailQuotaDialogOpen}"
                        Background="#D005080F" ZIndex="6000"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Border MaxWidth="380" Background="#111827" BorderBrush="#38BDF8" BorderThickness="1.5"
                            CornerRadius="10" Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="14"
                            BoxShadow="0 10 30 0 #AA000000">
                        <StackPanel Spacing="12">
                            <TextBlock Text="⚙ Hạn mức bộ nhớ ảnh bìa (Thumbnails)" Foreground="#38BDF8" FontSize="13.5" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="Chọn dung lượng tối đa cho ảnh bìa thư viện. Khi vượt quá, hệ thống tự động dọn bớt ảnh ít dùng nhất (LRU):"
                                       Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />

                            <Border Background="#1E293B" CornerRadius="6" Padding="10,6">
                                <TextBlock Text="{Binding SelectedThumbnailQuotaMb, StringFormat='Đang chọn: {0} MB'}"
                                           Foreground="#F8FAFC" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Border>

                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="200 MB" Command="{Binding SelectThumbnailQuotaCommand}" CommandParameter="200"
                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />
                                <Button Content="500 MB" Command="{Binding SelectThumbnailQuotaCommand}" CommandParameter="500"
                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />
                                <Button Content="1.0 GB (1000 MB)" Command="{Binding SelectThumbnailQuotaCommand}" CommandParameter="1000"
                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />
                                <Button Content="2.0 GB (2000 MB)" Command="{Binding SelectThumbnailQuotaCommand}" CommandParameter="2000"
                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />
                                <Button Content="3.0 GB (3000 MB)" Command="{Binding SelectThumbnailQuotaCommand}" CommandParameter="3000"
                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />
                                <Button Content="5.0 GB (5000 MB)" Command="{Binding SelectThumbnailQuotaCommand}" CommandParameter="5000"
                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />
                            </WrapPanel>

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,6,0,0">
                                <Button Grid.Column="0" Command="{Binding CloseThumbnailQuotaDialogCommand}"
                                        Background="#1E293B" Foreground="#94A3B8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Padding="0,8" CornerRadius="6" Content="Hủy" />
                                <Button Grid.Column="1" Command="{Binding ConfirmThumbnailQuotaCommand}"
                                        Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Padding="0,8" CornerRadius="6" Content="Lưu hạn mức" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- DIALOG MODAL CHỌN DUNG LƯỢNG ZIP CACHE (RESPONSIVE) -->
                <Border IsVisible="{Binding IsZipQuotaDialogOpen}"
                        Background="#D005080F" ZIndex="6000"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Border MaxWidth="380" Background="#111827" BorderBrush="#38BDF8" BorderThickness="1.5"
                            CornerRadius="10" Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="14"
                            BoxShadow="0 10 30 0 #AA000000">
                        <StackPanel Spacing="12">
                            <TextBlock Text="⚙ Hạn mức bộ nhớ đệm tệp nén (Zip Cache)" Foreground="#38BDF8" FontSize="13.5" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="Chọn dung lượng tối đa cho bộ nhớ đệm giải nén tệp zip, cbz, rar, pdf... Khi vượt quá hạn mức, hệ thống tự động dọn bớt trang cũ nhất (LRU):"
                                       Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />

                            <Border Background="#1E293B" CornerRadius="6" Padding="10,6">
                                <TextBlock Text="{Binding SelectedZipQuotaMb, StringFormat='Đang chọn: {0} MB'}"
                                           Foreground="#F8FAFC" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Border>

                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="500 MB" Command="{Binding SelectZipQuotaCommand}" CommandParameter="500"
                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />
                                <Button Content="1.0 GB (1000 MB - Mặc định)" Command="{Binding SelectZipQuotaCommand}" CommandParameter="1000"
                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />
                                <Button Content="2.0 GB (2000 MB)" Command="{Binding SelectZipQuotaCommand}" CommandParameter="2000"
                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />
                                <Button Content="4.0 GB (4000 MB)" Command="{Binding SelectZipQuotaCommand}" CommandParameter="4000"
                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />
                                <Button Content="8.0 GB (8000 MB)" Command="{Binding SelectZipQuotaCommand}" CommandParameter="8000"
                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />
                                <Button Content="16.0 GB (16000 MB)" Command="{Binding SelectZipQuotaCommand}" CommandParameter="16000"
                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />
                                <Button Content="32.0 GB (32000 MB)" Command="{Binding SelectZipQuotaCommand}" CommandParameter="32000"
                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />
                            </WrapPanel>

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,6,0,0">
                                <Button Grid.Column="0" Command="{Binding CloseZipQuotaDialogCommand}"
                                        Background="#1E293B" Foreground="#94A3B8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Padding="0,8" CornerRadius="6" Content="Hủy" />
                                <Button Grid.Column="1" Command="{Binding ConfirmZipQuotaCommand}"
                                        Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Padding="0,8" CornerRadius="6" Content="Lưu hạn mức" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- DIALOG MODAL CHỌN THỜI HẠN LƯU TỆP NÉN (RESPONSIVE) -->
                <Border IsVisible="{Binding IsRetentionDialogOpen}"
                        Background="#D005080F" ZIndex="6000"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Border MaxWidth="380" Background="#111827" BorderBrush="#38BDF8" BorderThickness="1.5"
                            CornerRadius="10" Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="14"
                            BoxShadow="0 10 30 0 #AA000000">
                        <StackPanel Spacing="12">
                            <TextBlock Text="⏳ Thời hạn lưu bộ nhớ đệm tệp nén &amp; tài liệu" Foreground="#38BDF8" FontSize="13.5" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="Các trang ảnh trích xuất từ .zip, .cbz, .rar, .cbr, .pdf, .mobi không được mở sau số ngày này sẽ tự động xóa để giải phóng dung lượng đĩa:"
                                       Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />

                            <Border Background="#1E293B" CornerRadius="6" Padding="10,6">
                                <TextBlock Text="{Binding SelectedRetentionDays, StringFormat='Đang chọn: {0} ngày'}"
                                           Foreground="#F8FAFC" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Border>

                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="1 ngày" Command="{Binding SelectRetentionDaysCommand}" CommandParameter="1"
                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="10,6" CornerRadius="5" />
                                <Button Content="2 ngày" Command="{Binding SelectRetentionDaysCommand}" CommandParameter="2"
                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="10,6" CornerRadius="5" />
                                <Button Content="4 ngày (Mặc định)" Command="{Binding SelectRetentionDaysCommand}" CommandParameter="4"
                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="10,6" CornerRadius="5" />
                                <Button Content="7 ngày" Command="{Binding SelectRetentionDaysCommand}" CommandParameter="7"
                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="10,6" CornerRadius="5" />
                                <Button Content="14 ngày" Command="{Binding SelectRetentionDaysCommand}" CommandParameter="14"
                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="10,6" CornerRadius="5" />
                                <Button Content="30 ngày" Command="{Binding SelectRetentionDaysCommand}" CommandParameter="30"
                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="10,6" CornerRadius="5" />
                                <Button Content="Vĩnh viễn (Không xóa)" Command="{Binding SelectRetentionDaysCommand}" CommandParameter="0"
                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="10,6" CornerRadius="5" />
                            </WrapPanel>

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,6,0,0">
                                <Button Grid.Column="0" Command="{Binding CloseRetentionDialogCommand}"
                                        Background="#1E293B" Foreground="#94A3B8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Padding="0,8" CornerRadius="6" Content="Hủy" />
                                <Button Grid.Column="1" Command="{Binding ConfirmRetentionDaysCommand}"
                                        Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Padding="0,8" CornerRadius="6" Content="Lưu thời hạn" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Border>
            </Panel>
        </Border>
    </Grid>
</UserControl>
