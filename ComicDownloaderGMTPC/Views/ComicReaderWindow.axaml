<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ComicDownloaderGMTPC.ViewModels"
        xmlns:views="using:ComicDownloaderGMTPC.Views"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="ComicDownloaderGMTPC.Views.ComicReaderWindow"
        x:DataType="vm:ComicReaderViewModel"
        Title="{Binding ChapterTitle, StringFormat='📖 Đọc Truyện - {0}'}"
        WindowState="FullScreen"
        WindowStartupLocation="CenterScreen"
        Background="#05080F">

    <views:ComicReaderControl x:Name="InnerReaderControl" />
</Window>
