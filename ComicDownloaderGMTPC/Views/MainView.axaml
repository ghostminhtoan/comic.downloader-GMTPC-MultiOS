                                    <StackPanel Spacing="8">

                                        <TextBlock Text="Nguồn Tiểu Thuyết (Hako / Docln)" FontWeight="Bold" Foreground="#10B981" FontSize="12" />

                                        <TextBlock Text="Ví dụ: https://docln.net/truyen/..." Foreground="#94A3B8" FontSize="11" />

                                        <TextBox Text="{Binding UrlInput}" PlaceholderText="Dán link truyện chữ Hako / Docln..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />

                                        <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4">

                                            <TextBlock Text="🔍 LẤY LINK NOVEL" FontSize="11" />

                                        </Button>

                                    </StackPanel>

                                </Border>

                            </TabItem>



                            <!-- 1.4 SEARCH (TÌM KIẾM ĐA NGUỒN) -->

                            <TabItem Header="🔍 Tìm Kiếm" FontSize="12" FontWeight="SemiBold">

                                <Grid RowDefinitions="Auto, *" Margin="0,4,0,0">

                                    <Border Grid.Row="0" Background="#161F30" Padding="10" CornerRadius="6" BorderBrush="#1E293B" BorderThickness="1">

                                        <Grid RowDefinitions="Auto, Auto, Auto">

                                            <TextBox Grid.Row="0" Text="{Binding SourceSearchKeyword}" PlaceholderText="Nhập tên truyện cần tìm..." Height="34" CornerRadius="4" Background="#0F172A" Foreground="#F8FAFC" FontSize="11" Margin="0,0,0,6" />

                                            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">

                                                <Button Command="{Binding SearchSourceCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="4" Padding="10,5" Height="30" Margin="0,0,6,0">

                                                    <TextBlock Text="🔍 TÌM KIẾM" FontSize="11" />

                                                </Button>

                                                <Button Command="{Binding ImportSelectedSearchToQueueCommand}" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="4" Padding="10,5" Height="30" Margin="0,0,6,0">

                                                    <TextBlock Text="📥 NẠP VÀO QUEUE" FontSize="11" />

                                                </Button>

                                                <Button Command="{Binding OpenExternalSearchCommand}" CommandParameter="False" Background="#1E293B" Foreground="#38BDF8" CornerRadius="4" Padding="8,5" Height="30">

                                                    <TextBlock Text="🌐 Google site: search" FontSize="11" />

                                                </Button>

                                            </WrapPanel>

                                            <WrapPanel Grid.Row="2" Orientation="Horizontal">

                                                <CheckBox IsChecked="{Binding SearchTruyenqq}" Content="TruyenQQ" FontSize="10" Foreground="#D1D5DB" Margin="0,0,10,0" />

                                                <CheckBox IsChecked="{Binding SearchMangaDex}" Content="MangaDex" FontSize="10" Foreground="#D1D5DB" Margin="0,0,10,0" />

                                                <CheckBox IsChecked="{Binding SearchNettruyen}" Content="NetTruyen" FontSize="10" Foreground="#D1D5DB" Margin="0,0,10,0" />

                                                <CheckBox IsChecked="{Binding SearchHako}" Content="Hako" FontSize="10" Foreground="#D1D5DB" />

                                            </WrapPanel>

                                        </Grid>

                                    </Border>



                                    <!-- Kết quả tìm kiếm -->

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MinHeight="260" Margin="0,6,0,0">

                                        <ItemsControl ItemsSource="{Binding SearchResults}">

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="8,5">

                                                        <Grid ColumnDefinitions="Auto, 75, *, Auto" VerticalAlignment="Center">

                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,6,0" VerticalAlignment="Center" />

                                                            <Border Grid.Column="1" Background="#1E293B" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">

                                                                <TextBlock Text="{Binding Domain}" FontSize="9" Foreground="#38BDF8" FontWeight="SemiBold" />

                                                            </Border>

                                                            <StackPanel Grid.Column="2" Margin="4,0" VerticalAlignment="Center">

                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F1F5F9" FontSize="11" TextTrimming="CharacterEllipsis" />

                                                                <TextBlock Text="{Binding LatestChapter}" Foreground="#94A3B8" FontSize="10" TextTrimming="CharacterEllipsis" />

                                                            </StackPanel>

                                                            <Border Grid.Column="3" Background="#064E3B" CornerRadius="3" Padding="5,2" VerticalAlignment="Center">

                                                                <TextBlock Text="Sẵn sàng" FontSize="9" Foreground="#34D399" FontWeight="SemiBold" />

                                                            </Border>

                                                        </Grid>

                                                    </Border>

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </ScrollViewer>

                                </Grid>

                            </TabItem>



                            <!-- 1.5 PASSWORD / MẬT KHẨU -->

                            <TabItem Header="🔑 Password" FontSize="12" FontWeight="SemiBold">

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">

                                    <Border Background="#131B2E" CornerRadius="6" Padding="15" Margin="0,4,0,0">

                                        <StackPanel Spacing="14">

                                            <!-- Title -->

                                            <TextBlock Text="PASSWORD MANAGER" Foreground="#38BDF8" FontSize="14" FontWeight="Bold" />



                                            <!-- Row 1: damconuong.pet / damconuong.shop -->

                                            <Border Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,10">

                                                <StackPanel Spacing="8">

                                                    <DockPanel LastChildFill="False">

                                                        <TextBlock DockPanel.Dock="Left" Text="🌐 damconuong.pet / damconuong.shop" Foreground="#38BDF8" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" />

                                                        <Border DockPanel.Dock="Right" Background="#1E293B" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">

                                                            <TextBlock Text="Auto-Login &amp; Sync" FontSize="9.5" Foreground="#94A3B8" />

                                                        </Border>

                                                    </DockPanel>



                                                    <WrapPanel Orientation="Horizontal">

                                                        <TextBox Text="{Binding DamconuongUsername}" PlaceholderText="Username / Email..." Width="240" Height="34" Background="#161F30" BorderBrush="#1E293B" Foreground="#F8FAFC" FontSize="11.5" CornerRadius="4" VerticalContentAlignment="Center" Margin="0,0,8,6" />

                                                        <Grid Width="200" Height="34" Margin="0,0,8,6">

                                                            <TextBox Text="{Binding DamconuongPassword}" PasswordChar="●" IsVisible="{Binding !IsDamconuongPasswordVisible}" PlaceholderText="Password..." Height="34" Background="#161F30" BorderBrush="#1E293B" Foreground="#F8FAFC" FontSize="11.5" CornerRadius="4" VerticalContentAlignment="Center" Padding="8,0,36,0" />

                                                            <TextBox Text="{Binding DamconuongPassword}" IsVisible="{Binding IsDamconuongPasswordVisible}" PlaceholderText="Password..." Height="34" Background="#161F30" BorderBrush="#1E293B" Foreground="#F8FAFC" FontSize="11.5" CornerRadius="4" VerticalContentAlignment="Center" Padding="8,0,36,0" />

                                                            <Button Command="{Binding TogglePasswordVisibilityCommand}" CommandParameter="damconuong.shop" Content="👁" Width="30" Height="28" Background="Transparent" BorderThickness="0" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Xem / Ẩn mật khẩu" />

                                                        </Grid>

                                                        <Button Command="{Binding ApplyPasswordCommand}" CommandParameter="damconuong.shop" Content="APPLY" FontWeight="Bold" FontSize="11" Height="34" Padding="16,0" Background="#0284C7" Foreground="#FFFFFF" CornerRadius="4" Margin="0,0,0,6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

                                                    </WrapPanel>

                                                </StackPanel>

                                            </Border>



                                            <!-- Row 2: mangadex.org -->

                                            <Border Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,10">

                                                <StackPanel Spacing="8">

                                                    <DockPanel LastChildFill="False">

                                                        <TextBlock DockPanel.Dock="Left" Text="🌐 mangadex.org" Foreground="#38BDF8" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" />

                                                        <Border DockPanel.Dock="Right" Background="#1E293B" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">

                                                            <TextBlock Text="API / Account" FontSize="9.5" Foreground="#94A3B8" />

                                                        </Border>

                                                    </DockPanel>



                                                    <WrapPanel Orientation="Horizontal">

                                                        <TextBox Text="{Binding MangadexUsername}" PlaceholderText="Username / Email..." Width="240" Height="34" Background="#161F30" BorderBrush="#1E293B" Foreground="#F8FAFC" FontSize="11.5" CornerRadius="4" VerticalContentAlignment="Center" Margin="0,0,8,6" />

                                                        <Grid Width="200" Height="34" Margin="0,0,8,6">

                                                            <TextBox Text="{Binding MangadexPassword}" PasswordChar="●" IsVisible="{Binding !IsMangadexPasswordVisible}" PlaceholderText="Password..." Height="34" Background="#161F30" BorderBrush="#1E293B" Foreground="#F8FAFC" FontSize="11.5" CornerRadius="4" VerticalContentAlignment="Center" Padding="8,0,36,0" />

                                                            <TextBox Text="{Binding MangadexPassword}" IsVisible="{Binding IsMangadexPasswordVisible}" PlaceholderText="Password..." Height="34" Background="#161F30" BorderBrush="#1E293B" Foreground="#F8FAFC" FontSize="11.5" CornerRadius="4" VerticalContentAlignment="Center" Padding="8,0,36,0" />

                                                            <Button Command="{Binding TogglePasswordVisibilityCommand}" CommandParameter="mangadex.org" Content="👁" Width="30" Height="28" Background="Transparent" BorderThickness="0" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Xem / Ẩn mật khẩu" />

                                                        </Grid>

                                                        <Button Command="{Binding ApplyPasswordCommand}" CommandParameter="mangadex.org" Content="APPLY" FontWeight="Bold" FontSize="11" Height="34" Padding="16,0" Background="#0284C7" Foreground="#FFFFFF" CornerRadius="4" Margin="0,0,0,6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

                                                    </WrapPanel>

                                                </StackPanel>

                                            </Border>



                                            <!-- Status Text -->

                                            <TextBlock Text="{Binding PasswordManagerStatusText}" Foreground="#10B981" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />



                                            <!-- Footer Actions & Help -->

                                            <StackPanel Spacing="6" Margin="0,4,0,0">

                                                <Border Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="10,8">

                                                    <TextBlock Text="APPLY sẽ đẩy username/password sang tab source của domain tương ứng, auto login, rồi tab source tự xóa ô login sau khi hoàn tất. Password sẽ autosave vào autosave_password.md." Foreground="#94A3B8" FontSize="10.5" TextWrapping="Wrap" />

                                                </Border>

                                                <WrapPanel Orientation="Horizontal">

                                                    <Button Command="{Binding ImportPasswordsCommand}" Content="IMPORT" Background="#E11D48" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Height="32" Padding="14,0" CornerRadius="4" Margin="0,0,8,4" VerticalAlignment="Center" />

                                                    <Button Command="{Binding ExportPasswordsCommand}" Content="EXPORT" Background="#E11D48" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Height="32" Padding="14,0" CornerRadius="4" Margin="0,0,8,4" VerticalAlignment="Center" />

                                                    <Button Command="{Binding ApplyAllPasswordsCommand}" Content="APPLY ALL" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Height="32" Padding="16,0" CornerRadius="4" Margin="0,0,0,4" VerticalAlignment="Center" />

                                                </WrapPanel>

                                            </StackPanel>

                                        </StackPanel>

                                    </Border>

                                </ScrollViewer>

                            </TabItem>

                        </TabControl>

                    </Border>

                </TabItem>



                <!-- ========================================================================= -->

                <!-- [TAB 3 LỚN] TAB TOOL: CÔNG CỤ (SPLIT/MERGE, CẮT ẢNH DÀI, XỬ LÝ ẢNH, ĐÓNG GÓI) -->

                <!-- ========================================================================= -->

                <TabItem Header="🛠️ Công cụ" FontSize="12" FontWeight="Bold">

                    <Border Background="#0F172A" CornerRadius="6" Padding="6,3" Margin="0,2,0,0">

                        <TabControl SelectedIndex="{Binding SelectedToolsTabIndex}" Background="Transparent" Margin="0">



                            <!-- CHILD TAB 3.1: FOLDER TOOLS (TÁCH / GỘP FOLDER) -->

                            <TabItem Header="📁 Tách / Gộp Thư Mục" FontSize="12" FontWeight="SemiBold">

                                <Grid RowDefinitions="Auto, *">

                                    <!-- Panel cấu hình tác vụ Tách / Gộp Folder -->

                                    <Border Grid.Row="0" Background="#161F30" Padding="12,10" BorderBrush="#1E293B" BorderThickness="0,0,0,1">

                                        <StackPanel Spacing="12">

                                            <!-- KHU VỰC 1: TÁCH / GỘP THEO SỐ LƯỢNG CHAPTER -->

                                            <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10">

                                                <StackPanel Spacing="8">

                                                    <TextBlock Text="1. Tách / Gộp Thư Mục Theo Số Lượng Chapter (Ví dụ: Nhóm 200 chap/folder)" FontWeight="Bold" Foreground="#38BDF8" FontSize="12" />

                                                    

                                                    <!-- Thư mục gốc theo Chapter (Bố cục 2 tầng xem Full Path trên Android) -->

                                                    <StackPanel Spacing="3">

                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                            <TextBlock Text="📁 Thư mục truyện gốc (Root Single Comic):" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                            <Button Command="{Binding BrowseFolderSplitRootCommand}" Content="📁 Chọn Thư Mục" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" />

                                                            <Button Command="{Binding OpenFolderSplitRootCommand}" Content="📂 Mở" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" ToolTip.Tip="Mở thư mục trên thiết bị" />

                                                        </WrapPanel>

                                                        <TextBox Text="{Binding FolderSplitRootPath}" PlaceholderText="Chọn thư mục truyện gốc cần tách hoặc gộp..." Height="30" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" BorderBrush="#38BDF8" BorderThickness="1" FontSize="10" VerticalContentAlignment="Center" Padding="8,2" />

                                                    </StackPanel>



                                                    <!-- Cấu hình số chapter mỗi nhóm & kiểu tách -->

                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center">

                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                                                <TextBlock Text="Số chap/folder:" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />

                                                                <NumericUpDown Value="{Binding FolderSplitGroupSize}" Minimum="1" Maximum="5000" Increment="50" FormatString="0" Width="120" Height="28" FontSize="11" Foreground="#38BDF8" Background="#0B0F19" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                                                            </StackPanel>

                                                        </Border>



                                                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center">

                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                                                <TextBlock Text="Số CPU:" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />

                                                                <NumericUpDown Value="{Binding FolderToolThreads}" Minimum="1" Maximum="{Binding MaxFolderToolThreads}" Increment="1" FormatString="0" Width="110" Height="28" FontSize="11" Foreground="#10B981" Background="#0B0F19" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTip.Tip="Số lượng folder di chuyển cùng lúc (Mặc định: 20 folder, tối đa theo CPU máy)" />

                                                                <TextBlock Text="folder" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />

                                                            </StackPanel>

                                                        </Border>



                                                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="0,0,8,4" VerticalAlignment="Center">

                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                                                                <TextBlock Text="Kiểu tên folder:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />

                                                                <ComboBox SelectedItem="{Binding FolderSplitType}" Width="150" Height="26" FontSize="10">

                                                                    <x:String>chapter</x:String>

                                                                    <x:String>book-chapter</x:String>

                                                                </ComboBox>

                                                            </StackPanel>

                                                        </Border>



                                                        <CheckBox IsChecked="{Binding IsMergeRemainderFolder}" Content="Gộp cả nhóm lẻ còn lại" FontSize="10" Foreground="#D1D5DB" Margin="0,0,8,4" />



                                                        <Button Command="{Binding SplitByChapterCountCommand}" IsEnabled="{Binding !IsFolderToolRunning}"

                                                                Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" Padding="12,5" Height="28" CornerRadius="4" Margin="0,0,6,4">

                                                            <TextBlock Text="📂 TÁCH THEO SỐ LƯỢNG CHAPTER" />

                                                        </Button>



                                                        <Button Command="{Binding MergeByChapterCountCommand}" IsEnabled="{Binding !IsFolderToolRunning}"

                                                                Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" Padding="12,5" Height="28" CornerRadius="4" Margin="0,0,0,4">

                                                            <TextBlock Text="🔄 GỘP CHAPTER VỀ GỐC" />

                                                        </Button>

                                                    </WrapPanel>

                                                </StackPanel>

                                            </Border>



                                            <!-- KHU VỰC 2: TÁCH / GỘP THEO BẢNG CHỮ CÁI (ALPHABET) -->

                                            <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10">

                                                <StackPanel Spacing="8">

                                                    <TextBlock Text="2. Tách / Gộp Thư Mục Theo Bảng Chữ Cái (Alphabet A-G, H-P, Q-Z...)" FontWeight="Bold" Foreground="#F59E0B" FontSize="12" />



                                                    <!-- Thư mục gốc theo Alphabet (Bố cục 2 tầng xem Full Path trên Android) -->

                                                    <StackPanel Spacing="3">

                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                            <TextBlock Text="📁 Thư mục gốc chứa nhiều bộ truyện (Multi-Comic Root):" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                            <Button Command="{Binding BrowseFolderAlphabetRootCommand}" Content="📁 Chọn Thư Mục" Background="#D97706" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" />

                                                            <Button Command="{Binding OpenFolderAlphabetRootCommand}" Content="📂 Mở" Background="#1E293B" Foreground="#F59E0B" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" ToolTip.Tip="Mở thư mục trên thiết bị" />

                                                        </WrapPanel>

                                                        <TextBox Text="{Binding FolderAlphabetRootPath}" PlaceholderText="Chọn thư mục chứa nhiều bộ truyện cần phân loại theo chữ cái..." Height="30" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" BorderBrush="#F59E0B" BorderThickness="1" FontSize="10" VerticalContentAlignment="Center" Padding="8,2" />

                                                    </StackPanel>



                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                        <CheckBox IsChecked="{Binding IsAlphabetIgnoreLeadingTags}" Content="Bỏ qua tiền tố tag [...]" FontSize="10" Foreground="#D1D5DB" Margin="0,0,10,4" />



                                                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center">

                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                                                <TextBlock Text="Số CPU:" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />

                                                                <NumericUpDown Value="{Binding FolderToolThreads}" Minimum="1" Maximum="{Binding MaxFolderToolThreads}" Increment="1" FormatString="0" Width="110" Height="28" FontSize="11" Foreground="#10B981" Background="#0B0F19" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTip.Tip="Số lượng folder di chuyển cùng lúc (Mặc định: 20 folder, tối đa theo CPU máy)" />

                                                                <TextBlock Text="folder" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />

                                                            </StackPanel>

                                                        </Border>



                                                        <!-- Quản lý dải chữ cái -->

                                                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="0,0,8,4" VerticalAlignment="Center">

                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                                                                <TextBlock Text="Dải:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />

                                                                <TextBox Text="{Binding NewAlphabetRangeInput}" PlaceholderText="VD: A-C" Width="105" Height="28" FontSize="11" Background="#0B0F19" Foreground="#F8FAFC" BorderBrush="#334155" CornerRadius="3" VerticalContentAlignment="Center" Padding="6,2" />

                                                                <Button Command="{Binding AddAlphabetRangeCommand}" Content="➕ Thêm" Background="#1E293B" Foreground="#38BDF8" FontSize="10" Padding="8,4" CornerRadius="3" />

                                                            </StackPanel>

                                                        </Border>



                                                        <Button Command="{Binding SplitByAlphabetCommand}" IsEnabled="{Binding !IsFolderToolRunning}"

                                                                Background="#D97706" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" Padding="12,5" Height="28" CornerRadius="4" Margin="0,0,6,4">

                                                            <TextBlock Text="🔤 TÁCH THEO ALPHABET" />

                                                        </Button>



                                                        <Button Command="{Binding MergeByAlphabetCommand}" IsEnabled="{Binding !IsFolderToolRunning}"

                                                                Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" Padding="12,5" Height="28" CornerRadius="4" Margin="0,0,6,4">

                                                            <TextBlock Text="🔄 GỘP TỪ ALPHABET VỀ GỐC" />

                                                        </Button>



                                                        <Button Command="{Binding StopFolderToolCommand}" IsEnabled="{Binding IsFolderToolRunning}"

                                                                Background="#DC2626" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="10,5" Height="28" CornerRadius="4" Margin="0,0,6,4">

                                                            <TextBlock Text="⏹ DỪNG" />

                                                        </Button>



                                                        <Button Command="{Binding ClearFolderToolLogsCommand}"

                                                                Background="#1E293B" Foreground="#94A3B8" FontSize="10" Padding="8,5" Height="28" CornerRadius="4" Margin="0,0,0,4">

                                                            <TextBlock Text="🧹 Xóa log" />

                                                        </Button>

                                                    </WrapPanel>

                                                </StackPanel>

                                            </Border>



                                            <!-- KHU VỰC 3: ĐỔI TÊN THƯ MỤC CHAPTER (SINGLE / MULTI-COMIC RENAME) -->

                                            <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10">

                                                <StackPanel Spacing="8">

                                                    <TextBlock Text="3. Đổi Tên Thư Mục Chapter (Rename Folders: Single / Multi-Comic)" FontWeight="Bold" Foreground="#A78BFA" FontSize="12" />

                                                    <TextBlock Text="Đổi tên các thư mục chapter đa tầng sâu để hiển thị rõ tên truyện trên Comic Screen, tránh bị lẫn lộn giữa các bộ truyện." Foreground="#94A3B8" FontSize="10.5" TextWrapping="Wrap" />



                                                    <!-- Thư mục gốc (Bố cục 2 tầng xem Full Path trên Android) -->

                                                    <StackPanel Spacing="3">

                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                            <TextBlock Text="📁 Thư mục gốc chứa truyện (Root Folder):" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                            <Button Command="{Binding BrowseFolderRenameRootCommand}" Content="📁 Chọn Thư Mục" Background="#7C3AED" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" />

                                                            <Button Command="{Binding OpenFolderRenameRootCommand}" Content="📂 Mở" Background="#1E293B" Foreground="#A78BFA" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" ToolTip.Tip="Mở thư mục trên thiết bị" />

                                                        </WrapPanel>

                                                        <TextBox Text="{Binding FolderRenameRootPath}" PlaceholderText="Chọn thư mục gốc chứa truyện cần đổi tên (hỗ trợ thư mục đa tầng sâu)..." Height="30" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" BorderBrush="#8B5CF6" BorderThickness="1" FontSize="10" VerticalContentAlignment="Center" Padding="8,2" />

                                                    </StackPanel>



                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                        <!-- Chế độ đổi tên -->

                                                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="0,0,8,4" VerticalAlignment="Center">

                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                                                <TextBlock Text="Định dạng:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />

                                                                <ComboBox SelectedItem="{Binding FolderRenameMode}" Width="260" Height="26" FontSize="10">

                                                                    <x:String>Multi-comic ({book-name}-{chapter})</x:String>

                                                                    <x:String>Single comic ({chapter})</x:String>

                                                                </ComboBox>

                                                            </StackPanel>

                                                        </Border>



                                                        <!-- Tùy chọn Slugify ASCII -->

                                                        <CheckBox IsChecked="{Binding IsFolderRenameSlugify}" Content="Chuẩn hóa slug (chữ thường không dấu)" FontSize="10" Foreground="#D1D5DB" Margin="0,0,8,4" ToolTip.Tip="Bật để chuyển thành tên ASCII không dấu (VD: a-good-day-to-camp-chuong-01). Tắt để giữ nguyên tiếng Việt có dấu." />



                                                        <!-- NumericUpDown Song song -->

                                                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center">

                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                                                <TextBlock Text="Số CPU:" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />

                                                                <NumericUpDown Value="{Binding FolderToolThreads}" Minimum="1" Maximum="{Binding MaxFolderToolThreads}" Increment="1" FormatString="0" Width="110" Height="28" FontSize="11" Foreground="#10B981" Background="#0B0F19" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTip.Tip="Số lượng folder đổi tên cùng lúc (Mặc định: 20 folder)" />

                                                                <TextBlock Text="folder" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />

                                                            </StackPanel>

                                                        </Border>



                                                        <Button Command="{Binding RenameChapterFoldersCommand}" IsEnabled="{Binding !IsFolderToolRunning}"

                                                                Background="#7C3AED" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" Padding="12,5" Height="28" CornerRadius="4" Margin="0,0,6,4">

                                                            <TextBlock Text="🏷️ ĐỔI TÊN THƯ MỤC (RENAME)" />

                                                        </Button>



                                                        <Button Command="{Binding StopFolderToolCommand}" IsEnabled="{Binding IsFolderToolRunning}"

                                                                Background="#DC2626" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="10,5" Height="28" CornerRadius="4" Margin="0,0,6,4">

                                                            <TextBlock Text="⏹ DỪNG" />

                                                        </Button>



                                                        <Button Command="{Binding ClearFolderToolLogsCommand}"

                                                                Background="#1E293B" Foreground="#94A3B8" FontSize="10" Padding="8,5" Height="28" CornerRadius="4" Margin="0,0,0,4">

                                                            <TextBlock Text="🧹 Xóa log" />

                                                        </Button>

                                                    </WrapPanel>

                                                </StackPanel>

                                            </Border>



                                            <!-- Thanh tiến trình & Trạng thái (Bố cục thông minh chống Overlap 100%) -->

                                            <Border Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8">

                                                <StackPanel Spacing="6">

                                                    <Grid ColumnDefinitions="Auto, *">

                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">

                                                            <TextBlock Text="📊 Tiến độ xử lý:" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />

                                                            <TextBlock Text="{Binding FolderToolProgressText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />

                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1" Text="{Binding FolderToolStatusText}" Foreground="#10B981" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                                    </Grid>

                                                    <ProgressBar Value="{Binding FolderToolProgress}" Maximum="100" Height="8" CornerRadius="4" Foreground="#38BDF8" Background="#1E293B" BorderBrush="#0284C7" BorderThickness="1" />

                                                    <TextBlock Text="{Binding FolderToolStatusText}" Foreground="#34D399" FontSize="10.5" TextWrapping="Wrap" IsVisible="{Binding IsFolderToolRunning}" />

                                                </StackPanel>

                                            </Border>

                                        </StackPanel>

                                    </Border>



                                    <!-- Log chi tiết -->

                                    <Border Grid.Row="1" Background="#0A0E17" Padding="6" MinHeight="160">

                                        <ScrollViewer VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False">

                                            <ItemsControl ItemsSource="{Binding FolderToolLogs}">

                                                <ItemsControl.ItemTemplate>

                                                    <DataTemplate>

                                                        <TextBlock Text="{Binding}" Foreground="#CBD5E1" FontSize="10" FontFamily="Consolas, Monospace" Margin="2,1" />

                                                    </DataTemplate>

                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>

                                        </ScrollViewer>

                                    </Border>

                                </Grid>

                            </TabItem>



                            <!-- CHILD TAB 3.2: SPLIT LONG IMAGES (CẮT ẢNH DÀI) -->

                            <TabItem Header="✂️ Cắt Ảnh Dài" FontSize="12" FontWeight="SemiBold">

                                <Grid RowDefinitions="Auto, *">

                                    <!-- Panel cấu hình -->

                                    <Border Grid.Row="0" Background="#161F30" Padding="12,10" BorderBrush="#1E293B" BorderThickness="0,0,0,1">

                                        <StackPanel Spacing="10">

                                            <!-- Chọn thư mục (Bố cục 2 tầng xem Full Path trên Android) -->

                                            <StackPanel Spacing="3">

                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <TextBlock Text="📁 Thư mục chứa ảnh dài để cắt:" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                    <Button Command="{Binding BrowseManualSplitFolderCommand}" Content="📁 Chọn Thư Mục" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" />

                                                    <Button Command="{Binding OpenManualSplitFolderCommand}" Content="📂 Mở" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" ToolTip.Tip="Mở thư mục trên thiết bị" />

                                                </WrapPanel>

                                                <TextBox Text="{Binding ManualSplitFolderPath}" PlaceholderText="Chọn thư mục chứa ảnh dài để cắt..." Height="30" CornerRadius="4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#38BDF8" BorderThickness="1" FontSize="10" VerticalContentAlignment="Center" Padding="8,2" />

                                            </StackPanel>



                                            <!-- Cấu hình Height, Quality, Threads & Nút Bắt đầu -->

                                            <WrapPanel Orientation="Horizontal">

                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,8,6" VerticalAlignment="Center">

                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                                        <TextBlock Text="Chiều cao cắt:" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />

                                                        <NumericUpDown Value="{Binding ManualSplitHeight}" Minimum="500" Maximum="50000" Increment="500" FormatString="0" Width="140" Height="28" FontSize="11" Foreground="#38BDF8" Background="#0B0F19" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                                                        <TextBlock Text="px" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />

                                                    </StackPanel>

                                                </Border>



                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,8,6" VerticalAlignment="Center">

                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                                        <TextBlock Text="Chất lượng:" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />

                                                        <NumericUpDown Value="{Binding ManualSplitQuality}" Minimum="10" Maximum="100" Increment="5" FormatString="0" Width="130" Height="28" FontSize="11" Foreground="#10B981" Background="#0B0F19" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                                                        <TextBlock Text="%" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />

                                                    </StackPanel>

                                                </Border>



                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,8,6" VerticalAlignment="Center">

                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                                        <TextBlock Text="Số CPU:" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />

                                                        <NumericUpDown Value="{Binding ManualSplitThreads}" Minimum="1" Maximum="{Binding MaxSystemThreads}" Increment="1" FormatString="0" Width="120" Height="28" FontSize="11" Foreground="#F59E0B" Background="#0B0F19" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTip.Tip="Số CPU cắt ảnh song song (Tự động nhận diện theo CPU máy)" />

                                                    </StackPanel>

                                                </Border>



                                                <Button Command="{Binding StartManualSplitCommand}" IsEnabled="{Binding !IsManualSplitting}"

                                                        Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="14,6" Height="34" CornerRadius="4" Margin="0,0,6,6">

                                                    <TextBlock Text="▶ BẮT ĐẦU CẮT ẢNH" />

                                                </Button>



                                                <Button Command="{Binding StopManualSplitCommand}" IsEnabled="{Binding !IsManualSplitting, Converter={x:Static BoolConverters.Not}}"

                                                        Background="#DC2626" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="12,6" Height="34" CornerRadius="4" Margin="0,0,6,6">

                                                    <TextBlock Text="⏹ DỪNG" />

                                                </Button>



                                                <Button Command="{Binding ClearManualSplitLogsCommand}"

                                                        Background="#1E293B" Foreground="#94A3B8" FontSize="11" Padding="10,6" Height="34" CornerRadius="4" Margin="0,0,0,6">

                                                    <TextBlock Text="🧹 Xóa log" />

                                                </Button>

                                            </WrapPanel>



                                            <!-- Thanh tiến trình & Trạng thái -->

                                            <StackPanel Spacing="4">

                                                <ProgressBar Value="{Binding ManualSplitProgress}" Maximum="100" Height="6" CornerRadius="3" Foreground="#10B981" Background="#0F172A" />

                                                <WrapPanel Orientation="Horizontal">

                                                    <TextBlock Text="{Binding ManualSplitCurrentFileText}" Foreground="#64748B" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="400" Margin="0,0,12,0" />

                                                    <TextBlock Text="{Binding ManualSplitProgressText}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" Margin="0,0,10,0" />

                                                    <TextBlock Text="{Binding ManualSplitCountText, StringFormat='{}Đã cắt: {0}'}" Foreground="#10B981" FontWeight="SemiBold" FontSize="10" Margin="0,0,10,0" />

                                                    <TextBlock Text="{Binding ManualSplitErrorCountText, StringFormat='{}Lỗi: {0}'}" Foreground="#F43F5E" FontWeight="SemiBold" FontSize="10" />

                                                </WrapPanel>

                                            </StackPanel>

                                        </StackPanel>

                                    </Border>



                                    <!-- Log chi tiết -->

                                    <Border Grid.Row="1" Background="#0A0E17" Padding="6" MinHeight="180">

                                        <ScrollViewer VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False">

                                            <ItemsControl ItemsSource="{Binding ManualSplitLogs}">

                                                <ItemsControl.ItemTemplate>

                                                    <DataTemplate>

                                                        <TextBlock Text="{Binding}" Foreground="#CBD5E1" FontSize="10" FontFamily="Consolas, Monospace" Margin="2,1" />

                                                    </DataTemplate>

                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>

                                        </ScrollViewer>

                                    </Border>

                                </Grid>

                            </TabItem>



                            <!-- CHILD TAB 3.3: BATCH IMAGE ENHANCEMENT (XỬ LÝ ẢNH) -->

                            <TabItem Header="🎨 Xử Lý Ảnh" FontSize="12" FontWeight="SemiBold">

                                <Grid RowDefinitions="Auto, *">

                                    <!-- Panel cấu hình bộ lọc & tác vụ -->

                                    <Border Grid.Row="0" Background="#161F30" Padding="12,10" BorderBrush="#1E293B" BorderThickness="0,0,0,1">

                                        <StackPanel Spacing="10">

                                            <!-- Hàng 1: Thư mục nguồn (Bố cục 2 tầng xem Full Path trên Android) -->

                                            <StackPanel Spacing="3">

                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <TextBlock Text="📥 Thư mục nguồn chứa ảnh (hỗ trợ quét đệ quy đa tầng):" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                    <Button Command="{Binding BrowseEnhanceFolderCommand}" Content="📁 Chọn Thư Mục" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" />

                                                    <Button Command="{Binding OpenEnhanceFolderCommand}" Content="📂 Mở" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" ToolTip.Tip="Mở thư mục nguồn trên thiết bị" />

                                                </WrapPanel>

                                                <TextBox Text="{Binding EnhanceFolderPath}" PlaceholderText="Chọn thư mục nguồn chứa ảnh..." Height="30" CornerRadius="4" Background="#0F172A" Foreground="#F8FAFC" FontSize="11" VerticalContentAlignment="Center" Padding="8,0" IsReadOnly="True" />

                                            </StackPanel>



                                            <!-- Hàng 2: Thư mục lưu ảnh đã xử lý (Bố cục 2 tầng xem Full Path trên Android) -->

                                            <StackPanel Spacing="3">

                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <TextBlock Text="📤 Thư mục lưu ảnh đã xử lý (Mặc định: thư mục 'enhanced' cùng cấp với nguồn):" Foreground="#10B981" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                    <Button Command="{Binding BrowseEnhanceOutputFolderCommand}" Content="📁 Chọn Thư Mục" Background="#059669" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" />

                                                    <Button Command="{Binding OpenEnhanceOutputFolderCommand}" Content="📂 Mở" Background="#1E293B" Foreground="#10B981" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" ToolTip.Tip="Mở thư mục lưu ảnh đã xử lý trên thiết bị" />

                                                    <CheckBox IsChecked="{Binding EnhanceOverwriteOriginal}" Content="Chỉ đè trực tiếp lên file gốc" Foreground="#F59E0B" FontWeight="SemiBold" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Nếu chọn, ảnh sau xử lý sẽ lưu đè trực tiếp lên file ảnh gốc thay vì tạo thư mục mới" />

                                                </WrapPanel>

                                                <TextBox Text="{Binding EnhanceOutputFolderPath}" IsEnabled="{Binding !EnhanceOverwriteOriginal}" PlaceholderText="Chọn thư mục lưu ảnh đã xử lý..." Height="30" CornerRadius="4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#10B981" BorderThickness="1" FontSize="10" VerticalContentAlignment="Center" Padding="8,2" />

                                            </StackPanel>



                                            <!-- Hàng 2.5: Định dạng xuất ảnh (Output Format WrapPanel: Original, JPG, GIF Tĩnh/Động, WebP Tĩnh/Động) -->

                                            <Border Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,5">

                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,12,2">

                                                        <TextBlock Text="📁" FontSize="11" VerticalAlignment="Center" />

                                                        <TextBlock Text="Định dạng xuất:" Foreground="#E2E8F0" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />

                                                    </StackPanel>



                                                    <!-- 1. Original (Giữ nguyên gốc) -->

                                                    <RadioButton IsChecked="{Binding IsEnhanceFormatOriginal}" GroupName="EnhanceFormatGroup"

                                                                 Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" Margin="0,0,14,2"

                                                                 ToolTip.Tip="Giữ nguyên định dạng gốc của từng file (JPG, PNG, GIF, WebP, BMP)">

                                                        <StackPanel Orientation="Horizontal" Spacing="4">

                                                            <TextBlock Text="🔄 Original (Giữ nguyên gốc)" VerticalAlignment="Center" />

                                                        </StackPanel>

                                                    </RadioButton>



                                                    <!-- 2. JPG -->

                                                    <RadioButton IsChecked="{Binding IsEnhanceFormatJpg}" GroupName="EnhanceFormatGroup"

                                                                 Foreground="#F59E0B" FontWeight="SemiBold" FontSize="11" Margin="0,0,14,2"

                                                                 ToolTip.Tip="Chuyển đổi toàn bộ ảnh sang định dạng JPEG (.jpg)">

                                                        <StackPanel Orientation="Horizontal" Spacing="4">

                                                            <TextBlock Text="🖼️ JPG" VerticalAlignment="Center" />

                                                        </StackPanel>

                                                    </RadioButton>



                                                    <!-- 3. GIF (Tĩnh / Động) -->

                                                    <RadioButton IsChecked="{Binding IsEnhanceFormatGif}" GroupName="EnhanceFormatGroup"

                                                                 Foreground="#C084FC" FontWeight="SemiBold" FontSize="11" Margin="0,0,14,2"

                                                                 ToolTip.Tip="Xuất ra định dạng GIF (Tự động bảo toàn chuyển động Animated GIF nếu nguồn là ảnh động)">

                                                        <StackPanel Orientation="Horizontal" Spacing="4">

                                                            <TextBlock Text="🎞️ GIF (Tĩnh / Động)" VerticalAlignment="Center" />

                                                        </StackPanel>

                                                    </RadioButton>



                                                    <!-- 4. WebP (Tĩnh / Động) -->

                                                    <RadioButton IsChecked="{Binding IsEnhanceFormatWebp}" GroupName="EnhanceFormatGroup"

                                                                 Foreground="#10B981" FontWeight="Bold" FontSize="11" Margin="0,0,8,2"

                                                                 ToolTip.Tip="Xuất ra định dạng WebP hiện đại (Ảnh tĩnh ra WebP tĩnh, ảnh GIF/WebP động ra Animated WebP siêu nhẹ)">

                                                        <StackPanel Orientation="Horizontal" Spacing="4">

                                                            <TextBlock Text="⚡ WebP (Tĩnh / Động)" VerticalAlignment="Center" />

                                                        </StackPanel>

                                                    </RadioButton>

                                                </WrapPanel>

                                            </Border>



                                            <!-- Hàng 3: Bộ thông số tinh chỉnh (Chuẩn bố cục XnConvert: Slider ngang mỏng, NumericUpDown 3-digit nhỏ gọn, Nút Reset riêng ↺) -->
                                            <!-- Căn lề phải Margin="0,0,32,0" cách ly thanh cuộn ScrollBar chống chạm nhầm khi bấm mũi tên tăng giảm -->
                                            <UniformGrid Columns="{Binding EnhanceDualColumns}" HorizontalAlignment="Stretch" Margin="0,0,48,0">

                                                <UniformGrid.Resources>

                                                    <x:Double x:Key="SliderHorizontalThumbWidth">8</x:Double>

                                                    <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>

                                                    <x:Double x:Key="SliderHorizontalTrackHeight">3</x:Double>

                                                </UniformGrid.Resources>

                                                <UniformGrid.Styles>

                                                    <!-- Slider phong cách XnConvert: Thanh mỏng, con trỏ hình chữ nhật nhỏ xám sang trọng -->

                                                    <Style Selector="Slider">

                                                        <Setter Property="Height" Value="18" />

                                                        <Setter Property="MinHeight" Value="18" />

                                                        <Setter Property="VerticalAlignment" Value="Center" />

                                                        <Setter Property="Margin" Value="4,0,6,0" />

                                                    </Style>

                                                    <Style Selector="Slider:horizontal Thumb">

                                                        <Setter Property="Width" Value="8" />

                                                        <Setter Property="Height" Value="14" />

                                                        <Setter Property="MinWidth" Value="8" />

                                                        <Setter Property="MinHeight" Value="14" />

                                                        <Setter Property="CornerRadius" Value="2" />

                                                        <Setter Property="Background" Value="#64748B" />

                                                        <Setter Property="BorderBrush" Value="#475569" />

                                                        <Setter Property="BorderThickness" Value="1" />

                                                    </Style>

                                                    <Style Selector="Slider:horizontal:pointerover Thumb">

                                                        <Setter Property="Background" Value="#94A3B8" />

                                                        <Setter Property="BorderBrush" Value="#CBD5E1" />

                                                    </Style>

                                                    <Style Selector="Slider:horizontal:pressed Thumb">

                                                        <Setter Property="Background" Value="#38BDF8" />

                                                    </Style>

                                                    <Style Selector="Slider:horizontal Track#PART_Track">

                                                        <Setter Property="MinHeight" Value="3" />

                                                    </Style>



                                                    <!-- NumericUpDown phong cách XnConvert: Số hiển thị rõ nét căn phải, 2 nút mũi tên dọc mép phải, không bị che khuất -->

                                                    <Style Selector="NumericUpDown">

                                                        <Setter Property="Height" Value="24" />

                                                        <Setter Property="MinHeight" Value="24" />

                                                        <Setter Property="Width" Value="60" />

                                                        <Setter Property="Padding" Value="0" />

                                                        <Setter Property="FontSize" Value="11" />

                                                        <Setter Property="CornerRadius" Value="3" />

                                                        <Setter Property="BorderThickness" Value="1" />

                                                        <Setter Property="BorderBrush" Value="#334155" />

                                                        <Setter Property="Background" Value="#0B0F19" />

                                                        <Setter Property="Foreground" Value="#F8FAFC" />

                                                        <Setter Property="VerticalContentAlignment" Value="Center" />

                                                        <Setter Property="HorizontalContentAlignment" Value="Right" />

                                                    </Style>

                                                    <Style Selector="NumericUpDown:pointerover">

                                                        <Setter Property="BorderBrush" Value="#38BDF8" />

                                                    </Style>

                                                    <Style Selector="NumericUpDown:focus-within">

                                                        <Setter Property="BorderBrush" Value="#38BDF8" />

                                                        <Setter Property="Background" Value="#0B0F19" />

                                                    </Style>

                                                    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">

                                                        <Setter Property="Height" Value="20" />

                                                        <Setter Property="MinHeight" Value="18" />

                                                        <Setter Property="Padding" Value="3,0,1,0" />

                                                        <Setter Property="FontSize" Value="11" />

                                                        <Setter Property="Background" Value="Transparent" />

                                                        <Setter Property="BorderThickness" Value="0" />

                                                        <Setter Property="Foreground" Value="#F8FAFC" />

                                                        <Setter Property="VerticalContentAlignment" Value="Center" />

                                                        <Setter Property="HorizontalContentAlignment" Value="Right" />

                                                    </Style>

                                                    <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner">

                                                        <Setter Property="Background" Value="Transparent" />

                                                        <Setter Property="BorderThickness" Value="0" />

                                                        <Setter Property="Padding" Value="0" />

                                                        <Setter Property="Margin" Value="0" />

                                                    </Style>

                                                    <Style Selector="ButtonSpinner">

                                                        <Setter Property="Background" Value="Transparent" />

                                                        <Setter Property="BorderThickness" Value="0" />

                                                        <Setter Property="Padding" Value="0" />

                                                        <Setter Property="Template">

                                                            <ControlTemplate TargetType="ButtonSpinner">

                                                                <Border Background="{TemplateBinding Background}"

                                                                        BorderBrush="{TemplateBinding BorderBrush}"

                                                                        BorderThickness="{TemplateBinding BorderThickness}"

                                                                        CornerRadius="{TemplateBinding CornerRadius}">

                                                                    <Grid ColumnDefinitions="*, 22">

                                                                        <ContentPresenter Name="PART_ContentPresenter"

                                                                                          Grid.Column="0"

                                                                                          Content="{TemplateBinding Content}"

                                                                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"

                                                                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"

                                                                                          Padding="{TemplateBinding Padding}" />

                                                                        <Grid Grid.Column="1" RowDefinitions="*,*" Width="22" Margin="0" VerticalAlignment="Stretch">

                                                                            <RepeatButton Name="PART_IncreaseButton"

                                                                                          Grid.Row="0" Width="22" Padding="0" Margin="0,0,0,0.5"

                                                                                          BorderThickness="0" Background="#1E293B" Foreground="#94A3B8"

                                                                                          CornerRadius="0,2,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"

                                                                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center">

                                                                                <Path Data="M 0 3.5 L 3 0.5 L 6 3.5 Z" Fill="#94A3B8" Width="9" Height="5.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                                            </RepeatButton>

                                                                            <RepeatButton Name="PART_DecreaseButton"

                                                                                          Grid.Row="1" Width="22" Padding="0" Margin="0,0.5,0,0"

                                                                                          BorderThickness="0" Background="#1E293B" Foreground="#94A3B8"

                                                                                          CornerRadius="0,0,2,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"

                                                                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center">

                                                                                <Path Data="M 0 0.5 L 3 3.5 L 6 0.5 Z" Fill="#94A3B8" Width="9" Height="5.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                                            </RepeatButton>

                                                                        </Grid>

                                                                    </Grid>

                                                                </Border>

                                                            </ControlTemplate>

                                                        </Setter>

                                                    </Style>

                                                    <Style Selector="ButtonSpinner /template/ RepeatButton:pointerover">

                                                        <Setter Property="Background" Value="#334155" />

                                                    </Style>

                                                    <Style Selector="ButtonSpinner /template/ RepeatButton:pointerover Path">

                                                        <Setter Property="Fill" Value="#38BDF8" />

                                                    </Style>

                                                    <Style Selector="ButtonSpinner /template/ RepeatButton:pressed">

                                                        <Setter Property="Background" Value="#0284C7" />

                                                    </Style>

                                                    <Style Selector="ButtonSpinner /template/ RepeatButton:pressed Path">

                                                        <Setter Property="Fill" Value="#FFFFFF" />

                                                    </Style>

                                                </UniformGrid.Styles>



                                                <!-- 1. Tương phản (Contrast) -->

                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="2,1">

                                                    <Grid ColumnDefinitions="74, *, 22, 60" VerticalAlignment="Center">

                                                        <TextBlock Grid.Column="0" Text="Tương phản:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />

                                                        <Slider Grid.Column="1" Value="{Binding EnhanceContrast}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" />

                                                        <Button Grid.Column="2" Command="{Binding ResetContrastCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Tương phản về mặc định (0)" Margin="2,0,2,0">

                                                            <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />

                                                        </Button>

                                                        <NumericUpDown Grid.Column="3" Value="{Binding EnhanceContrast}" Minimum="-100" Maximum="100" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ToolTip.Tip="Tương phản (-100 đến 100)" />

                                                    </Grid>

                                                </Border>



                                                <!-- 2. Độ sáng (Brightness) -->

                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="2,1">

                                                    <Grid ColumnDefinitions="74, *, 22, 60" VerticalAlignment="Center">

                                                        <TextBlock Grid.Column="0" Text="Độ sáng:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />

                                                        <Slider Grid.Column="1" Value="{Binding EnhanceBrightness}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" />

                                                        <Button Grid.Column="2" Command="{Binding ResetBrightnessCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Độ sáng về mặc định (0)" Margin="2,0,2,0">

                                                            <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />

                                                        </Button>

                                                        <NumericUpDown Grid.Column="3" Value="{Binding EnhanceBrightness}" Minimum="-100" Maximum="100" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ToolTip.Tip="Độ sáng (-100 đến 100)" />

                                                    </Grid>

                                                </Border>



                                                <!-- 3. Bão hòa (Saturation) -->

                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="2,1">

                                                    <Grid ColumnDefinitions="74, *, 22, 60" VerticalAlignment="Center">

                                                        <TextBlock Grid.Column="0" Text="Bão hòa:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />

                                                        <Slider Grid.Column="1" Value="{Binding EnhanceSaturation}" Minimum="0" Maximum="200" SmallChange="1" LargeChange="10" />

                                                        <Button Grid.Column="2" Command="{Binding ResetSaturationCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Bão hòa về mặc định (100%)" Margin="2,0,2,0">

                                                            <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />

                                                        </Button>

                                                        <NumericUpDown Grid.Column="3" Value="{Binding EnhanceSaturation}" Minimum="0" Maximum="200" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ToolTip.Tip="Bão hòa màu (0 đến 200%)" />

                                                    </Grid>

                                                </Border>



                                                <!-- 4. Độ nét (Sharpness) -->

                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="2,1">

                                                    <Grid ColumnDefinitions="74, *, 22, 60" VerticalAlignment="Center">

                                                        <TextBlock Grid.Column="0" Text="Độ nét:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />

                                                        <Slider Grid.Column="1" Value="{Binding EnhanceSharpness}" Minimum="0" Maximum="10" SmallChange="0.5" LargeChange="1" />

                                                        <Button Grid.Column="2" Command="{Binding ResetSharpnessCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Độ nét về mặc định (0.0)" Margin="2,0,2,0">

                                                            <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />

                                                        </Button>

                                                        <NumericUpDown Grid.Column="3" Value="{Binding EnhanceSharpness}" Minimum="0" Maximum="10" Increment="0.5" FormatString="0.0" ToolTip.Tip="Độ nét (0.0 đến 10.0)" />

                                                    </Grid>

                                                </Border>



                                                <!-- 5. Khử nhiễu (Noise Reduce) -->

                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="2,1">

                                                    <Grid ColumnDefinitions="74, *, 22, 60" VerticalAlignment="Center">

                                                        <TextBlock Grid.Column="0" Text="Khử nhiễu:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />

                                                        <Slider Grid.Column="1" Value="{Binding EnhanceNoiseReduce}" Minimum="0" Maximum="5" SmallChange="1" LargeChange="1" />

                                                        <Button Grid.Column="2" Command="{Binding ResetNoiseReduceCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Khử nhiễu về mặc định (0)" Margin="2,0,2,0">

                                                            <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />

                                                        </Button>

                                                        <NumericUpDown Grid.Column="3" Value="{Binding EnhanceNoiseReduce}" Minimum="0" Maximum="5" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ToolTip.Tip="Khử nhiễu (0 đến 5)" />

                                                    </Grid>

                                                </Border>



                                                <!-- 6. Chất lượng ảnh (Quality) -->

                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="2,1">

                                                    <Grid ColumnDefinitions="74, *, 22, 60" VerticalAlignment="Center">

                                                        <TextBlock Grid.Column="0" Text="Chất lượng:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />

                                                        <Slider Grid.Column="1" Value="{Binding EnhanceQuality}" Minimum="10" Maximum="100" SmallChange="5" LargeChange="10" />

                                                        <Button Grid.Column="2" Command="{Binding ResetQualityCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Chất lượng ảnh về mặc định (90%)" Margin="2,0,2,0">

                                                            <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />

                                                        </Button>

                                                        <NumericUpDown Grid.Column="3" Value="{Binding EnhanceQuality}" Minimum="10" Maximum="100" Increment="5" FormatString="0" ParsingNumberStyle="Integer" ToolTip.Tip="Chất lượng ảnh JPG/WEBP %" />

                                                    </Grid>

                                                </Border>



                                                <!-- 7. Số CPU (Threads) -->

                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="2,1">

                                                    <Grid ColumnDefinitions="74, *, 22, 60" VerticalAlignment="Center">

                                                        <TextBlock Grid.Column="0" Text="Số CPU:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />

                                                        <Slider Grid.Column="1" Value="{Binding EnhanceThreads}" Minimum="1" Maximum="{Binding MaxSystemThreads}" SmallChange="1" LargeChange="2" />

                                                        <Button Grid.Column="2" Command="{Binding ResetThreadsCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Số CPU về mặc định" Margin="2,0,2,0">

                                                            <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />

                                                        </Button>

                                                        <NumericUpDown Grid.Column="3" Value="{Binding EnhanceThreads}" Minimum="1" Maximum="{Binding MaxSystemThreads}" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ToolTip.Tip="Số CPU xử lý ảnh song song (Tự động nhận diện theo CPU máy)" />

                                                    </Grid>

                                                </Border>



                                                <!-- 8. Reset toàn bộ (Reset all) -->

                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="2,1">

                                                    <Button Command="{Binding ResetEnhanceSettingsCommand}" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Height="22" HorizontalAlignment="Stretch" VerticalAlignment="Center" ToolTip.Tip="Khôi phục toàn bộ thông số về giá trị mặc định">

                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">

                                                            <TextBlock Text="🔄" FontSize="11" VerticalAlignment="Center" />

                                                            <TextBlock Text="Khôi phục tất cả mặc định" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />

                                                        </StackPanel>

                                                    </Button>

                                                </Border>

                                            </UniformGrid>



                                            <!-- Hàng 4: Các nút hành động chính -->

                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                <Button Command="{Binding StartEnhanceCommand}" IsEnabled="{Binding !IsEnhancing}"

                                                        Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="14,6" Height="34" CornerRadius="4" Margin="0,0,8,6">

                                                    <TextBlock Text="▶ BẮT ĐẦU XỬ LÝ ẢNH" />

                                                </Button>



                                                <Button Command="{Binding StopEnhanceCommand}" IsEnabled="{Binding IsEnhancing}"

                                                        Background="#DC2626" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="12,6" Height="34" CornerRadius="4" Margin="0,0,8,6">

                                                    <TextBlock Text="⏹ DỪNG" />

                                                </Button>



                                                <Button Command="{Binding PickSampleImageCommand}"

                                                        Background="#4F46E5" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="12,6" Height="34" CornerRadius="4" Margin="0,0,8,6" ToolTip.Tip="Chọn một ảnh cụ thể để xem trước Before / After">

                                                    <TextBlock Text="👁️ Chọn ảnh mẫu xem trước" />

                                                </Button>



                                                <Button Command="{Binding ToggleFullscreenPreviewCommand}"

                                                        Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="12,6" Height="34" CornerRadius="4" Margin="0,0,8,6" ToolTip.Tip="Mở chế độ đối chiếu toàn màn hình trực tiếp trong ứng dụng">

                                                    <TextBlock Text="⛶ TOÀN MÀN HÌNH ĐỐI CHIẾU" />

                                                </Button>



                                                <!-- Nút Mở Cửa Sổ Riêng Tím Nổi Bật -->

                                                <Button Command="{Binding OpenComparisonWindowCommand}" IsVisible="{Binding IsDesktopLifetime}"

                                                        Background="#7C3AED" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="12,6" Height="34" CornerRadius="4" Margin="0,0,8,6" ToolTip.Tip="Mở cửa sổ đối chiếu độc lập phong cách FastStone trên Desktop (hỗ trợ kéo sang màn hình thứ 2)">

                                                    <TextBlock Text="🗖 MỞ TRONG CỬA SỔ MỚI" />

                                                </Button>



                                                <Button Command="{Binding ClearEnhanceLogsCommand}"

                                                        Background="#1E293B" Foreground="#94A3B8" FontSize="11" Padding="10,6" Height="34" CornerRadius="4" Margin="0,0,0,6">

                                                    <TextBlock Text="🧹 Xóa log" />

                                                </Button>

                                            </WrapPanel>



                                            <!-- Thanh tiến trình & Trạng thái -->

                                            <StackPanel Spacing="4">

                                                <ProgressBar Value="{Binding EnhanceProgress}" Maximum="100" Height="6" CornerRadius="3" Foreground="#38BDF8" Background="#0F172A" />

                                                <WrapPanel Orientation="Horizontal">

                                                    <TextBlock Text="{Binding EnhanceCurrentFileText}" Foreground="#64748B" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="400" Margin="0,0,12,0" />

                                                    <TextBlock Text="{Binding EnhanceProgressText}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" Margin="0,0,10,0" />

                                                    <TextBlock Text="{Binding EnhanceCountText, StringFormat='{}Đã xong: {0}'}" Foreground="#10B981" FontWeight="SemiBold" FontSize="10" Margin="0,0,10,0" />

                                                    <TextBlock Text="{Binding EnhanceErrorCountText, StringFormat='{}Lỗi: {0}'}" Foreground="#F43F5E" FontWeight="SemiBold" FontSize="10" />

                                                </WrapPanel>

                                            </StackPanel>

                                        </StackPanel>

                                    </Border>



                                    <!-- Khung nội dung dưới: Live Preview Before / After có Zoom & Pan & Log Co Giãn Tối Đa -->

                                    <Grid Grid.Row="1" RowDefinitions="*, Auto">

                                        <!-- Khung so sánh trực quan Trước & Sau (Live Preview chiếm toàn bộ không gian còn lại) -->

                                        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="8,6">

                                            <Grid RowDefinitions="Auto, Auto, *">

                                                <!-- Toolbar Preview: Sử dụng WrapPanel chống overlap/tràn mép trên Android -->

                                                <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">

                                                    <!-- Cụm 1: Tiêu đề & Duyệt ảnh Previous / Next to rõ cho Android & Desktop -->

                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,12,6">

                                                        <TextBlock Text="⚡ Preview:" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />

                                                        <Button Command="{Binding PreviousImageCommand}" IsEnabled="{Binding CanGoPrevious}"

                                                                Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" Padding="10,5" Height="32" CornerRadius="4" ToolTip.Tip="Ảnh trước (◀)">

                                                            <StackPanel Orientation="Horizontal" Spacing="4">

                                                                <TextBlock Text="◀" FontSize="10" VerticalAlignment="Center" />

                                                                <TextBlock Text="Trước" FontSize="11" VerticalAlignment="Center" />

                                                            </StackPanel>

                                                        </Button>

                                                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="8,4" Height="32" VerticalAlignment="Center">

                                                            <TextBlock Text="{Binding EnhanceImageCounterText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" TextAlignment="Center" />

                                                        </Border>

                                                        <Button Command="{Binding NextImageCommand}" IsEnabled="{Binding CanGoNext}"

                                                                Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" Padding="10,5" Height="32" CornerRadius="4" ToolTip.Tip="Ảnh tiếp theo (▶)">

                                                            <StackPanel Orientation="Horizontal" Spacing="4">

                                                                <TextBlock Text="Sau" FontSize="11" VerticalAlignment="Center" />

                                                                <TextBlock Text="▶" FontSize="10" VerticalAlignment="Center" />

                                                            </StackPanel>

                                                        </Button>

                                                        <TextBlock Text="{Binding EnhanceImageFileNameText}" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" MaxWidth="140" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding EnhanceImageFileNameText}" Margin="4,0,0,0" />

                                                    </StackPanel>



                                                    <!-- Cụm 2: Nút Đảo vị trí Trước / Sau (Swap Before ⇄ After) -->

                                                    <Button Command="{Binding SwapDualOrderCommand}" Content="{Binding SwapDualOrderButtonText}"

                                                            Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" Padding="8,4" CornerRadius="4"

                                                            Margin="0,0,8,6" VerticalAlignment="Center" ToolTip.Tip="Hoán đổi vị trí hiển thị giữa ảnh Gốc (Before) và ảnh Tối ưu (After)" />



                                                    <!-- Cụm 3: Presets nhanh & Custom Presets dạng WrapPanel chống tràn mép -->

                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,6">

                                                        <TextBlock Text="⚡ Presets:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />

                                                        <Button Command="{Binding ApplyPresetDefaultCommand}" Content="🔘 Gốc" Background="#1E293B" Foreground="#E2E8F0" FontSize="9" Padding="6,2" CornerRadius="3" ToolTip.Tip="Thông số gốc" Margin="0,0,3,2" />

                                                        <Button Command="{Binding ApplyPresetOldScanCommand}" Content="📜 Khử ố" Background="#854D0E" Foreground="#FEF08A" FontWeight="Bold" FontSize="9" Padding="6,2" CornerRadius="3" ToolTip.Tip="Làm trắng nền giấy scan cũ" Margin="0,0,3,2" />

                                                        <Button Command="{Binding ApplyPresetWebtoonCommand}" Content="🎨 Webtoon" Background="#831843" Foreground="#FBCFE8" FontWeight="Bold" FontSize="9" Padding="6,2" CornerRadius="3" ToolTip.Tip="Rực rỡ màu sắc webtoon" Margin="0,0,3,2" />

                                                        <Button Command="{Binding ApplyPresetNightCommand}" Content="🌙 Đọc đêm" Background="#1E1B4B" Foreground="#C7D2FE" FontWeight="Bold" FontSize="9" Padding="6,2" CornerRadius="3" ToolTip.Tip="Hạ sáng dịu mắt" Margin="0,0,4,2" />



                                                        <!-- 3 Custom Presets lưu trữ cá nhân -->

                                                        <TextBlock Text="💾" Foreground="#38BDF8" FontSize="10" VerticalAlignment="Center" Margin="2,0,3,2" ToolTip.Tip="Custom Presets" />

                                                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,3,2">

                                                            <TextBox Text="{Binding UserPreset1Name}" Width="85" Height="24" FontSize="10" Padding="5,2" VerticalAlignment="Center" Background="#1E293B" Foreground="#E2E8F0" CornerRadius="3" ToolTip.Tip="Tên Preset 1" />

                                                            <Button Command="{Binding SaveUserPreset1Command}" Content="💾" Background="#0284C7" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="22" CornerRadius="3" ToolTip.Tip="Lưu vào Preset 1" />

                                                            <Button Command="{Binding LoadUserPreset1Command}" Content="📂" Background="#0D9488" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="22" CornerRadius="3" ToolTip.Tip="Tải Preset 1" />

                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,3,2">

                                                            <TextBox Text="{Binding UserPreset2Name}" Width="85" Height="24" FontSize="10" Padding="5,2" VerticalAlignment="Center" Background="#1E293B" Foreground="#E2E8F0" CornerRadius="3" ToolTip.Tip="Tên Preset 2" />

                                                            <Button Command="{Binding SaveUserPreset2Command}" Content="💾" Background="#0284C7" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="22" CornerRadius="3" ToolTip.Tip="Lưu vào Preset 2" />

                                                            <Button Command="{Binding LoadUserPreset2Command}" Content="📂" Background="#0D9488" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="22" CornerRadius="3" ToolTip.Tip="Tải Preset 2" />

                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,3,2">

                                                            <TextBox Text="{Binding UserPreset3Name}" Width="85" Height="24" FontSize="10" Padding="5,2" VerticalAlignment="Center" Background="#1E293B" Foreground="#E2E8F0" CornerRadius="3" ToolTip.Tip="Tên Preset 3" />

                                                            <Button Command="{Binding SaveUserPreset3Command}" Content="💾" Background="#0284C7" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="22" CornerRadius="3" ToolTip.Tip="Lưu vào Preset 3" />

                                                            <Button Command="{Binding LoadUserPreset3Command}" Content="📂" Background="#0D9488" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="22" CornerRadius="3" ToolTip.Tip="Tải Preset 3" />

                                                        </StackPanel>

                                                        <Button Command="{Binding ResetEnhanceSettingsCommand}" Content="🔄" Background="#1E293B" Foreground="#94A3B8" FontSize="9" Padding="5,2" Height="22" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,0,2" ToolTip.Tip="Đặt lại toàn bộ thông số về mặc định" />

                                                    </WrapPanel>

                                                    

                                                    <!-- Cụm 4: Bộ điều khiển Zoom & Cố định Khung & Nút Toàn Màn Hình / Cửa Sổ Mới -->

                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">

                                                        <Button Command="{Binding ResetZoomPreviewCommand}" Content="1:1" Background="#1E293B" Foreground="#10B981" Padding="5,2" FontSize="10" CornerRadius="3" ToolTip.Tip="Tỷ lệ 100%" Margin="0,0,3,0" />

                                                        <Button Command="{Binding ZoomFitPreviewCommand}" Content="⛶ Fit" Background="#1E293B" Foreground="#F59E0B" Padding="5,2" FontSize="10" CornerRadius="3" ToolTip.Tip="Tự co vừa khung cố định" Margin="0,0,3,0" />

                                                        <Button Command="{Binding ZoomOutPreviewCommand}" Content="➖" Background="#1E293B" Foreground="#94A3B8" Padding="5,2" FontSize="11" CornerRadius="3" ToolTip.Tip="Thu nhỏ" Margin="0,0,3,0" />

                                                        <Border Background="#1E293B" CornerRadius="3" Padding="6,2" VerticalAlignment="Center" Margin="0,0,3,0">

                                                            <TextBlock Text="{Binding EnhancePreviewZoomText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" Width="36" TextAlignment="Center" />

                                                        </Border>

                                                        <Button Command="{Binding ZoomInPreviewCommand}" Content="➕" Background="#1E293B" Foreground="#38BDF8" Padding="5,2" FontSize="11" CornerRadius="3" ToolTip.Tip="Phóng to" Margin="0,0,6,0" />



                                                        <!-- Cụm chọn nhanh Chiều cao Khung ảnh cố định -->

                                                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,6,0">

                                                            <TextBlock Text="📏 Khung:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0" />

                                                            <Button Command="{Binding SetLiveFrameHeight400Command}" Content="400" Background="#1E293B" Foreground="#94A3B8" FontSize="9" Padding="4,2" CornerRadius="3" ToolTip.Tip="Cố định khung 400px" />

                                                            <Button Command="{Binding SetLiveFrameHeight480Command}" Content="480" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" FontSize="9" Padding="4,2" CornerRadius="3" ToolTip.Tip="Cố định khung 480px" />

                                                            <Button Command="{Binding SetLiveFrameHeight560Command}" Content="560" Background="#1E293B" Foreground="#94A3B8" FontSize="9" Padding="4,2" CornerRadius="3" ToolTip.Tip="Cố định khung 560px" />

                                                            <Button Command="{Binding SetLiveFrameHeight650Command}" Content="650" Background="#1E293B" Foreground="#94A3B8" FontSize="9" Padding="4,2" CornerRadius="3" ToolTip.Tip="Cố định khung 650px" />

                                                        </StackPanel>



                                                        <Button Command="{Binding ToggleFullscreenPreviewCommand}" Content="⛶ Toàn màn hình" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="6,3" FontSize="10" CornerRadius="3" Margin="0,0,4,0" ToolTip.Tip="Mở toàn màn hình đối chiếu Before / After trực tiếp" />

                                                        <Button Command="{Binding OpenComparisonWindowCommand}" IsVisible="{Binding IsDesktopLifetime}" Content="🗖 Cửa sổ riêng" Background="#7C3AED" Foreground="#FFFFFF" FontWeight="Bold" Padding="6,3" FontSize="10" CornerRadius="3" ToolTip.Tip="Mở đối chiếu Before/After trong cửa sổ riêng biệt" />

                                                    </WrapPanel>

                                                </WrapPanel>



                                                <!-- FastStone Info Bar (Dung lượng Before vs After) -->

                                                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,2">

                                                    <Border Background="#1E293B" CornerRadius="3" Padding="6,2" Margin="0,0,6,4">

                                                        <TextBlock Text="{Binding EnhanceBeforeInfoText}" Foreground="#94A3B8" FontSize="10" />

                                                    </Border>

                                                    <Border Background="#0C4A6E" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,6,4">

                                                        <TextBlock Text="{Binding EnhanceAfterInfoText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" />

                                                    </Border>

                                                    <Border Background="#1E293B" CornerRadius="3" Padding="6,2" Margin="0,0,0,4">

                                                        <TextBlock Text="{Binding EnhanceClippingInfoText}" Foreground="#FCD34D" FontWeight="Bold" FontSize="10" />

                                                    </Border>

                                                </WrapPanel>



                                                <!-- Vùng hiển thị Đối chiếu 2 ảnh song song Before / After (Responsive Portrait & Landscape với Khung Cố Định) -->

                                                <Panel Grid.Row="2" Height="{Binding EnhanceLiveFrameHeight}" Margin="0,2,0,0">

                                                    <!-- DUAL VIEW (Song song Khung cố định) -->

                                                    <UniformGrid Columns="{Binding EnhanceDualColumns}" Rows="{Binding EnhanceDualRows}">

                                                        <!-- Ảnh 1 (Theo thứ tự Swap) -->

                                                        <Border Background="#090D16" BorderBrush="{Binding FirstDualBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4" Margin="2">

                                                            <Grid RowDefinitions="Auto, *">

                                                                <Border Grid.Row="0" Background="{Binding FirstDualBadgeBg}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,4">

                                                                    <TextBlock Text="{Binding FirstDualBadgeTitle}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9" />

                                                                </Border>

                                                                <ScrollViewer Grid.Row="1" x:Name="LiveBeforeScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False" IsScrollInertiaEnabled="True" Background="#050811" CornerRadius="4">

                                                                    <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">

                                                                        <LayoutTransformControl.LayoutTransform>

                                                                            <ScaleTransform ScaleX="{Binding EnhancePreviewZoom}" ScaleY="{Binding EnhancePreviewZoom}" />

                                                                        </LayoutTransformControl.LayoutTransform>

                                                                        <Image Source="{Binding FirstDualImage}" Width="{Binding EnhanceImagePixelWidth}" Height="{Binding EnhanceImagePixelHeight}" Stretch="Fill" />

                                                                    </LayoutTransformControl>

                                                                </ScrollViewer>

                                                            </Grid>

                                                        </Border>



                                                        <!-- Ảnh 2 (Theo thứ tự Swap) -->

                                                        <Border Background="#090D16" BorderBrush="{Binding SecondDualBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4" Margin="2">

                                                            <Grid RowDefinitions="Auto, *">

                                                                <Border Grid.Row="0" Background="{Binding SecondDualBadgeBg}" CornerRadius="3" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,4">

                                                                    <TextBlock Text="{Binding SecondDualBadgeTitle}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9" />

                                                                </Border>

                                                                <ScrollViewer Grid.Row="1" x:Name="LiveAfterScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False" IsScrollInertiaEnabled="True" Background="#050811" CornerRadius="4">

                                                                    <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">

                                                                        <LayoutTransformControl.LayoutTransform>

                                                                            <ScaleTransform ScaleX="{Binding EnhancePreviewZoom}" ScaleY="{Binding EnhancePreviewZoom}" />

                                                                        </LayoutTransformControl.LayoutTransform>

                                                                        <Image Source="{Binding SecondDualImage}" Width="{Binding EnhanceImagePixelWidth}" Height="{Binding EnhanceImagePixelHeight}" Stretch="Fill" />

                                                                    </LayoutTransformControl>

                                                                </ScrollViewer>

                                                            </Grid>

                                                        </Border>

                                                    </UniformGrid>



                                                    <!-- Nút chuyển ảnh trước nổi trên ảnh -->

                                                    <Button Command="{Binding PreviousImageCommand}" IsEnabled="{Binding CanGoPrevious}"

                                                            ZIndex="1500" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"

                                                            Width="34" Height="48" CornerRadius="6"

                                                            Background="#B30F172A" BorderBrush="#38BDF8" BorderThickness="1"

                                                            Foreground="#38BDF8" FontWeight="Bold" FontSize="16"

                                                            ToolTip.Tip="Ảnh trước (◀)">

                                                        <TextBlock Text="❮" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                    </Button>



                                                    <!-- Nút chuyển ảnh sau nổi trên ảnh -->

                                                    <Button Command="{Binding NextImageCommand}" IsEnabled="{Binding CanGoNext}"

                                                            ZIndex="1500" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"

                                                            Width="34" Height="48" CornerRadius="6"

                                                            Background="#B30F172A" BorderBrush="#38BDF8" BorderThickness="1"

                                                            Foreground="#38BDF8" FontWeight="Bold" FontSize="16"

                                                            ToolTip.Tip="Ảnh tiếp theo (▶)">

                                                        <TextBlock Text="❯" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                    </Button>

                                                </Panel>

                                            </Grid>

                                        </Border>



                                        <!-- Khung log chi tiết dạng Collapsible (Thu gọn mặc định để nhường 100% không gian cho Preview) -->

                                        <Border Grid.Row="1" Background="#0A0E17" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="8,4">

                                            <Grid RowDefinitions="Auto, Auto">

                                                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">

                                                    <Button Grid.Column="0" Command="{Binding ToggleEnhanceLogCommand}" Content="{Binding EnhanceLogToggleText}" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="3" />

                                                    <Button Grid.Column="2" Command="{Binding ClearEnhanceLogsCommand}" Content="🧹 Xóa log" Background="#1E293B" Foreground="#94A3B8" FontSize="10" Padding="8,3" CornerRadius="3" />

                                                </Grid>

                                                <ScrollViewer Grid.Row="1" IsVisible="{Binding IsEnhanceLogExpanded}" MaxHeight="130" VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False" Margin="0,4,0,0">

                                                    <ItemsControl ItemsSource="{Binding EnhanceLogs}">

                                                        <ItemsControl.ItemTemplate>

                                                            <DataTemplate>

                                                                <TextBlock Text="{Binding}" Foreground="#CBD5E1" FontSize="10" FontFamily="Consolas, Monospace" Margin="2,1" />

                                                            </DataTemplate>

                                                        </ItemsControl.ItemTemplate>

                                                    </ItemsControl>

                                                </ScrollViewer>

                                            </Grid>

                                        </Border>

                                    </Grid>

                                </Grid>

                            </TabItem>



                            <!-- CHILD TAB 3.4: PACKAGE / ARCHIVE & CONVERT TOOLS (ĐÓNG GÓI & CHUYỂN ĐỔI FILE ZIP, CBZ, PDF, RAR) -->

                            <TabItem Header="📦 Đóng Gói &amp; Chuyển Đổi" FontSize="12" FontWeight="SemiBold">

                                <Grid RowDefinitions="Auto, *">

                                    <Border Grid.Row="0" Background="#161F30" Padding="12,10" BorderBrush="#1E293B" BorderThickness="0,0,0,1">

                                        <StackPanel Spacing="10">

                                            <!-- Hàng 1: Thư mục hoặc tệp nguồn (Bố cục 2 tầng xem Full Path trên Android) -->

                                            <StackPanel Spacing="3">

                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <TextBlock Text="📥 Nguồn ảnh / tệp cần đóng gói hoặc chuyển đổi (PDF, ZIP, CBZ, RAR, CBR):" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                    <Button Command="{Binding BrowsePackerInputFolderCommand}" Content="📁 Chọn Thư Mục" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" ToolTip.Tip="Chọn thư mục chứa ảnh hoặc thư mục chứa các file cần chuyển đổi" />

                                                    <Button Command="{Binding BrowsePackerInputFileCommand}" Content="📄 Chọn File" Background="#8B5CF6" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" ToolTip.Tip="Chọn 1 tệp PDF, ZIP, CBZ, RAR, CBR để chuyển đổi trực tiếp" />

                                                    <Button Command="{Binding OpenPackerInputFolderCommand}" Content="📂 Mở" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" ToolTip.Tip="Mở thư mục nguồn trên thiết bị" />

                                                </WrapPanel>

                                                <TextBox Text="{Binding PackerInputFolderPath}" PlaceholderText="Chọn thư mục chứa ảnh hoặc chọn file PDF / ZIP / CBR / RAR cần chuyển đổi..." Height="30" CornerRadius="4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#38BDF8" BorderThickness="1" FontSize="10" VerticalContentAlignment="Center" Padding="8,2" />

                                            </StackPanel>



                                            <!-- Hàng 2: Thư mục lưu (Bố cục 2 tầng xem Full Path trên Android) -->

                                            <StackPanel Spacing="3">

                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <TextBlock Text="📤 Thư mục lưu file (Mặc định: thư mục 'packed' cùng cấp với nguồn):" Foreground="#10B981" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                    <Button Command="{Binding BrowsePackerOutputFolderCommand}" Content="📁 Chọn Thư Mục" Background="#059669" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" />

                                                    <Button Command="{Binding OpenPackerOutputFolderCommand}" Content="📂 Mở" Background="#1E293B" Foreground="#10B981" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" ToolTip.Tip="Mở thư mục lưu file đóng gói trên thiết bị" />

                                                </WrapPanel>

                                                <TextBox Text="{Binding PackerOutputFolderPath}" PlaceholderText="Chọn thư mục lưu file đóng gói / chuyển đổi..." Height="30" CornerRadius="4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#10B981" BorderThickness="1" FontSize="10" VerticalContentAlignment="Center" Padding="8,2" />

                                            </StackPanel>



                                            <!-- Hàng 3: Tùy chọn định dạng đóng gói & chế độ quét -->

                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,8,6" VerticalAlignment="Center">

                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                        <TextBlock Text="Định dạng xuất:" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                        <CheckBox IsChecked="{Binding IsPackerCbz}" Content="CBZ (.cbz)" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip.Tip="Định dạng Comic Book Zip chuẩn quốc tế (chuyển đổi từ PDF hoặc nén từ ảnh)" />

                                                        <CheckBox IsChecked="{Binding IsPackerZip}" Content="ZIP (.zip)" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip.Tip="File nén zip chuẩn (chuyển đổi từ PDF hoặc nén từ ảnh)" />

                                                        <CheckBox IsChecked="{Binding IsPackerPdf}" Content="PDF (.pdf)" Foreground="#EC4899" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" ToolTip.Tip="Chuyển đổi từ ZIP/CBZ/RAR/CBR sang PDF hoặc ghép ảnh thành PDF kèm mục lục chương" />

                                                    </WrapPanel>

                                                </Border>



                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,8,6" VerticalAlignment="Center">

                                                    <CheckBox IsChecked="{Binding IsPackerBatchSubfolders}" Content="📦 Đóng gói từng thư mục con (Chapter) thành 1 file riêng" Foreground="#10B981" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" ToolTip.Tip="Nếu chọn, mỗi thư mục con bên trong sẽ được đóng gói thành một file riêng mang tên thư mục đó. Nếu bỏ chọn, toàn bộ sẽ gom vào 1 file lớn kèm mục lục chương." />

                                                </Border>

                                            </WrapPanel>



                                            <!-- Hàng 4: Nút hành động -->

                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                <Button Command="{Binding StartPackingCommand}" IsEnabled="{Binding !IsPacking}"

                                                        Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="14,6" Height="34" CornerRadius="4" Margin="0,0,8,6">

                                                    <TextBlock Text="▶ BẮT ĐẦU ĐÓNG GÓI / CONVERT" />

                                                </Button>



                                                <Button Command="{Binding StopPackingCommand}" IsEnabled="{Binding IsPacking}"

                                                        Background="#DC2626" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="12,6" Height="34" CornerRadius="4" Margin="0,0,8,6">

                                                    <TextBlock Text="⏹ DỪNG" />

                                                </Button>



                                                <Button Command="{Binding ClearPackerLogsCommand}"

                                                        Background="#1E293B" Foreground="#94A3B8" FontSize="11" Padding="10,6" Height="34" CornerRadius="4" Margin="0,0,0,6">

                                                    <TextBlock Text="🧹 Xóa log" />

                                                </Button>

                                            </WrapPanel>



                                            <!-- Thanh tiến trình & Trạng thái -->

                                            <StackPanel Spacing="4">

                                                <ProgressBar Value="{Binding PackerProgress}" Maximum="100" Height="6" CornerRadius="3" Foreground="#10B981" Background="#0F172A" />

                                                <WrapPanel Orientation="Horizontal">

                                                    <TextBlock Text="{Binding PackerCurrentFileText}" Foreground="#64748B" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="400" Margin="0,0,12,0" />

                                                    <TextBlock Text="{Binding PackerProgressText}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" Margin="0,0,10,0" />

                                                    <TextBlock Text="{Binding PackerCountText, StringFormat='{}Đã xong: {0}'}" Foreground="#10B981" FontWeight="SemiBold" FontSize="10" Margin="0,0,10,0" />

                                                    <TextBlock Text="{Binding PackerErrorCountText, StringFormat='{}Lỗi: {0}'}" Foreground="#F43F5E" FontWeight="SemiBold" FontSize="10" />

                                                </WrapPanel>

                                            </StackPanel>



                                            <!-- Banner thông báo khi đóng gói hoàn tất -->

                                            <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="6" Padding="12,8" Margin="0,4,0,0" IsVisible="{Binding IsPackerCompletedVisible}">

                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,6">

                                                        <TextBlock Text="🎉" FontSize="18" VerticalAlignment="Center" />

                                                        <StackPanel VerticalAlignment="Center">

                                                            <TextBlock Text="ĐÓNG GÓI HOÀN TẤT THÀNH CÔNG!" FontWeight="Bold" FontSize="12" Foreground="#34D399" />

                                                            <TextBlock Text="{Binding PackerCompletedMessage}" FontSize="11" Foreground="#E2E8F0" TextWrapping="Wrap" />

                                                        </StackPanel>

                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,0,6">

                                                        <Button Command="{Binding OpenPackerOutputFolderCommand}" Content="📂 Mở Thư Mục Chứa File" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="10,6" CornerRadius="4" />

                                                        <Button Command="{Binding DismissPackerCompletedCommand}" Content="✕" Background="#1E293B" Foreground="#94A3B8" FontSize="11" Padding="8,6" CornerRadius="4" />

                                                    </StackPanel>

                                                </WrapPanel>

                                            </Border>

                                        </StackPanel>

                                    </Border>



                                    <!-- Log chi tiết -->

                                    <Border Grid.Row="1" Background="#0A0E17" Padding="6" MinHeight="180">

                                        <ScrollViewer VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False">

                                            <ItemsControl ItemsSource="{Binding PackerLogs}">

                                                <ItemsControl.ItemTemplate>

                                                    <DataTemplate>

                                                        <TextBlock Text="{Binding}" Foreground="#CBD5E1" FontSize="10" FontFamily="Consolas, Monospace" Margin="2,1" />

                                                    </DataTemplate>

                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>

                                        </ScrollViewer>

                                    </Border>

                                </Grid>

                            </TabItem>



                            <!-- ========================================================================= -->

                            <!-- CHILD TAB: GỘP FILE LẺ TRUYỆN (ARCHIVE MERGER: PDF, ZIP, CBZ, RAR, CBR, MOBI) -->

                            <!-- ========================================================================= -->

                            <TabItem Header="📚 Gộp File / Nối Chap (Merger)" FontSize="12" FontWeight="SemiBold">

                                <Grid RowDefinitions="Auto, *">

                                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                                        <Border Background="#161F30" Padding="12,10" BorderBrush="#1E293B" BorderThickness="0,0,0,1">

                                            <StackPanel Spacing="10">

                                                                                                <!-- Bộ chuyển chế độ: Gộp Hàng Loạt vs Nối Chap Vào File Cũ -->
                                                <Border Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="6,4">
                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <RadioButton IsChecked="{Binding !IsMergeAppendMode}" Command="{Binding SetMergeModeBatchCommand}" GroupName="MergeModeGroup" Margin="0,0,16,0" VerticalContentAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <TextBlock Text="📦" FontSize="13" VerticalAlignment="Center" />
                                                                <TextBlock Text="Chế độ 1: Gộp hàng loạt file / thư mục lẻ" FontWeight="SemiBold" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </RadioButton>
                                                        <RadioButton IsChecked="{Binding IsMergeAppendMode}" Command="{Binding SetMergeModeAppendCommand}" GroupName="MergeModeGroup" VerticalContentAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <TextBlock Text="➕" FontSize="13" VerticalAlignment="Center" />
                                                                <TextBlock Text="Chế độ 2: Nối Chap vào File có sẵn (Append Mode)" FontWeight="SemiBold" FontSize="11" Foreground="#10B981" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </RadioButton>
                                                    </WrapPanel>
                                                </Border>

                                                <!-- ========================================================================= -->
                                                <!-- CHẾ ĐỘ 1: GỘP HÀNG LOẠT FILE / THƯ MỤC LẺ -->
                                                <!-- ========================================================================= -->
                                                <StackPanel Spacing="10" IsVisible="{Binding !IsMergeAppendMode}">
<!-- Hàng 1: Thư mục nguồn chứa các file chương lẻ (PDF, ZIP, CBZ, RAR, CBR, MOBI) -->

                                                <StackPanel Spacing="3">

                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                        <TextBlock Text="📥 Thư mục chứa các file chương lẻ (PDF, ZIP, CBZ, RAR, CBR, MOBI):" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,4" TextWrapping="Wrap" />

                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">

                                                            <Button Command="{Binding BrowseMergeInputFolderCommand}" Content="📁 Chọn Thư Mục" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" ToolTip.Tip="Chọn thư mục chứa các file chapter lẻ của bộ truyện" />

                                                            <Button Command="{Binding OpenMergeInputFolderCommand}" Content="📂 Mở" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" ToolTip.Tip="Mở thư mục nguồn trên thiết bị" />

                                                        </WrapPanel>

                                                    </WrapPanel>

                                                    <TextBox Text="{Binding MergeInputFolderPath}" PlaceholderText="Chọn thư mục chứa các file chương lẻ (.pdf, .zip, .cbz, .rar, .cbr, .mobi)..." Height="30" CornerRadius="4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#38BDF8" BorderThickness="1" FontSize="10" VerticalContentAlignment="Center" Padding="8,2" />

                                                </StackPanel>



                                                <!-- Hàng 2: Thư mục lưu kết quả gộp -->

                                                <StackPanel Spacing="3">

                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                        <TextBlock Text="📤 Thư mục lưu file gộp (Mặc định: thư mục 'merged' cùng cấp với nguồn):" Foreground="#10B981" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,4" TextWrapping="Wrap" />

                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">

                                                            <Button Command="{Binding BrowseMergeOutputFolderCommand}" Content="📁 Chọn Thư Mục" Background="#059669" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" />

                                                            <Button Command="{Binding OpenMergeOutputFolderCommand}" Content="📂 Mở" Background="#1E293B" Foreground="#10B981" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" ToolTip.Tip="Mở thư mục lưu file sau khi gộp" />

                                                            <Button Command="{Binding ResetAndroidFolderOpenerCommand}" Content="🔄 Đổi App Mở" Background="#1E293B" Foreground="#F59E0B" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" Margin="6,0,0,0" ToolTip.Tip="Đặt lại ứng dụng mở thư mục mặc định trên Android để chọn app khác" />

                                                        </WrapPanel>

                                                    </WrapPanel>

                                                    <TextBox Text="{Binding MergeOutputFolderPath}" PlaceholderText="Chọn thư mục lưu file gộp (để trống sẽ tự tạo thư mục 'merged')..." Height="30" CornerRadius="4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#10B981" BorderThickness="1" FontSize="10" VerticalContentAlignment="Center" Padding="8,2" />

                                                </StackPanel>



                                                <!-- Hàng 3: Cấu hình mốc chapter gom nhóm & Định dạng xuất -->

                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <!-- Mốc gom nhóm Chapter -->

                                                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,8,6" VerticalAlignment="Center">

                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                            <TextBlock Text="Số Chapter mỗi file:" Foreground="#F59E0B" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,2,8,2" />

                                                            <Button Command="{Binding SetMergeChunk100Command}" Content="100 Chap" Background="#1E293B" Foreground="#38BDF8" FontSize="10" FontWeight="SemiBold" Padding="8,3" CornerRadius="4" Margin="0,2,4,2" ToolTip.Tip="Gộp 100 chap/file (1-100, 101-200, 201-300... file cuối biến thiên theo chap cuối)" />

                                                            <Button Command="{Binding SetMergeChunk200Command}" Content="200 Chap" Background="#1E293B" Foreground="#38BDF8" FontSize="10" FontWeight="SemiBold" Padding="8,3" CornerRadius="4" Margin="0,2,4,2" ToolTip.Tip="Gộp 200 chap/file (1-200, 201-400, 401-600... file cuối biến thiên theo chap cuối)" />

                                                            <Button Command="{Binding SetMergeChunk300Command}" Content="300 Chap" Background="#1E293B" Foreground="#38BDF8" FontSize="10" FontWeight="SemiBold" Padding="8,3" CornerRadius="4" Margin="0,2,4,2" ToolTip.Tip="Gộp 300 chap/file (1-300, 301-600, 601-900... file cuối biến thiên theo chap cuối)" />

                                                            <Button Command="{Binding SetMergeChunkAllCommand}" Content="Tất cả (1 File)" Background="#1E293B" Foreground="#10B981" FontSize="10" FontWeight="SemiBold" Padding="8,3" CornerRadius="4" Margin="0,2,6,2" ToolTip.Tip="Gộp toàn bộ các chương của truyện vào duy nhất 1 file lớn" />

                                                            

                                                            <Border Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="5" Padding="6,3" Margin="0,2,0,2" VerticalAlignment="Center">

                                                                <Border.Styles>

                                                                    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">

                                                                        <Setter Property="Foreground" Value="#38BDF8" />

                                                                        <Setter Property="Background" Value="Transparent" />

                                                                        <Setter Property="VerticalContentAlignment" Value="Center" />

                                                                        <Setter Property="HorizontalContentAlignment" Value="Center" />

                                                                        <Setter Property="FontWeight" Value="Bold" />

                                                                        <Setter Property="FontSize" Value="12" />

                                                                        <Setter Property="Padding" Value="4,0" />

                                                                        <Setter Property="MinHeight" Value="0" />

                                                                    </Style>

                                                                    <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner">

                                                                        <Setter Property="Background" Value="Transparent" />

                                                                        <Setter Property="BorderThickness" Value="0" />

                                                                        <Setter Property="Padding" Value="0" />

                                                                        <Setter Property="Margin" Value="0" />

                                                                    </Style>

                                                                    <Style Selector="ButtonSpinner">

                                                                        <Setter Property="Background" Value="Transparent" />

                                                                        <Setter Property="BorderThickness" Value="0" />

                                                                        <Setter Property="Padding" Value="0" />

                                                                        <Setter Property="Template">

                                                                            <ControlTemplate TargetType="ButtonSpinner">

                                                                                <Border Background="{TemplateBinding Background}"

                                                                                        BorderBrush="{TemplateBinding BorderBrush}"

                                                                                        BorderThickness="{TemplateBinding BorderThickness}"

                                                                                        CornerRadius="{TemplateBinding CornerRadius}">

                                                                                    <Grid ColumnDefinitions="*, 20">

                                                                                        <ContentPresenter Name="PART_ContentPresenter"

                                                                                                          Grid.Column="0"

                                                                                                          Content="{TemplateBinding Content}"

                                                                                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"

                                                                                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"

                                                                                                          Padding="{TemplateBinding Padding}" />

                                                                                        <Grid Grid.Column="1" RowDefinitions="*,*" Width="20" Margin="0" VerticalAlignment="Stretch">

                                                                                            <RepeatButton Name="PART_IncreaseButton"

                                                                                                          Grid.Row="0" Width="20" Padding="0" Margin="0,0,0,0.5"

                                                                                                          BorderThickness="0" Background="#1E293B" Foreground="#94A3B8"

                                                                                                          CornerRadius="0,2,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"

                                                                                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center">

                                                                                                <Path Data="M 0 3.5 L 3 0.5 L 6 3.5 Z" Fill="#94A3B8" Width="7" Height="4" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                                                            </RepeatButton>

                                                                                            <RepeatButton Name="PART_DecreaseButton"

                                                                                                          Grid.Row="1" Width="20" Padding="0" Margin="0,0.5,0,0"

                                                                                                          BorderThickness="0" Background="#1E293B" Foreground="#94A3B8"

                                                                                                          CornerRadius="0,0,2,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"

                                                                                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center">

                                                                                                <Path Data="M 0 0.5 L 3 3.5 L 6 0.5 Z" Fill="#94A3B8" Width="7" Height="4" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                                                            </RepeatButton>

                                                                                        </Grid>

                                                                                    </Grid>

                                                                                </Border>

                                                                            </ControlTemplate>

                                                                        </Setter>

                                                                    </Style>

                                                                </Border.Styles>

                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">

                                                                    <TextBlock Text="Hoặc" Foreground="#FBBF24" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,2,0" />

                                                                    <CheckBox IsChecked="{Binding IsMergeCustomChunk}" Content="Tùy chỉnh:" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,2,0" />

                                                                    <NumericUpDown Value="{Binding MergeCustomChunkInput}" Minimum="1" Maximum="9999" Increment="10" FormatString="0" ParsingNumberStyle="Integer"

                                                                                   Width="86" Height="30" FontSize="12" FontWeight="Bold"

                                                                                   Foreground="#38BDF8" Background="#0F172A" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="4"

                                                                                   HorizontalContentAlignment="Center" VerticalContentAlignment="Center"

                                                                                   VerticalAlignment="Center" Margin="0,0,2,0" ToolTip.Tip="Nhập số chapter tùy ý cho mỗi file gộp (ví dụ: 50, 150...)" />

                                                                    <TextBlock Text="chap/file" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />

                                                                </StackPanel>

                                                            </Border>

                                                        </WrapPanel>

                                                    </Border>



                                                    <!-- Định dạng xuất -->

                                                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,8,6" VerticalAlignment="Center">

                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                            <TextBlock Text="Định dạng xuất:" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,2,8,2" />

                                                            <RadioButton Content="CBZ (.cbz)" IsChecked="{Binding IsMergeFormatCbz}" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,2,10,2" ToolTip.Tip="Định dạng Comic Book Archive chuẩn quốc tế (được hỗ trợ bởi mọi app đọc truyện)" />

                                                            <RadioButton Content="ZIP (.zip)" IsChecked="{Binding IsMergeFormatZip}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,2,10,2" ToolTip.Tip="Định dạng file nén ZIP tiêu chuẩn" />

                                                            <RadioButton Content="PDF (.pdf)" IsChecked="{Binding IsMergeFormatPdf}" Foreground="#EC4899" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,2,10,2" ToolTip.Tip="Tài liệu PDF kèm Mục Lục Bookmarks từng chapter (Đọc trên mọi thiết bị)" />

                                                            <RadioButton Content="MOBI (.mobi)" IsChecked="{Binding IsMergeFormatMobi}" Foreground="#10B981" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,2,0,2" ToolTip.Tip="Định dạng sách điện tử Kindle MOBI đa chương chuẩn quốc tế" />

                                                        </WrapPanel>

                                                    </Border>

                                                </WrapPanel>



                                                <!-- Hàng 4: Ghi chú tiêu chuẩn xử lý thông minh -->

                                                <Border Background="#0B132B" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,5">

                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                        <TextBlock Text="💡 Ghi chú thông minh:" Foreground="#FBBF24" FontSize="10" FontWeight="Bold" Margin="0,2,8,2" VerticalAlignment="Center" />

                                                        <TextBlock Text="• Giữ nguyên từng thư mục chapter bên trong file nén để dễ đọc, không xả ảnh lung tung." Foreground="#94A3B8" FontSize="10" Margin="0,2,12,2" VerticalAlignment="Center" TextWrapping="Wrap" />

                                                        <TextBlock Text="• Gom theo số chapter thực tế (chap số thập phân 100.1, 100.5 đều nằm gọn ở mốc 1-100)." Foreground="#94A3B8" FontSize="10" Margin="0,2,12,2" VerticalAlignment="Center" TextWrapping="Wrap" />

                                                        <TextBlock Text="• File cuối cùng luôn tự động biến thiên theo chap cuối thực tế (ví dụ: 201-330 hoặc 201-351)." Foreground="#94A3B8" FontSize="10" Margin="0,2,0,2" VerticalAlignment="Center" TextWrapping="Wrap" />

                                                    </WrapPanel>

                                                </Border>



                                            <!-- Hàng 5: Nút hành động -->

                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                <Button Command="{Binding StartArchiveMergeCommand}" IsEnabled="{Binding !IsMergingArchives}"

                                                        Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="14,6" Height="34" CornerRadius="4" Margin="0,0,8,6">

                                                    <TextBlock Text="▶ BẮT ĐẦU GỘP FILE LẺ" />

                                                </Button>



                                                <Button Command="{Binding StopArchiveMergeCommand}" IsEnabled="{Binding IsMergingArchives}"

                                                        Background="#DC2626" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="12,6" Height="34" CornerRadius="4" Margin="0,0,8,6">

                                                    <TextBlock Text="⏹ DỪNG" />

                                                </Button>



                                                <Button Command="{Binding ClearMergeLogsCommand}"

                                                        Background="#1E293B" Foreground="#94A3B8" FontSize="11" Padding="10,6" Height="34" CornerRadius="4" Margin="0,0,0,6">

                                                    <TextBlock Text="🧹 Xóa log" />

                                                </Button>

                                            </WrapPanel>



                                            
                                                </StackPanel>

                                                <!-- ========================================================================= -->
                                                <!-- CHẾ ĐỘ 2: NỐI CHƯƠNG VÀO TỆP CÓ SẴN (APPEND MODE) -->
                                                <!-- ========================================================================= -->
                                                <StackPanel Spacing="10" IsVisible="{Binding IsMergeAppendMode}">
                                                    <!-- BƯỚC 1: CHỌN FILE GỐC CẦN NỐI -->
                                                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                        <StackPanel Spacing="4">
                                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="📄 Bước 1: Chọn Tệp Gốc Cần Nối Chap (.pdf, .cbz, .zip, .mobi):" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,4" TextWrapping="Wrap" />
                                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                                                    <Button Command="{Binding BrowseMergeAppendBaseFileCommand}" Content="📁 Chọn Tệp Gốc" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" ToolTip.Tip="Chọn file truyện đã có cần nối thêm các chapter mới" />
                                                                    <Button Command="{Binding OpenMergeAppendBaseFileFolderCommand}" Content="📂 Mở Thư Mục" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" ToolTip.Tip="Mở thư mục chứa file gốc" />
                                                                </WrapPanel>
                                                            </WrapPanel>
                                                            <TextBox Text="{Binding MergeAppendBaseFilePath}" PlaceholderText="Chọn hoặc dán đường dẫn file gốc (.pdf, .cbz, .zip, .mobi)..." Height="30" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" BorderBrush="#38BDF8" BorderThickness="1" FontSize="10" VerticalContentAlignment="Center" Padding="8,2" />
                                                            <TextBlock Text="{Binding MergeAppendBaseFileInfoText}" IsVisible="{Binding MergeAppendBaseFileInfoText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="#38BDF8" FontSize="10.5" FontWeight="SemiBold" Margin="2,2,0,0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- BƯỚC 2: CHỌN THƯ MỤC CHỨA CÁC CHAP MỚI -->
                                                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                        <StackPanel Spacing="4">
                                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="📁 Bước 2: Chọn Thư Mục Chứa Các Chap Mới Cần Nối:" Foreground="#10B981" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,4" TextWrapping="Wrap" />
                                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                                                    <Button Command="{Binding BrowseMergeAppendNewFolderCommand}" Content="📁 Chọn Thư Mục" Background="#059669" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" ToolTip.Tip="Chọn thư mục chứa các chapter mới vừa tải về" />
                                                                    <Button Command="{Binding OpenMergeAppendNewFolderCommand}" Content="📂 Mở" Background="#1E293B" Foreground="#10B981" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" ToolTip.Tip="Mở thư mục chap mới" />
                                                                </WrapPanel>
                                                            </WrapPanel>
                                                            <TextBox Text="{Binding MergeAppendNewFolderPath}" PlaceholderText="Chọn thư mục chứa các chapter mới..." Height="30" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" BorderBrush="#10B981" BorderThickness="1" FontSize="10" VerticalContentAlignment="Center" Padding="8,2" />
                                                            <TextBlock Text="{Binding MergeAppendNewFolderInfoText}" IsVisible="{Binding MergeAppendNewFolderInfoText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="#10B981" FontSize="10.5" FontWeight="SemiBold" Margin="2,2,0,0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- BƯỚC 3: TÙY CHỌN XUẤT XƯỞNG & BẢO TỒN CẤU TRÚC (RESPONSIVE ANDROID & DESKTOP) -->
                                                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                        <StackPanel Spacing="10">
                                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="⚙️ Bước 3: Chế Độ Xuất File &amp; Quản Lý Tiến Độ:" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,4" TextWrapping="Wrap" />
                                                                <Border Background="#3B1E08" CornerRadius="3" Padding="5,1" VerticalAlignment="Center" Margin="0,0,0,4">
                                                                    <TextBlock Text="BẢO TỒN FOLDER &amp; BOOKMARK" FontSize="8.5" FontWeight="Bold" Foreground="#FBBF24" />
                                                                </Border>
                                                            </WrapPanel>

                                                            <!-- Hai lựa chọn cốt lõi: Ghi đè vào file cũ VS Tạo file mới (Responsive Android) -->
                                                            <StackPanel Spacing="8">
                                                                <!-- Option 1: Ghi đè vào file cũ (MẶC ĐỊNH & KHUYÊN DÙNG) -->
                                                                <Border CornerRadius="6" Padding="10,8" Background="#131B2E" BorderThickness="1" BorderBrush="#38BDF8">
                                                                    <RadioButton GroupName="MergeAppendOutputMode"
                                                                                 IsChecked="{Binding IsMergeAppendOverwrite, Mode=TwoWay}"
                                                                                 Command="{Binding SetMergeAppendOverwriteModeCommand}"
                                                                                 HorizontalAlignment="Stretch"
                                                                                 VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Vertical" Spacing="4">
                                                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <TextBlock Text="⚡ Ghi đè vào file cũ" FontWeight="Bold" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,2" />
                                                                                <Border Background="#064E3B" CornerRadius="3" Padding="5,1" Margin="0,0,0,2" VerticalAlignment="Center">
                                                                                    <TextBlock Text="MẶC ĐỊNH &amp; GIỮ FOLDER / BOOKMARK" FontSize="8.5" FontWeight="Bold" Foreground="#34D399" />
                                                                                </Border>
                                                                            </WrapPanel>
                                                                            <TextBlock Text="(Giữ nguyên 100% cấu trúc folder từng chapter, bookmark mục lục &amp; tiến độ trang đọc dở của app đọc truyện)"
                                                                                       FontSize="10" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                                                            <TextBlock Text="• Tự động sao lưu bản dự phòng .bak an toàn 100% trước khi cập nhật"
                                                                                       FontSize="9" Foreground="#64748B" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                    </RadioButton>
                                                                </Border>

                                                                <!-- Option 2: Tạo file mới độc lập -->
                                                                <Border CornerRadius="6" Padding="10,8" Background="#131B2E" BorderThickness="1" BorderBrush="#1E293B">
                                                                    <RadioButton GroupName="MergeAppendOutputMode"
                                                                                 IsChecked="{Binding IsMergeAppendCreateNew, Mode=TwoWay}"
                                                                                 Command="{Binding SetMergeAppendCreateNewModeCommand}"
                                                                                 HorizontalAlignment="Stretch"
                                                                                 VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Vertical" Spacing="4">
                                                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <TextBlock Text="📄 Tạo file mới độc lập" FontWeight="Bold" FontSize="11" Foreground="#F59E0B" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,2" />
                                                                                <Border Background="#374151" CornerRadius="3" Padding="5,1" Margin="0,0,0,2" VerticalAlignment="Center">
                                                                                    <TextBlock Text="TỆP MỚI RIÊNG BIỆT" FontSize="8.5" FontWeight="Bold" Foreground="#D1D5DB" />
                                                                                </Border>
                                                                            </WrapPanel>
                                                                            <TextBlock Text="(Tạo tệp mới riêng biệt, vẫn giữ nguyên 100% cấu trúc folder từng chapter &amp; bookmark mục lục nối tiếp)"
                                                                                       FontSize="10" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                                                            <TextBlock Text="• File gốc ban đầu được bảo toàn nguyên vẹn 100%, không bị sửa đổi"
                                                                                       FontSize="9" Foreground="#94A3B8" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                    </RadioButton>
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- Khung chọn vị trí lưu tệp mới (Chỉ hiển thị khi chọn Tạo file mới) -->
                                                            <Border IsVisible="{Binding IsMergeAppendCreateNew}" Background="#0B0F19" BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Padding="8,6">
                                                                <StackPanel Spacing="4">
                                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="💾 Vị trí lưu tệp mới sau khi nối:" Foreground="#38BDF8" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,4" TextWrapping="Wrap" />
                                                                        <Button Command="{Binding BrowseMergeAppendOutputFileCommand}" Content="📁 Đổi Vị Trí Lưu..." Background="#1E293B" Foreground="#38BDF8" FontSize="10" Padding="8,3" CornerRadius="3" Margin="0,0,0,4" />
                                                                    </WrapPanel>
                                                                    <TextBox Text="{Binding MergeAppendOutputFilePath}" Height="28" CornerRadius="4" Background="#020617" Foreground="#F8FAFC" FontSize="10" VerticalContentAlignment="Center" Padding="8,2" TextWrapping="NoWrap" />
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Tùy chọn bảo tồn Bookmarks PDF -->
                                                            <CheckBox IsChecked="{Binding IsMergeAppendPreserveBookmarks}" Margin="0,2,0,2" ToolTip.Tip="Tự động giữ nguyên cây Bookmarks mục lục cũ và đánh số mục lục nối tiếp cho từng chapter mới (áp dụng cho file PDF)">
                                                                <TextBlock Text="🔖 Tự động tạo và bảo tồn Bookmarks mục lục từng chương (đối với PDF)" FontSize="10.5" Foreground="#A78BFA" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                            </CheckBox>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Nút hành động cho Chế độ Nối Chap -->
                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Command="{Binding StartMergeAppendCommand}" IsEnabled="{Binding !IsMergingArchives}"
                                                                Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="14,6" Height="34" CornerRadius="4" Margin="0,0,8,6">
                                                            <TextBlock Text="⚡ BẮT ĐẦU NỐI CHAP VÀO TỆP" />
                                                        </Button>

                                                        <Button Command="{Binding StopArchiveMergeCommand}" IsEnabled="{Binding IsMergingArchives}"
                                                                Background="#DC2626" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="12,6" Height="34" CornerRadius="4" Margin="0,0,8,6">
                                                            <TextBlock Text="⏹ DỪNG" />
                                                        </Button>

                                                        <Button Command="{Binding ClearMergeLogsCommand}"
                                                                Background="#1E293B" Foreground="#94A3B8" FontSize="11" Padding="10,6" Height="34" CornerRadius="4" Margin="0,0,0,6">
                                                            <TextBlock Text="🧹 Xóa log" />
                                                        </Button>
                                                    </WrapPanel>
                                                </StackPanel>


                                            <!-- Thanh tiến trình & Trạng thái -->

                                            <StackPanel Spacing="4">

                                                <ProgressBar Value="{Binding MergeProgress}" Maximum="100" Height="6" CornerRadius="3" Foreground="#10B981" Background="#0F172A" />

                                                <WrapPanel Orientation="Horizontal">

                                                    <TextBlock Text="{Binding MergeStatusText}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" MaxWidth="500" />

                                                    <TextBlock Text="{Binding MergeProgressText}" Foreground="#10B981" FontWeight="Bold" FontSize="10" />

                                                </WrapPanel>

                                            </StackPanel>



                                            <!-- Banner thông báo khi hoàn tất -->

                                            <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="6" Padding="12,8" Margin="0,4,0,0" IsVisible="{Binding IsMergeCompletedVisible}">

                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,6">

                                                        <TextBlock Text="🎉" FontSize="18" VerticalAlignment="Center" />

                                                        <StackPanel VerticalAlignment="Center">

                                                            <TextBlock Text="GỘP FILE LẺ HOÀN TẤT THÀNH CÔNG!" FontWeight="Bold" FontSize="12" Foreground="#34D399" />

                                                            <TextBlock Text="{Binding MergeCompletedMessage}" FontSize="11" Foreground="#E2E8F0" TextWrapping="Wrap" />

                                                        </StackPanel>

                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,0,6">

                                                        <Button Command="{Binding OpenMergeOutputFolderCommand}" Content="📂 Mở Thư Mục Chứa File" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="10,6" CornerRadius="4" />

                                                        <Button Command="{Binding DismissMergeCompletedCommand}" Content="✕" Background="#1E293B" Foreground="#94A3B8" FontSize="11" Padding="8,6" CornerRadius="4" />

                                                    </StackPanel>

                                                </WrapPanel>

                                            </Border>

                                        </StackPanel>

                                    </Border>

                                </ScrollViewer>



                                    <!-- Log chi tiết -->

                                    <Border Grid.Row="1" Background="#0A0E17" Padding="6" MinHeight="180">

                                        <ScrollViewer VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False">

                                            <ItemsControl ItemsSource="{Binding MergeLogs}">

                                                <ItemsControl.ItemTemplate>

                                                    <DataTemplate>

                                                        <TextBlock Text="{Binding}" Foreground="#CBD5E1" FontSize="10" FontFamily="Consolas, Monospace" Margin="2,1" />

                                                    </DataTemplate>

                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>

                                        </ScrollViewer>

                                    </Border>

                                </Grid>

                            </TabItem>



                            <!-- ========================================================================= -->

                            <!-- CHILD TAB 3.5: QUÉT CHAP THIẾU OFFLINE (OFFLINE MISSING CHAPTERS) -->

                            <!-- ========================================================================= -->

                            <TabItem Header="🔍 Quét Chap Thiếu Offline" FontSize="12" FontWeight="SemiBold">

                                <Grid RowDefinitions="Auto, *">

                                    <!-- Panel cấu hình quét & công cụ hành động -->

                                    <Border Grid.Row="0" Background="#161F30" Padding="12,10" BorderBrush="#1E293B" BorderThickness="0,0,0,1">

                                        <StackPanel Spacing="10">

                                            <!-- Hàng 1: Chọn thư mục cần quét -->

                                            <StackPanel Spacing="4">

                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <TextBlock Text="📁 Thư mục truyện / Thư mục tải về:" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,4" />

                                                    <Button Command="{Binding BrowseOfflineScanFolderCommand}" Content="📁 Chọn Thư Mục" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="10,4" CornerRadius="4" Margin="0,0,6,4" />

                                                    <Button Command="{Binding ScanOfflineFolderCommand}" IsEnabled="{Binding !IsScanningOfflineMissing}" Content="🔄 Quét Lại" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="10,4" CornerRadius="4" Margin="0,0,6,4" />

                                                    <Button Command="{Binding StopScanOfflineFolderCommand}" IsEnabled="{Binding IsScanningOfflineMissing}" Content="⏹ Dừng" Background="#DC2626" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="10,4" CornerRadius="4" Margin="0,0,6,4" />

                                                    <Button Command="{Binding OpenSelectedMangaFolderCommand}" Content="📂 Mở Thư Mục Truyện" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" Padding="10,4" CornerRadius="4" Margin="0,0,0,4" />

                                                </WrapPanel>

                                                <TextBox Text="{Binding OfflineScanRootPath}" PlaceholderText="Đường dẫn thư mục truyện tranh tải về..." Height="30" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" BorderBrush="#38BDF8" BorderThickness="1" FontSize="11" VerticalContentAlignment="Center" Padding="8,2" />

                                            </StackPanel>



                                            <!-- Hàng 2: Bộ lọc & Công cụ thao tác nhanh (WrapPanel Responsive) -->

                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                <!-- Ô tìm kiếm tên truyện -->

                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="4,2" Margin="0,0,8,4" VerticalAlignment="Center">

                                                    <TextBox Text="{Binding OfflineSearchQuery}" PlaceholderText="🔍 Lọc tên truyện..." Width="180" Height="26" CornerRadius="3" Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" FontSize="11" VerticalContentAlignment="Center" />

                                                </Border>



                                                <!-- CheckBox chỉ hiện truyện thiếu chap -->

                                                <CheckBox IsChecked="{Binding OfflineFilterOnlyMissing}" Content="⚠️ Chỉ hiện truyện thiếu chap" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,4" />



                                                <!-- Các nút sao chép & tìm kiếm -->

                                                <Button Command="{Binding CopySelectedMissingCommand}" Content="📋 Sao Chép Chap Thiếu (Truyện Này)" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="10,4" CornerRadius="4" Margin="0,0,6,4" ToolTip.Tip="Sao chép các khoảng chap thiếu của bộ truyện đang chọn" />

                                                <Button Command="{Binding CopyAllMissingCommand}" Content="📋 Sao Chép Tất Cả Chap Thiếu" Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="10,4" CornerRadius="4" Margin="0,0,6,4" ToolTip.Tip="Sao chép danh sách toàn bộ truyện bị thiếu chap vào Clipboard" />

                                                <Button Command="{Binding GoogleSearchMissingCommand}" Content="🌐 Google Tìm Chap Thiếu" Background="#D97706" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="10,4" CornerRadius="4" Margin="0,0,6,4" ToolTip.Tip="Mở trình duyệt Google tìm kiếm chương thiếu của truyện này" />

                                            </WrapPanel>



                                            <!-- Thông điệp trạng thái -->

                                            <TextBlock Text="{Binding OfflineStatusMessage}" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

                                        </StackPanel>

                                    </Border>



                                    <!-- Panel nội dung 2 cột: Danh sách truyện (trái) & Chi tiết chapter (phải) -->

                                    <Grid Grid.Row="1" ColumnDefinitions="320, *">

                                        <!-- CỘT TRÁI: DANH SÁCH BỘ TRUYỆN -->

                                        <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0" Padding="8">

                                            <Grid RowDefinitions="Auto, *">

                                                <TextBlock Grid.Row="0" Text="{Binding OfflineFilteredMangaList.Count, StringFormat='{}DANH SÁCH BỘ TRUYỆN ({0})'}" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" Margin="2,0,0,8" />

                                                <ListBox Grid.Row="1" ItemsSource="{Binding OfflineFilteredMangaList}" SelectedItem="{Binding SelectedOfflineManga}" Background="Transparent">

                                                    <ListBox.ItemTemplate>

                                                        <DataTemplate>

                                                            <Border Background="#161F30" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,2">

                                                                <Grid RowDefinitions="Auto, Auto">

                                                                    <TextBlock Grid.Row="0" Text="{Binding Title}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis" />

                                                                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">

                                                                        <TextBlock Text="{Binding ChapterCount, StringFormat='{}{0} chap'}" Foreground="#94A3B8" FontSize="10" Margin="0,0,8,0" VerticalAlignment="Center" />

                                                                        <Border Background="{Binding StatusBadgeBackground}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">

                                                                            <TextBlock Text="{Binding StatusBadgeText}" Foreground="{Binding StatusBadgeForeground}" FontSize="9.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="190" />

                                                                        </Border>

                                                                    </WrapPanel>

                                                                </Grid>

                                                            </Border>

                                                        </DataTemplate>

                                                    </ListBox.ItemTemplate>

                                                </ListBox>

                                            </Grid>

                                        </Border>



                                        <!-- CỘT PHẢI: CHI TIẾT TRUYỆN & CÁC CHƯƠNG -->

                                        <Border Grid.Column="1" Background="#0A0E17" Padding="12">

                                            <Grid RowDefinitions="Auto, Auto, *">

                                                <!-- Card tóm tắt thống kê chuẩn theo phong cách WPF -->

                                                <Border Grid.Row="0" Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">

                                                    <StackPanel Spacing="6">

                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                            <TextBlock Text="📖 " FontSize="14" VerticalAlignment="Center" />

                                                            <TextBlock Text="{Binding SelectedOfflineManga.Title, FallbackValue='(Chưa chọn bộ truyện nào)'}" Foreground="#FBBF24" FontWeight="ExtraBold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="500" Margin="0,0,12,0" />

                                                            <TextBlock Text="{Binding SelectedOfflineChapters.Count, StringFormat='{}(Đã tải: {0} chap)'}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />

                                                        </WrapPanel>



                                                        <!-- Hàng thống kê số nguyên, thập phân & dải thiếu -->

                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                            <TextBlock Text="Chap nguyên: " Foreground="#94A3B8" FontSize="11" />

                                                            <TextBlock Text="{Binding SelectedOfflineManga.Analysis.IntegerCount, FallbackValue='0'}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="11" Margin="0,0,8,0" />



                                                            <TextBlock Text="| chap thập phân: " Foreground="#94A3B8" FontSize="11" />

                                                            <TextBlock Text="{Binding SelectedOfflineManga.Analysis.DecimalCount, FallbackValue='0'}" Foreground="#22D3EE" FontWeight="Bold" FontSize="11" Margin="0,0,8,0" />



                                                            <TextBlock Text="| chap khác: " Foreground="#94A3B8" FontSize="11" />

                                                            <TextBlock Text="{Binding SelectedOfflineManga.Analysis.UnknownCount, FallbackValue='0'}" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" Margin="0,0,8,0" />



                                                            <TextBlock Text="| " Foreground="#94A3B8" FontSize="11" />

                                                            <TextBlock Text="thiếu: " Foreground="#F87171" FontWeight="ExtraBold" FontSize="12" />

                                                            <TextBlock Text="{Binding SelectedOfflineManga.Analysis.MissingSummaryText, FallbackValue='không có'}" Foreground="#F87171" FontWeight="ExtraBold" FontSize="12.5" TextWrapping="Wrap" />

                                                        </WrapPanel>

                                                    </StackPanel>

                                                </Border>



                                                <!-- Header bảng danh sách chương -->

                                                <Grid Grid.Row="1" ColumnDefinitions="*, 90, 130, 90" Margin="4,0,4,6">

                                                    <TextBlock Grid.Column="0" Text="TÊN CHƯƠNG / FOLDER" Foreground="#64748B" FontWeight="Bold" FontSize="10" />

                                                    <TextBlock Grid.Column="1" Text="SỐ TRANG" Foreground="#64748B" FontWeight="Bold" FontSize="10" TextAlignment="Center" />

                                                    <TextBlock Grid.Column="2" Text="NGÀY CẬP NHẬT" Foreground="#64748B" FontWeight="Bold" FontSize="10" TextAlignment="Center" />

                                                    <TextBlock Grid.Column="3" Text="THAO TÁC" Foreground="#64748B" FontWeight="Bold" FontSize="10" TextAlignment="Right" />

                                                </Grid>



                                                <!-- Danh sách các chapter đã tải (ListBox Virtualizing chống lag với hàng ngàn chap) -->

                                                <ListBox Grid.Row="2" ItemsSource="{Binding SelectedOfflineChapters}" Background="Transparent">

                                                    <ListBox.ItemsPanel>

                                                        <ItemsPanelTemplate>

                                                            <VirtualizingStackPanel />

                                                        </ItemsPanelTemplate>

                                                    </ListBox.ItemsPanel>

                                                    <ListBox.ItemTemplate>

                                                        <DataTemplate>

                                                            <Border Background="#101726" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="6,6">

                                                                <Grid ColumnDefinitions="*, 90, 130, 90">

                                                                    <!-- Tên chapter với màu sắc phân biệt -->

                                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                                                        <TextBlock Text="📁" FontSize="11" VerticalAlignment="Center" />

                                                                        <TextBlock Text="{Binding Name}" Foreground="{Binding DisplayForeground}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                                    </StackPanel>



                                                                    <!-- Số trang ảnh -->

                                                                    <TextBlock Grid.Column="1" Text="{Binding PageCount, StringFormat='{}{0} pages'}" Foreground="#94A3B8" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center" />



                                                                    <!-- Ngày cập nhật -->

                                                                    <TextBlock Grid.Column="2" Text="{Binding LastModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="#64748B" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />



                                                                    <!-- Nút mở thư mục -->

                                                                    <Button Grid.Column="3" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenSelectedChapterFolderCommand}" CommandParameter="{Binding}" Content="📂 Mở" Background="#1E293B" Foreground="#38BDF8" FontSize="10" Padding="8,2" CornerRadius="3" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                                                </Grid>

                                                            </Border>

                                                        </DataTemplate>

                                                    </ListBox.ItemTemplate>

                                                </ListBox>

                                            </Grid>

                                        </Border>

                                    </Grid>

                                </Grid>

                            </TabItem>



                            <!-- ========================================================================= -->

                            <!-- CHILD TAB 3.6: ĐỔI TÊN HÀNG LOẠT (BATCH RENAME FILE / FOLDER) -->

                            <!-- ========================================================================= -->

                            <TabItem Header="🏷️ Đổi Tên (Rename)" FontSize="12" FontWeight="SemiBold">

                                <Grid RowDefinitions="Auto, *">

                                    <!-- Toolbar trên cùng (WrapPanel Responsive) -->

                                    <Border Grid.Row="0" Background="#161F30" Padding="12,10" BorderBrush="#1E293B" BorderThickness="0,0,0,1">

                                        <StackPanel Spacing="8">

                                            <!-- Hàng 0: Nhập/Dán đường dẫn thư mục quét nhanh đa tầng -->

                                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,2">

                                                <TextBox Text="{Binding ManualRenameFolderPath}" PlaceholderText="Dán hoặc nhập đường dẫn thư mục cần đổi tên (hỗ trợ quét đa tầng)..." Height="30" CornerRadius="4,0,0,4" Background="#0B0F19" Foreground="#F8FAFC" BorderBrush="#38BDF8" BorderThickness="1" FontSize="11" VerticalContentAlignment="Center" Padding="8,2" />

                                                <Button Grid.Column="1" Command="{Binding BrowseManualRenameFolderCommand}" Content="📁 Duyệt" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="12,4" Height="30" CornerRadius="0" ToolTip.Tip="Chọn thư mục từ máy" />

                                                <Button Grid.Column="2" Command="{Binding ScanManualRenameFolderCommand}" Content="🔍 Quét Folder" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="14,4" Height="30" CornerRadius="0,4,4,0" ToolTip.Tip="Quét thư mục và nạp vào danh sách đổi tên" />

                                            </Grid>



                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                <!-- Thêm File & Thư mục -->

                                                <Button Command="{Binding AddRenameFilesCommand}" Content="📄 + Thêm File" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="10,5" CornerRadius="4" Margin="0,0,6,4" ToolTip.Tip="Chọn một hoặc nhiều file để đổi tên" />

                                                <Button Command="{Binding AddRenameFolderCommand}" Content="📁 + Thêm Thư Mục" Background="#0D9488" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="10,5" CornerRadius="4" Margin="0,0,6,4" ToolTip.Tip="Chọn thư mục để đổi tên chính thư mục hoặc nạp file bên trong" />



                                                <!-- Chế độ mục tiêu đổi tên -->

                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,4" VerticalAlignment="Center">

                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                                        <TextBlock Text="Mục tiêu:" Foreground="#94A3B8" FontSize="10.5" VerticalAlignment="Center" />

                                                        <ComboBox SelectedItem="{Binding RenameTargetMode}" Width="105" Height="26" FontSize="10.5" VerticalAlignment="Center">

                                                            <x:String>Files</x:String>

                                                            <x:String>Folders</x:String>

                                                            <x:String>All</x:String>

                                                        </ComboBox>

                                                    </StackPanel>

                                                </Border>



                                                <!-- Toggle Quét Đa Tầng -->

                                                <CheckBox IsChecked="{Binding IsRecursiveScan}" Content="⚡ Đa tầng (Quét mọi thư mục con)" Foreground="#10B981" FontWeight="Bold" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,10,4" ToolTip.Tip="Quét đệ quy tất cả các thư mục con và file con bên trong" />



                                                <!-- Xóa danh sách -->

                                                <Button Command="{Binding RemoveSelectedRenameItemCommand}" Content="🗑 Xóa Đã Chọn" Background="#1E293B" Foreground="#EF4444" FontSize="10.5" Padding="8,5" CornerRadius="4" Margin="0,0,6,4" />

                                                <Button Command="{Binding ClearRenameItemsCommand}" Content="🧹 Xóa Tất Cả" Background="#1E293B" Foreground="#94A3B8" FontSize="10.5" Padding="8,5" CornerRadius="4" Margin="0,0,12,4" />



                                                <!-- Thực thi & Hoàn tác -->

                                                <Button Command="{Binding ExecuteBatchRenameCommand}" IsEnabled="{Binding !IsRenamingBatch}" Content="▶ START BATCH" Background="#059669" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="11" Padding="14,5" CornerRadius="4" Margin="0,0,6,4" ToolTip.Tip="Bắt đầu đổi tên an toàn cho toàn bộ các mục hợp lệ" />

                                                <Button Command="{Binding UndoBatchRenameCommand}" IsEnabled="{Binding CanUndoRename}" Content="↩️ UNDO ĐỔI TÊN" Background="#D97706" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="10,5" CornerRadius="4" Margin="0,0,6,4" ToolTip.Tip="Hoàn tác khôi phục lại tên cũ cho lần đổi tên vừa rồi" />

                                            </WrapPanel>



                                            <!-- Trạng thái & thống kê -->

                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                <TextBlock Text="{Binding RenameStatusMessage}" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold" Margin="0,0,12,0" />

                                                <TextBlock Text="{Binding RenameItems.Count, StringFormat='{}Tổng: {0} mục | '}" Foreground="#94A3B8" FontSize="10.5" />

                                                <TextBlock Text="{Binding RenameItemsValidCount, StringFormat='{}Hợp lệ: {0} | '}" Foreground="#10B981" FontSize="10.5" FontWeight="SemiBold" />

                                                <TextBlock Text="{Binding RenameItemsChangedCount, StringFormat='{}Có thay đổi: {0}'}" Foreground="#FBBF24" FontSize="10.5" FontWeight="SemiBold" />

                                            </WrapPanel>

                                        </StackPanel>

                                    </Border>



                                    <!-- Panel nội dung 2 cột: Danh sách File/Folder (trái) & Pipeline Method (phải) -->

                                    <Grid Grid.Row="1" ColumnDefinitions="3*, 2*">

                                        <!-- CỘT TRÁI: DANH SÁCH FILE / FOLDER PREVIEW -->

                                        <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0" Padding="8"

                                                DragDrop.AllowDrop="True" DragDrop.DragOver="OnRenameDragOver" DragDrop.Drop="OnRenameDrop">

                                            <Grid RowDefinitions="Auto, *">

                                                <!-- Header bảng danh sách -->

                                                <Grid Grid.Row="0" ColumnDefinitions="*, *, 120" Margin="6,0,6,6">

                                                    <TextBlock Grid.Column="0" Text="TÊN GỐC (ORIGINAL)" Foreground="#64748B" FontWeight="Bold" FontSize="10.5" />

                                                    <TextBlock Grid.Column="1" Text="TÊN MỚI (NEW NAME)" Foreground="#38BDF8" FontWeight="Bold" FontSize="10.5" />

                                                    <TextBlock Grid.Column="2" Text="TRẠNG THÁI" Foreground="#64748B" FontWeight="Bold" FontSize="10.5" TextAlignment="Right" />

                                                </Grid>



                                                <!-- Bảng danh sách mục -->

                                                <Grid Grid.Row="1">

                                                    <ListBox ItemsSource="{Binding RenameItems}" SelectedItem="{Binding SelectedRenameItem}" Background="Transparent">

                                                        <ListBox.ItemTemplate>

                                                            <DataTemplate>

                                                                <Border Background="#161F30" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,1.5">

                                                                    <Grid ColumnDefinitions="*, *, 120">

                                                                        <!-- Tên gốc -->

                                                                        <TextBlock Grid.Column="0" Text="{Binding OriginalName}" Foreground="#CBD5E1" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" VerticalAlignment="Center" />



                                                                        <!-- Tên mới -->

                                                                        <TextBlock Grid.Column="1" Text="{Binding NewName}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" VerticalAlignment="Center" />



                                                                        <!-- Trạng thái -->

                                                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="10" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" />

                                                                    </Grid>

                                                                </Border>

                                                            </DataTemplate>

                                                        </ListBox.ItemTemplate>

                                                    </ListBox>



                                                    <!-- Gợi ý kéo thả khi danh sách trống (chuẩn WPF) -->

                                                    <Border Background="Transparent" IsVisible="{Binding !RenameItems.Count}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">

                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">

                                                            <TextBlock Text="📥" FontSize="28" HorizontalAlignment="Center" Foreground="#475569" />

                                                            <TextBlock Text="Kéo - thả file hoặc thư mục vào đây để thêm..." Foreground="#64748B" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />

                                                            <TextBlock Text="Hoặc bấm nút '+ Thêm File' / '+ Thêm Thư Mục' ở thanh công cụ" Foreground="#475569" FontSize="10.5" HorizontalAlignment="Center" />

                                                        </StackPanel>

                                                    </Border>

                                                </Grid>

                                            </Grid>

                                        </Border>



                                        <!-- CỘT PHẢI: QUẢN LÝ METHOD & CẤU HÌNH CHI TIẾT -->

                                        <Border Grid.Column="1" Background="#0A0E17" Padding="10">

                                            <Grid RowDefinitions="Auto, 160, Auto, *">

                                                <!-- Header khu vực Method -->

                                                <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">

                                                    <TextBlock Text="DANH SÁCH METHOD (PIPELINE)" Foreground="#FBBF24" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,4" />

                                                    <ComboBox SelectedItem="{Binding NewMethodSelection}" Width="150" Height="26" VerticalAlignment="Center" Margin="0,0,6,4" FontSize="10.5">

                                                        <x:String>NewName</x:String>

                                                        <x:String>Replace</x:String>

                                                        <x:String>Renumber</x:String>

                                                        <x:String>Case</x:String>

                                                        <x:String>Remove</x:String>

                                                        <x:String>OptimizeZero</x:String>

                                                    </ComboBox>

                                                    <Button Command="{Binding AddRenameMethodCommand}" Content="+ Thêm method" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10.5" Padding="8,3" CornerRadius="3" Margin="0,0,6,4" />

                                                    <Button Command="{Binding MoveRenameMethodUpCommand}" Content="⬆️" Background="#1E293B" Foreground="#38BDF8" FontSize="10.5" Padding="6,3" CornerRadius="3" Margin="0,0,3,4" ToolTip.Tip="Đẩy lên trước" />

                                                    <Button Command="{Binding MoveRenameMethodDownCommand}" Content="⬇️" Background="#1E293B" Foreground="#38BDF8" FontSize="10.5" Padding="6,3" CornerRadius="3" Margin="0,0,3,4" ToolTip.Tip="Đẩy xuống sau" />

                                                    <Button Command="{Binding RemoveSelectedRenameMethodCommand}" Content="❌" Background="#1E293B" Foreground="#EF4444" FontSize="10.5" Padding="6,3" CornerRadius="3" Margin="0,0,0,4" ToolTip.Tip="Xóa method đang chọn" />

                                                </WrapPanel>



                                                <!-- ListBox danh sách method trong pipeline -->

                                                <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="4" Margin="0,0,0,10">

                                                    <ListBox ItemsSource="{Binding RenameMethods}" SelectedItem="{Binding SelectedRenameMethod}" Background="Transparent">

                                                        <ListBox.ItemTemplate>

                                                            <DataTemplate>

                                                                <Grid ColumnDefinitions="Auto, *, Auto">

                                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                                                        <TextBlock Text="{Binding Icon}" FontSize="12" VerticalAlignment="Center" />

                                                                        <TextBlock Text="{Binding Name}" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />

                                                                    </StackPanel>

                                                                    <TextBlock Grid.Column="2" Text="{Binding ApplyTo, StringFormat='{}({0})'}" Foreground="#64748B" FontSize="10" VerticalAlignment="Center" />

                                                                </Grid>

                                                            </DataTemplate>

                                                        </ListBox.ItemTemplate>

                                                    </ListBox>

                                                </Border>



                                                <!-- Tiêu đề Cấu hình chi tiết -->

                                                <TextBlock Grid.Row="2" Text="CẤU HÌNH CHI TIẾT (CONFIG)" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" Margin="0,0,0,6" />



                                                <!-- Khung cấu hình động tùy theo loại method đang chọn -->

                                                <Border Grid.Row="3" Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10">

                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                                                        <StackPanel Spacing="10">

                                                            <!-- Phạm vi áp dụng chung -->

                                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                                <TextBlock Text="Áp dụng cho:" Foreground="#94A3B8" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,8,4" />

                                                                <ComboBox SelectedItem="{Binding SelectedRenameMethod.ApplyTo}" Width="150" Height="26" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,12,4">

                                                                    <x:String>Name</x:String>

                                                                    <x:String>Extension</x:String>

                                                                    <x:String>Both</x:String>

                                                                </ComboBox>

                                                                <CheckBox IsChecked="{Binding SelectedRenameMethod.Backwards}" Content="Quét ngược (Backwards)" Foreground="#CBD5E1" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,8,4" />

                                                                <CheckBox IsChecked="{Binding SelectedRenameMethod.UseRegex}" Content="Sử dụng Regex" Foreground="#38BDF8" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,0,4" />

                                                            </WrapPanel>



                                                            <!-- CẤU HÌNH 1: NEW NAME METHOD -->

                                                            <StackPanel Spacing="6" IsVisible="{Binding SelectedRenameMethod, Converter={x:Static ObjectConverters.IsNotNull}}">

                                                                <!-- Khi là NewNameMethod -->

                                                                <StackPanel Spacing="4">

                                                                    <TextBlock Text="Định dạng tên mới (Tags: &lt;Name&gt;, &lt;Ext&gt;, &lt;Counter:3&gt;, &lt;Date:yyyy-MM-dd&gt;):" Foreground="#CBD5E1" FontSize="10.5" FontWeight="SemiBold" />

                                                                    <TextBox Text="{Binding ((services:NewNameMethod)SelectedRenameMethod).Format}" PlaceholderText="Ví dụ: &lt;Name&gt; - chap &lt;Counter:3&gt;" Height="30" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" BorderBrush="#38BDF8" BorderThickness="1" FontSize="11" VerticalContentAlignment="Center" Padding="8,2" />

                                                                </StackPanel>



                                                                <!-- Khi là ReplaceMethod -->

                                                                <StackPanel Spacing="6">

                                                                    <Grid ColumnDefinitions="*, *">

                                                                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">

                                                                            <TextBlock Text="Tìm chuỗi (Find):" Foreground="#CBD5E1" FontSize="10.5" />

                                                                            <TextBox Text="{Binding ((services:ReplaceMethod)SelectedRenameMethod).FindText}" Height="28" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" BorderBrush="#38BDF8" BorderThickness="1" FontSize="11" VerticalContentAlignment="Center" Padding="6,2" />

                                                                        </StackPanel>

                                                                        <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">

                                                                            <TextBlock Text="Thay bằng (Replace With):" Foreground="#CBD5E1" FontSize="10.5" />

                                                                            <TextBox Text="{Binding ((services:ReplaceMethod)SelectedRenameMethod).ReplaceWithText}" Height="28" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" BorderBrush="#38BDF8" BorderThickness="1" FontSize="11" VerticalContentAlignment="Center" Padding="6,2" />

                                                                        </StackPanel>

                                                                    </Grid>

                                                                    <CheckBox IsChecked="{Binding ((services:ReplaceMethod)SelectedRenameMethod).CaseSensitive}" Content="Phân biệt chữ hoa/thường (Case Sensitive)" Foreground="#CBD5E1" FontSize="10.5" />

                                                                </StackPanel>



                                                                <!-- Khi là RenumberMethod -->

                                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                                    <StackPanel Spacing="2" Margin="0,0,10,6">

                                                                        <TextBlock Text="Bắt đầu từ:" Foreground="#CBD5E1" FontSize="10.5" />

                                                                        <NumericUpDown Value="{Binding ((services:RenumberMethod)SelectedRenameMethod).StartNumber}" Minimum="0" Maximum="99999" Height="28" Width="110" FontSize="11" />

                                                                    </StackPanel>

                                                                    <StackPanel Spacing="2" Margin="0,0,10,6">

                                                                        <TextBlock Text="Bước nhảy:" Foreground="#CBD5E1" FontSize="10.5" />

                                                                        <NumericUpDown Value="{Binding ((services:RenumberMethod)SelectedRenameMethod).Step}" Minimum="1" Maximum="1000" Height="28" Width="105" FontSize="11" />

                                                                    </StackPanel>

                                                                    <StackPanel Spacing="2" Margin="0,0,10,6">

                                                                        <TextBlock Text="Số chữ số 0:" Foreground="#CBD5E1" FontSize="10.5" />

                                                                        <NumericUpDown Value="{Binding ((services:RenumberMethod)SelectedRenameMethod).ZeroPadding}" Minimum="0" Maximum="10" Height="28" Width="105" FontSize="11" />

                                                                    </StackPanel>

                                                                    <StackPanel Spacing="2" Margin="0,0,10,6">

                                                                        <TextBlock Text="Vị trí chèn:" Foreground="#CBD5E1" FontSize="10.5" />

                                                                        <ComboBox SelectedItem="{Binding ((services:RenumberMethod)SelectedRenameMethod).Location}" Width="110" Height="26" FontSize="10.5">

                                                                            <x:String>Prepend</x:String>

                                                                            <x:String>Append</x:String>

                                                                            <x:String>Replace</x:String>

                                                                        </ComboBox>

                                                                    </StackPanel>

                                                                </WrapPanel>



                                                                <!-- Khi là ChangeCaseMethod -->

                                                                <StackPanel Spacing="4">

                                                                    <TextBlock Text="Kiểu chuyển đổi chữ hoa/thường:" Foreground="#CBD5E1" FontSize="10.5" />

                                                                    <ComboBox SelectedItem="{Binding ((services:ChangeCaseMethod)SelectedRenameMethod).CaseType}" Width="200" Height="28" FontSize="11">

                                                                        <x:String>Title Case</x:String>

                                                                        <x:String>lowercase</x:String>

                                                                        <x:String>UPPERCASE</x:String>

                                                                        <x:String>Sentence case</x:String>

                                                                    </ComboBox>

                                                                </StackPanel>



                                                                <!-- Khi là RemoveMethod -->

                                                                <StackPanel Spacing="6">

                                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                                        <TextBlock Text="Kiểu xóa:" Foreground="#CBD5E1" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,8,4" />

                                                                        <ComboBox SelectedItem="{Binding ((services:RemoveMethod)SelectedRenameMethod).RemoveType}" Width="160" Height="26" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,8,4">

                                                                            <x:String>String</x:String>

                                                                            <x:String>Range</x:String>

                                                                            <x:String>ExtraWhitespace</x:String>

                                                                            <x:String>SpecialChars</x:String>

                                                                            <x:String>Digits</x:String>

                                                                        </ComboBox>

                                                                    </WrapPanel>

                                                                    <StackPanel Spacing="4">

                                                                        <TextBlock Text="Chuỗi cần xóa:" Foreground="#CBD5E1" FontSize="10.5" />

                                                                        <TextBox Text="{Binding ((services:RemoveMethod)SelectedRenameMethod).TargetText}" Height="28" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" BorderBrush="#38BDF8" BorderThickness="1" FontSize="11" VerticalContentAlignment="Center" Padding="6,2" />

                                                                    </StackPanel>

                                                                </StackPanel>



                                                                <!-- Khi là OptimizeZeroMethod -->

                                                                <StackPanel Spacing="4">

                                                                    <TextBlock Text="Độ dài chuẩn hóa số 0 đệm (Ví dụ: 3 chữ số -> 001, 002):" Foreground="#CBD5E1" FontSize="10.5" />

                                                                    <NumericUpDown Value="{Binding ((services:OptimizeZeroMethod)SelectedRenameMethod).PadLength}" Minimum="1" Maximum="10" Height="26" Width="100" HorizontalAlignment="Left" FontSize="11" />

                                                                </StackPanel>

                                                            </StackPanel>

                                                        </StackPanel>

                                                    </ScrollViewer>

                                                </Border>

                                            </Grid>

                                        </Border>

                                    </Grid>

                                </Grid>

                            </TabItem>



                            <!-- CHILD TAB 3.7: DUAL PICTURE SORT (LỌC ẢNH SONG SONG) -->

                            <TabItem Header="🖼️ Dual Picture Sort" FontSize="12" FontWeight="SemiBold">

                                <Grid RowDefinitions="Auto, *">

                                    <!-- Header & Cấu hình thư mục -->

                                    <Border Grid.Row="0" Background="#161F30" Padding="12,10" BorderBrush="#1E293B" BorderThickness="0,0,0,1">

                                        <StackPanel Spacing="10">

                                            <!-- Hàng 0: Header Bar phong cách chuyên nghiệp (WrapPanel tự động xuống hàng trên mọi kích thước màn hình) -->

                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,14,6">

                                                    <TextBlock Text="Dual Picture Sort - GMTPC" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />

                                                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">

                                                        <TextBlock Text="v1.0 • Avalonia Multiplatform" FontSize="10" Foreground="#94A3B8" FontWeight="SemiBold" />

                                                    </Border>

                                                </StackPanel>



                                                <!-- Nút Mở / Tắt Floating Batch Toolbar -->

                                                <Button Command="{Binding ToggleDualSortBatchToolbarVisibleCommand}"

                                                        Background="{Binding DualSortBatchToggleBtnBg}"

                                                        BorderBrush="{Binding DualSortBatchToggleBtnBorder}"

                                                        BorderThickness="1"

                                                        Foreground="{Binding DualSortBatchToggleBtnFg}"

                                                        FontWeight="Bold" FontSize="11" Padding="10,5" CornerRadius="4" Margin="0,0,6,6"

                                                        ToolTip.Tip="Mở hoặc tắt thanh công cụ nổi Batch (Floating Batch Toolbar)">

                                                    <TextBlock Text="{Binding DualSortBatchToggleBtnText}" />

                                                </Button>



                                                <Button Command="{Binding ToggleDualSortPreviewEnabledCommand}"

                                                        Background="{Binding DualSortPreviewButtonBg}"

                                                        BorderBrush="{Binding DualSortPreviewButtonBorder}"

                                                        BorderThickness="1"

                                                        Foreground="{Binding DualSortPreviewButtonFg}"

                                                        FontWeight="Bold" FontSize="11" Padding="10,5" CornerRadius="4" Margin="0,0,6,6"

                                                        ToolTip.Tip="Bật/Tắt tính năng xem trước ảnh (Preview)">

                                                    <TextBlock Text="{Binding DualSortPreviewButtonText}" />

                                                </Button>

                                                <Button Command="{Binding UndoLastSortCommand}" IsEnabled="{Binding CanUndoSort}"

                                                        Background="#334155" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="11" Padding="10,5" CornerRadius="4" Margin="0,0,6,6"

                                                        ToolTip.Tip="Hoàn tác thao tác di chuyển/sao chép ảnh vừa thực hiện (Ctrl+Z)">

                                                    <TextBlock Text="↩ Hoàn tác (Ctrl+Z)" />

                                                </Button>

                                                <Button Command="{Binding KeepParentCommand}"

                                                        Background="#D97706" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="10,5" CornerRadius="4" Margin="0,0,6,6"

                                                        ToolTip.Tip="Keep Parent: Xóa hoàn toàn thư mục Đã Lọc (Child), chỉ giữ lại thư mục Gốc">

                                                    <TextBlock Text="🛡️ Giữ Gốc (Keep Parent)" />

                                                </Button>

                                                <Button Command="{Binding KeepChildCommand}"

                                                        Background="#7C3AED" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="10,5" CornerRadius="4" Margin="0,0,6,6"

                                                        ToolTip.Tip="Keep Child: Xóa file ở Gốc, chuyển toàn bộ ảnh Đã Lọc (Child) sang Gốc và xóa thư mục Child">

                                                    <TextBlock Text="✨ Giữ Đã Lọc (Keep Child)" />

                                                </Button>

                                                <Button Command="{Binding KeepSelectedOnlyCommand}"

                                                        Background="#BE185D" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="10,5" CornerRadius="4" Margin="0,0,6,6"

                                                        ToolTip.Tip="Chỉ giữ đã chọn: Xóa các file không được chọn ở cả 2 thư mục và xóa luôn cả thư mục Đã Lọc (Child)">

                                                    <TextBlock Text="🎯 Chỉ Giữ Đã Chọn" />

                                                </Button>

                                                <Button Command="{Binding RefreshDualSortFoldersCommand}"

                                                        Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="10,5" CornerRadius="4" Margin="0,0,6,6"

                                                        ToolTip.Tip="Làm mới lại danh sách ảnh từ cả 2 thư mục">

                                                    <TextBlock Text="🔄 Làm mới tất cả" />

                                                </Button>

                                                <!-- Cá»¥m chá»n Grid 1 - 3 (Windows & Linux) -->
                                                <!-- Cụm chọn Grid (ComboBox từ 1 đến 6 trên Desktop, có Icon Grid vector) -->
                                                <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="4,2" Margin="0,0,0,6" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <PathIcon Data="M3 3h7v7H3V3zm11 0h7v7h-7V3zm0 11h7v7h-7v-7zm-11 0h7v7H3v-7z"
                                                                  Width="13" Height="13" Foreground="#38BDF8" VerticalAlignment="Center" Margin="2,0,2,0" />
                                                        <TextBlock Text="Grid:" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                                        <ComboBox ItemsSource="{Binding DualSortGridOptions}"
                                                                  SelectedItem="{Binding DualSortGridColumns, Mode=TwoWay}"
                                                                  Height="26" MinWidth="54" Padding="6,1" FontSize="11" FontWeight="Bold"
                                                                  Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="3"
                                                                  VerticalContentAlignment="Center" ToolTip.Tip="Chọn số cột hiển thị ảnh (Grid 1 - 6)">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}" HorizontalAlignment="Center" FontWeight="Bold" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Border>

                                            </WrapPanel>



                                            <!-- Hàng 1: Thư mục gốc -->

                                            <StackPanel Spacing="3">

                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <TextBlock Text="📁 Thư mục gốc:" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                    <Button Command="{Binding BrowseDualSortSourceFolderCommand}" Content="📁 Chọn..." Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10.5" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" />

                                                    <Button Command="{Binding OpenDualSortSourceFolderCommand}" Content="🔍 Mở" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10.5" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" ToolTip.Tip="Mở thư mục gốc trong trình quản lý tệp" />

                                                    <Button Command="{Binding DualSortPreviousFolderCommand}" Content="⏮️ Trước" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1" FontWeight="SemiBold" FontSize="10.5" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" ToolTip.Tip="Previous Folder: Chuyển sang thư mục anh em liền trước" />

                                                    <Button Command="{Binding DualSortNextFolderCommand}" Content="Tiếp ⏭️" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#0284C7" BorderThickness="1" FontWeight="SemiBold" FontSize="10.5" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" ToolTip.Tip="Next Folder: Chuyển sang thư mục anh em tiếp theo" />

                                                    <Button Command="{Binding DualSortDeleteFolderCommand}" Content="🗑️ Xóa Thư Mục" Background="#7F1D1D" Foreground="#FCA5A5" BorderBrush="#EF4444" BorderThickness="1" FontWeight="Bold" FontSize="10.5" Padding="8,3" CornerRadius="4" ToolTip.Tip="Xóa thư mục gốc hiện tại (chuyển an toàn vào Thùng rác Recycle Bin / Trash) và tự động chuyển sang thư mục kế tiếp" />

                                                </WrapPanel>

                                                <TextBox Text="{Binding DualSortSourcePath}" PlaceholderText="Chọn thư mục chứa ảnh gốc cần lọc (ví dụ: comic\ranma fanart)..." Height="30" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" BorderBrush="#F59E0B" BorderThickness="1" FontSize="10.5" VerticalContentAlignment="Center" Padding="8,2" />

                                            </StackPanel>



                                            <!-- Hàng 2: Thư mục đã lọc -->

                                            <StackPanel Spacing="3">

                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <TextBlock Text="✨ Thư mục đã lọc:" Foreground="#10B981" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                    <Button Command="{Binding BrowseDualSortSortedFolderCommand}" Content="📁 Chọn..." Background="#059669" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10.5" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" />

                                                    <Button Command="{Binding OpenDualSortSortedFolderCommand}" Content="🔍 Mở" Background="#1E293B" Foreground="#10B981" FontWeight="SemiBold" FontSize="10.5" Padding="8,3" CornerRadius="4" ToolTip.Tip="Mở thư mục đã lọc trong trình quản lý tệp" />

                                                </WrapPanel>

                                                <TextBox Text="{Binding DualSortSortedPath}" PlaceholderText="Chọn hoặc tự động tạo thư mục đã lọc (ví dụ: comic\ranma fanart\ranma fanart-sorted)..." Height="30" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" BorderBrush="#10B981" BorderThickness="1" FontSize="10.5" VerticalContentAlignment="Center" Padding="8,2" />

                                            </StackPanel>



                                            <!-- Hàng 2.5: Thư mục hoàn thành (Finish folder) -->

                                            <StackPanel Spacing="3">

                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <TextBlock Text="🏁 Thư mục đích (Finish):" Foreground="#34D399" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                    <Button Command="{Binding BrowseDualSortFinishFolderCommand}" Content="📁 Chọn..." Background="#059669" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10.5" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" />

                                                    <Button Command="{Binding OpenDualSortFinishFolderCommand}" Content="🔍 Mở" Background="#1E293B" Foreground="#34D399" FontWeight="SemiBold" FontSize="10.5" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" ToolTip.Tip="Mở thư mục hoàn thành trong trình quản lý tệp" />

                                                    <Button Command="{Binding ClearDualSortFinishFolderCommand}" Content="✕ Xóa đường dẫn" Background="#1E293B" Foreground="#F87171" BorderBrush="#EF4444" BorderThickness="1" FontWeight="SemiBold" FontSize="10.5" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" ToolTip.Tip="Làm sạch đường dẫn Thư mục hoàn thành (Finish folder)" />

                                                    <Button Command="{Binding DualSortFinishFolderCommand}" Content="🏁 Finish Folder" Background="#065F46" Foreground="#FFFFFF" BorderBrush="#10B981" BorderThickness="1" FontWeight="Bold" FontSize="10.5" Padding="10,3" CornerRadius="4" ToolTip.Tip="Chuyển thư mục hiện tại vào Thư mục hoàn thành (Finish folder) và tự động chuyển sang thư mục kế tiếp" />

                                                </WrapPanel>

                                                <TextBox Text="{Binding DualSortFinishPath}" PlaceholderText="Chọn thư mục chứa các bộ ảnh đã lọc xong (Finish folder)..." Height="30" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" BorderBrush="#34D399" BorderThickness="1" FontSize="10.5" VerticalContentAlignment="Center" Padding="8,2" />

                                            </StackPanel>



                                            <!-- Hàng 3: Tùy chọn (WrapPanel thích ứng) -->

                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                <CheckBox IsChecked="{Binding IsAutoCreateSortedFolder}" Content="⚡ Tự động tạo thư mục con '...-sorted'" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,16,4" />

                                                <RadioButton IsChecked="{Binding IsSortMoveMode}" GroupName="DualSortModeGroup" Content="🔘 Di chuyển ảnh (Move)" FontSize="11" Foreground="#E2E8F0" Margin="0,0,14,4" />

                                                <RadioButton IsChecked="{Binding IsSortCopyMode}" GroupName="DualSortModeGroup" Content="⚪ Sao chép ảnh (Copy)" FontSize="11" Foreground="#E2E8F0" Margin="0,0,16,4" />

                                                <CheckBox IsChecked="{Binding IsOneClickFastSort}" Content="🚀 Chuyển ngay khi Click (1-Click Fast Sort)" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,8,4" ToolTip.Tip="Bật chế độ phân loại siêu tốc: Click vào ảnh là chuyển ngay lập tức!" />

                                            </WrapPanel>

                                        </StackPanel>

                                    </Border>



                                    <!-- Thân chính: Mỗi panel là 1 Tab độc lập (Gốc vs Đã Lọc) trên cả Desktop và Android -->
                                    <Grid Grid.Row="1" RowDefinitions="Auto, *" Margin="4,2">
                                        <!-- HÀNG 0: THANH CHUYỂN ĐỔI 2 TAB LỚN -->
                                        <Grid Grid.Row="0" ColumnDefinitions="*, *" Margin="0,0,0,6">
                                            <!-- TAB 1: THƯ MỤC GỐC -->
                                            <Button Grid.Column="0" Command="{Binding SelectDualSortSourceTabCommand}"
                                                    Background="{Binding SourceTabBg}"
                                                    BorderBrush="{Binding SourceTabBorder}" BorderThickness="1.5"
                                                    Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" Height="36" CornerRadius="5,0,0,5">
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="📁 THƯ MỤC GỐC" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" />
                                                    <Border Background="#1E293B" CornerRadius="10" Padding="8,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DualSortSourceCount, StringFormat='{}{0} ảnh'}" FontSize="10.5" Foreground="#CBD5E1" FontWeight="Bold" />
                                                    </Border>
                                                </StackPanel>
                                            </Button>

                                            <!-- TAB 2: ĐÃ LỌC (SORTED) -->
                                            <Button Grid.Column="1" Command="{Binding SelectDualSortSortedTabCommand}"
                                                    Background="{Binding SortedTabBg}"
                                                    BorderBrush="{Binding SortedTabBorder}" BorderThickness="1.5"
                                                    Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" Height="36" CornerRadius="0,5,5,0">
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="✨ ĐÃ LỌC (SORTED)" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" />
                                                    <Border Background="#1E293B" CornerRadius="10" Padding="8,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DualSortSortedCount, StringFormat='{}{0} ảnh'}" FontSize="10.5" Foreground="#CBD5E1" FontWeight="Bold" />
                                                    </Border>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- HÀNG 1: NỘI DUNG TỪNG TAB -->
                                        <Grid Grid.Row="1">
                                            <!-- PANEL TAB 1: THƯ MỤC GỐC -->
                                            <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="6"
                                                    IsVisible="{Binding IsSourceTabVisible}">
                                                <Grid RowDefinitions="Auto, *">
                                                    <!-- Header Bar Tab Gốc: Tìm kiếm + Nút Chuyển sang Sorted -->
                                                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,6">
                                                        <TextBox Grid.Column="0" Text="{Binding DualSortSearchSource}" PlaceholderText="🔍 Tìm tên file trong Thư mục gốc..." Height="30" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" FontSize="11" Padding="8,2" Margin="0,0,8,0" VerticalContentAlignment="Center" />
                                                        <Button Grid.Column="1" Command="{Binding SortSelectedForwardCommand}"
                                                                Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" Padding="14,4" Height="30" CornerRadius="4"
                                                                ToolTip.Tip="Chuyển ảnh đang chọn sang thư mục Sorted (Phím Enter / Phím →)">
                                                            <TextBlock Text="➡️ Chuyển sang Sorted" VerticalAlignment="Center" />
                                                        </Button>
                                                    </Grid>

                                                    <!-- Danh sách ảnh gốc (toàn màn hình, grid từ 1 đến 6 cột) -->
                                                    <ScrollViewer Grid.Row="1" Classes="dualSortScroll" BringIntoViewOnFocusChange="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl ItemsSource="{Binding FilteredDualSortSourceItems}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Columns="{Binding DualSortGridColumns}" HorizontalAlignment="Stretch" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border HorizontalAlignment="Stretch" Margin="4" CornerRadius="5" Padding="4"
                                                                            PointerEntered="OnDualSortSourceItemPointerEntered"
                                                                            PointerMoved="OnDualSortSourceItemPointerMoved"
                                                                            PointerExited="OnDualSortSourceItemPointerExited"
                                                                            PointerPressed="OnDualSortSourceItemPointerPressed"
                                                                            PointerReleased="OnDualSortSourceItemPointerReleased"
                                                                            Background="{Binding ItemBgBrush}"
                                                                            BorderBrush="{Binding ItemBorderBrush}"
                                                                            BorderThickness="1.5" Cursor="Hand">
                                                                        <Grid RowDefinitions="Auto, Auto, Auto">
                                                                            <!-- Thumbnail Aspect Ratio Landscape Widescreen -->
                                                                            <Border Grid.Row="0" CornerRadius="4" ClipToBounds="True" Background="#060913" Height="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DualSortThumbHeight}">
                                                                                <Panel>
                                                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                              HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                                              Margin="2,2,0,0" ZIndex="10" />
                                                                                </Panel>
                                                                            </Border>
                                                                            <!-- Tên file -->
                                                                            <TextBlock Grid.Row="1" Text="{Binding FileName}" FontSize="10.5" FontWeight="SemiBold" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis" Margin="0,4,0,2" ToolTip.Tip="{Binding FileName}" />
                                                                            <!-- Metadata: Độ phân giải & Dung lượng -->
                                                                            <Grid Grid.Row="2" ColumnDefinitions="*, Auto">
                                                                                <TextBlock Grid.Column="0" Text="{Binding ResolutionText}" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" />
                                                                                <TextBlock Grid.Column="1" Text="{Binding FileSizeText}" FontSize="9.5" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                                            </Grid>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Grid>
                                            </Border>

                                            <!-- PANEL TAB 2: ĐÃ LỌC (SORTED) -->
                                            <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="6"
                                                    IsVisible="{Binding IsSortedTabVisible}">
                                                <Grid RowDefinitions="Auto, *">
                                                    <!-- Header Bar Tab Đã Lọc: Tìm kiếm + Nút Trả lại Gốc -->
                                                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,6">
                                                        <TextBox Grid.Column="0" Text="{Binding DualSortSearchSorted}" PlaceholderText="🔍 Tìm tên file trong Thư mục đã lọc..." Height="30" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" FontSize="11" Padding="8,2" Margin="0,0,8,0" VerticalContentAlignment="Center" />
                                                        <Button Grid.Column="1" Command="{Binding SortSelectedBackwardCommand}"
                                                                Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" Padding="14,4" Height="30" CornerRadius="4"
                                                                ToolTip.Tip="Trả ảnh đang chọn về thư mục gốc (Phím Backspace / Phím ←)">
                                                            <TextBlock Text="⬅️ Trả lại Gốc" VerticalAlignment="Center" />
                                                        </Button>
                                                    </Grid>

                                                    <!-- Danh sách ảnh đã lọc (toàn màn hình, grid từ 1 đến 6 cột) -->
                                                    <ScrollViewer Grid.Row="1" Classes="dualSortScroll" BringIntoViewOnFocusChange="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl ItemsSource="{Binding FilteredDualSortSortedItems}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Columns="{Binding DualSortGridColumns}" HorizontalAlignment="Stretch" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border HorizontalAlignment="Stretch" Margin="4" CornerRadius="5" Padding="4"
                                                                            PointerEntered="OnDualSortSortedItemPointerEntered"
                                                                            PointerMoved="OnDualSortSortedItemPointerMoved"
                                                                            PointerExited="OnDualSortSortedItemPointerExited"
                                                                            PointerPressed="OnDualSortSortedItemPointerPressed"
                                                                            PointerReleased="OnDualSortSortedItemPointerReleased"
                                                                            Background="{Binding ItemBgBrush}"
                                                                            BorderBrush="{Binding ItemBorderBrush}"
                                                                            BorderThickness="1.5" Cursor="Hand">
                                                                        <Grid RowDefinitions="Auto, Auto, Auto">
                                                                            <!-- Thumbnail Aspect Ratio Landscape Widescreen -->
                                                                            <Border Grid.Row="0" CornerRadius="4" ClipToBounds="True" Background="#060913" Height="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DualSortThumbHeight}">
                                                                                <Panel>
                                                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                              HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                                              Margin="2,2,0,0" ZIndex="10" />
                                                                                </Panel>
                                                                            </Border>
                                                                            <!-- Tên file -->
                                                                            <TextBlock Grid.Row="1" Text="{Binding FileName}" FontSize="10.5" FontWeight="SemiBold" Foreground="#F1F5F9" TextTrimming="CharacterEllipsis" Margin="0,4,0,2" ToolTip.Tip="{Binding FileName}" />
                                                                            <!-- Metadata: Độ phân giải & Dung lượng -->
                                                                            <Grid Grid.Row="2" ColumnDefinitions="*, Auto">
                                                                                <TextBlock Grid.Column="0" Text="{Binding ResolutionText}" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" />
                                                                                <TextBlock Grid.Column="1" Text="{Binding FileSizeText}" FontSize="9.5" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                                            </Grid>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </TabItem>



                            <!-- CHILD TAB 3.7: FILE ASSOCIATION & CONTEXT MENU (WINDOWS & LINUX) -->

                            <TabItem Header="🔗 Liên Kết Tệp (File Association)" FontSize="12" FontWeight="SemiBold">

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                                    <Border Background="#0F172A" CornerRadius="6" Padding="6,4" Margin="0,2,0,0">

                                        <StackPanel Spacing="16" MaxWidth="1050" HorizontalAlignment="Stretch">



                                            <!-- TIÊU ĐỀ & MÔ TẢ TỔNG QUAN -->

                                            <Border Background="#161F30" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="8" Padding="14,12">

                                                <Grid RowDefinitions="Auto, Auto">

                                                    <StackPanel Grid.Row="0" Spacing="4">

                                                        <TextBlock Text="🔗 THIẾT LẬP LIÊN KẾT TỆP &amp; MENU NGỮ CẢNH (FILE ASSOCIATION &amp; CONTEXT MENU)"

                                                                   FontWeight="Bold" FontSize="14" Foreground="#38BDF8" />

                                                        <TextBlock Text="Cấu hình mở file ảnh/sách truyện mặc định bằng app và menu chuột phải cho file nén (User Scope: 100% an toàn, không cần quyền Admin hay Root). Hỗ trợ Windows &amp; Linux (tuyệt đối không áp dụng trên Android)."

                                                                   Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />

                                                    </StackPanel>



                                                    <Border Grid.Row="1" Margin="0,10,0,0" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6">

                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                            <TextBlock Text="Hệ điều hành hiện tại: " Foreground="#64748B" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />

                                                            <TextBlock Text="{Binding AssociationPlatformText}" Foreground="#10B981" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,12,0" />

                                                            <Button Command="{Binding RefreshAssociationStatusCommand}" Content="🔄 Làm Mới Trạng Thái"

                                                                    Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" Padding="8,3" CornerRadius="4" ToolTip.Tip="Kiểm tra lại cấu hình từ Registry / MIME" />

                                                        </WrapPanel>

                                                    </Border>

                                                </Grid>

                                            </Border>



                                            <!-- KHỐI 1: MỞ MẶC ĐỊNH (DEFAULT ASSOCIATION) - ẢNH & SÁCH TRUYỆN -->

                                            <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,12">

                                                <Grid RowDefinitions="Auto, Auto, Auto">

                                                    <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">

                                                        <TextBlock Text="1. Mở Mặc Định Tệp Hình Ảnh &amp; Sách Truyện (Default File Opener)" FontWeight="Bold" Foreground="#F8FAFC" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,4" />

                                                    </WrapPanel>



                                                    <TextBlock Grid.Row="1" Margin="0,4,0,12" Text="Khi kích hoạt, double-click vào bất kỳ tệp ảnh (.png, .bmp, .jpg, .jpeg, .webp) hoặc sách (.pdf, .mobi) sẽ tự động mở thẳng vào trình đọc truyện của app. App tự động nhận diện toàn bộ ảnh trong cùng thư mục và lật trang mượt mà."

                                                               Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />



                                                    <!-- Thẻ điều khiển & Nút Bật/Tắt -->

                                                    <Border Grid.Row="2" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,10">

                                                        <Grid ColumnDefinitions="*, Auto">

                                                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">

                                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                                    <TextBlock Text="Định dạng áp dụng: " Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" />

                                                                    <TextBlock Text=".png, .jpg, .jpeg, .bmp, .webp, .pdf, .mobi" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" />

                                                                </WrapPanel>

                                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                                    <TextBlock Text="Trạng thái: " Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />

                                                                    <TextBlock Text="{Binding DefaultImageBookStatusText}" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />

                                                                </WrapPanel>

                                                            </StackPanel>



                                                            <!-- Nút Bật / Tắt -->

                                                            <Button Grid.Column="1" Command="{Binding ToggleDefaultImageBookAssociationCommand}"

                                                                    Content="{Binding DefaultImageBookButtonText}"

                                                                    Background="{Binding DefaultImageBookButtonBackground}"

                                                                    Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="14,8" CornerRadius="6"

                                                                    VerticalAlignment="Center" />

                                                        </Grid>

                                                    </Border>

                                                </Grid>

                                            </Border>



                                            <!-- KHỐI 2: MENU CHUỘT PHẢI CHO FILE NÉN (CONTEXT MENU - KHÔNG MẶC ĐỊNH) -->

                                            <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,12">

                                                <Grid RowDefinitions="Auto, Auto, Auto">

                                                    <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">

                                                        <TextBlock Text="2. Menu Chuột Phải Cho Tệp Nén (Archive Context Menu - Không Chiếm Mặc Định)" FontWeight="Bold" Foreground="#F8FAFC" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,4" />

                                                    </WrapPanel>



                                                    <TextBlock Grid.Row="1" Margin="0,4,0,12" Text="TUYỆT ĐỐI KHÔNG chiếm quyền mở mặc định (để giữ nguyên trình giải nén như WinRAR/7-Zip). Chỉ bổ sung thêm mục ngữ cảnh khi click chuột phải: '📖 Đọc truyện bằng Comic Downloader GMTPC' để mở đọc tức thì khi cần."

                                                               Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />



                                                    <!-- Thẻ điều khiển & Nút Bật/Tắt -->

                                                    <Border Grid.Row="2" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,10">

                                                        <Grid ColumnDefinitions="*, Auto">

                                                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">

                                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                                    <TextBlock Text="Định dạng áp dụng: " Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" />

                                                                    <TextBlock Text=".zip, .rar, .cbz, .cbr" Foreground="#10B981" FontSize="11" FontWeight="Bold" />

                                                                </WrapPanel>

                                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                                    <TextBlock Text="Mục ngữ cảnh: " Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />

                                                                    <TextBlock Text="📖 Đọc truyện bằng Comic Downloader GMTPC" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />

                                                                    <TextBlock Text="{Binding ArchiveContextMenuStatusText}" Foreground="#10B981" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />

                                                                </WrapPanel>

                                                            </StackPanel>



                                                            <!-- Nút Bật / Tắt -->

                                                            <Button Grid.Column="1" Command="{Binding ToggleArchiveContextMenuCommand}"

                                                                    Content="{Binding ArchiveContextMenuButtonText}"

                                                                    Background="{Binding ArchiveContextMenuButtonBackground}"

                                                                    Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="14,8" CornerRadius="6"

                                                                    VerticalAlignment="Center" />

                                                        </Grid>

                                                    </Border>

                                                </Grid>

                                            </Border>



                                            <!-- KHỐI 3: THAO TÁC NHANH (QUICK BATCH ACTIONS) -->

                                            <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,12">

                                                <StackPanel Spacing="10">

                                                    <TextBlock Text="3. Thao Tác Nhanh (Batch Controls)" FontWeight="Bold" Foreground="#F8FAFC" FontSize="13" />

                                                    <WrapPanel Orientation="Horizontal">

                                                        <Button Command="{Binding RegisterAllAssociationsCommand}" Content="🚀 KÍCH HOẠT TẤT CẢ (MẶC ĐỊNH + MENU PHẢI)"

                                                                Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="14,8" CornerRadius="6" Margin="0,0,10,6" />

                                                        <Button Command="{Binding UnregisterAllAssociationsCommand}" Content="🧹 GỠ BỎ TẤT CẢ (KHÔI PHỤC HỆ THỐNG GỐC)"

                                                                Background="#EF4444" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="14,8" CornerRadius="6" Margin="0,0,10,6" />

                                                        <Button Command="{Binding RefreshAssociationStatusCommand}" Content="🔄 LÀM MỚI TRẠNG THÁI"

                                                                Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" Padding="14,8" CornerRadius="6" Margin="0,0,10,6" />

                                                    </WrapPanel>

                                                </StackPanel>

                                            </Border>



                                            <!-- KHỐI 4: QUẢN LÝ ĐA TIẾN TRÌNH APP CHÍNH (MULTI-INSTANCE SETTING) -->

                                            <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,12">

                                                <Grid RowDefinitions="Auto, Auto, Auto">

                                                    <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">

                                                        <TextBlock Text="4. Chế Độ Đa Phiên Bản App Chính (Multi-instance Setting)" FontWeight="Bold" Foreground="#F8FAFC" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,4" />

                                                    </WrapPanel>



                                                    <TextBlock Grid.Row="1" Margin="0,4,0,12" Text="Kiểm soát khả năng mở nhiều cửa sổ App chính (giao diện tải truyện). Khi tắt (mặc định), hệ thống sẽ chỉ giữ duy nhất một cửa sổ ứng dụng tải truyện để bảo vệ cơ sở dữ liệu và tránh xung đột tải trùng lặp. Trình đọc truyện độc lập siêu nhẹ khi double-click file ngoài Desktop sẽ luôn chạy riêng biệt không ảnh hưởng app chính."

                                                               Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />



                                                    <Border Grid.Row="2" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,10">

                                                        <StackPanel Spacing="6" VerticalAlignment="Center">

                                                            <CheckBox IsChecked="{Binding IsMultiInstanceEnabled, Mode=TwoWay}"

                                                                      Content="Cho phép mở nhiều cửa sổ App chính (Multi-instance)"

                                                                      FontWeight="Bold" FontSize="12" Foreground="#F8FAFC" />

                                                            <TextBlock Text="{Binding MultiInstanceStatusText}" Foreground="#10B981" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />

                                                        </StackPanel>

                                                    </Border>

                                                </Grid>

                                            </Border>



                                            <!-- KHỐI 5: BONG BÓNG CHẠY NGẦM & TỰ ĐỘNG THỤT MÉP (BUBBLE OVERLAY SETTING) -->

                                            <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,12">

                                                <Grid RowDefinitions="Auto, Auto, Auto">

                                                    <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">

                                                        <TextBlock Text="5. Chế Độ Bong Bóng Nổi (Bubble Overlay &amp; System Bubble)" FontWeight="Bold" Foreground="#F8FAFC" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,4" />

                                                        <Border Background="#3B0764" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,0,4">

                                                            <TextBlock Text="ANDROID OVERLAY &amp; BUBBLE API" FontSize="10" FontWeight="Bold" Foreground="#C084FC" />

                                                        </Border>

                                                    </WrapPanel>



                                                    <TextBlock Grid.Row="1" Margin="0,4,0,12" Text="Bật biểu tượng bong bóng nổi lơ lửng trên màn hình khi ứng dụng chạy ngầm. Tích hợp công nghệ tự động thụt vào mép màn hình (Auto-docking) và độ mờ linh hoạt (Dynamic Opacity) khi nhàn rỗi để không che khuất màn hình hay cản trở thao tác đọc truyện, chơi game."

                                                               Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />



                                                    <Border Grid.Row="2" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,10">

                                                        <StackPanel Spacing="6" VerticalAlignment="Center">

                                                            <CheckBox IsChecked="{Binding IsBubbleMode, Mode=TwoWay}" Click="OnBubbleCheckBoxClicked"

                                                                      Content="Bật chế độ Bong bóng nổi (Bubble Mode)"

                                                                      FontWeight="Bold" FontSize="12" Foreground="#F8FAFC" />

                                                            <TextBlock Text="• Tự động thụt 60% vào mép và giảm độ mờ còn 45% sau 3.5 giây không chạm&#x0a;• Tự động khôi phục 100% độ rõ khi chạm hoặc có tiến trình tải mới&#x0a;• Chạm nhanh vào bong bóng để mở lại ứng dụng tức thì"

                                                                       Foreground="#A78BFA" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />

                                                        </StackPanel>

                                                    </Border>

                                                </Grid>

                                            </Border>



                                            <!-- KHỐI 6: NHẬT KÝ THAO TÁC & THÔNG BÁO -->

                                            <Border Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,10">

                                                <StackPanel Spacing="4">

                                                    <TextBlock Text="📋 Thông báo &amp; Trạng thái xử lý:" Foreground="#64748B" FontSize="11" FontWeight="SemiBold" />

                                                    <TextBlock Text="{Binding AssociationStatusMessage}" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />

                                                </StackPanel>

                                            </Border>



                                        </StackPanel>

                                    </Border>

                                </ScrollViewer>

                            </TabItem>



                        </TabControl>

                    </Border>

                </TabItem>



                <!-- ========================================================================= -->

                <!-- [TAB 5 LỚN] TAB THƯ VIỆN: ĐỌC TRUYỆN OFFLINE (COMIC READER & LIBRARY) -->

                <!-- ========================================================================= -->

                <TabItem Header="📚 Thư viện" FontSize="12" FontWeight="Bold">

                    <views:LibraryView DataContext="{Binding LibraryVm}" />

                </TabItem>



                <!-- ========================================================================= -->

                <!-- [TAB 2 LỚN] TAB SEARCH: TÌM TRUYỆN HÀNG LOẠT (BATCH COMIC SEARCH) -->

                <!-- ========================================================================= -->

                <TabItem Header="🔍 Tìm truyện" FontSize="12" FontWeight="Bold">

                    <Border Background="#0F172A" CornerRadius="6" Padding="6,4" Margin="0,2,0,0">

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,70">

                            <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="16">

                                <Grid RowDefinitions="Auto, *, Auto">

                                    <!-- Tiêu đề lớn -->

                                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,14">

                                        <TextBlock Text="TÌM TRUYỆN HÀNG LOẠT" Foreground="#38BDF8" FontSize="16" FontWeight="ExtraBold" />

                                        <TextBlock Text="Nhập danh sách tên truyện, chọn các website nguồn cần tìm và bấm TÌM KIẾM để tra cứu hàng loạt qua Search Engine." Foreground="#94A3B8" FontSize="11" />

                                    </StackPanel>



                                    <!-- Bố cục 2 Cột chính: Cột Trái = Danh sách tên truyện, Cột Phải = Domain & Engine (Tự động thích ứng Responsive Dọc trên Android / Mobile) -->

                                    <Grid x:Name="SearchLayoutGrid" Grid.Row="1" ColumnDefinitions="*, 16, 360" MinHeight="320">

                                        <!-- CỘT TRÁI: DANH SÁCH TÊN TRUYỆN -->

                                        <Border x:Name="SearchInputBorder" Grid.Column="0" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12">

                                            <Grid RowDefinitions="Auto, *, Auto">

                                                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" VerticalAlignment="Center" Margin="0,0,0,8">

                                                    <TextBlock Grid.Column="0" Text="DANH SÁCH TÊN TRUYỆN (MỖI TRUYỆN 1 DÒNG)" Foreground="#38BDF8" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" />

                                                    <TextBlock Grid.Column="1" Text="{Binding SearchBookCountText}" Foreground="#FDE047" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />

                                                </Grid>



                                                <TextBox Grid.Row="1" Text="{Binding SearchBookNamesInput}"

                                                         AcceptsReturn="True" TextWrapping="Wrap"

                                                         PlaceholderText="Nhập hoặc dán danh sách tên truyện cần tìm (mỗi truyện một dòng)...&#x0a;Ví dụ:&#x0a;Yêu thần ký&#x0a;Võ luyện đỉnh phong&#x0a;Chainsaw Man"

                                                         Background="#070A12" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"

                                                         CornerRadius="4" FontSize="11.5" FontFamily="Consolas, Monospace"

                                                         Padding="10,8" VerticalContentAlignment="Top" MinHeight="220" />



                                                <WrapPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">

                                                    <Button Command="{Binding PasteToSearchInputCommand}"

                                                            Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" Foreground="#38BDF8" FontWeight="SemiBold"

                                                            FontSize="10.5" Padding="10,4" CornerRadius="4" Margin="0,0,8,0">

                                                        <TextBlock Text="📋 Dán Clipboard" />

                                                    </Button>

                                                    <Button Command="{Binding ClearSearchInputCommand}"

                                                            Background="#1E293B" Foreground="#EF4444" FontWeight="SemiBold"

                                                            FontSize="10.5" Padding="10,4" CornerRadius="4" Margin="0,0,8,0">

                                                        <TextBlock Text="🧹 Xóa trắng" />

                                                    </Button>

                                                </WrapPanel>

                                            </Grid>

                                        </Border>



                                        <!-- CỘT PHẢI: CHỌN DOMAIN & SEARCH ENGINE (CÓ GRID GIỮA CÁC ROW) -->

                                        <Border x:Name="SearchDomainBorder" Grid.Column="2" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12">

                                            <StackPanel Spacing="10">

                                                <!-- Header Select Domain -->

                                                <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">

                                                    <TextBlock Grid.Column="0" Text="SELECT DOMAIN" Foreground="#F59E0B" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" />

                                                    <WrapPanel Grid.Column="1" Orientation="Horizontal">

                                                        <Button Command="{Binding SelectAllSearchDomainsCommand}" Content="✓ Tất cả" Background="#1E293B" Foreground="#38BDF8" FontSize="9.5" Padding="6,2" CornerRadius="3" Margin="0,0,4,0" />

                                                        <Button Command="{Binding UnselectAllSearchDomainsCommand}" Content="✗ Bỏ chọn" Background="#1E293B" Foreground="#94A3B8" FontSize="9.5" Padding="6,2" CornerRadius="3" />

                                                    </WrapPanel>

                                                </Grid>



                                                <!-- Filter buttons category -->

                                                <WrapPanel Orientation="Horizontal">

                                                    <Button Command="{Binding SelectCategorySearchDomainsCommand}" CommandParameter="Manga" Content="Manga" Background="#1E293B" Foreground="#38BDF8" FontSize="9.5" Padding="6,2" CornerRadius="3" Margin="0,0,4,4" />

                                                    <Button Command="{Binding SelectCategorySearchDomainsCommand}" CommandParameter="Hentai" Content="Hentai" Background="#1E293B" Foreground="#EC4899" FontSize="9.5" Padding="6,2" CornerRadius="3" Margin="0,0,4,4" />

                                                    <Button Command="{Binding SelectCategorySearchDomainsCommand}" CommandParameter="Novel" Content="Novel" Background="#1E293B" Foreground="#10B981" FontSize="9.5" Padding="6,2" CornerRadius="3" Margin="0,0,0,4" />

                                                </WrapPanel>



                                                <!-- DANH SÁCH DOMAIN VỚI GRID PHÂN CÁCH TỪNG DÒNG (GRID GIỮA CÁC ROW) -->

                                                <Border Background="#070A12" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Height="170">

                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                                                        <ItemsControl ItemsSource="{Binding SearchDomains}">

                                                            <ItemsControl.ItemTemplate>

                                                                <DataTemplate>

                                                                    <!-- Row với đường line phân cách (Grid giữa các rows) -->

                                                                    <Border Background="Transparent" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="8,4">

                                                                        <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">

                                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" Margin="0,0,8,0" VerticalAlignment="Center" />

                                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                                            <Border Grid.Column="2" Background="#1E293B" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">

                                                                                <TextBlock Text="{Binding Category}" FontSize="9" Foreground="#94A3B8" FontWeight="SemiBold" />

                                                                            </Border>

                                                                        </Grid>

                                                                    </Border>

                                                                </DataTemplate>

                                                            </ItemsControl.ItemTemplate>

                                                        </ItemsControl>

                                                    </ScrollViewer>

                                                </Border>



                                                <!-- SEARCH ENGINE -->

                                                <StackPanel Spacing="4">

                                                    <TextBlock Text="SEARCH ENGINE" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" />

                                                    <ComboBox ItemsSource="{Binding SearchEngines}" SelectedItem="{Binding SelectedSearchEngine}"

                                                              Height="30" CornerRadius="4" Background="#161F30" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="11"

                                                              HorizontalAlignment="Stretch" />

                                                </StackPanel>



                                                <!-- CheckBox Open in new window -->

                                                <CheckBox IsChecked="{Binding IsSearchOpenNewWindow}" VerticalAlignment="Center">

                                                    <TextBlock Text="Open in new window (Mở cửa sổ mới)" FontSize="10.5" Foreground="#E2E8F0" FontWeight="SemiBold" />

                                                </CheckBox>



                                                <!-- Button SEARCH -->

                                                <Button Command="{Binding ExecuteBatchSearchCommand}"

                                                        Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"

                                                        Height="36" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">

                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Center">

                                                        <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" />

                                                        <TextBlock Text="SEARCH (TÌM KIẾM)" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />

                                                    </StackPanel>

                                                </Button>

                                            </StackPanel>

                                        </Border>

                                    </Grid>



                                    <!-- Status Message -->

                                    <Border Grid.Row="2" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="10,6">

                                        <TextBlock Text="{Binding SearchStatusMessage}" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />

                                    </Border>

                                </Grid>

                            </Border>

                        </ScrollViewer>

                    </Border>

                </TabItem>


            </TabControl>



            <!-- 4. FOOTER STATUS BAR (2 DÒNG ĐỘC LẬP ĐỂ KHÔNG BAO GIỜ BỊ MẤT STAT TRÊN ANDROID KHI ĐANG TẢI) -->

            <Border Grid.Row="3" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="12,5">

                <Grid RowDefinitions="Auto, Auto">

                    <!-- Hàng 0: Luôn hiển thị đầy đủ thống kê Tổng, Đang tải, Hoàn tất, Lỗi, Tốc độ 100% chiều ngang -->

                    <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">

                        <TextBlock Text="{Binding TotalBooks, StringFormat='{}Tổng: {0}'}" FontSize="10.5" Foreground="#94A3B8" FontWeight="SemiBold" Margin="0,2,10,2" VerticalAlignment="Center" />

                        <TextBlock Text="{Binding DownloadingCount, StringFormat='{}Đang tải: {0}'}" FontSize="10.5" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,2,10,2" VerticalAlignment="Center" />

                        <TextBlock Text="{Binding CompletedCount, StringFormat='{}Hoàn tất: {0}'}" FontSize="10.5" Foreground="#10B981" FontWeight="SemiBold" Margin="0,2,10,2" VerticalAlignment="Center" />

                        <TextBlock Text="{Binding ErrorCount, StringFormat='{}Lỗi: {0}'}" FontSize="10.5" Foreground="#F43F5E" FontWeight="SemiBold" Margin="0,2,10,2" VerticalAlignment="Center" />

                        <TextBlock Text="{Binding DownloadSpeedText, StringFormat='{}Tốc độ: {0}'}" FontSize="10.5" Foreground="#F59E0B" FontWeight="SemiBold" Margin="0,2,0,2" VerticalAlignment="Center" />

                    </WrapPanel>



                    <!-- Hàng 1: Background Task Status Indicator nằm ngay bên dưới để không chèn ép mất dòng Stat trên màn hình dọc Android -->

                    <Border Grid.Row="1" Background="#1E1B4B" BorderBrush="#8B5CF6" BorderThickness="1"

                            CornerRadius="5" Padding="8,3" Margin="0,4,0,0"

                            IsVisible="{Binding IsBackgroundWorking}" VerticalAlignment="Center" HorizontalAlignment="Stretch">

                        <Grid ColumnDefinitions="Auto, Auto, Auto, *, Auto, Auto" VerticalAlignment="Center">

                            <Border Grid.Column="0" Width="6" Height="6" CornerRadius="3" Background="#10B981" VerticalAlignment="Center" Margin="0,0,6,0" />

                            <TextBlock Grid.Column="1" Text="{Binding BubbleStatusTitle}" FontWeight="Bold" FontSize="10" Foreground="#F3F4F6" VerticalAlignment="Center" Margin="0,0,6,0" />

                            <TextBlock Grid.Column="2" Text="•" Foreground="#6B7280" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />

                            <TextBlock Grid.Column="3" Text="{Binding BubbleStatusDetail}" FontSize="9.5" Foreground="#94A3B8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                            <ProgressBar Grid.Column="4" Value="{Binding BubbleProgress}" Minimum="0" Maximum="100" Width="60" Height="6" CornerRadius="3" Foreground="#8B5CF6" Background="#0F172A" VerticalAlignment="Center" Margin="0,0,6,0" />

                            <TextBlock Grid.Column="5" Text="{Binding BubbleProgressText}" FontSize="9.5" Foreground="#A78BFA" FontWeight="Bold" VerticalAlignment="Center" />

                        </Grid>

                    </Border>

                </Grid>

            </Border>

        </Grid>

    </ScrollViewer>



        <!-- 5. MODAL POPUP: MANGADEX LANGUAGE SELECTION DIALOG -->

        <Border Background="#CC000000" IsVisible="{Binding IsMangadexPromptVisible}" ZIndex="999" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

            <Border Background="#111827" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="10" 

                    Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" MaxWidth="450"

                    BoxShadow="0 10 25 #80000000">

                <StackPanel Spacing="14">

                    <!-- Title Header -->

                    <StackPanel Orientation="Horizontal" Spacing="8">

                        <Border Background="#38BDF8" CornerRadius="4" Width="24" Height="24">

                            <TextBlock Text="🌐" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <TextBlock Text="MangaDex - Chọn Ngôn Ngữ Tải" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" VerticalAlignment="Center" />

                    </StackPanel>



                    <TextBlock Text="Phát hiện liên kết MangaDex. Vui lòng chọn ngôn ngữ bản dịch của các chương bạn muốn tải về:" 

                               Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />



                    <!-- Options -->

                    <Border Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,10">

                        <StackPanel Spacing="10">

                            <!-- Tiếng Việt -->

                            <Button Command="{Binding SelectMangadexViCommand}" Background="Transparent" Padding="0" Cursor="Hand" HorizontalAlignment="Stretch">

                                <Grid ColumnDefinitions="Auto, *">

                                    <RadioButton Grid.Column="0" IsChecked="{Binding MangadexLangVi}" GroupName="mdLang" IsHitTestVisible="False" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">

                                        <TextBlock Text="🇻🇳 Tiếng Việt (Vietnamese)" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" />

                                        <TextBlock Text="Ưu tiên tải các chương truyện bản dịch tiếng Việt" FontSize="10" Foreground="#64748B" />

                                    </StackPanel>

                                </Grid>

                            </Button>



                            <Border Height="1" Background="#1E293B" />



                            <!-- Tiếng Anh -->

                            <Button Command="{Binding SelectMangadexEnCommand}" Background="Transparent" Padding="0" Cursor="Hand" HorizontalAlignment="Stretch">

                                <Grid ColumnDefinitions="Auto, *">

                                    <RadioButton Grid.Column="0" IsChecked="{Binding MangadexLangEn}" GroupName="mdLang" IsHitTestVisible="False" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">

                                        <TextBlock Text="🇬🇧 Tiếng Anh (English)" FontWeight="Bold" FontSize="12" Foreground="#F59E0B" />

                                        <TextBlock Text="Ưu tiên tải các chương truyện bản dịch tiếng Anh" FontSize="10" Foreground="#64748B" />

                                    </StackPanel>

                                </Grid>

                            </Button>

                        </StackPanel>

                    </Border>



                    <!-- Fallback Option -->

                    <CheckBox IsChecked="{Binding MangadexFallback}" Margin="2,0,0,0">

                        <TextBlock Text="Tự động tải ngôn ngữ còn lại nếu không có bản dịch đã chọn" FontSize="10.5" Foreground="#CBD5E1" TextWrapping="Wrap" />

                    </CheckBox>



                    <!-- Action Buttons -->

                    <Grid ColumnDefinitions="*, *" Margin="0,6,0,0">

                        <Button Grid.Column="0" Command="{Binding CancelMangadexLanguageCommand}" 

                                Background="#1E293B" BorderBrush="#334155" BorderThickness="1" 

                                Foreground="#94A3B8" Padding="12,7" CornerRadius="6" HorizontalAlignment="Stretch" Margin="0,0,6,0">

                            <TextBlock Text="❌ HỦY BỎ" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />

                        </Button>



                        <Button Grid.Column="1" Command="{Binding ConfirmMangadexLanguageCommand}" 

                                Background="#0284C7" BorderBrush="#38BDF8" BorderThickness="1" 

                                Foreground="#FFFFFF" Padding="12,7" CornerRadius="6" HorizontalAlignment="Stretch" Margin="6,0,0,0">

                            <TextBlock Text="✅ XÁC NHẬN" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />

                        </Button>

                    </Grid>

                </StackPanel>

            </Border>

        </Border>



        <!-- 6. MODAL POPUP: TOÀN MÀN HÌNH ĐỐI CHIẾU ẢNH BEFORE / AFTER (FASTSTONE CONVERSION PREVIEW) -->

        <Border Background="#F20B0F19" IsVisible="{Binding IsEnhanceFullscreenVisible}" ZIndex="1000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

            <Panel>

                <!-- NÚT ĐÓNG NỔI TO RÕ LUÔN NẰM TRÊN CÙNG GÓC PHẢI (CHỐNG KẸT TRÊN ANDROID / MOBILE) -->

                <Button Command="{Binding CloseFullscreenPreviewCommand}"

                        ZIndex="3000" HorizontalAlignment="Right" VerticalAlignment="Top"

                        Margin="10" MinWidth="44" MinHeight="44" CornerRadius="22"

                        Background="#DC2626" Foreground="#FFFFFF"

                        FontWeight="ExtraBold" FontSize="18"

                        ToolTip.Tip="Đóng chế độ đối chiếu toàn màn hình (Esc)">

                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,0">

                        <TextBlock Text="✕" FontWeight="ExtraBold" FontSize="16" VerticalAlignment="Center" />

                        <TextBlock Text="ĐÓNG" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />

                    </StackPanel>

                </Button>



                <Grid RowDefinitions="Auto, Auto, Auto, *">

                    <!-- ROW 0: Header Toolbar (FastStone Style) -->

                    <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="6,4">

                        <Grid ColumnDefinitions="Auto, Auto, *, Auto">

                            <!-- Cột 0: Title -->

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">

                                <Border Background="#38BDF8" CornerRadius="4" Width="26" Height="26">

                                    <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                </Border>

                                <TextBlock Text="CONVERSION PREVIEW (TOÀN MÀN HÌNH)" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" VerticalAlignment="Center" />

                            </StackPanel>



                            <!-- Cột 1: Navigation Previous / Next to rõ cho Android & Desktop -->

                            <Border Grid.Column="1" Background="#1E293B" CornerRadius="5" Padding="4,2" Margin="0,0,12,0" VerticalAlignment="Center">

                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                    <Button Command="{Binding PreviousImageCommand}" IsEnabled="{Binding CanGoPrevious}"

                                            Background="#0F172A" Foreground="#38BDF8" FontWeight="Bold" Padding="10,5" Height="32" CornerRadius="3" ToolTip.Tip="Ảnh trước (◀)">

                                        <StackPanel Orientation="Horizontal" Spacing="4">

                                            <TextBlock Text="◀" FontSize="10" VerticalAlignment="Center" />

                                            <TextBlock Text="Trước" FontSize="11" VerticalAlignment="Center" />

                                        </StackPanel>

                                    </Button>

                                    <Border Background="#0B0F19" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="3" Padding="8,4" Height="32" VerticalAlignment="Center">

                                        <TextBlock Text="{Binding EnhanceImageCounterText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" TextAlignment="Center" />

                                    </Border>

                                    <Button Command="{Binding NextImageCommand}" IsEnabled="{Binding CanGoNext}"

                                            Background="#0F172A" Foreground="#38BDF8" FontWeight="Bold" Padding="10,5" Height="32" CornerRadius="3" ToolTip.Tip="Ảnh tiếp theo (▶)">

                                        <StackPanel Orientation="Horizontal" Spacing="4">

                                            <TextBlock Text="Sau" FontSize="11" VerticalAlignment="Center" />

                                            <TextBlock Text="▶" FontSize="10" VerticalAlignment="Center" />

                                        </StackPanel>

                                    </Button>

                                    <TextBlock Text="{Binding EnhanceImageFileNameText}" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding EnhanceImageFileNameText}" Margin="4,0,0,0" />

                                </StackPanel>

                            </Border>



                            <!-- Cột 2: Đảo vị trí & Focus & Bộ Zoom FastStone -->

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" VerticalAlignment="Center">

                                <!-- Nút Đảo vị trí Before ⇄ After & Chế độ Focus -->

                                <Border Background="#1E293B" CornerRadius="5" Padding="3" VerticalAlignment="Center">

                                <StackPanel Orientation="Horizontal" Spacing="4">

                                    <Button Command="{Binding SwapDualOrderCommand}"

                                            Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="8,4" CornerRadius="3"

                                            ToolTip.Tip="Đổi vị trí hiển thị giữa Ảnh gốc và Ảnh đã xử lý (Before ⇄ After)">

                                        <TextBlock Text="{Binding SwapDualOrderButtonText}" FontSize="11" VerticalAlignment="Center" />

                                    </Button>

                                    <Button Command="{Binding ToggleImmersiveDualFocusCommand}"

                                            Background="#7C3AED" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="8,4" CornerRadius="3"

                                            ToolTip.Tip="Ẩn / Hiện thanh công cụ Sliders để tập trung soi ảnh tối đa diện tích màn hình">

                                        <TextBlock Text="{Binding ImmersiveFocusButtonText}" FontSize="11" VerticalAlignment="Center" />

                                    </Button>

                                </StackPanel>

                            </Border>



                            <!-- Bộ công cụ Zoom -->

                            <Border Background="#1E293B" CornerRadius="5" Padding="4,2" VerticalAlignment="Center">

                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                                    <Button Command="{Binding ResetZoomPreviewCommand}" Content="1:1" Background="#0F172A" Foreground="#10B981" FontWeight="Bold" Padding="8,5" FontSize="11" CornerRadius="3" ToolTip.Tip="Kích thước thực 100%" />

                                    <Button Command="{Binding ZoomFitPreviewCommand}" Content="⛶ Vừa khung" Background="#0F172A" Foreground="#F59E0B" FontWeight="Bold" Padding="8,5" FontSize="11" CornerRadius="3" ToolTip.Tip="Tự co vừa cửa sổ" />

                                    <Button Command="{Binding ZoomOutPreviewCommand}" Content="➖" Background="#0F172A" Foreground="#94A3B8" Padding="8,4" FontSize="13" FontWeight="Bold" CornerRadius="3" ToolTip.Tip="Thu nhỏ" />

                                    <NumericUpDown Value="{Binding EnhancePreviewZoomPercent}" Minimum="10" Maximum="1000" Increment="25" FormatString="0'%'" Width="110" Height="30" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Background="#0F172A" CornerRadius="3" ParsingNumberStyle="Integer" HorizontalContentAlignment="Center" ToolTip.Tip="Tỷ lệ phóng to % (Nhập số trực tiếp)" />

                                    <Button Command="{Binding ZoomInPreviewCommand}" Content="➕" Background="#0F172A" Foreground="#38BDF8" Padding="8,4" FontSize="13" FontWeight="Bold" CornerRadius="3" ToolTip.Tip="Phóng to" />

                                </StackPanel>

                            </Border>

                        </StackPanel>



                        <!-- Cột 3: Đổi ảnh mẫu, Cửa sổ riêng & Đóng -->

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                            <Button Command="{Binding OpenComparisonWindowCommand}" IsVisible="{Binding IsDesktopLifetime}" Background="#7C3AED" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="10,6" CornerRadius="4" ToolTip.Tip="Mở cửa sổ đối chiếu độc lập phong cách FastStone">

                                <TextBlock Text="🗖 Cửa sổ riêng" />

                            </Button>

                            <Button Command="{Binding PickSampleImageCommand}" Background="#4F46E5" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="10,6" CornerRadius="4">

                                <TextBlock Text="🖼️ Đổi ảnh mẫu" />

                            </Button>

                            <Button Command="{Binding CloseFullscreenPreviewCommand}" Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="12,6" CornerRadius="4">

                                <TextBlock Text="✕ ĐÓNG" />

                            </Button>

                        </StackPanel>

                    </Grid>

                </Border>



                <!-- ROW 1: FastStone Info Bar (Dung lượng Before/After & Presets) -->

                <Border Grid.Row="1" Background="#0E1626" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="12,6" IsVisible="{Binding !IsImmersiveDualFocus}">

                    <Grid ColumnDefinitions="Auto, *, Auto">

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

                            <Border Background="#1E293B" CornerRadius="4" Padding="8,3">

                                <TextBlock Text="{Binding EnhanceBeforeInfoText}" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11" />

                            </Border>

                            <Border Background="#0C4A6E" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="4" Padding="8,3">

                                <TextBlock Text="{Binding EnhanceAfterInfoText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" />

                            </Border>

                            <Border Background="#1E293B" CornerRadius="4" Padding="8,3">

                                <TextBlock Text="{Binding EnhanceClippingInfoText}" Foreground="#FCD34D" FontWeight="Bold" FontSize="11" />

                            </Border>

                        </StackPanel>



                        <!-- One-Click Presets -->

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                            <TextBlock Text="⚡ Presets truyện:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />

                            <Button Command="{Binding ApplyPresetDefaultCommand}" Content="🔘 Mặc định" Background="#1E293B" Foreground="#E2E8F0" FontSize="10" Padding="8,4" CornerRadius="4" ToolTip.Tip="Khôi phục thông số gốc" />

                            <Button Command="{Binding ApplyPresetOldScanCommand}" Content="📜 Khử ố scan" Background="#854D0E" Foreground="#FEF08A" FontWeight="Bold" FontSize="10" Padding="8,4" CornerRadius="4" ToolTip.Tip="Tăng sáng nền, tương phản mạnh khử vàng giấy cũ" />

                            <Button Command="{Binding ApplyPresetWebtoonCommand}" Content="🎨 Webtoon rực rỡ" Background="#831843" Foreground="#FBCFE8" FontWeight="Bold" FontSize="10" Padding="8,4" CornerRadius="4" ToolTip.Tip="Tăng bão hòa màu và độ sắc nét viền vẽ truyện tranh màu" />

                            <Button Command="{Binding ApplyPresetNightCommand}" Content="🌙 Đọc đêm dịu mắt" Background="#1E1B4B" Foreground="#C7D2FE" FontWeight="Bold" FontSize="10" Padding="8,4" CornerRadius="4" ToolTip.Tip="Hạ sáng nền, tăng nét chữ giúp đỡ mỏi mắt" />

                        </StackPanel>

                    </Grid>

                </Border>



                                <!-- ROW 2: Sliders Toolbar & 3 Custom Presets (Chuẩn bố cục XnConvert: Slider ngang mỏng, NumericUpDown 3-digit nhỏ gọn, Nút Reset riêng ↺) -->

                <Border Grid.Row="2" Background="#161F30" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="8,3" IsVisible="{Binding !IsImmersiveDualFocus}">

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">

                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <WrapPanel.Resources>

                                <x:Double x:Key="SliderHorizontalThumbWidth">8</x:Double>

                                <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>

                                <x:Double x:Key="SliderHorizontalTrackHeight">3</x:Double>

                            </WrapPanel.Resources>

                            <WrapPanel.Styles>

                                <!-- Slider phong cách XnConvert: Thanh mỏng, con trỏ hình chữ nhật nhỏ xám sang trọng -->

                                <Style Selector="Slider">

                                    <Setter Property="Height" Value="18" />

                                    <Setter Property="MinHeight" Value="18" />

                                    <Setter Property="VerticalAlignment" Value="Center" />

                                    <Setter Property="Margin" Value="4,0,6,0" />

                                </Style>

                                <Style Selector="Slider:horizontal Thumb">

                                    <Setter Property="Width" Value="8" />

                                    <Setter Property="Height" Value="14" />

                                    <Setter Property="MinWidth" Value="8" />

                                    <Setter Property="MinHeight" Value="14" />

                                    <Setter Property="CornerRadius" Value="2" />

                                    <Setter Property="Background" Value="#64748B" />

                                    <Setter Property="BorderBrush" Value="#475569" />

                                    <Setter Property="BorderThickness" Value="1" />

                                </Style>

                                <Style Selector="Slider:horizontal:pointerover Thumb">

                                    <Setter Property="Background" Value="#94A3B8" />

                                    <Setter Property="BorderBrush" Value="#CBD5E1" />

                                </Style>

                                <Style Selector="Slider:horizontal:pressed Thumb">

                                    <Setter Property="Background" Value="#38BDF8" />

                                </Style>

                                <Style Selector="Slider:horizontal Track#PART_Track">

                                    <Setter Property="MinHeight" Value="3" />

                                </Style>



                                <!-- NumericUpDown phong cách XnConvert: Số hiển thị rõ nét căn phải, 2 nút mũi tên dọc mép phải, không bị che khuất -->

                                <Style Selector="NumericUpDown">

                                    <Setter Property="Height" Value="22" />

                                    <Setter Property="MinHeight" Value="22" />

                                    <Setter Property="Width" Value="52" />

                                    <Setter Property="Padding" Value="0" />

                                    <Setter Property="FontSize" Value="11" />

                                    <Setter Property="CornerRadius" Value="3" />

                                    <Setter Property="BorderThickness" Value="1" />

                                    <Setter Property="BorderBrush" Value="#334155" />

                                    <Setter Property="Background" Value="#0B0F19" />

                                    <Setter Property="Foreground" Value="#F8FAFC" />

                                    <Setter Property="VerticalContentAlignment" Value="Center" />

                                    <Setter Property="HorizontalContentAlignment" Value="Right" />

                                </Style>

                                <Style Selector="NumericUpDown:pointerover">

                                    <Setter Property="BorderBrush" Value="#38BDF8" />

                                </Style>

                                <Style Selector="NumericUpDown:focus-within">

                                    <Setter Property="BorderBrush" Value="#38BDF8" />

                                    <Setter Property="Background" Value="#0B0F19" />

                                </Style>

                                <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">

                                    <Setter Property="Height" Value="20" />

                                    <Setter Property="MinHeight" Value="18" />

                                    <Setter Property="Padding" Value="3,0,1,0" />

                                    <Setter Property="FontSize" Value="11" />

                                    <Setter Property="Background" Value="Transparent" />

                                    <Setter Property="BorderThickness" Value="0" />

                                    <Setter Property="Foreground" Value="#F8FAFC" />

                                    <Setter Property="VerticalContentAlignment" Value="Center" />

                                    <Setter Property="HorizontalContentAlignment" Value="Right" />

                                </Style>

                                <Style Selector="ButtonSpinner#PART_Spinner">

                                    <Setter Property="Background" Value="Transparent" />

                                    <Setter Property="BorderThickness" Value="0" />

                                    <Setter Property="Padding" Value="0" />

                                    <Setter Property="Margin" Value="0" />

                                </Style>

                                <Style Selector="ButtonSpinner">

                                    <Setter Property="Background" Value="Transparent" />

                                    <Setter Property="BorderThickness" Value="0" />

                                    <Setter Property="Padding" Value="0" />

                                    <Setter Property="Template">

                                        <ControlTemplate TargetType="ButtonSpinner">

                                            <Border Background="{TemplateBinding Background}"

                                                    BorderBrush="{TemplateBinding BorderBrush}"

                                                    BorderThickness="{TemplateBinding BorderThickness}"

                                                    CornerRadius="{TemplateBinding CornerRadius}">

                                                <Grid ColumnDefinitions="*, 14">

                                                    <ContentPresenter Name="PART_ContentPresenter"

                                                                      Grid.Column="0"

                                                                      Content="{TemplateBinding Content}"

                                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"

                                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"

                                                                      Padding="{TemplateBinding Padding}" />

                                                    <Grid Grid.Column="1" RowDefinitions="*,*" Width="14" Margin="0" VerticalAlignment="Stretch">

                                                        <RepeatButton Name="PART_IncreaseButton"

                                                                      Grid.Row="0" Width="14" Padding="0" Margin="0,0,0,0.5"

                                                                      BorderThickness="0" Background="#1E293B" Foreground="#94A3B8"

                                                                      CornerRadius="0,2,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"

                                                                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center">

                                                            <Path Data="M 0 3.5 L 3 0.5 L 6 3.5 Z" Fill="#94A3B8" Width="6" Height="3.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                        </RepeatButton>

                                                        <RepeatButton Name="PART_DecreaseButton"

                                                                      Grid.Row="1" Width="14" Padding="0" Margin="0,0.5,0,0"

                                                                      BorderThickness="0" Background="#1E293B" Foreground="#94A3B8"

                                                                      CornerRadius="0,0,2,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"

                                                                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center">

                                                            <Path Data="M 0 0.5 L 3 3.5 L 6 0.5 Z" Fill="#94A3B8" Width="6" Height="3.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                        </RepeatButton>

                                                    </Grid>

                                                </Grid>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter>

                                </Style>

                                <Style Selector="ButtonSpinner /template/ RepeatButton:pointerover">

                                    <Setter Property="Background" Value="#334155" />

                                </Style>

                                <Style Selector="ButtonSpinner /template/ RepeatButton:pointerover Path">

                                    <Setter Property="Fill" Value="#38BDF8" />

                                </Style>

                                <Style Selector="ButtonSpinner /template/ RepeatButton:pressed">

                                    <Setter Property="Background" Value="#0284C7" />

                                </Style>

                                <Style Selector="ButtonSpinner /template/ RepeatButton:pressed Path">

                                    <Setter Property="Fill" Value="#FFFFFF" />

                                </Style>

                            </WrapPanel.Styles>



                            <!-- Contrast -->

                            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,4" VerticalAlignment="Center">

                                <Grid ColumnDefinitions="Auto, 100, 22, 52" VerticalAlignment="Center">

                                    <TextBlock Grid.Column="0" Text="Tương phản:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />

                                    <Slider Grid.Column="1" Value="{Binding EnhanceContrast}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" />

                                    <Button Grid.Column="2" Command="{Binding ResetContrastCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Tương phản về mặc định (0)" Margin="2,0,2,0">

                                        <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />

                                    </Button>

                                    <NumericUpDown Grid.Column="3" Value="{Binding EnhanceContrast}" Minimum="-100" Maximum="100" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ToolTip.Tip="Tương phản (-100 đến 100)" />

                                </Grid>

                            </Border>



                            <!-- Brightness -->

                            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,4" VerticalAlignment="Center">

                                <Grid ColumnDefinitions="Auto, 100, 22, 52" VerticalAlignment="Center">

                                    <TextBlock Grid.Column="0" Text="Độ sáng:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />

                                    <Slider Grid.Column="1" Value="{Binding EnhanceBrightness}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" />

                                    <Button Grid.Column="2" Command="{Binding ResetBrightnessCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Độ sáng về mặc định (0)" Margin="2,0,2,0">

                                        <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />

                                    </Button>

                                    <NumericUpDown Grid.Column="3" Value="{Binding EnhanceBrightness}" Minimum="-100" Maximum="100" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ToolTip.Tip="Độ sáng (-100 đến 100)" />

                                </Grid>

                            </Border>



                            <!-- Saturation -->

                            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,4" VerticalAlignment="Center">

                                <Grid ColumnDefinitions="Auto, 100, 22, 52" VerticalAlignment="Center">

                                    <TextBlock Grid.Column="0" Text="Bão hòa:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />

                                    <Slider Grid.Column="1" Value="{Binding EnhanceSaturation}" Minimum="0" Maximum="200" SmallChange="1" LargeChange="10" />

                                    <Button Grid.Column="2" Command="{Binding ResetSaturationCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Bão hòa về mặc định (100%)" Margin="2,0,2,0">

                                        <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />

                                    </Button>

                                    <NumericUpDown Grid.Column="3" Value="{Binding EnhanceSaturation}" Minimum="0" Maximum="200" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ToolTip.Tip="Bão hòa màu (0 đến 200%)" />

                                </Grid>

                            </Border>



                            <!-- Sharpness -->

                            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,4" VerticalAlignment="Center">

                                <Grid ColumnDefinitions="Auto, 100, 22, 52" VerticalAlignment="Center">

                                    <TextBlock Grid.Column="0" Text="Độ nét:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />

                                    <Slider Grid.Column="1" Value="{Binding EnhanceSharpness}" Minimum="0" Maximum="10" SmallChange="0.5" LargeChange="1" />

                                    <Button Grid.Column="2" Command="{Binding ResetSharpnessCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Độ nét về mặc định (0.0)" Margin="2,0,2,0">

                                        <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />

                                    </Button>

                                    <NumericUpDown Grid.Column="3" Value="{Binding EnhanceSharpness}" Minimum="0" Maximum="10" Increment="0.5" FormatString="0.0" ToolTip.Tip="Độ nét (0.0 đến 10.0)" />

                                </Grid>

                            </Border>



                            <!-- Noise Reduce -->

                            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,4" VerticalAlignment="Center">

                                <Grid ColumnDefinitions="Auto, 100, 22, 52" VerticalAlignment="Center">

                                    <TextBlock Grid.Column="0" Text="Khử nhiễu:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />

                                    <Slider Grid.Column="1" Value="{Binding EnhanceNoiseReduce}" Minimum="0" Maximum="5" SmallChange="1" LargeChange="1" />

                                    <Button Grid.Column="2" Command="{Binding ResetNoiseReduceCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Khử nhiễu về mặc định (0)" Margin="2,0,2,0">

                                        <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />

                                    </Button>

                                    <NumericUpDown Grid.Column="3" Value="{Binding EnhanceNoiseReduce}" Minimum="0" Maximum="5" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ToolTip.Tip="Khử nhiễu (0 đến 5)" />

                                </Grid>

                            </Border>



                            <!-- 3 Custom Presets -->

                            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="0,0,4,4" VerticalAlignment="Center">

                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <TextBlock Text="💾 Presets:" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />

                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,4,2">

                                        <TextBox Text="{Binding UserPreset1Name}" Width="85" Height="24" FontSize="10" Padding="5,2" VerticalAlignment="Center" Background="#1E293B" Foreground="#E2E8F0" CornerRadius="3" ToolTip.Tip="Tên Preset 1" />

                                        <Button Command="{Binding SaveUserPreset1Command}" Content="💾" Background="#0284C7" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="24" CornerRadius="3" ToolTip.Tip="Lưu vào Preset 1" />

                                        <Button Command="{Binding LoadUserPreset1Command}" Content="📂" Background="#0D9488" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="24" CornerRadius="3" ToolTip.Tip="Tải Preset 1" />

                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,4,2">

                                        <TextBox Text="{Binding UserPreset2Name}" Width="85" Height="24" FontSize="10" Padding="5,2" VerticalAlignment="Center" Background="#1E293B" Foreground="#E2E8F0" CornerRadius="3" ToolTip.Tip="Tên Preset 2" />

                                        <Button Command="{Binding SaveUserPreset2Command}" Content="💾" Background="#0284C7" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="24" CornerRadius="3" ToolTip.Tip="Lưu vào Preset 2" />

                                        <Button Command="{Binding LoadUserPreset2Command}" Content="📂" Background="#0D9488" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="24" CornerRadius="3" ToolTip.Tip="Tải Preset 2" />

                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,0,2">

                                        <TextBox Text="{Binding UserPreset3Name}" Width="85" Height="24" FontSize="10" Padding="5,2" VerticalAlignment="Center" Background="#1E293B" Foreground="#E2E8F0" CornerRadius="3" ToolTip.Tip="Tên Preset 3" />

                                        <Button Command="{Binding SaveUserPreset3Command}" Content="💾" Background="#0284C7" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="24" CornerRadius="3" ToolTip.Tip="Lưu vào Preset 3" />

                                        <Button Command="{Binding LoadUserPreset3Command}" Content="📂" Background="#0D9488" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="24" CornerRadius="3" ToolTip.Tip="Tải Preset 3" />

                                    </StackPanel>

                                </WrapPanel>

                            </Border>



                            <Button Command="{Binding ResetEnhanceSettingsCommand}" Background="#1E293B" Foreground="#94A3B8" FontSize="9" Padding="6,3" Height="26" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,0,4">

                                <TextBlock Text="🔄 Đặt lại" VerticalAlignment="Center" />

                            </Button>

                        </WrapPanel>

                    </ScrollViewer>

                </Border>



                <!-- ROW 3: Vùng hiển thị đối chiếu 2 ảnh song song (Locked-step ComicScreen Pan & Zoom) -->

                <Panel Grid.Row="3" Margin="6">

                    <!-- Nút chuyển ảnh trước nổi mép trái (To rõ cho Android) -->

                    <Button Command="{Binding PreviousImageCommand}" IsEnabled="{Binding CanGoPrevious}"

                            ZIndex="1500" HorizontalAlignment="Left" VerticalAlignment="Center"

                            Margin="8,0,0,0" Width="44" Height="60" CornerRadius="8"

                            Background="#B30F172A" BorderBrush="#38BDF8" BorderThickness="1"

                            Foreground="#38BDF8" FontWeight="Bold" FontSize="20"

                            ToolTip.Tip="Ảnh trước (◀)">

                        <TextBlock Text="❮" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    </Button>



                    <!-- Nút chuyển ảnh sau nổi mép phải (To rõ cho Android) -->

                    <Button Command="{Binding NextImageCommand}" IsEnabled="{Binding CanGoNext}"

                            ZIndex="1500" HorizontalAlignment="Right" VerticalAlignment="Center"

                            Margin="0,0,8,0" Width="44" Height="60" CornerRadius="8"

                            Background="#B30F172A" BorderBrush="#38BDF8" BorderThickness="1"

                            Foreground="#38BDF8" FontWeight="Bold" FontSize="20"

                            ToolTip.Tip="Ảnh tiếp theo (▶)">

                        <TextBlock Text="❯" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    </Button>



                    <!-- DUAL VIEW: Tự động responsive Portrait (2 hàng) / Landscape (2 cột) & Hỗ trợ hoán đổi Before / After tức thì -->

                    <UniformGrid Columns="{Binding EnhanceDualColumns}" Rows="{Binding EnhanceDualRows}">

                        <!-- Panel 1 (Ảnh Thứ Nhất) -->

                        <Border Background="#090D16" BorderBrush="{Binding FirstDualBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4" Margin="2">

                            <Grid RowDefinitions="Auto, *">

                                <Border Grid.Row="0" Background="{Binding FirstDualBadgeBg}" CornerRadius="3" Padding="6,3" HorizontalAlignment="Left" Margin="0,0,0,4">

                                    <TextBlock Text="{Binding FirstDualBadgeTitle}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" />

                                </Border>

                                <ScrollViewer x:Name="ModalBeforeScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False" IsScrollInertiaEnabled="True" Background="#050811" CornerRadius="4">

                                    <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">

                                        <LayoutTransformControl.LayoutTransform>

                                            <ScaleTransform ScaleX="{Binding EnhancePreviewZoom}" ScaleY="{Binding EnhancePreviewZoom}" />

                                        </LayoutTransformControl.LayoutTransform>

                                        <Image Source="{Binding FirstDualImage}" Width="{Binding EnhanceImagePixelWidth}" Height="{Binding EnhanceImagePixelHeight}" Stretch="Fill" />

                                    </LayoutTransformControl>

                                </ScrollViewer>

                            </Grid>

                        </Border>



                        <!-- Panel 2 (Ảnh Thứ Hai) -->

                        <Border Background="#090D16" BorderBrush="{Binding SecondDualBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4" Margin="2">

                            <Grid RowDefinitions="Auto, *">

                                <Border Grid.Row="0" Background="{Binding SecondDualBadgeBg}" CornerRadius="3" Padding="6,3" HorizontalAlignment="Left" Margin="0,0,0,4">

                                    <TextBlock Text="{Binding SecondDualBadgeTitle}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" />

                                </Border>

                                <ScrollViewer x:Name="ModalAfterScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False" IsScrollInertiaEnabled="True" Background="#050811" CornerRadius="4">

                                    <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">

                                        <LayoutTransformControl.LayoutTransform>

                                            <ScaleTransform ScaleX="{Binding EnhancePreviewZoom}" ScaleY="{Binding EnhancePreviewZoom}" />

                                        </LayoutTransformControl.LayoutTransform>

                                        <Image Source="{Binding SecondDualImage}" Width="{Binding EnhanceImagePixelWidth}" Height="{Binding EnhanceImagePixelHeight}" Stretch="Fill" />

                                    </LayoutTransformControl>

                                </ScrollViewer>

                            </Grid>

                        </Border>

                    </UniformGrid>

                </Panel>

            </Grid>

            </Panel>

        </Border>



        <!-- FLOATING QUICK CONTROL BAR (DỌC, MOVEABLE/DRAGGABLE KÉO THẢ TỰ DO ĐỔI VỊ TRÍ, TÔNG CYAN/BLUE) -->

        <Border x:Name="FloatingQuickControlBorder"

                IsVisible="{Binding IsFloatingQuickControlVisible}"

                HorizontalAlignment="Right" VerticalAlignment="Bottom"

                Margin="0,0,24,45" CornerRadius="16"

                Background="#F00B132B" BorderBrush="#38BDF8" BorderThickness="1.5"

                Padding="4,5" ZIndex="1200" IsHitTestVisible="True"

                BoxShadow="0 8 24 0 #90000000">

            <Border.RenderTransform>

                <TranslateTransform X="0" Y="0" />

            </Border.RenderTransform>

            <StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Center">

                <!-- Thanh Grip kéo thả di chuyển vị trí (Move Handle) -->

                <Border x:Name="FloatingGripBar"

                        Background="#1E293B" CornerRadius="8"

                        Width="44" Height="14" Margin="0,1,0,2"

                        Cursor="SizeAll"

                        ToolTip.Tip="Chạm giữ &amp; kéo để di chuyển. Chạm nhẹ để thu nhỏ/mở rộng cụm nút nổi này">

                    <TextBlock Text="⋮⋮⋮" Foreground="#38BDF8" FontSize="9" FontWeight="Bold"

                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />

                </Border>



                <!-- Cụm thao tác Tải / Dừng / Tạm dừng (Ẩn khi thu nhỏ, chỉ hiện khi mở rộng) -->

                <StackPanel x:Name="FloatingActionPanel" Orientation="Vertical" Spacing="4" HorizontalAlignment="Center">

                    <!-- Thao tác Dán Link & Tự dán trên thanh Quick Float Button (Đồng bộ 2 chiều với thanh chính) -->
                    <Button Command="{Binding PasteLinkCommand}"
                            Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1"
                            Foreground="#38BDF8" FontWeight="Bold"
                            CornerRadius="12" Padding="4,4" Width="74" Height="28"
                            ToolTip.Tip="Dán link truyện từ Clipboard">
                        <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📋" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Text="DÁN LINK" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <CheckBox IsChecked="{Binding IsAutoPasteClipboard}"
                              HorizontalAlignment="Center" Margin="0,1,0,3"
                              ToolTip.Tip="Tự động theo dõi Clipboard: mỗi khi copy link truyện sẽ tự động nạp">
                        <TextBlock Text="⚡ Tự dán" FontSize="9.5" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </CheckBox>

                    <Border Height="1" Width="50" Background="#334155" HorizontalAlignment="Center" Margin="0,1,0,3" />

                    <!-- Nút Chọn / Hủy chọn dải truyện theo Part (Start & End Part) trên Quick Float Button -->
                    <Button Command="{Binding ToggleQueueBatchSelectModeCommand}"
                            Background="{Binding QueueBatchButtonBg}" Foreground="{Binding QueueBatchButtonFg}"
                            BorderBrush="{Binding QueueBatchButtonBorder}" BorderThickness="1"
                            FontWeight="Bold" CornerRadius="12" Padding="2,3" Width="74" Height="28"
                            ToolTip.Tip="Chọn / Hủy chọn dải nhiều truyện theo Part (Bấm Start -> Chạm truyện Đầu -> Chạm truyện Cuối)">
                        <TextBlock Text="{Binding QueueBatchButtonText}" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <Border Height="1" Width="50" Background="#334155" HorizontalAlignment="Center" Margin="0,1,0,3" />

                    <!-- 1. Toggle Button Tải / Dừng tải -->

                    <Button Command="{Binding DownloadAllCommand}" IsVisible="{Binding !IsDownloading}"

                            Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold"

                            CornerRadius="12" Padding="6,4" Width="74" Height="28"

                            ToolTip.Tip="Bắt đầu tải toàn bộ danh sách truyện (Tải)">

                        <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <TextBlock Text="⬇️" FontSize="11" VerticalAlignment="Center" />

                            <TextBlock Text="TẢI" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />

                        </StackPanel>

                    </Button>

                    <Button Command="{Binding StopCommand}" IsVisible="{Binding IsDownloading}"

                            Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold"

                            CornerRadius="12" Padding="6,4" Width="74" Height="28"

                            ToolTip.Tip="Dừng tiến trình tải truyện (Dừng)">

                        <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <TextBlock Text="⏹️" FontSize="11" VerticalAlignment="Center" />

                            <TextBlock Text="DỪNG" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />

                        </StackPanel>

                    </Button>



                    <!-- 2. Toggle Button Pause / Resume -->

                    <Button Command="{Binding TogglePauseCommand}" IsVisible="{Binding !IsPaused}"

                            Background="#D97706" Foreground="#FFFFFF" FontWeight="SemiBold"

                            CornerRadius="12" Padding="4,4" Width="74" Height="28"

                            ToolTip.Tip="Tạm dừng tiến trình tải truyện">

                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <TextBlock Text="⏸️" FontSize="10" VerticalAlignment="Center" />

                            <TextBlock Text="T.DỪNG" FontSize="9.5" VerticalAlignment="Center" />

                        </StackPanel>

                    </Button>

                    <Button Command="{Binding TogglePauseCommand}" IsVisible="{Binding IsPaused}"

                            Background="#059669" Foreground="#FFFFFF" FontWeight="Bold"

                            CornerRadius="12" Padding="4,4" Width="74" Height="28"

                            ToolTip.Tip="Tiếp tục tiến trình tải truyện">

                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <TextBlock Text="▶️" FontSize="10" VerticalAlignment="Center" />

                            <TextBlock Text="TIẾP TỤC" FontSize="9.5" VerticalAlignment="Center" />

                        </StackPanel>

                    </Button>



                    <Border Height="1" Width="50" Background="#334155" HorizontalAlignment="Center" Margin="0,1" />

                </StackPanel>



                <!-- Cụm nút Cuộn Top / Bot (Luôn hiển thị kể cả khi thu nhỏ theo yêu cầu người dùng) -->

                <StackPanel x:Name="FloatingScrollPanel" Orientation="Vertical" Spacing="4" HorizontalAlignment="Center">

                    <!-- 3. Nút Cuộn Lên Đầu Trang (Top) -->

                    <Button Command="{Binding ScrollToTopCommand}"

                            Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1"

                            Foreground="#38BDF8" FontWeight="Bold"

                            CornerRadius="12" Padding="6,4" Width="74" Height="28"

                            ToolTip.Tip="Cuộn lên đầu trang (Top)">

                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <TextBlock Text="⬆️" FontSize="11" VerticalAlignment="Center" />

                            <TextBlock Text="TOP" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />

                        </StackPanel>

                    </Button>



                    <!-- 4. Nút Cuộn Xuống Cuối Trang (Bot) -->

                    <Button Command="{Binding ScrollToBottomCommand}"

                            Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1"

                            Foreground="#38BDF8" FontWeight="Bold"

                            CornerRadius="12" Padding="6,4" Width="74" Height="28"

                            ToolTip.Tip="Cuộn xuống cuối trang (Bot)">

                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <TextBlock Text="⬇️" FontSize="11" VerticalAlignment="Center" />

                            <TextBlock Text="BOT" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />

                        </StackPanel>

                    </Button>

                </StackPanel>

            </StackPanel>

        </Border>

        </Panel>



        <!-- MODAL POPUP CONFIRM KHI BẤM PHÍM BACK HOẶC NÚT THOÁT (2 OPTION: CHẠY NGẦM / THOÁT HOÀN TOÀN) -->

        <Border IsVisible="{Binding IsExitConfirmOpen}"

                Background="#B0050A15"

                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"

                ZIndex="999">

            <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1.5"

                    CornerRadius="16" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center"

                    MinWidth="320" MaxWidth="440" Margin="16"

                    BoxShadow="0 16 40 0 #A0000000">

                <StackPanel Spacing="16">

                    <!-- Header Dialog -->

                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">

                        <Border Background="#312E81" CornerRadius="10" Width="36" Height="36">

                            <TextBlock Text="⚙️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="TÙY CHỌN ỨNG DỤNG" FontWeight="Bold" FontSize="15" Foreground="#F3F4F6" />

                            <TextBlock Text="Chọn cách đóng hoặc chạy ngầm:" FontSize="11" Foreground="#94A3B8" />

                        </StackPanel>

                    </StackPanel>



                    <Border Height="1" Background="#1E293B" HorizontalAlignment="Stretch" />



                    <!-- Danh sách 2 Lựa chọn chính -->

                    <StackPanel Spacing="10">

                        <!-- Option 1: Ẩn / Tắt giao diện (Chạy ngầm mượt mà) -->

                        <Button Command="{Binding MinimizeOrHideAppCommand}"

                                Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1"

                                CornerRadius="10" Padding="14,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">

                            <Grid ColumnDefinitions="Auto, *">

                                <TextBlock Grid.Column="0" Text="🔘" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                    <TextBlock Text="Chạy Ngầm (Ẩn Giao Diện)" FontWeight="Bold" Foreground="#38BDF8" FontSize="13" />

                                    <TextBlock Text="Thu ứng dụng xuống nền, tiếp tục chạy tải/xử lý ngầm mượt mà" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" />

                                </StackPanel>

                            </Grid>

                        </Button>



                        <!-- Option 2: Thoát hoàn toàn (Force Stop) -->

                        <Button Command="{Binding ForceExitAppCommand}"

                                Background="#3B1219" BorderBrush="#EF4444" BorderThickness="1"

                                CornerRadius="10" Padding="14,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">

                            <Grid ColumnDefinitions="Auto, *">

                                <TextBlock Grid.Column="0" Text="⛔" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                    <TextBlock Text="Thoát Hoàn Toàn (Force Stop)" FontWeight="Bold" Foreground="#F87171" FontSize="13" />

                                    <TextBlock Text="Dừng mọi tác vụ, tắt sạch tiến trình và giải phóng bộ nhớ" FontSize="10" Foreground="#FDA4AF" TextWrapping="Wrap" />

                                </StackPanel>

                            </Grid>

                        </Button>

                    </StackPanel>



                    <Border Height="1" Background="#1E293B" HorizontalAlignment="Stretch" />



                    <!-- Nút Hủy / Đóng dialog -->

                    <Button Command="{Binding CancelExitConfirmCommand}"

                            Background="#0F172A" BorderBrush="#475569" BorderThickness="1"

                            Foreground="#94A3B8" FontWeight="SemiBold" FontSize="12"

                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"

                            Padding="10,6" CornerRadius="8">

                        <TextBlock Text="✕ Hủy / Ở lại ứng dụng" />

                    </Button>

                </StackPanel>

            </Border>

        </Border>



        <!-- ========================================== -->

        <!-- CENTER TOAST / NOTIFICATION MODAL OVERLAY -->

        <!-- ========================================== -->

        <Border IsVisible="{Binding IsCenterToastVisible}"

                Background="#99000000"

                PointerPressed="OnCenterToastOverlayPointerPressed"

                ZIndex="9999"

                HorizontalAlignment="Stretch"

                VerticalAlignment="Stretch">

            <Border HorizontalAlignment="Center" VerticalAlignment="Center"

                    Background="#0D1527" BorderBrush="#00F0FF" BorderThickness="1.5"

                    CornerRadius="12" Padding="20,16" MinWidth="320" MaxWidth="520"

                    BoxShadow="0 10 30 5 #5500F0FF" Margin="20">

                <StackPanel Spacing="12">

                    <Grid ColumnDefinitions="Auto, *, Auto">

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                            <TextBlock Text="{Binding CenterToastIcon}" FontSize="22" VerticalAlignment="Center" />

                            <Border Background="#1E293B" BorderBrush="#00F0FF" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">

                                <TextBlock Text="{Binding CenterToastBadge}" FontSize="9" FontWeight="ExtraBold" Foreground="#00F0FF" />

                            </Border>

                        </StackPanel>

                        <Button Grid.Column="2" Command="{Binding DismissCenterToastCommand}"

                                Background="Transparent" Foreground="#94A3B8" Padding="6,2" FontSize="14" FontWeight="Bold"

                                ToolTip.Tip="Đóng thông báo">

                            <TextBlock Text="✕" />

                        </Button>

                    </Grid>



                    <TextBlock Text="{Binding CenterToastTitle}" FontSize="14" FontWeight="ExtraBold" Foreground="#F8FAFC" TextWrapping="Wrap" />



                    <TextBlock Text="{Binding CenterToastMessage}" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="16" />



                    <!-- NÚT CẬP NHẬT TRỰC TIẾP KHI CÓ BẢN MỚI -->

                    <Grid ColumnDefinitions="*, *" Margin="0,4,0,0" IsVisible="{Binding HasAvailableUpdateInToast}">

                        <Button Grid.Column="0" Command="{Binding ConfirmUpdateFromToastCommand}"

                                Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"

                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"

                                Padding="12,8" CornerRadius="6" Margin="0,0,6,0">

                            <TextBlock Text="{Binding ToastUpdateButtonText}" />

                        </Button>

                        <Button Grid.Column="1" Command="{Binding DismissCenterToastCommand}"

                                Background="#334155" Foreground="#CBD5E1" FontWeight="Bold" FontSize="11"

                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"

                                Padding="12,8" CornerRadius="6">

                            <TextBlock Text="✕ ĐỂ SAU" />

                        </Button>

                    </Grid>



                    <Button Command="{Binding DismissCenterToastCommand}"

                            IsVisible="{Binding !HasAvailableUpdateInToast}"

                            Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"

                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"

                            Padding="12,7" CornerRadius="6">

                        <TextBlock Text="✓ ĐÃ HIỂU" />

                    </Button>

                </StackPanel>

            </Border>

        </Border>

    

        <!-- POPUP PREVIEW OVERLAY CHUẨN GIAO DIỆN WPF (DESKTOP HOVER & MOBILE TAP) VỚI NÚT ĐÓNG TRỰC TIẾP -->

        <Border x:Name="HoverPreviewPopupBorder"

                IsVisible="{Binding IsHoverPreviewVisible}"

                IsHitTestVisible="True"

                ZIndex="2500"

                HorizontalAlignment="Center" VerticalAlignment="Center"

                Margin="0" Width="340" MaxWidth="360"

                Background="#F8091018" BorderBrush="#00E5FF" BorderThickness="1.5"

                CornerRadius="6" Padding="8" BoxShadow="0 12 30 6 #C0000000" ClipToBounds="True"

                PointerExited="OnPopupPreviewPointerExited">

            <Grid RowDefinitions="Auto, *">

                <!-- Thanh tiêu đề Popup Preview kèm Nút Tắt (✕ ĐÓNG) nổi bật cho Android & Desktop (Cố định ở đỉnh, luôn nhìn thấy 100%) -->

                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="2,0,0,6">

                    <TextBlock Grid.Column="0" Text="🔍 XEM TRƯỚC TRUYỆN"

                               FontSize="10.5" FontWeight="ExtraBold" Foreground="#00E5FF"

                               VerticalAlignment="Center" />

                    <Button Grid.Column="1"

                            Command="{Binding CloseHoverPreviewCommand}"

                            Click="OnClosePreviewOverlayClicked"

                            Background="#DC2626" BorderBrush="#F87171" BorderThickness="1"

                            Foreground="#FFFFFF" FontWeight="ExtraBold"

                            Padding="10,3" Height="26" CornerRadius="4"

                            ToolTip.Tip="Đóng cửa sổ xem trước (Popup Preview)">

                        <TextBlock Text="✕ ĐÓNG" FontSize="10" FontWeight="ExtraBold" VerticalAlignment="Center" />

                    </Button>

                </Grid>



                <!-- Vùng cuộn an toàn chống tràn viền màn hình cho Android & Desktop khi nội dung dài hoặc xoay ngang màn hình -->

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Spacing="6" Margin="0,0,2,0">

                        <!-- Khung Ảnh Bìa Độ Phân Giải Cao (cover.jpg) -->

                        <Border Background="#05080D" CornerRadius="2" MinHeight="180" MaxHeight="380" ClipToBounds="True">

                            <Grid>

                                <TextBlock Text="NO IMG" FontSize="14" FontWeight="Bold" Foreground="#475569"

                                           HorizontalAlignment="Center" VerticalAlignment="Center"

                                           IsVisible="{Binding ActiveHoverItem.EffectivePopupBitmap, Converter={x:Static ObjectConverters.IsNull}}" />

                                <Image Source="{Binding ActiveHoverItem.EffectivePopupBitmap}"

                                       Stretch="Uniform" MaxHeight="370"

                                       HorizontalAlignment="Center" VerticalAlignment="Center"

                                       RenderOptions.BitmapInterpolationMode="HighQuality" />

                                <Border Background="#80000000" IsVisible="{Binding ActiveHoverItem.IsThumbnailLoading}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                                    <TextBlock Text="⏳ Đang tải ảnh bìa..." FontSize="11" Foreground="#00E5FF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                </Border>

                            </Grid>

                        </Border>



                        <!-- Thông tin chi tiết chuẩn WPF: Title, latest chapter, missing chapter, Status, Tags -->

                        <StackPanel Spacing="2" Margin="2,2,2,0">

                            <TextBlock Text="{Binding ActiveHoverItem.Title}"

                                       FontWeight="Bold" FontSize="13" Foreground="#FDE047" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />

                            <!-- Dòng Type & Language thanh lịch, gọn gàng -->

                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1,0,1" IsVisible="{Binding ActiveHoverItem.HasPreviewTypeOrLanguage}">

                                <TextBlock FontSize="11" IsVisible="{Binding ActiveHoverItem.HasPreviewType}">

                                    <Run Text="Type: " Foreground="#94A3B8" />

                                    <Run Text="{Binding ActiveHoverItem.PreviewType}" Foreground="#F472B6" FontWeight="SemiBold" />

                                </TextBlock>



                                <TextBlock Text="•" Foreground="#475569" IsVisible="{Binding ActiveHoverItem.HasBothPreviewTypeAndLanguage}" VerticalAlignment="Center" />



                                <TextBlock FontSize="11" IsVisible="{Binding ActiveHoverItem.HasPreviewLanguage}">

                                    <Run Text="Language: " Foreground="#94A3B8" />

                                    <Run Text="{Binding ActiveHoverItem.PreviewLanguage}" Foreground="#34D399" FontWeight="SemiBold" />

                                </TextBlock>

                            </StackPanel>



                            <!-- Artist & Parody (nếu có) -->

                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,1,0,1" IsVisible="{Binding ActiveHoverItem.HasPreviewArtist}">

                                <Run Text="Artist: " Foreground="#94A3B8" />

                                <Run Text="{Binding ActiveHoverItem.PreviewArtist}" Foreground="#38BDF8" FontWeight="SemiBold" />

                            </TextBlock>



                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,1,0,1" IsVisible="{Binding ActiveHoverItem.HasPreviewParody}">

                                <Run Text="Parody: " Foreground="#94A3B8" />

                                <Run Text="{Binding ActiveHoverItem.PreviewParody}" Foreground="#FACC15" FontWeight="SemiBold" />

                            </TextBlock>



                            <TextBlock Text="{Binding ActiveHoverItem.PreviewTagsText}"

                                       IsVisible="{Binding ActiveHoverItem.HasPreviewTags}"

                                       FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" Margin="0,1,0,2" />



                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="#00E5FF" TextWrapping="Wrap">

                                <Run Text="latest chapter: " />

                                <Run Text="{Binding ActiveHoverItem.LatestChapterDisplay}" />

                            </TextBlock>



                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding ActiveHoverItem.MissingChapterBrush}" TextWrapping="Wrap">

                                <Run Text="missing chapter: " />

                                <Run Text="{Binding ActiveHoverItem.MissingChapterDisplay}" />

                            </TextBlock>



                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="#00E5FF">

                                <Run Text="Status: " />

                                <Run Text="{Binding ActiveHoverItem.DisplayStatusVi}" />

                            </TextBlock>



                        </StackPanel>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

        </Border>



        <!-- FLOATING BATCH TOOLBAR CHO DUAL PICTURE SORT (TÔNG VÀNG CAM HỔ PHÁCH/AMBER NỔI BẬT ĐỂ PHÂN BIỆT RÕ RÀNG VỚI QUICK BAR) -->

        <Border x:Name="DualSortFloatingBatchToolbar"

                IsVisible="{Binding IsDualSortBatchToolbarRealVisible}"

                HorizontalAlignment="Right" VerticalAlignment="Bottom"

                Margin="0,0,24,35" CornerRadius="16"

                Background="#F21E1205" BorderBrush="#F59E0B" BorderThickness="1.5"

                Padding="4,5" ZIndex="2600" IsHitTestVisible="True"

                BoxShadow="0 8 28 0 #B0000000">

            <Border.RenderTransform>

                <TranslateTransform X="0" Y="0" />

            </Border.RenderTransform>

            <StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Center">

                <!-- Thanh Grip kéo thả di chuyển vị trí (Move Handle) & Nút Đóng Nhanh -->

                <Grid x:Name="DualSortBatchHeaderGrid" ColumnDefinitions="*, Auto" Width="92" Margin="0,1,0,2">

                    <Border Grid.Column="0" x:Name="DualSortBatchGripBar"

                            Background="#382109" CornerRadius="8"

                            Height="16" Margin="0,0,3,0"

                            Cursor="SizeAll"

                            ToolTip.Tip="Chạm giữ &amp; kéo để di chuyển. Chạm nhẹ để thu nhỏ/mở rộng thanh Batch Tool">

                        <TextBlock x:Name="DualSortBatchGripText" Text="⋮⋮ BATCH TOOL ⋮⋮" Foreground="#FBBF24" FontSize="8.5" FontWeight="Bold"

                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />

                    </Border>

                    <Button Grid.Column="1" x:Name="DualSortBatchCloseBtn" Command="{Binding ToggleDualSortBatchToolbarVisibleCommand}"

                            Background="#451A03" Foreground="#FDE68A"

                            Padding="0" Width="16" Height="16" CornerRadius="8"

                            ToolTip.Tip="Tắt thanh công cụ Batch (Có thể mở lại ở Header Bar)">

                        <TextBlock Text="✕" FontSize="8.5" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    </Button>

                </Grid>



                <!-- Cụm tính năng thiết yếu (Luôn hiển thị kể cả khi thu nhỏ: Previous/Next Folder, Start/Stop Part, Preview) -->

                <StackPanel x:Name="DualSortBatchEssentialPanel" Orientation="Vertical" Spacing="4" HorizontalAlignment="Center">

                    <!-- Nút Finish Folder: Chuyển thư mục hiện tại vào Thư mục hoàn thành và sang thư mục tiếp theo -->

                    <Button Command="{Binding DualSortFinishFolderCommand}"

                            Background="#065F46" Foreground="#34D399" BorderBrush="#10B981" BorderThickness="1.2"

                            FontWeight="Bold" CornerRadius="10" Padding="2,2" Width="92" Height="26" Margin="0,1,0,1"

                            ToolTip.Tip="Finish Folder: Chuyển thư mục hiện tại vào Thư mục hoàn thành (Finish folder) và sang thư mục tiếp theo">

                        <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <TextBlock Text="🏁" FontSize="9" VerticalAlignment="Center" />

                            <TextBlock Text="Finish" FontSize="8.5" FontWeight="Bold" VerticalAlignment="Center" />

                        </StackPanel>

                    </Button>

                    <!-- Nút Delete Folder: Xóa thư mục gốc hiện tại (chuyển an toàn vào Thùng rác Recycle Bin / Trash) và sang thư mục tiếp theo -->
                    <Button Command="{Binding DualSortDeleteFolderCommand}"
                            Background="#7F1D1D" Foreground="#FCA5A5" BorderBrush="#EF4444" BorderThickness="1.2"
                            FontWeight="Bold" CornerRadius="10" Padding="2,2" Width="92" Height="26" Margin="0,1,0,1"
                            ToolTip.Tip="Delete Folder: Xóa thư mục gốc hiện tại (chuyển vào Thùng rác Recycle Bin / Trash) và tự động chuyển sang thư mục kế tiếp">
                        <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🗑️" FontSize="9" VerticalAlignment="Center" />
                            <TextBlock Text="Delete" FontSize="8.5" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Điều hướng Thư mục: Previous Folder (Trước) & Next Folder (Tiếp) -->

                    <Grid ColumnDefinitions="*, 4, *" Width="92" Margin="0,1,0,1">

                        <Button Grid.Column="0" Command="{Binding DualSortPreviousFolderCommand}"

                                Background="#382109" Foreground="#FBBF24" BorderBrush="#D97706" BorderThickness="1"

                                FontWeight="Bold" CornerRadius="10" Padding="2,2" Height="26"

                                ToolTip.Tip="Previous Folder (⏮️ Thư mục trước trong cùng thư mục cha)">

                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">

                                <TextBlock Text="⏮️" FontSize="8.5" VerticalAlignment="Center" />

                                <TextBlock Text="Prev" FontSize="8.5" FontWeight="Bold" VerticalAlignment="Center" />

                            </StackPanel>

                        </Button>

                        <Button Grid.Column="2" Command="{Binding DualSortNextFolderCommand}"

                                Background="#382109" Foreground="#FBBF24" BorderBrush="#D97706" BorderThickness="1"

                                FontWeight="Bold" CornerRadius="10" Padding="2,2" Height="26"

                                ToolTip.Tip="Next Folder (Next ⏭️ Thư mục tiếp theo trong cùng thư mục cha)">

                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">

                                <TextBlock Text="Next" FontSize="8.5" FontWeight="Bold" VerticalAlignment="Center" />

                                <TextBlock Text="⏭️" FontSize="8.5" VerticalAlignment="Center" />

                            </StackPanel>

                        </Button>

                    </Grid>



                    <Border Height="1" Width="76" Background="#5C3106" HorizontalAlignment="Center" Margin="0,1" />



                    <!-- 1. Start batch (Part X) -->

                    <Button Command="{Binding ToggleBatchSelectModeCommand}"

                            Background="{Binding DualSortBatchButtonBg}" Foreground="{Binding DualSortBatchButtonFg}"

                            BorderBrush="{Binding DualSortBatchButtonBorder}" BorderThickness="1"

                            FontWeight="Bold" CornerRadius="12" Padding="4,4" Width="92" Height="28"

                            ToolTip.Tip="Start batch: Bắt đầu chọn dải ảnh theo Part X">

                        <TextBlock Text="{Binding DualSortBatchButtonText}" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    </Button>



                    <Border Height="1" Width="76" Background="#5C3106" HorizontalAlignment="Center" Margin="0,1" />



                    <!-- 2. Preview Button -->

                    <Button Command="{Binding ToggleDualSortPreviewEnabledCommand}"

                            Background="{Binding DualSortPreviewButtonBg}" Foreground="{Binding DualSortPreviewButtonFg}"

                            BorderBrush="{Binding DualSortPreviewButtonBorder}" BorderThickness="1"

                            CornerRadius="12" Padding="4,3" Width="92" Height="26"

                            ToolTip.Tip="Bật / Tắt tính năng xem trước ảnh (Preview)">

                        <TextBlock Text="{Binding DualSortPreviewButtonShortText}" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    </Button>

                </StackPanel>



                <!-- Cụm tính năng mở rộng/nâng cao (Chỉ hiển thị khi mở rộng, ẩn khi thu nhỏ) -->

                <StackPanel x:Name="DualSortBatchAdvancedPanel" Orientation="Vertical" Spacing="4" HorizontalAlignment="Center">

                    <Border Height="1" Width="76" Background="#5C3106" HorizontalAlignment="Center" Margin="0,1" />



                    <!-- 3. Chuyển sang sort -->

                    <Button Command="{Binding SortSelectedForwardCommand}"

                            Background="#059669" Foreground="#FFFFFF" FontWeight="Bold"

                            CornerRadius="12" Padding="4,4" Width="92" Height="28"

                            ToolTip.Tip="Chuyển tất cả ảnh đang chọn sang thư mục Đã lọc (Sorted)">

                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <TextBlock Text="➡️" FontSize="10" VerticalAlignment="Center" />

                            <TextBlock Text="Sang Sort" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" />

                        </StackPanel>

                    </Button>



                    <!-- 4. Trả lại gốc -->

                    <Button Command="{Binding SortSelectedBackwardCommand}"

                            Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold"

                            CornerRadius="12" Padding="4,4" Width="92" Height="28"

                            ToolTip.Tip="Trả tất cả ảnh đang chọn về thư mục Gốc">

                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <TextBlock Text="⬅️" FontSize="10" VerticalAlignment="Center" />

                            <TextBlock Text="Về Gốc" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" />

                        </StackPanel>

                    </Button>



                    <Border Height="1" Width="76" Background="#5C3106" HorizontalAlignment="Center" Margin="0,1" />



                    <!-- 5. Giữ gốc (Keep Parent) -->

                    <Button Command="{Binding KeepParentCommand}"

                            Background="#D97706" Foreground="#FFFFFF" FontWeight="Bold"

                            CornerRadius="12" Padding="4,3" Width="92" Height="26"

                            ToolTip.Tip="Keep Parent: Xóa hoàn toàn thư mục Đã Lọc, chỉ giữ lại thư mục Gốc">

                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <TextBlock Text="🛡️" FontSize="9.5" VerticalAlignment="Center" />

                            <TextBlock Text="Giữ Gốc" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />

                        </StackPanel>

                    </Button>



                    <!-- 6. Giữ đã lọc (Keep Child) -->

                    <Button Command="{Binding KeepChildCommand}"

                            Background="#7C3AED" Foreground="#FFFFFF" FontWeight="Bold"

                            CornerRadius="12" Padding="4,3" Width="92" Height="26"

                            ToolTip.Tip="Keep Child: Xóa file ở Gốc, chuyển toàn bộ ảnh Đã Lọc sang Gốc và xóa thư mục Child">

                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <TextBlock Text="✨" FontSize="9.5" VerticalAlignment="Center" />

                            <TextBlock Text="Giữ Đã Lọc" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />

                        </StackPanel>

                    </Button>



                    <!-- 7. Chỉ giữ đã chọn (Keep Selected Only) -->

                    <Button Command="{Binding KeepSelectedOnlyCommand}"

                            Background="#BE185D" Foreground="#FFFFFF" FontWeight="Bold"

                            CornerRadius="12" Padding="4,3" Width="92" Height="26"

                            ToolTip.Tip="Chỉ giữ đã chọn: Xóa các file không được chọn ở cả 2 thư mục và xóa luôn cả thư mục Đã Lọc (Child)">

                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <TextBlock Text="🎯" FontSize="9.5" VerticalAlignment="Center" />

                            <TextBlock Text="Giữ Đã Chọn" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />

                        </StackPanel>

                    </Button>



                    <Border Height="1" Width="76" Background="#5C3106" HorizontalAlignment="Center" Margin="0,1" />



                    <!-- 8. Checkbox select all -->

                    <CheckBox IsChecked="{Binding IsDualSortSelectAllActive, Mode=TwoWay}"

                              Command="{Binding ToggleSelectAllCommand}"

                              HorizontalAlignment="Center" Margin="0,1"

                              ToolTip.Tip="Chọn tất cả / Bỏ chọn tất cả ảnh">

                        <TextBlock Text="Select All" FontSize="9.5" FontWeight="SemiBold" Foreground="#FBBF24" VerticalAlignment="Center" />

                    </CheckBox>



                    <Border Height="1" Width="76" Background="#5C3106" HorizontalAlignment="Center" Margin="0,1" />



                    <!-- 9. Undo -->

                    <Button Command="{Binding UndoLastSortCommand}" IsEnabled="{Binding CanUndoSort}"

                            Background="#382109" Foreground="#FDE68A" FontWeight="SemiBold"

                            BorderBrush="#78350F" BorderThickness="1"

                            CornerRadius="12" Padding="4,3" Width="92" Height="25"

                            ToolTip.Tip="Hoàn tác thao tác vừa thực hiện (Ctrl+Z)">

                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <TextBlock Text="↩️" FontSize="9" VerticalAlignment="Center" />

                            <TextBlock Text="Undo" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />

                        </StackPanel>

                    </Button>



                    <!-- 10. Redo -->

                    <Button Command="{Binding RedoLastSortCommand}" IsEnabled="{Binding CanRedoSort}"

                            Background="#382109" Foreground="#FDE68A" FontWeight="SemiBold"

                            BorderBrush="#78350F" BorderThickness="1"

                            CornerRadius="12" Padding="4,3" Width="92" Height="25"

                            ToolTip.Tip="Làm lại thao tác vừa hoàn tác (Ctrl+Y)">

                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <TextBlock Text="↪️" FontSize="9" VerticalAlignment="Center" />

                            <TextBlock Text="Redo" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />

                        </StackPanel>

                    </Button>

                </StackPanel>

            </StackPanel>

        </Border>



        <!-- OVERLAY CIRCULAR PROGRESS BAR CHO CRAWL LINK MỌI TAB SOURCE -->
        <Border x:Name="SourceCrawlProgressOverlay"
                IsVisible="{Binding IsSourceCrawlBusy}"
                IsHitTestVisible="True"
                ZIndex="3000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Background="#B0050811">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#181F2E" BorderBrush="#00F0FF" BorderThickness="1.5"
                    CornerRadius="16" Padding="26,22" MinWidth="280" MaxWidth="380"
                    BoxShadow="0 16 48 10 #E0000000">
                <StackPanel Orientation="Vertical" Spacing="14" HorizontalAlignment="Center">
                    <!-- Header Icon & Title -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="🌐" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="ĐANG CÀO TRUYỆN TỪ NGUỒN..." FontSize="13" FontWeight="ExtraBold" Foreground="#00F0FF" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- CIRCULAR PROGRESS BAR -->
                    <Grid Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Vòng nền xám mờ -->
                        <Ellipse Width="86" Height="86"
                                 Stroke="#334155" StrokeThickness="7"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <!-- Cung tròn tiến độ (Arc quay theo góc SourceCrawlProgressAngle từ 0 đến 360 độ) -->
                        <Arc Width="86" Height="86"
                             Stroke="#00F0FF" StrokeThickness="7"
                             StrokeLineCap="Round"
                             StartAngle="-90"
                             SweepAngle="{Binding SourceCrawlProgressAngle}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <!-- Con số phần trăm to bản ở giữa -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SourceCrawlProgressPercentText}"
                                       FontSize="18" FontWeight="Black"
                                       Foreground="#00F0FF"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Text số truyện / tổng số truyện đang load -->
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SourceCrawlCountText}"
                                   FontSize="13" FontWeight="Bold" Foreground="#FDE047"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding SourceCrawlStatusText}"
                                   FontSize="11" Foreground="#94A3B8"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="320" MaxLines="2" TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Nút Dừng cào nổi bật -->
                    <Button Command="{Binding StopSourceCrawlCommand}"
                            Background="#DC2626" BorderBrush="#F87171" BorderThickness="1"
                            Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"
                            Padding="14,6" CornerRadius="6" HorizontalAlignment="Center"
                            ToolTip.Tip="Dừng tiến trình cào truyện hiện tại">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="⏹" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="DỪNG CÀO" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Border>

        <!-- 8. MODAL / OVERLAY CIRCULAR PROGRESS BAR CHO DUAL PICTURE SORT -->
        <Border x:Name="DualSortProgressOverlay"
                IsVisible="{Binding IsDualSortBusy}"
                IsHitTestVisible="True"
                ZIndex="3000"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Background="#B0050811">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#181F2E" BorderBrush="#0284C7" BorderThickness="1.5"
                    CornerRadius="16" Padding="24,20" MinWidth="260" MaxWidth="360"
                    BoxShadow="0 16 48 10 #E0000000">
                <StackPanel Orientation="Vertical" Spacing="14" HorizontalAlignment="Center">
                    <!-- CIRCULAR PROGRESS BAR -->
                    <Grid Width="90" Height="90" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Vòng nền xám mờ -->
                        <Ellipse Width="80" Height="80"
                                 Stroke="#334155" StrokeThickness="7"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <!-- Cung tròn tiến độ (Arc quay theo góc DualSortProgressAngle từ 0 đến 360 độ) -->
                        <Arc Width="80" Height="80"
                             Stroke="#38BDF8" StrokeThickness="7"
                             StrokeLineCap="Round"
                             StartAngle="-90"
                             SweepAngle="{Binding DualSortProgressAngle}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <!-- Con số phần trăm ở giữa -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DualSortProgressPercentText}"
                                       FontSize="16" FontWeight="Black"
                                       Foreground="#38BDF8"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Text trạng thái và chi tiết -->
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding DualSortProgressStatusText}"
                                   FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding DualSortProgressDetailText}"
                                   FontSize="10" Foreground="#94A3B8"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   IsVisible="{Binding DualSortProgressDetailText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 7. POPUP PREVIEW CHO DUAL PICTURE SORT (HOVER 0.5S TRÊN DESKTOP HOẶC SINGLE TAP TRÊN ANDROID) -->

        <Border x:Name="DualSortPreviewPopupBorder"

                IsVisible="{Binding IsDualSortPreviewVisible}"

                IsHitTestVisible="True"

                ZIndex="2700"

                HorizontalAlignment="Left" VerticalAlignment="Top"

                Margin="400,160,0,0" Width="380"

                Background="#F8091018" BorderBrush="#38BDF8" BorderThickness="1.5"

                CornerRadius="8" Padding="10" BoxShadow="0 16 40 8 #D0000000"

                PointerExited="OnDualSortPreviewPopupPointerExited">

            <StackPanel Spacing="6">

                <!-- Thanh tiêu đề Popup Preview kèm Nút Tắt (✕ ĐÓNG) -->

                <Grid ColumnDefinitions="*, Auto" Margin="2,0,0,2">

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                        <TextBlock Text="🔍 XEM ẢNH" FontSize="11" FontWeight="ExtraBold" Foreground="#38BDF8" VerticalAlignment="Center" />

                        <Border Background="#7C3AED" CornerRadius="4" Padding="5,1" VerticalAlignment="Center"

                                IsVisible="{Binding IsDualSortPreviewAnimated}">

                            <TextBlock Text="{Binding DualSortPreviewAnimatedBadge}" FontSize="9" FontWeight="ExtraBold" Foreground="#FFFFFF" />

                        </Border>

                        <TextBlock Text="{Binding DualSortPreviewItem.FileName}" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding DualSortPreviewItem.FileName}" />

                    </StackPanel>

                    <Button Grid.Column="1"

                            Command="{Binding CloseDualSortPreviewCommand}"

                            Background="#DC2626" BorderBrush="#F87171" BorderThickness="1"

                            Foreground="#FFFFFF" FontWeight="ExtraBold"

                            Padding="10,3" Height="26" CornerRadius="4"

                            ToolTip.Tip="Đóng cửa sổ xem trước">

                        <TextBlock Text="✕ ĐÓNG" FontSize="10" FontWeight="ExtraBold" VerticalAlignment="Center" />

                    </Button>

                </Grid>



                <!-- Khung Ảnh Lớn Độ Phân Giải Cao -->

                <Border Background="#05080D" CornerRadius="4" MinHeight="260" MaxHeight="450" ClipToBounds="True">

                    <Grid>

                        <TextBlock Text="Đang tải ảnh..." FontSize="12" Foreground="#64748B"

                                   HorizontalAlignment="Center" VerticalAlignment="Center"

                                   IsVisible="{Binding DualSortPreviewBitmap, Converter={x:Static ObjectConverters.IsNull}}" />

                        <Image Source="{Binding DualSortPreviewBitmap}"

                               Stretch="Uniform" MaxHeight="440"

                               HorizontalAlignment="Center" VerticalAlignment="Center"

                               RenderOptions.BitmapInterpolationMode="HighQuality" />

                    </Grid>

                </Border>



                <!-- Footer: Thông tin độ phân giải, dung lượng, ngày sửa -->

                <WrapPanel Orientation="Horizontal" Margin="2,4,2,0">

                    <TextBlock Text="Kích thước: " FontSize="10.5" Foreground="#94A3B8" />

                    <TextBlock Text="{Binding DualSortPreviewItem.ResolutionText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,12,0" />

                    <TextBlock Text="Dung lượng: " FontSize="10.5" Foreground="#94A3B8" />

                    <TextBlock Text="{Binding DualSortPreviewItem.FileSizeText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#10B981" Margin="0,0,12,0" />

                    <TextBlock Text="Ngày sửa: " FontSize="10.5" Foreground="#94A3B8" />

                    <TextBlock Text="{Binding DualSortPreviewItem.LastModifiedText}" FontSize="10.5" Foreground="#CBD5E1" />

                </WrapPanel>

            </StackPanel>

        </Border>



        <!-- ========================================================================= -->

        <!-- MODAL QUẢN LÝ BỘ NHỚ ĐỆM CHO TAB DOWNLOAD (THUMBNAIL STORAGE & ZIP CACHE) -->

        <!-- ========================================================================= -->

        <Border IsVisible="{Binding IsDownloadCacheModalOpen}"

                Background="#B005080F"

                ZIndex="5000"

                HorizontalAlignment="Stretch"

                VerticalAlignment="Stretch">

            <Panel>

                <Border MaxWidth="560" MaxHeight="620"

                        Background="#0D131F" BorderBrush="#06B6D4" BorderThickness="1.5"

                        CornerRadius="10" Padding="16"

                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="12,16"

                        BoxShadow="0 15 40 0 #DD000000">

                    <Grid RowDefinitions="Auto, Auto, *, Auto" RowSpacing="12">

                        <!-- HEADER MODAL -->

                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="💾 Quản lý bộ nhớ đệm Tab Download (Cache Data)" Foreground="#38BDF8" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" />

                                <TextBlock Text="Cấu hình hạn mức lưu trữ ảnh bìa (Thumbnails) và tệp nén (Zip/Document)"

                                           Foreground="#64748B" FontSize="11" TextWrapping="Wrap" />

                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding CloseDownloadCacheModalCommand}"

                                    Width="30" Height="30" Padding="0" CornerRadius="6"

                                    Background="#1E293B" Foreground="#94A3B8"

                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"

                                    ToolTip.Tip="Đóng">

                                <TextBlock Text="✕" FontSize="13" FontWeight="Bold" />

                            </Button>

                        </Grid>



                        <!-- THANH TỔNG HỢP DUNG LƯỢNG -->

                        <Border Grid.Row="1" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="7" Padding="12,8">

                            <Grid ColumnDefinitions="*, Auto">

                                <TextBlock Grid.Column="0" Text="Hỗ trợ đầy đủ: .zip, .cbz, .rar, .cbr, .pdf, .mobi (azw, azw3, prc)"

                                           Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />

                                <Border Grid.Column="1" Background="#1E293B" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">

                                    <TextBlock Text="{Binding TotalCacheSummaryText, StringFormat='Tổng dung lượng: {0}'}"

                                               Foreground="#10B981" FontSize="11.5" FontWeight="Bold" />

                                </Border>

                            </Grid>

                        </Border>



                        <!-- DANH SÁCH CÁC MỤC THUMBNAIL & ZIP CACHE DÀNH CHO TAB DOWNLOAD -->

                        <Border Grid.Row="2" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="8">

                            <ScrollViewer VerticalScrollBarVisibility="Auto">

                                <StackPanel Spacing="8">

                                    <!-- NHÓM 1: ẢNH BÌA THU NHỎ (THUMBNAILS) -->

                                    <TextBlock Text="🖼️ BỘ NHỚ ĐỆM ẢNH BÌA (THUMBNAILS)" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" Margin="4,2,0,0" />



                                    <!-- ITEM 1: SET THUMBNAILS STORAGE -->

                                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="7" Padding="10,8">

                                        <Grid ColumnDefinitions="Auto, *, Auto">

                                            <TextBlock Grid.Column="0" Text="🖼️" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">

                                                <TextBlock Text="Set thumbnails storage" Foreground="#F8FAFC" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />

                                                <TextBlock Text="{Binding ThumbnailStorageSummaryText}" Foreground="#38BDF8" FontSize="11" TextWrapping="Wrap" />

                                            </StackPanel>

                                            <Button Grid.Column="2" Command="{Binding OpenThumbnailQuotaDialogCommand}"

                                                    Background="#1E293B" Foreground="#38BDF8" BorderBrush="#38BDF8" BorderThickness="1"

                                                    CornerRadius="6" Padding="10,5" FontWeight="SemiBold" FontSize="11"

                                                    Content="Đổi hạn mức ⚙" HorizontalAlignment="Right" />

                                        </Grid>

                                    </Border>



                                    <!-- ITEM 2: CLEAR THUMBNAILS -->

                                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="7" Padding="10,8">

                                        <Grid ColumnDefinitions="Auto, *, Auto">

                                            <TextBlock Grid.Column="0" Text="🧹" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">

                                                <TextBlock Text="Clear Thumbnails" Foreground="#F8FAFC" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />

                                                <TextBlock Text="Xóa toàn bộ ảnh bìa thu nhỏ đã lưu trong thư viện và tải về" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />

                                            </StackPanel>

                                            <Button Grid.Column="2" Command="{Binding ClearThumbnailsCommand}"

                                                    Background="#1E293B" Foreground="#F59E0B" BorderBrush="#F59E0B" BorderThickness="1"

                                                    CornerRadius="6" Padding="10,5" FontWeight="SemiBold" FontSize="11"

                                                    Content="Xóa" HorizontalAlignment="Right" />

                                        </Grid>

                                    </Border>



                                    <!-- NHÓM 2: TỆP NÉN & TÀI LIỆU (ZIP FILE CACHE) -->

                                    <TextBlock Text="🗜️ BỘ NHỚ ĐỆM TỆP NÉN &amp; TÀI LIỆU (ZIP FILE CACHE)" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" Margin="4,6,0,0" />



                                    <!-- ITEM 3: SET ZIP-FILE CACHE STORAGE (CHỌN DUNG LƯỢNG ZIP CACHE) -->

                                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="7" Padding="10,8">

                                        <Grid ColumnDefinitions="Auto, *, Auto">

                                            <TextBlock Grid.Column="0" Text="🗜️" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">

                                                <TextBlock Text="Set zip-file cache storage" Foreground="#F8FAFC" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />

                                                <TextBlock Text="{Binding ZipCacheStorageSummaryText}" Foreground="#38BDF8" FontSize="11" TextWrapping="Wrap" />

                                            </StackPanel>

                                            <Button Grid.Column="2" Command="{Binding OpenZipQuotaDialogCommand}"

                                                    Background="#1E293B" Foreground="#38BDF8" BorderBrush="#38BDF8" BorderThickness="1"

                                                    CornerRadius="6" Padding="10,5" FontWeight="SemiBold" FontSize="11"

                                                    Content="Đổi dung lượng ⚙" HorizontalAlignment="Right" />

                                        </Grid>

                                    </Border>



                                    <!-- ITEM 4: CLEAR ZIP-FILE CACHE (XÓA DUNG LƯỢNG ZIP CACHE) -->

                                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="7" Padding="10,8">

                                        <Grid ColumnDefinitions="Auto, *, Auto">

                                            <TextBlock Grid.Column="0" Text="📦" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">

                                                <TextBlock Text="Clear zip-file cache" Foreground="#F8FAFC" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />

                                                <TextBlock Text="{Binding ArchiveCacheSummaryText, StringFormat='Xóa toàn bộ bộ nhớ đệm tệp nén &amp; tài liệu: {0} (.zip, .cbz, .rar, .cbr, .pdf, .mobi)'}"

                                                           Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />

                                            </StackPanel>

                                            <Button Grid.Column="2" Command="{Binding ClearArchiveCacheCommand}"

                                                    Background="#1E293B" Foreground="#F59E0B" BorderBrush="#F59E0B" BorderThickness="1"

                                                    CornerRadius="6" Padding="10,5" FontWeight="SemiBold" FontSize="11"

                                                    Content="Xóa" HorizontalAlignment="Right" />

                                        </Grid>

                                    </Border>



                                    <!-- ITEM 5: SET ZIP-FILE CACHE RETENTION PERIOD -->

                                    <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="7" Padding="10,8">

                                        <Grid ColumnDefinitions="Auto, *, Auto">

                                            <TextBlock Grid.Column="0" Text="⏳" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">

                                                <TextBlock Text="Set zip-file cache retention period" Foreground="#F8FAFC" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />

                                                <TextBlock Text="{Binding RetentionPeriodSummaryText, StringFormat='Thời hạn lưu đệm: {0}'}" Foreground="#38BDF8" FontSize="11" TextWrapping="Wrap" />

                                            </StackPanel>

                                            <Button Grid.Column="2" Command="{Binding OpenRetentionDialogCommand}"

                                                    Background="#1E293B" Foreground="#38BDF8" BorderBrush="#38BDF8" BorderThickness="1"

                                                    CornerRadius="6" Padding="10,5" FontWeight="SemiBold" FontSize="11"

                                                    Content="Đổi thời hạn ⚙" HorizontalAlignment="Right" />

                                        </Grid>

                                    </Border>

                                </StackPanel>

                            </ScrollViewer>

                        </Border>



                        <!-- FOOTER -->

                        <Grid Grid.Row="3" ColumnDefinitions="*, Auto">

                            <TextBlock Grid.Column="0" Text="💡 Thay đổi hạn mức hoặc dọn dẹp sẽ có hiệu lực ngay lập tức."

                                       Foreground="#64748B" FontSize="11" FontStyle="Italic" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />

                            <Button Grid.Column="1" Command="{Binding CloseDownloadCacheModalCommand}"

                                    Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold"

                                    Padding="16,7" CornerRadius="6" Content="Đóng" HorizontalAlignment="Right" />

                        </Grid>

                    </Grid>

                </Border>



                <!-- DIALOG MODAL CHỌN HẠN MỨC THUMBNAIL (RESPONSIVE) -->

                <Border IsVisible="{Binding IsThumbnailQuotaDialogOpen}"

                        Background="#D005080F" ZIndex="6000"

                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <Border MaxWidth="380" Background="#111827" BorderBrush="#38BDF8" BorderThickness="1.5"

                            CornerRadius="10" Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="14"

                            BoxShadow="0 10 30 0 #AA000000">

                        <StackPanel Spacing="12">

                            <TextBlock Text="⚙ Hạn mức bộ nhớ ảnh bìa (Thumbnails)" Foreground="#38BDF8" FontSize="13.5" FontWeight="Bold" TextWrapping="Wrap" />

                            <TextBlock Text="Chọn dung lượng tối đa cho ảnh bìa tải về &amp; thư viện. Khi vượt quá, hệ thống tự động dọn bớt ảnh ít dùng nhất (LRU):"

                                       Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />



                            <Border Background="#1E293B" CornerRadius="6" Padding="10,6">

                                <TextBlock Text="{Binding SelectedThumbnailQuotaMb, StringFormat='Đang chọn: {0} MB'}"

                                           Foreground="#F8FAFC" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center" />

                            </Border>



                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                <Button Content="200 MB" Command="{Binding SelectThumbnailQuotaCommand}" CommandParameter="200"

                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />

                                <Button Content="500 MB" Command="{Binding SelectThumbnailQuotaCommand}" CommandParameter="500"

                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />

                                <Button Content="1.0 GB (1000 MB)" Command="{Binding SelectThumbnailQuotaCommand}" CommandParameter="1000"

                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />

                                <Button Content="2.0 GB (2000 MB)" Command="{Binding SelectThumbnailQuotaCommand}" CommandParameter="2000"

                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />

                                <Button Content="3.0 GB (3000 MB)" Command="{Binding SelectThumbnailQuotaCommand}" CommandParameter="3000"

                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />

                                <Button Content="5.0 GB (5000 MB)" Command="{Binding SelectThumbnailQuotaCommand}" CommandParameter="5000"

                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />

                            </WrapPanel>



                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,6,0,0">

                                <Button Grid.Column="0" Command="{Binding CloseThumbnailQuotaDialogCommand}"

                                        Background="#1E293B" Foreground="#94A3B8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"

                                        Padding="0,8" CornerRadius="6" Content="Hủy" />

                                <Button Grid.Column="1" Command="{Binding ConfirmThumbnailQuotaCommand}"

                                        Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"

                                        Padding="0,8" CornerRadius="6" Content="Lưu hạn mức" />

                            </Grid>

                        </StackPanel>

                    </Border>

                </Border>



                <!-- DIALOG MODAL CHỌN DUNG LƯỢNG ZIP CACHE (RESPONSIVE) -->

                <Border IsVisible="{Binding IsZipQuotaDialogOpen}"

                        Background="#D005080F" ZIndex="6000"

                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <Border MaxWidth="380" Background="#111827" BorderBrush="#38BDF8" BorderThickness="1.5"

                            CornerRadius="10" Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="14"

                            BoxShadow="0 10 30 0 #AA000000">

                        <StackPanel Spacing="12">

                            <TextBlock Text="⚙ Hạn mức bộ nhớ đệm tệp nén (Zip Cache)" Foreground="#38BDF8" FontSize="13.5" FontWeight="Bold" TextWrapping="Wrap" />

                            <TextBlock Text="Chọn dung lượng tối đa cho bộ nhớ đệm giải nén tệp zip, cbz, rar, pdf... Khi vượt quá hạn mức, hệ thống tự động dọn bớt trang cũ nhất (LRU):"

                                       Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />



                            <Border Background="#1E293B" CornerRadius="6" Padding="10,6">

                                <TextBlock Text="{Binding SelectedZipQuotaMb, StringFormat='Đang chọn: {0} MB'}"

                                           Foreground="#F8FAFC" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center" />

                            </Border>



                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                <Button Content="500 MB" Command="{Binding SelectZipQuotaCommand}" CommandParameter="500"

                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />

                                <Button Content="1.0 GB (1000 MB - Mặc định)" Command="{Binding SelectZipQuotaCommand}" CommandParameter="1000"

                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />

                                <Button Content="2.0 GB (2000 MB)" Command="{Binding SelectZipQuotaCommand}" CommandParameter="2000"

                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />

                                <Button Content="4.0 GB (4000 MB)" Command="{Binding SelectZipQuotaCommand}" CommandParameter="4000"

                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />

                                <Button Content="8.0 GB (8000 MB)" Command="{Binding SelectZipQuotaCommand}" CommandParameter="8000"

                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />

                                <Button Content="16.0 GB (16000 MB)" Command="{Binding SelectZipQuotaCommand}" CommandParameter="16000"

                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />

                                <Button Content="32.0 GB (32000 MB)" Command="{Binding SelectZipQuotaCommand}" CommandParameter="32000"

                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="12,6" CornerRadius="5" />

                            </WrapPanel>



                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,6,0,0">

                                <Button Grid.Column="0" Command="{Binding CloseZipQuotaDialogCommand}"

                                        Background="#1E293B" Foreground="#94A3B8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"

                                        Padding="0,8" CornerRadius="6" Content="Hủy" />

                                <Button Grid.Column="1" Command="{Binding ConfirmZipQuotaCommand}"

                                        Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"

                                        Padding="0,8" CornerRadius="6" Content="Lưu hạn mức" />

                            </Grid>

                        </StackPanel>

                    </Border>

                </Border>



                <!-- DIALOG MODAL CHỌN THỜI HẠN LƯU TỆP NÉN (RESPONSIVE) -->

                <Border IsVisible="{Binding IsRetentionDialogOpen}"

                        Background="#D005080F" ZIndex="6000"

                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <Border MaxWidth="380" Background="#111827" BorderBrush="#38BDF8" BorderThickness="1.5"

                            CornerRadius="10" Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="14"

                            BoxShadow="0 10 30 0 #AA000000">

                        <StackPanel Spacing="12">

                            <TextBlock Text="⏳ Thời hạn lưu bộ nhớ đệm tệp nén &amp; tài liệu" Foreground="#38BDF8" FontSize="13.5" FontWeight="Bold" TextWrapping="Wrap" />

                            <TextBlock Text="Các trang ảnh trích xuất từ .zip, .cbz, .rar, .cbr, .pdf, .mobi không được mở sau số ngày này sẽ tự động xóa để giải phóng dung lượng đĩa:"

                                       Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />



                            <Border Background="#1E293B" CornerRadius="6" Padding="10,6">

                                <TextBlock Text="{Binding SelectedRetentionDays, StringFormat='Đang chọn: {0} ngày'}"

                                           Foreground="#F8FAFC" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center" />

                            </Border>



                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                <Button Content="1 ngày" Command="{Binding SelectRetentionDaysCommand}" CommandParameter="1"

                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="10,6" CornerRadius="5" />

                                <Button Content="2 ngày" Command="{Binding SelectRetentionDaysCommand}" CommandParameter="2"

                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="10,6" CornerRadius="5" />

                                <Button Content="4 ngày (Mặc định)" Command="{Binding SelectRetentionDaysCommand}" CommandParameter="4"

                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="10,6" CornerRadius="5" />

                                <Button Content="7 ngày" Command="{Binding SelectRetentionDaysCommand}" CommandParameter="7"

                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="10,6" CornerRadius="5" />

                                <Button Content="14 ngày" Command="{Binding SelectRetentionDaysCommand}" CommandParameter="14"

                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="10,6" CornerRadius="5" />

                                <Button Content="30 ngày" Command="{Binding SelectRetentionDaysCommand}" CommandParameter="30"

                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="10,6" CornerRadius="5" />

                                <Button Content="Vĩnh viễn (Không xóa)" Command="{Binding SelectRetentionDaysCommand}" CommandParameter="0"

                                        Background="#1E293B" Foreground="#E2E8F0" Margin="0,0,6,6" Padding="10,6" CornerRadius="5" />

                            </WrapPanel>



                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,6,0,0">

                                <Button Grid.Column="0" Command="{Binding CloseRetentionDialogCommand}"

                                        Background="#1E293B" Foreground="#94A3B8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"

                                        Padding="0,8" CornerRadius="6" Content="Hủy" />

                                <Button Grid.Column="1" Command="{Binding ConfirmRetentionDaysCommand}"

                                        Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"

                                        Padding="0,8" CornerRadius="6" Content="Lưu thời hạn" />

                            </Grid>

                        </StackPanel>

                    </Border>

                </Border>

            </Panel>

        </Border>



        <!-- ========================================================================= -->

        <!-- MODAL GOOGLE DRIVE CLOUD SYNC (\GMTPC\Comic Downloader GMTPC\) -->

        <!-- ========================================================================= -->

        <Border IsVisible="{Binding IsGoogleDriveModalOpen}"

                Background="#C805080F"

                ZIndex="5500"

                HorizontalAlignment="Stretch"

                VerticalAlignment="Stretch">

            <Panel>

                <Border MaxWidth="620" MaxHeight="680"

                        Background="#0D131F" BorderBrush="#818CF8" BorderThickness="1.5"

                        CornerRadius="12" Padding="18"

                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="14,16"

                        BoxShadow="0 20 50 0 #EE000000">

                    <Grid RowDefinitions="Auto, *" RowSpacing="12">

                        <!-- HEADER MODAL -->

                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">

                            <StackPanel Grid.Column="0">

                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                                    <Border Background="#4F46E5" CornerRadius="6" Width="26" Height="26">

                                        <TextBlock Text="☁️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    </Border>

                                    <TextBlock Text="Google Drive Cloud Sync" Foreground="#A5B4FC" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />

                                </StackPanel>

                                <TextBlock Text="Thư mục chỉ định: \GMTPC\Comic Downloader GMTPC\ (Google Drive)"

                                           Foreground="#64748B" FontSize="11" Margin="34,2,0,0" TextWrapping="Wrap" />

                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding CloseGoogleDriveModalCommand}"

                                    Width="30" Height="30" Padding="0" CornerRadius="6"

                                    Background="#1E293B" Foreground="#94A3B8"

                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"

                                    ToolTip.Tip="Đóng">

                                <TextBlock Text="✕" FontSize="13" FontWeight="Bold" />

                            </Button>

                        </Grid>



                        <!-- NỘI DUNG CUỘN CỦA MODAL -->

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                            <StackPanel Spacing="12">



                                <!-- CARD 1: THÔNG TIN TÀI KHOẢN GOOGLE -->

                                <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14,12">

                                    <StackPanel Spacing="10">

                                        <Grid ColumnDefinitions="*, Auto">

                                            <StackPanel Grid.Column="0">

                                                <TextBlock Text="TÀI KHOẢN LIÊN KẾT" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" />

                                                <TextBlock Text="{Binding GoogleDriveUserEmail, FallbackValue='Chưa kết nối tài khoản Google'}"

                                                           FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,3,0,0" />

                                                <TextBlock Text="{Binding GoogleDriveUserName}"

                                                           IsVisible="{Binding IsGoogleDriveConnected}"

                                                           Foreground="#60A5FA" FontSize="11" Margin="0,2,0,0" />

                                            </StackPanel>



                                            <!-- Nút Đăng xuất hoặc Trạng thái -->

                                            <Button Grid.Column="1" Command="{Binding LogoutGoogleDriveCommand}"

                                                    IsVisible="{Binding IsGoogleDriveConnected}"

                                                    Background="#1E293B" BorderBrush="#EF4444" BorderThickness="1"

                                                    Foreground="#F87171" FontWeight="SemiBold" CornerRadius="6" Padding="10,4" Height="28">

                                                <TextBlock Text="🚪 Đăng xuất" FontSize="11" VerticalAlignment="Center" />

                                            </Button>

                                        </Grid>



                                        <!-- Khu vực Đăng nhập khi chưa kết nối -->

                                        <StackPanel IsVisible="{Binding !IsGoogleDriveConnected}" Spacing="8">

                                            <WrapPanel Orientation="Horizontal">

                                                <!-- Nút Đăng nhập chính -->

                                                <Button Command="{Binding LoginGoogleDriveCommand}"

                                                        IsEnabled="{Binding !IsGoogleDriveBusy}"

                                                        Background="#2563EB" BorderBrush="#60A5FA" BorderThickness="1"

                                                        Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="6" Padding="14,7" Margin="0,0,8,6">

                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                                        <TextBlock Text="🔑" FontSize="12" />

                                                        <TextBlock Text="ĐĂNG NHẬP GOOGLE DRIVE" FontSize="11.5" FontWeight="Bold" />

                                                    </StackPanel>

                                                </Button>



                                                <!-- Nút Quick Connect -->

                                                <Button Command="{Binding UseCommunityCredentialsCommand}"

                                                        Background="#065F46" BorderBrush="#34D399" BorderThickness="1"

                                                        Foreground="#A7F3D0" FontWeight="SemiBold" CornerRadius="6" Padding="10,6" Margin="0,0,8,6"

                                                        ToolTip.Tip="Áp dụng Client ID công khai đã kiểm thử để kết nối ngay mà không cần tự tạo project Google Cloud">

                                                    <TextBlock Text="⚡ Quick Connect (Client ID có sẵn)" FontSize="11" />

                                                </Button>



                                                <!-- Nút nhập mã thủ công -->

                                                <Button Command="{Binding StartManualLoginGoogleDriveCommand}"

                                                        Background="#1E293B" BorderBrush="#334155" BorderThickness="1"

                                                        Foreground="#38BDF8" CornerRadius="6" Padding="10,6" Margin="0,0,8,6"

                                                        ToolTip.Tip="Mở URL cấp quyền và dán mã ủy quyền thủ công (hữu ích cho Android hoặc khi port bị chặn)">

                                                    <TextBlock Text="📋 Nhập mã thủ công" FontSize="11" />

                                                </Button>



                                                <!-- Nút toggle cấu hình nâng cao -->

                                                <Button Command="{Binding ToggleGoogleDriveCredentialsCommand}"

                                                        Background="Transparent" Foreground="#94A3B8" Padding="6,6" Margin="0,0,0,6">

                                                    <TextBlock Text="⚙️ Cấu hình Client ID cá nhân ▾" FontSize="10.5" />

                                                </Button>

                                            </WrapPanel>



                                            <!-- Panel nhập mã thủ công (Dành cho Android hoặc khi Loopback bị chặn) -->

                                            <Border IsVisible="{Binding IsGoogleDriveManualCodeVisible}"

                                                    Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,0,0">

                                                <StackPanel Spacing="6">

                                                    <TextBlock Text="1. Hãy mở đường link này trên trình duyệt và bấm 'Cho phép':" Foreground="#94A3B8" FontSize="10.5" />

                                                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6">

                                                        <TextBox Grid.Column="0" Text="{Binding GoogleDriveManualAuthUrl}" IsReadOnly="True" FontSize="10" Height="28" Background="#0B0F19" Foreground="#38BDF8" />

                                                        <Button Grid.Column="1" Command="{Binding ReopenManualAuthUrlCommand}"

                                                                Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="4" Padding="8,4" Height="28"

                                                                ToolTip.Tip="Mở liên kết này trên trình duyệt web">

                                                            <TextBlock Text="🌐 Mở Trình Duyệt" FontSize="10.5" />

                                                        </Button>

                                                        <Button Grid.Column="2" Command="{Binding CopyManualAuthUrlCommand}"

                                                                Background="#334155" Foreground="#F8FAFC" FontWeight="SemiBold" CornerRadius="4" Padding="8,4" Height="28"

                                                                ToolTip.Tip="Chép đường dẫn xác thực vào bộ nhớ tạm">

                                                            <TextBlock Text="📋 Chép Link" FontSize="10.5" />

                                                        </Button>

                                                    </Grid>



                                                    <!-- Khung hướng dẫn thông minh khi gặp ERR_CONNECTION_REFUSED trên Android -->

                                                    <Border Background="#1E1B4B" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,2,0,2">

                                                        <StackPanel Spacing="2">

                                                            <TextBlock Text="💡 NẾU TRÌNH DUYỆT BÁO '127.0.0.1 TỪ CHỐI KẾT NỐI' (ERR_CONNECTION_REFUSED):" Foreground="#A5B4FC" FontSize="10" FontWeight="Bold" />

                                                            <TextBlock Text="Google đã xác thực xong! Bạn chỉ cần: Chạm thanh địa chỉ trình duyệt ➔ Sao chép (Copy) toàn bộ link ➔ Bấm nút [📋 Dán Mã &amp; Xác Nhận] bên dưới!" Foreground="#CBD5E1" FontSize="10" TextWrapping="Wrap" />

                                                        </StackPanel>

                                                    </Border>



                                                    <TextBlock Text="2. Dán mã Authorization Code hoặc liên kết callback 127.0.0.1 nhận được vào đây:" Foreground="#94A3B8" FontSize="10.5" Margin="0,2,0,0" />

                                                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6">

                                                        <TextBox Grid.Column="0" Text="{Binding GoogleDriveManualCodeInput}" PlaceholderText="Dán mã code hoặc URL callback..." Height="30" FontSize="11" Background="#0B0F19" />

                                                        <Button Grid.Column="1" Command="{Binding PasteManualCodeCommand}"

                                                                Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="5" Padding="10,5" Height="30"

                                                                ToolTip.Tip="Tự động đọc mã từ bộ nhớ tạm và hoàn tất đăng nhập ngay">

                                                            <TextBlock Text="📋 Dán Mã &amp; Xác Nhận" FontSize="10.5" />

                                                        </Button>

                                                        <Button Grid.Column="2" Command="{Binding ConfirmManualCodeGoogleDriveCommand}"

                                                                Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Foreground="#94A3B8" FontWeight="SemiBold" CornerRadius="5" Padding="10,5" Height="30">

                                                            <TextBlock Text="✓ Xác Nhận" FontSize="10.5" />

                                                        </Button>

                                                    </Grid>

                                                </StackPanel>

                                            </Border>



                                            <!-- Panel cấu hình Client ID / Secret cá nhân -->

                                            <Border IsVisible="{Binding IsGoogleDriveCredentialsExpanded}"

                                                    Background="#0B0F19" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,4,0,0">

                                                <StackPanel Spacing="8">

                                                    <TextBlock Text="⚙️ Thiết lập Google OAuth Client ID của bạn:" Foreground="#F59E0B" FontSize="11" FontWeight="Bold" />

                                                    <TextBlock Text="Bạn có thể nhập trực tiếp hoặc tải file credentials.json từ Google Cloud Console về máy:" Foreground="#94A3B8" FontSize="10.5" TextWrapping="Wrap" />



                                                    <!-- Phím tắt mở Google Cloud Console -->

                                                    <WrapPanel Orientation="Horizontal">

                                                        <Button Command="{Binding ImportCredentialsFileCommand}"

                                                                Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold"

                                                                CornerRadius="4" Padding="10,5" Margin="0,0,8,4">

                                                            <TextBlock Text="📂 Nhập file credentials.json" FontSize="10.5" />

                                                        </Button>

                                                        <Button Command="{Binding OpenGoogleCloudConsoleCommand}"

                                                                Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1"

                                                                Foreground="#38BDF8" CornerRadius="4" Padding="8,5" Margin="0,0,8,4">

                                                            <TextBlock Text="🌐 1. Mở trang tạo OAuth Client ID" FontSize="10" />

                                                        </Button>

                                                        <Button Command="{Binding OpenGoogleDriveApiLibraryCommand}"

                                                                Background="#1E293B" BorderBrush="#10B981" BorderThickness="1"

                                                                Foreground="#34D399" CornerRadius="4" Padding="8,5" Margin="0,0,0,4">

                                                            <TextBlock Text="🌐 2. Bật Google Drive API" FontSize="10" />

                                                        </Button>

                                                    </WrapPanel>



                                                    <TextBox Text="{Binding GoogleDriveCustomClientId}" PlaceholderText="Google OAuth Client ID (xxx.apps.googleusercontent.com)..." Height="28" FontSize="10.5" Background="#111827" />

                                                    <TextBox Text="{Binding GoogleDriveCustomClientSecret}" PlaceholderText="Client Secret (nếu có)..." Height="28" FontSize="10.5" Background="#111827" />

                                                    <Button Command="{Binding SaveGoogleDriveCredentialsCommand}"

                                                            Background="#059669" Foreground="#FFFFFF" CornerRadius="4" Padding="12,5" HorizontalAlignment="Right">

                                                        <TextBlock Text="💾 Lưu Client ID" FontSize="10.5" FontWeight="Bold" />

                                                    </Button>

                                                </StackPanel>

                                            </Border>

                                        </StackPanel>



                                        <!-- Đường dẫn thư mục Google Drive & Nút Mở Web -->

                                        <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding IsGoogleDriveConnected}">

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">

                                                <TextBlock Text="Thư mục: \GMTPC\Comic Downloader GMTPC\" Foreground="#34D399" FontSize="11" FontWeight="SemiBold" />

                                            </StackPanel>

                                            <Button Grid.Column="1" Command="{Binding OpenGoogleDriveFolderInBrowserCommand}"

                                                    Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1"

                                                    Foreground="#38BDF8" CornerRadius="5" Padding="8,4" Height="26">

                                                <TextBlock Text="🌐 Mở trên Web Drive" FontSize="10" FontWeight="SemiBold" />

                                            </Button>

                                        </Grid>

                                    </StackPanel>

                                </Border>



                                <!-- CARD: QUẢN LÝ THIẾT BỊ & NGUỒN PHỤC HỒI CLOUD (MULTI-DEVICE) -->

                                <Border IsVisible="{Binding IsGoogleDriveConnected}"

                                        Background="#111827" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="14,12">

                                    <StackPanel Spacing="10">

                                        <!-- Header & Thư mục đồng bộ đang chọn -->

                                        <!-- Header & Thư mục đồng bộ đang chọn (Responsive layout) -->

                                        <Grid RowDefinitions="Auto, Auto" RowSpacing="8">

                                            <StackPanel Grid.Row="0">

                                                <TextBlock Text="THƯ MỤC ĐỒNG BỘ ĐANG CHỌN TRÊN GOOGLE DRIVE" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" />

                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3,0,0" VerticalAlignment="Center">

                                                    <TextBlock Text="📁" FontSize="14" VerticalAlignment="Center" />

                                                    <TextBlock Text="{Binding CurrentDeviceDisplayName}"

                                                               FontSize="13" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />

                                                </StackPanel>

                                            </StackPanel>



                                            <!-- Cụm nút Thao tác: Đổi tên / Tạo folder mới / Nhập ID / Xóa folder (Tự động Wrap, không bao giờ bị che) -->

                                            <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">

                                                <Button Command="{Binding StartRenameDeviceCommand}"

                                                        IsVisible="{Binding !IsRenamingDevice}"

                                                        Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1"

                                                        Foreground="#38BDF8" CornerRadius="6" Padding="9,5" Height="28" Margin="0,0,6,6"

                                                        ToolTip.Tip="Đổi tên thư mục này trực tiếp trên Google Drive">

                                                    <TextBlock Text="✏️ Đổi tên" FontSize="10.5" FontWeight="SemiBold" />

                                                </Button>

                                                <Button Command="{Binding StartInputFolderIdCommand}"

                                                        IsVisible="{Binding !IsInputFolderIdVisible}"

                                                        Background="#1E1B4B" BorderBrush="#818CF8" BorderThickness="1"

                                                        Foreground="#C7D2FE" CornerRadius="6" Padding="9,5" Height="28" Margin="0,0,6,6"

                                                        ToolTip.Tip="Nhập trực tiếp Google Drive Folder ID hoặc URL để liên kết đồng bộ">

                                                    <TextBlock Text="🔗 Nhập ID" FontSize="10.5" FontWeight="SemiBold" />

                                                </Button>

                                                <Button Command="{Binding DeleteSelectedCloudFolderCommand}"

                                                        Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1"

                                                        Foreground="#FCA5A5" CornerRadius="6" Padding="9,5" Height="28" Margin="0,0,6,6"

                                                        ToolTip.Tip="Xóa thư mục đang chọn trên Google Drive">

                                                    <TextBlock Text="🗑️ Xóa" FontSize="10.5" FontWeight="SemiBold" />

                                                </Button>

                                            </WrapPanel>

                                        </Grid>



                                        <!-- Panel nhập đổi tên thư mục -->

                                        <Border IsVisible="{Binding IsRenamingDevice}"

                                                Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,2,0,0">

                                            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6">

                                                <TextBox Grid.Column="0" Text="{Binding CustomDeviceNameInput}"

                                                         PlaceholderText="Nhập tên mới cho thư mục (vd: 231, MayDocTruyen...)"

                                                         Height="28" FontSize="11" Background="#0B0F19" />

                                                <Button Grid.Column="1" Command="{Binding SaveCustomDeviceNameCommand}"

                                                         Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="5" Padding="10,4" Height="28">

                                                    <TextBlock Text="💾 Đổi tên trên Drive" FontSize="10.5" />

                                                </Button>

                                                <Button Grid.Column="2" Command="{Binding CancelRenameDeviceCommand}"

                                                         Background="#334155" Foreground="#94A3B8" CornerRadius="5" Padding="8,4" Height="28">

                                                    <TextBlock Text="✕" FontSize="10.5" />

                                                </Button>

                                            </Grid>

                                        </Border>



                                        <!-- Panel nhập ID hoặc URL thư mục để đồng bộ -->

                                        <Border IsVisible="{Binding IsInputFolderIdVisible}"

                                                Background="#1E1B4B" BorderBrush="#818CF8" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,2,0,0">

                                            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="6">

                                                <TextBox Grid.Column="0" Text="{Binding CustomFolderIdInput}"

                                                         PlaceholderText="Dán Folder ID (vd: 1J0-mghYBBq82oc...) hoặc link Google Drive..."

                                                         Height="28" FontSize="11" Background="#0B0F19" />

                                                <Button Grid.Column="1" Command="{Binding ConfirmConnectByFolderIdCommand}"

                                                         Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="5" Padding="10,4" Height="28"

                                                         ToolTip.Tip="Tự động bóc tách Folder ID từ link Google Drive hoặc mã ID và liên kết ngay">

                                                    <TextBlock Text="✓ Liên kết (ID / Link)" FontSize="10.5" />

                                                </Button>

                                                <Button Grid.Column="2" Command="{Binding CancelInputFolderIdCommand}"

                                                         Background="#334155" Foreground="#94A3B8" CornerRadius="5" Padding="8,4" Height="28">

                                                    <TextBlock Text="✕" FontSize="10.5" />

                                                </Button>

                                            </Grid>

                                        </Border>



                                        <Border Height="1" Background="#1E293B" Margin="0,2" />



                                        <!-- Danh sách Thư mục trên Cloud (Chọn thư mục để đồng bộ hoặc phục hồi) -->

                                        <StackPanel Spacing="5">

                                            <Grid ColumnDefinitions="*, Auto">

                                                <StackPanel Grid.Column="0">

                                                    <TextBlock Text="DANH SÁCH THƯ MỤC TRÊN GOOGLE DRIVE (CHỌN ĐỂ ĐỒNG BỘ)" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" />

                                                    <TextBlock Text="Chọn thư mục để liên kết thiết bị này, hoặc tải dữ liệu về máy:"

                                                               Foreground="#64748B" FontSize="10" Margin="0,1,0,0" />

                                                </StackPanel>

                                                <Button Grid.Column="1" Command="{Binding RefreshGoogleDriveStatusCommand}"

                                                        Background="#1E293B" BorderBrush="#334155" BorderThickness="1"

                                                        Foreground="#94A3B8" CornerRadius="5" Padding="8,4" Height="26" VerticalAlignment="Center"

                                                        ToolTip.Tip="Quét lại toàn bộ thư mục trên Drive">

                                                    <TextBlock Text="🔄 Quét lại" FontSize="10.5" />

                                                </Button>

                                            </Grid>



                                            <!-- ComboBox chọn thư mục đồng bộ -->

                                            <ComboBox ItemsSource="{Binding AvailableCloudDevices}"

                                                      SelectedItem="{Binding SelectedCloudDevice}"

                                                      HorizontalAlignment="Stretch" Height="30" CornerRadius="6"

                                                      Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" FontSize="11">

                                                <ComboBox.ItemTemplate>

                                                    <DataTemplate DataType="services:GoogleDriveDeviceSlot">

                                                        <TextBlock Text="{Binding DisplayName}" Foreground="#F8FAFC" FontSize="11" VerticalAlignment="Center" />

                                                    </DataTemplate>

                                                </ComboBox.ItemTemplate>

                                            </ComboBox>

                                        </StackPanel>

                                    </StackPanel>

                                </Border>



                                <!-- CARD 2: BẢNG TRẠNG THÁI 2 TỆP ĐỒNG BỘ -->

                                <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14,12">

                                    <StackPanel Spacing="10">

                                        <Grid ColumnDefinitions="*, Auto">

                                            <TextBlock Grid.Column="0" Text="CÁC TỆP ĐỒNG BỘ CLOUD (.md)" Foreground="#9CA3AF" FontSize="10.5" FontWeight="Bold" />

                                            <TextBlock Grid.Column="1" Text="{Binding SelectedCloudDevice.DisplayName, StringFormat='Nguồn: {0}'}"

                                                       Foreground="#38BDF8" FontSize="10" FontWeight="SemiBold" />

                                        </Grid>



                                        <!-- Tệp 1: autosave.md (Queue tải) -->

                                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8">

                                            <Grid RowDefinitions="Auto, Auto" RowSpacing="6">

                                                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">

                                                    <TextBlock Grid.Column="0" Text="📋" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                        <TextBlock Text="autosave.md (Hàng Chờ Tải &amp; Tiến Độ)" Foreground="#F3F4F6" FontSize="11.5" FontWeight="Bold" />

                                                        <TextBlock Text="{Binding GoogleDriveQueueCloudInfo}" Foreground="#94A3B8" FontSize="10.5" Margin="0,1,0,0" />

                                                    </StackPanel>

                                                </Grid>

                                                <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">

                                                    <Button Command="{Binding BackupQueueToGoogleDriveCommand}"

                                                            IsEnabled="{Binding IsGoogleDriveConnected}"

                                                            Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold"

                                                            CornerRadius="4" Padding="10,4" Height="26" Margin="0,0,6,0">

                                                        <TextBlock Text="⬆ Tải lên Drive" FontSize="10.5" />

                                                    </Button>

                                                    <Button Command="{Binding RestoreQueueFromGoogleDriveCommand}"

                                                            IsEnabled="{Binding IsGoogleDriveConnected}"

                                                            Background="#0D9488" Foreground="#FFFFFF" FontWeight="SemiBold"

                                                            CornerRadius="4" Padding="10,4" Height="26">

                                                        <TextBlock Text="⬇ Phục hồi về máy" FontSize="10.5" />

                                                    </Button>

                                                </WrapPanel>

                                            </Grid>

                                        </Border>



                                        <!-- Tệp 2: bookmarks.md & history.md (Dấu trang & Lịch sử đọc) -->

                                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8">

                                            <Grid RowDefinitions="Auto, Auto" RowSpacing="6">

                                                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">

                                                    <TextBlock Grid.Column="0" Text="📖" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                        <TextBlock Text="bookmarks.md &amp; history.md (Dấu Trang &amp; Lịch Sử)" Foreground="#F3F4F6" FontSize="11.5" FontWeight="Bold" />

                                                        <TextBlock Text="{Binding GoogleDriveReaderCloudInfo}" Foreground="#94A3B8" FontSize="10.5" Margin="0,1,0,0" />

                                                    </StackPanel>

                                                </Grid>

                                                <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">

                                                    <Button Command="{Binding BackupReaderToGoogleDriveCommand}"

                                                            IsEnabled="{Binding IsGoogleDriveConnected}"

                                                            Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold"

                                                            CornerRadius="4" Padding="10,4" Height="26" Margin="0,0,6,0">

                                                        <TextBlock Text="⬆ Tải lên Drive" FontSize="10.5" />

                                                    </Button>

                                                    <Button Command="{Binding RestoreReaderFromGoogleDriveCommand}"

                                                            IsEnabled="{Binding IsGoogleDriveConnected}"

                                                            Background="#0D9488" Foreground="#FFFFFF" FontWeight="SemiBold"

                                                            CornerRadius="4" Padding="10,4" Height="26">

                                                        <TextBlock Text="⬇ Phục hồi về máy" FontSize="10.5" />

                                                    </Button>

                                                </WrapPanel>

                                            </Grid>

                                        </Border>



                                        <!-- Tệp 3: resume.md (Tiến độ đọc dở dùng chung cho mọi thiết bị) -->

                                        <Border Background="#0F172A" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="6" Padding="10,8">

                                            <Grid RowDefinitions="Auto, Auto" RowSpacing="6">

                                                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">

                                                    <TextBlock Grid.Column="0" Text="🌐" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                        <StackPanel Orientation="Horizontal" Spacing="6">

                                                            <TextBlock Text="resume.md (Tiến Độ Đọc Dùng Chung)" Foreground="#F3F4F6" FontSize="11.5" FontWeight="Bold" />

                                                            <Border Background="#1E3A8A" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">

                                                                <TextBlock Text="DÙNG CHUNG TẤT CẢ THIẾT BỊ" Foreground="#93C5FD" FontSize="9" FontWeight="Bold" />

                                                            </Border>

                                                        </StackPanel>

                                                        <TextBlock Text="{Binding GoogleDriveResumeCloudInfo}" Foreground="#94A3B8" FontSize="10.5" Margin="0,1,0,0" />

                                                    </StackPanel>

                                                </Grid>

                                                <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">

                                                    <Button Command="{Binding BackupResumeToGoogleDriveCommand}"

                                                            IsEnabled="{Binding IsGoogleDriveConnected}"

                                                            Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold"

                                                            CornerRadius="4" Padding="10,4" Height="26" Margin="0,0,6,0">

                                                        <TextBlock Text="⬆ Tải lên Drive" FontSize="10.5" />

                                                    </Button>

                                                    <Button Command="{Binding RestoreResumeFromGoogleDriveCommand}"

                                                            IsEnabled="{Binding IsGoogleDriveConnected}"

                                                            Background="#0D9488" Foreground="#FFFFFF" FontWeight="SemiBold"

                                                            CornerRadius="4" Padding="10,4" Height="26">

                                                        <TextBlock Text="⬇ Phục hồi về máy" FontSize="10.5" />

                                                    </Button>

                                                </WrapPanel>

                                            </Grid>

                                        </Border>

                                    </StackPanel>

                                </Border>



                                <!-- CARD 3: ĐỒNG BỘ TOÀN DIỆN & TÙY CHỌN TỰ ĐỘNG -->

                                <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14,12">

                                    <StackPanel Spacing="10">

                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                            <!-- Nút sao lưu tất cả 3 trong 1 -->

                                            <Button Command="{Binding FullSyncUploadGoogleDriveCommand}"

                                                    IsEnabled="{Binding IsGoogleDriveConnected}"

                                                    Background="#059669" BorderBrush="#34D399" BorderThickness="1"

                                                    Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="6" Padding="14,8" Margin="0,0,8,6">

                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                                    <TextBlock Text="🔄" FontSize="13" />

                                                    <TextBlock Text="SAO LƯU TẤT CẢ (QUEUE + READER + RESUME)" FontSize="11.5" FontWeight="Bold" />

                                                </StackPanel>

                                            </Button>



                                            <!-- Nút phục hồi tất cả từ drive -->

                                            <Button Command="{Binding FullSyncRestoreGoogleDriveCommand}"

                                                    IsEnabled="{Binding IsGoogleDriveConnected}"

                                                    Background="#0284C7" BorderBrush="#38BDF8" BorderThickness="1"

                                                    Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="6" Padding="14,8" Margin="0,0,8,6">

                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                                    <TextBlock Text="⬇" FontSize="13" />

                                                    <TextBlock Text="PHỤC HỒI TẤT CẢ TỪ DRIVE" FontSize="11.5" FontWeight="Bold" />

                                                </StackPanel>

                                            </Button>



                                             <!-- Nút làm mới trạng thái -->

                                            <Button Command="{Binding RefreshGoogleDriveStatusCommand}"

                                                    IsEnabled="{Binding IsGoogleDriveConnected}"

                                                    Background="#1E293B" Foreground="#94A3B8" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">

                                                <TextBlock Text="🔄 Làm mới" FontSize="11" />

                                            </Button>

                                        </WrapPanel>

                                    </StackPanel>

                                </Border>



                                <!-- DÒNG TRẠNG THÁI / LOG -->

                                <Border Background="#080D1A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6">

                                    <Grid ColumnDefinitions="Auto, *">

                                        <TextBlock Grid.Column="0" Text="📢 " FontSize="11" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1" Text="{Binding GoogleDriveStatusText}"

                                                   Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />

                                    </Grid>

                                </Border>



                            </StackPanel>

                        </ScrollViewer>

                    </Grid>

                </Border>



                <!-- OVERLAY LOADING / BACKUP Ở CHÍNH GIỮA MODAL KHI ĐANG SAO LƯU HOẶC ĐỒNG BỘ -->

                <Border IsVisible="{Binding IsGoogleDriveBusy}"

                        Background="#D005080F"

                        CornerRadius="12"

                        ZIndex="6000"

                        HorizontalAlignment="Stretch"

                        VerticalAlignment="Stretch">

                    <Border Background="#111827"

                            BorderBrush="#38BDF8"

                            BorderThickness="2"

                            CornerRadius="14"

                            Padding="24,20"

                            MaxWidth="440"

                            HorizontalAlignment="Center"

                            VerticalAlignment="Center"

                            BoxShadow="0 15 45 0 #EE000000">

                        <StackPanel Spacing="14" HorizontalAlignment="Center">

                            <!-- Icon xoay / hoạt họa -->

                            <Border Background="#0284C7" CornerRadius="30" Width="52" Height="52" HorizontalAlignment="Center">

                                <TextBlock Text="☁️" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />

                            </Border>

                            <StackPanel Spacing="4" HorizontalAlignment="Center">

                                <TextBlock Text="ĐANG XỬ LÝ GOOGLE DRIVE"

                                           Foreground="#38BDF8"

                                           FontSize="14"

                                           FontWeight="Bold"

                                           HorizontalAlignment="Center" />

                                <TextBlock Text="Vui lòng đợi giây lát, hệ thống đang đồng bộ dữ liệu..."

                                           Foreground="#94A3B8"

                                           FontSize="11"

                                           HorizontalAlignment="Center" />

                            </StackPanel>



                            <!-- Progress Bar chuyển động -->

                            <ProgressBar IsIndeterminate="{Binding IsGoogleDriveBusy}"

                                         Height="6"

                                         CornerRadius="3"

                                         Foreground="#38BDF8"

                                         Background="#1E293B"

                                         HorizontalAlignment="Stretch" />



                            <!-- Nội dung chi tiết trạng thái / thông báo Quota retry nếu có -->

                            <Border Background="#080D1A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,8">

                                <TextBlock Text="{Binding GoogleDriveStatusText}"

                                           Foreground="#F8FAFC"

                                           FontSize="11.5"

                                           FontWeight="SemiBold"

                                           TextWrapping="Wrap"

                                           TextAlignment="Center"

                                           HorizontalAlignment="Center" />

                            </Border>

                        </StackPanel>

                    </Border>

                </Border>

            </Panel>

        </Border>



    </Grid>

</UserControl>
