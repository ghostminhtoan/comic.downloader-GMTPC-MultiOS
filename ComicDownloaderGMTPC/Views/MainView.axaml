                                                    </Button>

                                                    <Button Command="{Binding OpenDomainBookmarksCommand}" CommandParameter="mangadex" Background="#1E293B" Foreground="#EC4899" Padding="8,4" CornerRadius="4" Margin="0,0,0,4">

                                                        <TextBlock Text="⭐ Lưu Bookmark" FontSize="10" />

                                                    </Button>

                                                </WrapPanel>



                                                <!-- Thông Báo MangaDex Không Hỗ Trợ Analyze -->

                                                <Border Background="#162238" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,2">

                                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

                                                        <TextBlock Text="ℹ️" FontSize="16" VerticalAlignment="Center" />

                                                        <StackPanel VerticalAlignment="Center" Spacing="2">

                                                            <TextBlock Text="Website không hỗ trợ analyze" Foreground="#38BDF8" FontWeight="Bold" FontSize="11.5" />

                                                            <TextBlock Text="MangaDex không hỗ trợ cào phân tích theo danh mục/thẻ tag. Vui lòng dán trực tiếp link truyện MangaDex bên dưới để tải." Foreground="#94A3B8" FontSize="10" />

                                                        </StackPanel>

                                                    </StackPanel>

                                                </Border>



                                                <Border Background="#161F30" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10">

                                                    <StackPanel Spacing="6">

                                                        <TextBlock Text="🔍 Phân Tích Tag / Thể Loại MangaDex Official:" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" />

                                                        <TextBox Text="{Binding DomainMangadexTagUrl}" PlaceholderText="Dán 1 hoặc nhiều link tag MangaDex (mỗi dòng 1 link)..." AcceptsReturn="True" MinHeight="34" MaxHeight="80" TextWrapping="Wrap" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />

                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                            <Button Command="{Binding AnalyzeDomainTagCommand}" CommandParameter="mangadex" IsEnabled="{Binding !IsDomainAnalyzing}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,5" CornerRadius="4" Margin="0,0,8,4" ToolTip.Tip="Phân tích kiểm tra số trang hoặc phân tích hàng loạt URL">

                                                                <TextBlock Text="🔍 PHÂN TÍCH" FontSize="10" />

                                                            </Button>

                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,6,4">

                                                                <TextBlock Text="Từ:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />

                                                                <NumericUpDown Value="{Binding DomainPageFrom}" Minimum="1" Maximum="9999" Increment="1" FormatString="0" Width="105" Height="28" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,6,4">

                                                                <TextBlock Text="Đến:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />

                                                                <NumericUpDown Value="{Binding DomainPageTo}" Minimum="1" Maximum="9999" Increment="1" FormatString="0" Width="105" Height="28" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                                                            </StackPanel>

                                                            <TextBlock Text="{Binding DomainTotalPages, StringFormat='{}(Tổng: {0} trang)'}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,4" />

                                                            <Button Command="{Binding ScrapeDomainBatchPagesCommand}" CommandParameter="mangadex" IsEnabled="{Binding !IsDomainBatchScraping}" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,5" CornerRadius="4" Margin="0,0,6,4" ToolTip.Tip="Cào danh sách từ đầu (xóa danh sách queue cũ)">

                                                                <TextBlock Text="📥 CÀO MỚI" FontSize="10" />

                                                            </Button>

                                                            <Button Command="{Binding CrawlMoreDomainBatchPagesCommand}" CommandParameter="mangadex" IsEnabled="{Binding !IsDomainBatchScraping}" Background="#0D9488" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,5" CornerRadius="4" Margin="0,0,6,4" ToolTip.Tip="Cào thêm vào danh sách hiện tại (giữ nguyên queue cũ)">

                                                                <TextBlock Text="➕ CÀO THÊM" FontSize="10" />

