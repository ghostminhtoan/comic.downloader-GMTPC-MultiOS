                            <!-- 1.2 SOURCE HENTAI (SUBTABS DOMAIN) -->
                            <TabItem Header="🔞 Source Hentai" FontSize="12" FontWeight="SemiBold">
                                <Border Background="#131B2E" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                                    <TabControl Background="Transparent">
                                        <!-- vi-hentai -->
                                        <TabItem Header="vi-hentai" FontSize="11">
                                            <StackPanel Spacing="10" Margin="0,8,0,0">
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Command="{Binding OpenDomainHomeCommand}" CommandParameter="vihentai" Background="#1E293B" Foreground="#F43F5E" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">
