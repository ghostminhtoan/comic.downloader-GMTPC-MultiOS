                                                        <TextBox Text="{Binding DomainVihentaiTagUrl}" PlaceholderText="Dán 1 hoặc nhiều link thể loại Vi-Hentai (mỗi dòng 1 link)..." AcceptsReturn="True" MinHeight="34" MaxHeight="80" TextWrapping="Wrap" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />

                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

