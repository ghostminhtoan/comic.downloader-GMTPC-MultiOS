<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ComicDownloaderGMTPC.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="850"
             x:Class="ComicDownloaderGMTPC.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="#0B0F19">

    <Grid>
        <!-- KHUNG CUỘN CHÍNH HỖ TRỢ ĐA NỀN TẢNG (DESKTOP & MOBILE/ANDROID) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid RowDefinitions="Auto, Auto, *, Auto" MinHeight="650">

            <!-- 1. HEADER / BRAND BAR -->
            <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="12,8">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,4">
                        <Border Background="#6366F1" CornerRadius="6" Width="26" Height="26">
                            <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="COMIC DOWNLOADER GMTPC" FontWeight="Bold" FontSize="15" Foreground="#F3F4F6" VerticalAlignment="Center" />
                        <Border Background="#312E81" CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                            <TextBlock Text="XPLAT" FontSize="10" FontWeight="SemiBold" Foreground="#A5B4FC" />
                        </Border>
                    </StackPanel>

                    <!-- Folder Mode Selector & Language Switcher -->
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="📁 Thư mục:" Foreground="#9CA3AF" VerticalAlignment="Center" FontSize="11" />
                            <ComboBox SelectedItem="{Binding ModeSelection}" Width="125" Height="28" FontSize="11">
                                <x:String>Single comic</x:String>
                                <x:String>Multi-comic</x:String>
                            </ComboBox>
                        </StackPanel>

                        <Button Command="{Binding ToggleLanguageCommand}"
                                Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                CornerRadius="6" Padding="8,3" Height="28">
                            <TextBlock Text="{Binding CurrentLanguage, StringFormat='{}🌐 {0}'}" FontWeight="SemiBold" Foreground="#38BDF8" FontSize="11" />
                        </Button>

                        <!-- Nút Tự Động Cập Nhật (Auto Update) -->
                        <Button Command="{Binding AutoUpdateCommand}"
                                IsEnabled="{Binding !IsUpdating}"
                                Background="#059669" BorderBrush="#10B981" BorderThickness="1"
                                CornerRadius="6" Padding="10,3" Height="28" ToolTip.Tip="Tự động tải ngầm và cài đặt phiên bản APK mới nhất">
                            <TextBlock Text="{Binding UpdateButtonLabel}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <!-- 2. QUICK DIRECT LINK BAR (TIỆN ÍCH DÁN LINK NHANH TOÀN CỤC) -->
            <Border Grid.Row="1" Background="#131B2E" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="12,6">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0" Text="{Binding UrlInput}"
                             PlaceholderText="⚡ Dán link truyện tại đây (TruyenQQ, MangaDex, NetTruyen, Vi-Hentai, Đảo Mèo Đen, Dâm Cô Nương, SayHentai...)"
                             Height="34" CornerRadius="5" VerticalContentAlignment="Center"
                             Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" FontSize="11"
                             Margin="0,0,8,0" />
                    <WrapPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding GetLinkCommand}"
                                Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold"
                                CornerRadius="5" Padding="12,4" Height="32" Margin="0,0,6,0">
                            <TextBlock Text="🔍 LẤY LINK" FontSize="11" />
                        </Button>
                        <Button Command="{Binding GetMoreCommand}"
                                Background="#059669" Foreground="#FFFFFF" FontWeight="SemiBold"
                                CornerRadius="5" Padding="10,4" Height="32" Margin="0,0,6,0">
                            <TextBlock Text="➕ THÊM" FontSize="11" />
                        </Button>
                        <Button Command="{Binding ClearLinksCommand}"
                                Background="#1E293B" Foreground="#94A3B8"
                                CornerRadius="5" Padding="8,4" Height="32">
                            <TextBlock Text="🗑️ XÓA" FontSize="11" />
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- 3. HAI TAB GỐC CHÍNH: TAB SOURCE & TAB DOWNLOAD (GIỐNG 100% WPF GỐC) -->
            <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedRootTabIndex}" Margin="0" Background="Transparent" MinHeight="480">

                <!-- ========================================================================= -->
                <!-- [TAB 1 LỚN] TAB SOURCE: MANGA SOURCE, SOURCE HENTAI, NOVEL SOURCE, SEARCH, PASSWORD -->
                <!-- ========================================================================= -->
                <TabItem Header="🌐 TAB SOURCE (NGUỒN TRUYỆN)" FontSize="13" FontWeight="Bold">
                    <Border Background="#0F172A" Padding="8">
                        <TabControl Background="Transparent" Margin="0">

                            <!-- 1.1 MANGA SOURCE (SUBTABS DOMAIN) -->
                            <TabItem Header="📖 Manga Source" FontSize="12" FontWeight="SemiBold">
                                <Border Background="#131B2E" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                                    <TabControl Background="Transparent">
                                        <!-- TruyenQQ -->
                                        <TabItem Header="truyenqq" FontSize="11">
                                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                                <TextBlock Text="Nguồn TruyenQQ (truyenqqto.com / truyenqq.com)" FontWeight="Bold" Foreground="#38BDF8" FontSize="12" />
                                                <TextBlock Text="Ví dụ: https://truyenqqto.com/truyen-tranh/dai-quan-gia-la-ma-hoang-1823" Foreground="#94A3B8" FontSize="11" />
                                                <TextBox Text="{Binding UrlInput}" PlaceholderText="Dán link truyện TruyenQQ..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4" Margin="0,0,6,0">
                                                        <TextBlock Text="🔍 LẤY LINK &amp; XEM TIẾN TRÌNH" FontSize="11" />
                                                    </Button>
                                                    <Button Command="{Binding GetMoreCommand}" Background="#059669" Foreground="#FFFFFF" Padding="10,5" CornerRadius="4">
                                                        <TextBlock Text="➕ Thêm vào Queue" FontSize="11" />
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </TabItem>

                                        <!-- nettruyenviet10.com -->
                                        <TabItem Header="nettruyenviet10.com" FontSize="11">
                                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                                <TextBlock Text="Nguồn NetTruyen Viet 10 (nettruyenviet10.com)" FontWeight="Bold" Foreground="#38BDF8" FontSize="12" />
                                                <TextBlock Text="Ví dụ: https://nettruyenviet10.com/truyen-tranh/vo-luyen-dinh-phong-1922" Foreground="#94A3B8" FontSize="11" />
                                                <TextBox Text="{Binding UrlInput}" PlaceholderText="Dán link truyện NetTruyen Viet 10..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4" Margin="0,0,6,0">
                                                        <TextBlock Text="🔍 LẤY LINK &amp; XEM TIẾN TRÌNH" FontSize="11" />
                                                    </Button>
                                                    <Button Command="{Binding GetMoreCommand}" Background="#059669" Foreground="#FFFFFF" Padding="10,5" CornerRadius="4">
                                                        <TextBlock Text="➕ Thêm vào Queue" FontSize="11" />
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </TabItem>

                                        <!-- loppytoonn.com -->
                                        <TabItem Header="loppytoonn.com" FontSize="11">
                                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                                <TextBlock Text="Nguồn LoppyToon (loppytoonn.com)" FontWeight="Bold" Foreground="#38BDF8" FontSize="12" />
                                                <TextBlock Text="Ví dụ: https://loppytoonn.com/truyen/buc-thu-ve-trong-dem" Foreground="#94A3B8" FontSize="11" />
                                                <TextBox Text="{Binding UrlInput}" PlaceholderText="Dán link truyện LoppyToon..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4" Margin="0,0,6,0">
                                                        <TextBlock Text="🔍 LẤY LINK &amp; XEM TIẾN TRÌNH" FontSize="11" />
                                                    </Button>
                                                    <Button Command="{Binding GetMoreCommand}" Background="#059669" Foreground="#FFFFFF" Padding="10,5" CornerRadius="4">
                                                        <TextBlock Text="➕ Thêm vào Queue" FontSize="11" />
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </TabItem>

                                        <!-- thuviensach.vn -->
                                        <TabItem Header="thuviensach.vn" FontSize="11">
                                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                                <TextBlock Text="Nguồn Thư Viện Sách / Dilib (thuviensach.vn / dilib.vn)" FontWeight="Bold" Foreground="#38BDF8" FontSize="12" />
                                                <TextBlock Text="Ví dụ: https://thuviensach.vn/truyen-tranh/tham-tu-lung-danh-conan.html" Foreground="#94A3B8" FontSize="11" />
                                                <TextBox Text="{Binding UrlInput}" PlaceholderText="Dán link truyện Thư Viện Sách..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4" Margin="0,0,6,0">
                                                        <TextBlock Text="🔍 LẤY LINK &amp; XEM TIẾN TRÌNH" FontSize="11" />
                                                    </Button>
                                                    <Button Command="{Binding GetMoreCommand}" Background="#059669" Foreground="#FFFFFF" Padding="10,5" CornerRadius="4">
                                                        <TextBlock Text="➕ Thêm vào Queue" FontSize="11" />
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </TabItem>

                                        <!-- loppytoonn.com -->
                                        <TabItem Header="loppytoonn.com" FontSize="11">
                                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                                <TextBlock Text="Nguồn LoppyToonn (loppytoonn.com)" FontWeight="Bold" Foreground="#38BDF8" FontSize="12" />
                                                <TextBlock Text="Ví dụ: https://loppytoonn.com/comic/..." Foreground="#94A3B8" FontSize="11" />
                                                <TextBox Text="{Binding UrlInput}" PlaceholderText="Dán link truyện LoppyToonn..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4" Margin="0,0,6,0">
                                                        <TextBlock Text="🔍 LẤY LINK &amp; XEM TIẾN TRÌNH" FontSize="11" />
                                                    </Button>
                                                    <Button Command="{Binding GetMoreCommand}" Background="#059669" Foreground="#FFFFFF" Padding="10,5" CornerRadius="4">
                                                        <TextBlock Text="➕ Thêm vào Queue" FontSize="11" />
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </TabItem>

                                        <!-- mangadex.org -->
                                        <TabItem Header="mangadex.org" FontSize="11">
                                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                                <TextBlock Text="Nguồn MangaDex Official (mangadex.org API)" FontWeight="Bold" Foreground="#38BDF8" FontSize="12" />
                                                <TextBlock Text="Ví dụ: https://mangadex.org/title/a1c7c817-4e59-43b7-9365-09675a149a6f/one-piece" Foreground="#94A3B8" FontSize="11" />
                                                <TextBox Text="{Binding UrlInput}" PlaceholderText="Dán link truyện MangaDex..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4" Margin="0,0,6,0">
                                                        <TextBlock Text="🔍 LẤY LINK &amp; XEM TIẾN TRÌNH" FontSize="11" />
                                                    </Button>
                                                    <Button Command="{Binding GetMoreCommand}" Background="#059669" Foreground="#FFFFFF" Padding="10,5" CornerRadius="4">
                                                        <TextBlock Text="➕ Thêm vào Queue" FontSize="11" />
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </TabItem>

                                        <!-- daomeoden -->
                                        <TabItem Header="daomeoden" FontSize="11">
                                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                                <TextBlock Text="Nguồn Đảo Mèo Đen (daomeoden.net)" FontWeight="Bold" Foreground="#38BDF8" FontSize="12" />
                                                <TextBlock Text="Ví dụ: https://daomeoden.net/truyen-tranh/con-gai-cua-boss-47593-0.html" Foreground="#94A3B8" FontSize="11" />
                                                <TextBox Text="{Binding UrlInput}" PlaceholderText="Dán link truyện Đảo Mèo Đen..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4" Margin="0,0,6,0">
                                                        <TextBlock Text="🔍 LẤY LINK &amp; XEM TIẾN TRÌNH" FontSize="11" />
                                                    </Button>
                                                    <Button Command="{Binding GetMoreCommand}" Background="#059669" Foreground="#FFFFFF" Padding="10,5" CornerRadius="4">
                                                        <TextBlock Text="➕ Thêm vào Queue" FontSize="11" />
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </TabItem>
                                    </TabControl>
                                </Border>
                            </TabItem>

                            <!-- 1.2 SOURCE HENTAI (SUBTABS DOMAIN) -->
                            <TabItem Header="🔞 Source Hentai" FontSize="12" FontWeight="SemiBold">
                                <Border Background="#131B2E" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                                    <TabControl Background="Transparent">
                                        <!-- vi-hentai -->
                                        <TabItem Header="vi-hentai" FontSize="11">
                                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                                <TextBlock Text="Nguồn Vi-Hentai (vi-hentai.pro / Packer Decoder)" FontWeight="Bold" Foreground="#F43F5E" FontSize="12" />
                                                <TextBlock Text="Ví dụ: https://vi-hentai.pro/truyen/..." Foreground="#94A3B8" FontSize="11" />
                                                <TextBox Text="{Binding UrlInput}" PlaceholderText="Dán link Vi-Hentai..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4">
                                                    <TextBlock Text="🔍 LẤY LINK &amp; XEM TIẾN TRÌNH" FontSize="11" />
                                                </Button>
                                            </StackPanel>
                                        </TabItem>

                                        <!-- damconuong.shop -->
                                        <TabItem Header="damconuong.shop" FontSize="11">
                                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                                <TextBlock Text="Nguồn Dâm Cô Nương (damconuong.shop)" FontWeight="Bold" Foreground="#F43F5E" FontSize="12" />
                                                <TextBlock Text="Ví dụ: https://damconuong.shop/truyen/..." Foreground="#94A3B8" FontSize="11" />
                                                <TextBox Text="{Binding UrlInput}" PlaceholderText="Dán link Dâm Cô Nương..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4">
                                                    <TextBlock Text="🔍 LẤY LINK &amp; XEM TIẾN TRÌNH" FontSize="11" />
                                                </Button>
                                            </StackPanel>
                                        </TabItem>

                                        <!-- sayhentai -->
                                        <TabItem Header="sayhentai" FontSize="11">
                                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                                <TextBlock Text="Nguồn SayHentai / Truyenggvn (sayhentai.cx)" FontWeight="Bold" Foreground="#F43F5E" FontSize="12" />
                                                <TextBlock Text="Ví dụ: https://sayhentai.cx/..." Foreground="#94A3B8" FontSize="11" />
                                                <TextBox Text="{Binding UrlInput}" PlaceholderText="Dán link SayHentai..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4">
                                                    <TextBlock Text="🔍 LẤY LINK &amp; XEM TIẾN TRÌNH" FontSize="11" />
                                                </Button>
                                            </StackPanel>
                                        </TabItem>

                                        <!-- HENTAIFORCE -->
                                        <TabItem Header="HENTAIFORCE" FontSize="11">
                                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                                <TextBlock Text="Nguồn HentaiForce (hentaiforce.net)" FontWeight="Bold" Foreground="#F43F5E" FontSize="12" />
                                                <TextBlock Text="Ví dụ: https://hentaiforce.net/view/..." Foreground="#94A3B8" FontSize="11" />
                                                <TextBox Text="{Binding UrlInput}" PlaceholderText="Dán link HentaiForce..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4">
                                                    <TextBlock Text="🔍 LẤY LINK &amp; XEM TIẾN TRÌNH" FontSize="11" />
                                                </Button>
                                            </StackPanel>
                                        </TabItem>

                                        <!-- hitomi.la -->
                                        <TabItem Header="hitomi.la" FontSize="11">
                                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                                <TextBlock Text="Nguồn Hitomi (hitomi.la)" FontWeight="Bold" Foreground="#F43F5E" FontSize="12" />
                                                <TextBlock Text="Ví dụ: https://hitomi.la/reader/..." Foreground="#94A3B8" FontSize="11" />
                                                <TextBox Text="{Binding UrlInput}" PlaceholderText="Dán link Hitomi..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4">
                                                    <TextBlock Text="🔍 LẤY LINK &amp; XEM TIẾN TRÌNH" FontSize="11" />
                                                </Button>
                                            </StackPanel>
                                        </TabItem>

                                        <!-- hentai2read -->
                                        <TabItem Header="hentai2read" FontSize="11">
                                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                                <TextBlock Text="Nguồn Hentai2Read (hentai2read.com)" FontWeight="Bold" Foreground="#F43F5E" FontSize="12" />
                                                <TextBlock Text="Ví dụ: https://hentai2read.com/..." Foreground="#94A3B8" FontSize="11" />
                                                <TextBox Text="{Binding UrlInput}" PlaceholderText="Dán link Hentai2Read..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4">
                                                    <TextBlock Text="🔍 LẤY LINK &amp; XEM TIẾN TRÌNH" FontSize="11" />
                                                </Button>
                                            </StackPanel>
                                        </TabItem>

                                        <!-- hentaiera -->
                                        <TabItem Header="hentaiera" FontSize="11">
                                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                                <TextBlock Text="Nguồn HentaiEra (hentaiera.com)" FontWeight="Bold" Foreground="#F43F5E" FontSize="12" />
                                                <TextBlock Text="Ví dụ: https://hentaiera.com/gallery/..." Foreground="#94A3B8" FontSize="11" />
                                                <TextBox Text="{Binding UrlInput}" PlaceholderText="Dán link HentaiEra..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4">
                                                    <TextBlock Text="🔍 LẤY LINK &amp; XEM TIẾN TRÌNH" FontSize="11" />
                                                </Button>
                                            </StackPanel>
                                        </TabItem>

                                        <!-- e-hentai.org -->
                                        <TabItem Header="e-hentai.org" FontSize="11">
                                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                                <TextBlock Text="Nguồn E-Hentai / ExHentai (e-hentai.org)" FontWeight="Bold" Foreground="#F43F5E" FontSize="12" />
                                                <TextBlock Text="Ví dụ: https://e-hentai.org/g/..." Foreground="#94A3B8" FontSize="11" />
                                                <TextBox Text="{Binding UrlInput}" PlaceholderText="Dán link E-Hentai..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4">
                                                    <TextBlock Text="🔍 LẤY LINK &amp; XEM TIẾN TRÌNH" FontSize="11" />
                                                </Button>
                                            </StackPanel>
                                        </TabItem>
                                    </TabControl>
                                </Border>
                            </TabItem>

                            <!-- 1.3 NOVEL SOURCE -->
                            <TabItem Header="📚 Novel Source" FontSize="12" FontWeight="SemiBold">
                                <Border Background="#131B2E" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Nguồn Tiểu Thuyết (Hako / Docln)" FontWeight="Bold" Foreground="#10B981" FontSize="12" />
                                        <TextBlock Text="Ví dụ: https://docln.net/truyen/..." Foreground="#94A3B8" FontSize="11" />
                                        <TextBox Text="{Binding UrlInput}" PlaceholderText="Dán link truyện chữ Hako / Docln..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                        <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4">
                                            <TextBlock Text="🔍 LẤY LINK NOVEL" FontSize="11" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </TabItem>

                            <!-- 1.4 SEARCH (TÌM KIẾM ĐA NGUỒN) -->
                            <TabItem Header="🔍 Tìm Kiếm (Search)" FontSize="12" FontWeight="SemiBold">
                                <Grid RowDefinitions="Auto, *" Margin="0,4,0,0">
                                    <Border Grid.Row="0" Background="#161F30" Padding="10" CornerRadius="6" BorderBrush="#1E293B" BorderThickness="1">
                                        <Grid RowDefinitions="Auto, Auto, Auto">
                                            <TextBox Grid.Row="0" Text="{Binding SourceSearchKeyword}" PlaceholderText="Nhập tên truyện cần tìm..." Height="34" CornerRadius="4" Background="#0F172A" Foreground="#F8FAFC" FontSize="11" Margin="0,0,0,6" />
                                            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                                                <Button Command="{Binding SearchSourceCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="4" Padding="10,5" Height="30" Margin="0,0,6,0">
                                                    <TextBlock Text="🔍 TÌM KIẾM" FontSize="11" />
                                                </Button>
                                                <Button Command="{Binding ImportSelectedSearchToQueueCommand}" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="4" Padding="10,5" Height="30" Margin="0,0,6,0">
                                                    <TextBlock Text="📥 NẠP VÀO QUEUE" FontSize="11" />
                                                </Button>
                                                <Button Command="{Binding OpenExternalSearchCommand}" CommandParameter="False" Background="#1E293B" Foreground="#38BDF8" CornerRadius="4" Padding="8,5" Height="30">
                                                    <TextBlock Text="🌐 Google site: search" FontSize="11" />
                                                </Button>
                                            </WrapPanel>
                                            <WrapPanel Grid.Row="2" Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding SearchTruyenqq}" Content="TruyenQQ" FontSize="10" Foreground="#D1D5DB" Margin="0,0,10,0" />
                                                <CheckBox IsChecked="{Binding SearchMangaDex}" Content="MangaDex" FontSize="10" Foreground="#D1D5DB" Margin="0,0,10,0" />
                                                <CheckBox IsChecked="{Binding SearchNettruyen}" Content="NetTruyen" FontSize="10" Foreground="#D1D5DB" Margin="0,0,10,0" />
                                                <CheckBox IsChecked="{Binding SearchHako}" Content="Hako" FontSize="10" Foreground="#D1D5DB" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Kết quả tìm kiếm -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MinHeight="260" Margin="0,6,0,0">
                                        <ItemsControl ItemsSource="{Binding SearchResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="8,5">
                                                        <Grid ColumnDefinitions="Auto, 75, *, Auto" VerticalAlignment="Center">
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <Border Grid.Column="1" Background="#1E293B" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Domain}" FontSize="9" Foreground="#38BDF8" FontWeight="SemiBold" />
                                                            </Border>
                                                            <StackPanel Grid.Column="2" Margin="4,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F1F5F9" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding LatestChapter}" Foreground="#94A3B8" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Border Grid.Column="3" Background="#064E3B" CornerRadius="3" Padding="5,2" VerticalAlignment="Center">
                                                                <TextBlock Text="Sẵn sàng" FontSize="9" Foreground="#34D399" FontWeight="SemiBold" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>

                            <!-- 1.5 PASSWORD / MẬT KHẨU -->
                            <TabItem Header="🔑 Password" FontSize="12" FontWeight="SemiBold">
                                <Border Background="#131B2E" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                                    <StackPanel Spacing="10" MaxWidth="500" HorizontalAlignment="Left">
                                        <TextBlock Text="Quản lý Mật khẩu &amp; Tài khoản VIP" FontWeight="Bold" Foreground="#F59E0B" FontSize="13" />
                                        <TextBlock Text="Lưu trữ tài khoản hoặc cookie dành cho các trang yêu cầu đăng nhập." Foreground="#94A3B8" FontSize="11" />
                                        <TextBox PlaceholderText="Tên đăng nhập / Email..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                        <TextBox PasswordChar="●" PlaceholderText="Mật khẩu..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                        <Button Content="💾 Lưu cấu hình mật khẩu" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="12,5" CornerRadius="4" />
                                    </StackPanel>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </Border>
                </TabItem>

                <!-- ========================================================================= -->
                <!-- [TAB 2 LỚN] TAB DOWNLOAD: DOWNLOAD MANGA, SPLIT/MERGE, SPLIT IMAGES, NOVEL -->
                <!-- ========================================================================= -->
                <TabItem Header="📥 TAB DOWNLOAD (TẢI VỀ &amp; QUẢN LÝ)" FontSize="13" FontWeight="Bold">
                    <Grid RowDefinitions="Auto, *">
                        <!-- Toolbar điều khiển tải chung -->
                        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="12,8">
                            <Grid RowDefinitions="Auto, Auto, Auto">
                                <!-- Main Download Action Buttons -->
                                <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Command="{Binding DownloadAllCommand}" Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="5" Padding="12,5" Height="30" Margin="0,0,6,3">
                                        <TextBlock Text="⬇️ TẢI TẤT CẢ" FontSize="11" />
                                    </Button>
                                    <Button Command="{Binding StopCommand}" Background="#DC2626" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="5" Padding="10,5" Height="30" Margin="0,0,6,3">
                                        <TextBlock Text="⏹️ DỪNG" FontSize="11" />
                                    </Button>
                                    <Button Command="{Binding RetryCommand}" Background="#D97706" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="5" Padding="10,5" Height="30" Margin="0,0,6,3">
                                        <TextBlock Text="🔄 THỬ LẠI" FontSize="11" />
                                    </Button>
                                    <Button Command="{Binding ClearQueueCommand}" Background="#374151" Foreground="#E5E7EB" CornerRadius="5" Padding="10,5" Height="30" Margin="0,0,6,3">
                                        <TextBlock Text="🧹 XÓA QUEUE" FontSize="11" />
                                    </Button>
                                    <Button Command="{Binding ChangeDownloadFolderCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="5" Padding="10,5" Height="30" Margin="0,0,6,3">
                                        <TextBlock Text="📁 ĐỔI THƯ MỤC" FontSize="11" />
                                    </Button>
                                    <Button Command="{Binding OpenDownloadRootCommand}" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Padding="10,5" Height="30" Margin="0,0,0,3">
                                        <TextBlock Text="📂 MỞ THƯ MỤC" FontSize="11" />
                                    </Button>
                                </WrapPanel>

                                <!-- Thư mục lưu hiện tại -->
                                <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,0,4">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <TextBlock Grid.Column="0" Text="📁 Lưu tại:" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding DownloadPathText}" FontSize="10" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2" Command="{Binding CopyDownloadPathCommand}" Background="#1E293B" Foreground="#94A3B8" Padding="5,1" FontSize="9" CornerRadius="3">
                                            <TextBlock Text="📋 Chép" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Toggles Checkboxes -->
                                <WrapPanel Grid.Row="2" Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsAutoDownload}" Content="⚡ Tự động tải" FontSize="10" Foreground="#D1D5DB" Margin="0,0,10,0" />
                                    <CheckBox IsChecked="{Binding IsAutoRetry}" Content="🔁 Tự thử lại" FontSize="10" Foreground="#D1D5DB" Margin="0,0,10,0" />
                                    <CheckBox IsChecked="{Binding IsCompactRow}" Content="📏 Nén dòng" FontSize="10" Foreground="#D1D5DB" Margin="0,0,10,0" />
                                    <CheckBox IsChecked="{Binding IsAutoSplitLongImages}" Content="✂️ Tự cắt ảnh dài" FontSize="10" Foreground="#F43F5E" FontWeight="SemiBold" Margin="0,0,6,0" ToolTip.Tip="Tự động cắt ảnh có chiều cao lớn hơn ngưỡng chỉ định thành các mảnh nhỏ trong khi tải" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding IsAutoSplitLongImages}">
                                        <TextBlock Text="Cao:" FontSize="10" Foreground="#F43F5E" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <NumericUpDown Value="{Binding AutoSplitHeight}" Minimum="500" Maximum="50000" Increment="500" FormatString="0" Width="125" Height="26" FontSize="11" Foreground="#38BDF8" Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                        <TextBlock Text="px" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    </StackPanel>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Subtabs bên trong Download Panel -->
                        <TabControl Grid.Row="1" Background="Transparent" Margin="0">

                            <!-- SUBTAB 2.1: DOWNLOAD MANGA QUEUE LIST -->
                            <TabItem Header="📋 Chờ Tải (Queue)" FontSize="12" FontWeight="SemiBold">
                                <Grid RowDefinitions="Auto, *">
                                    <!-- Toolbar chọn hàng -->
                                    <Border Grid.Row="0" Background="#161F30" Padding="10,5" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Command="{Binding SelectAllCommand}" Content="✓ Tất cả" Background="#1E293B" Foreground="#94A3B8" FontSize="10" Padding="5,2" CornerRadius="3" Margin="0,0,4,2" />
                                            <Button Command="{Binding UnselectAllCommand}" Content="✗ Bỏ chọn" Background="#1E293B" Foreground="#94A3B8" FontSize="10" Padding="5,2" CornerRadius="3" Margin="0,0,4,2" />
                                            <Button Command="{Binding InvertSelectionCommand}" Content="⇄ Đảo chọn" Background="#1E293B" Foreground="#94A3B8" FontSize="10" Padding="5,2" CornerRadius="3" Margin="0,0,4,2" />
                                            <Button Command="{Binding CheckSelectedRowsCommand}" Content="☑ Tích" Background="#1E293B" Foreground="#38BDF8" FontSize="10" Padding="5,2" CornerRadius="3" Margin="0,0,4,2" />
                                            <Button Command="{Binding CheckErrorsCommand}" Content="⚠️ Lỗi" Background="#1E293B" Foreground="#F43F5E" FontSize="10" Padding="5,2" CornerRadius="3" Margin="0,0,4,2" />
                                            <Button Command="{Binding CheckDuplicatesCommand}" Content="🔍 Trùng" Background="#1E293B" Foreground="#F59E0B" FontSize="10" Padding="5,2" CornerRadius="3" Margin="0,0,4,2" />
                                            <Button Command="{Binding DeleteSelectedCommand}" Content="🗑️ Xóa" Background="#1E293B" Foreground="#EF4444" FontSize="10" Padding="5,2" CornerRadius="3" Margin="0,0,0,2" />
                                        </WrapPanel>
                                    </Border>

                                    <!-- Danh sách các hàng truyện -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MinHeight="260">
                                        <ItemsControl ItemsSource="{Binding ComicBooks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="8,5">
                                                        <Grid ColumnDefinitions="Auto, Auto, *, Auto" VerticalAlignment="Center">
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Index, StringFormat='{}#{0}'}" Foreground="#64748B" FontSize="10" Width="24" VerticalAlignment="Center" />

                                                            <!-- Thông tin truyện -->
                                                            <StackPanel Grid.Column="2" Margin="4,0,8,0" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F1F5F9" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                    <Border IsVisible="{Binding IsDuplicate}" Background="#78350F" CornerRadius="2" Padding="3,1" VerticalAlignment="Center">
                                                                        <TextBlock Text="TRÙNG" FontSize="8" FontWeight="Bold" Foreground="#FDE047" />
                                                                    </Border>
                                                                </StackPanel>

                                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                                                    <Border Background="#1E293B" CornerRadius="2" Padding="3,1">
                                                                        <TextBlock Text="{Binding Domain}" FontSize="8" Foreground="#38BDF8" FontWeight="SemiBold" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding TotalChapters, StringFormat='{}{0} chaps'}" Foreground="#94A3B8" FontSize="9" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Status}" Foreground="#FCD34D" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                </StackPanel>

                                                                <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="2" CornerRadius="1" Foreground="#38BDF8" Background="#0F172A" Margin="0,2,0,0" />
                                                            </StackPanel>

                                                            <!-- Nút thao tác hàng -->
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                                <Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenBookFolderCommand}"
                                                                        CommandParameter="{Binding .}" ToolTip.Tip="Mở thư mục"
                                                                        Background="#1E293B" Foreground="#38BDF8" Padding="4,2" FontSize="9" CornerRadius="3">
                                                                    <TextBlock Text="📂" />
                                                                </Button>
                                                                <Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MoveUpCommand}"
                                                                        CommandParameter="{Binding .}"
                                                                        Background="#1E293B" Foreground="#94A3B8" Padding="4,2" FontSize="9" CornerRadius="3">
                                                                    <TextBlock Text="▲" />
                                                                </Button>
                                                                <Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MoveDownCommand}"
                                                                        CommandParameter="{Binding .}"
                                                                        Background="#1E293B" Foreground="#94A3B8" Padding="4,2" FontSize="9" CornerRadius="3">
                                                                    <TextBlock Text="▼" />
                                                                </Button>
                                                                <Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DeleteItemCommand}"
                                                                        CommandParameter="{Binding .}"
                                                                        Background="#1E293B" Foreground="#EF4444" Padding="4,2" FontSize="9" CornerRadius="3">
                                                                    <TextBlock Text="✕" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>

                            <!-- SUBTAB 2.2: SCAN MISSING INTEGER CHAPTER -->
                            <TabItem Header="🔍 Scan Thiếu Chap" FontSize="12" FontWeight="SemiBold">
                                <Grid RowDefinitions="Auto, *">
                                    <Border Grid.Row="0" Background="#161F30" Padding="10,5" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Command="{Binding StartScanMissingCommand}" Content="▶ Quét ngay" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" Padding="8,3" CornerRadius="3" Margin="0,0,8,2" />
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,2">
                                                <TextBlock Text="Song song:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                                                <NumericUpDown Value="{Binding ParallelCheckCount}" Minimum="1" Maximum="16" Width="80" Height="24" FontSize="10" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ScanResults.Count, StringFormat='{}Đã quét: {0}'}" Foreground="#10B981" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" />
                                        </WrapPanel>
                                    </Border>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MinHeight="260">
                                        <ItemsControl ItemsSource="{Binding ScanResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="8,5">
                                                        <Grid ColumnDefinitions="25, 75, *, Auto" VerticalAlignment="Center">
                                                            <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='{}#{0}'}" Foreground="#64748B" FontSize="10" VerticalAlignment="Center" />
                                                            <Border Grid.Column="1" Background="#1E293B" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Domain}" FontSize="8" Foreground="#38BDF8" FontWeight="SemiBold" />
                                                            </Border>
                                                            <StackPanel Grid.Column="2" Margin="4,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F1F5F9" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding MissingIntegerChapters, StringFormat='{}Thiếu: {0}'}" Foreground="#FDE047" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Border Grid.Column="3" Background="#1E293B" CornerRadius="3" Padding="5,2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Status}" FontSize="9" Foreground="#10B981" FontWeight="SemiBold" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>

                            <!-- SUBTAB 2.3: REALTIME LOGS -->
                            <TabItem Header="📜 Nhật Ký (Logs)" FontSize="12" FontWeight="SemiBold">
                                <Grid RowDefinitions="Auto, *">
                                    <Border Grid.Row="0" Background="#161F30" Padding="10,4" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Grid.Column="0" Text="Nhật ký các sự kiện tải xuống &amp; scan" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Command="{Binding ClearLogsCommand}" Content="🧹 Xóa log" Background="#1E293B" Foreground="#94A3B8" FontSize="9" Padding="6,2" CornerRadius="3" />
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1" Background="#0A0E17" Padding="6" MinHeight="260">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Logs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="50, 55, *" Margin="0,1">
                                                            <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="#64748B" FontSize="9" FontFamily="Consolas, Monospace" VerticalAlignment="Center" />
                                                            <Border Grid.Column="1" CornerRadius="2" Padding="2,1" HorizontalAlignment="Left" Background="#1E293B" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Level}" FontSize="8" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="#E2E8F0" FontSize="9" FontFamily="Consolas, Monospace" TextWrapping="Wrap" VerticalAlignment="Center" Margin="3,0,0,0" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- SUBTAB 2.4: FOLDER TOOLS (SPLIT / MERGE) -->
                            <TabItem Header="📁 Split / Merge Folder" FontSize="12" FontWeight="SemiBold">
                                <Border Background="#131B2E" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                                    <StackPanel Spacing="8" MaxWidth="550" HorizontalAlignment="Left">
                                        <TextBlock Text="Công cụ Gộp / Tách Thư mục Truyện" FontWeight="Bold" Foreground="#38BDF8" FontSize="13" />
                                        <TextBlock Text="Chuyển đổi cấu trúc thư mục giữa 'Single comic' (root/book/chapter) và 'Multi-comic' (root/book-chapter)." Foreground="#94A3B8" FontSize="11" />
                                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="🔄 Chuyển sang Single comic (Gộp)" Background="#0284C7" Foreground="#FFFFFF" Padding="10,5" CornerRadius="4" Margin="0,0,8,0" />
                                            <Button Content="📂 Chuyển sang Multi-comic (Tách)" Background="#1E293B" Foreground="#38BDF8" Padding="10,5" CornerRadius="4" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </TabItem>

                            <!-- SUBTAB 2.5: SPLIT LONG IMAGES (FULL WORKFLOW) -->
                            <TabItem Header="✂️ Cắt Ảnh Dài" FontSize="12" FontWeight="SemiBold">
                                <Grid RowDefinitions="Auto, *">
                                    <!-- Panel cấu hình -->
                                    <Border Grid.Row="0" Background="#161F30" Padding="12,10" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                                        <StackPanel Spacing="8">
                                            <!-- Chọn thư mục -->
                                            <Grid ColumnDefinitions="*, Auto, Auto">
                                                <TextBox Grid.Column="0" Text="{Binding ManualSplitFolderPath}" PlaceholderText="Chọn thư mục chứa ảnh dài để cắt..." Height="34" CornerRadius="4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#38BDF8" BorderThickness="1" FontSize="11" Margin="0,0,6,0" VerticalContentAlignment="Center" Padding="8,4" />
                                                <Button Grid.Column="1" Command="{Binding BrowseManualSplitFolderCommand}" Content="📁 Chọn Thư Mục" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="12,5" Height="34" CornerRadius="4" Margin="0,0,6,0" />
                                                <Button Grid.Column="2" Command="{Binding OpenManualSplitFolderCommand}" Content="📂 Mở" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" Padding="10,5" Height="34" CornerRadius="4" ToolTip.Tip="Mở thư mục trên thiết bị" />
                                            </Grid>

                                            <!-- Cấu hình Height, Quality, Threads & Nút Bắt đầu -->
                                            <WrapPanel Orientation="Horizontal">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="0,0,16,6">
                                                    <TextBlock Text="Chiều cao cắt (Height):" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                    <NumericUpDown Value="{Binding ManualSplitHeight}" Minimum="500" Maximum="50000" Increment="500" FormatString="0" Width="135" Height="28" FontSize="11" Foreground="#38BDF8" Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                    <TextBlock Text="px" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="0,0,16,6">
                                                    <TextBlock Text="Chất lượng (Quality):" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                    <NumericUpDown Value="{Binding ManualSplitQuality}" Minimum="10" Maximum="100" Increment="5" FormatString="0" Width="110" Height="28" FontSize="11" Foreground="#10B981" Background="#0F172A" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                    <TextBlock Text="%" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="0,0,16,6">
                                                    <TextBlock Text="Số luồng (Threads):" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                    <NumericUpDown Value="{Binding ManualSplitThreads}" Minimum="1" Maximum="16" Increment="1" FormatString="0" Width="100" Height="28" FontSize="11" Foreground="#F59E0B" Background="#0F172A" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                </StackPanel>

                                                <Button Command="{Binding StartManualSplitCommand}" IsEnabled="{Binding !IsManualSplitting}"
                                                        Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="14,6" Height="30" CornerRadius="4" Margin="0,0,6,6">
                                                    <TextBlock Text="▶ BẮT ĐẦU CẮT ẢNH" />
                                                </Button>

                                                <Button Command="{Binding StopManualSplitCommand}" IsEnabled="{Binding IsManualSplitting}"
                                                        Background="#DC2626" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="12,6" Height="30" CornerRadius="4" Margin="0,0,6,6">
                                                    <TextBlock Text="⏹ DỪNG" />
                                                </Button>

                                                <Button Command="{Binding ClearManualSplitLogsCommand}"
                                                        Background="#1E293B" Foreground="#94A3B8" FontSize="11" Padding="10,6" Height="30" CornerRadius="4" Margin="0,0,0,6">
                                                    <TextBlock Text="🧹 Xóa log" />
                                                </Button>
                                            </WrapPanel>

                                            <!-- Thanh tiến trình & Trạng thái -->
                                            <Grid ColumnDefinitions="*, Auto" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Spacing="3">
                                                    <ProgressBar Value="{Binding ManualSplitProgress}" Maximum="100" Height="6" CornerRadius="3" Foreground="#10B981" Background="#0F172A" />
                                                    <TextBlock Text="{Binding ManualSplitCurrentFileText}" Foreground="#64748B" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ManualSplitProgressText}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" />
                                                    <TextBlock Text="{Binding ManualSplitCountText, StringFormat='{}Đã cắt: {0}'}" Foreground="#10B981" FontWeight="SemiBold" FontSize="10" />
                                                    <TextBlock Text="{Binding ManualSplitErrorCountText, StringFormat='{}Lỗi: {0}'}" Foreground="#F43F5E" FontWeight="SemiBold" FontSize="10" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Log chi tiết -->
                                    <Border Grid.Row="1" Background="#0A0E17" Padding="6" MinHeight="220">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ManualSplitLogs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Foreground="#CBD5E1" FontSize="10" FontFamily="Consolas, Monospace" Margin="2,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- SUBTAB 2.6: BATCH IMAGE ENHANCEMENT (DẠNG 2) -->
                            <TabItem Header="🎨 Xử Lý Ảnh" FontSize="12" FontWeight="SemiBold">
                                <Grid RowDefinitions="Auto, *">
                                    <!-- Panel cấu hình bộ lọc & tác vụ -->
                                    <Border Grid.Row="0" Background="#161F30" Padding="12,10" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                                        <StackPanel Spacing="10">
                                            <!-- Hàng 1: Thư mục nguồn (Input Folder) -->
                                            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                                <TextBlock Grid.Column="0" Text="📥 Thư mục nguồn:" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" Width="125" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{Binding EnhanceFolderPath}" PlaceholderText="Chọn thư mục nguồn chứa ảnh (hỗ trợ quét đệ quy đa tầng)..." Height="34" CornerRadius="4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#38BDF8" BorderThickness="1" FontSize="11" Margin="0,0,6,0" VerticalContentAlignment="Center" Padding="8,4" />
                                                <Button Grid.Column="2" Command="{Binding BrowseEnhanceFolderCommand}" Content="📁 Chọn Thư Mục" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="12,5" Height="34" CornerRadius="4" Margin="0,0,6,0" />
                                                <Button Grid.Column="3" Command="{Binding OpenEnhanceFolderCommand}" Content="📂 Mở" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" Padding="10,5" Height="34" CornerRadius="4" ToolTip.Tip="Mở thư mục nguồn trên thiết bị" />
                                            </Grid>

                                            <!-- Hàng 2: Thư mục đích (Output Folder) & Tùy chọn ghi đè -->
                                            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto">
                                                <TextBlock Grid.Column="0" Text="📤 Thư mục lưu:" Foreground="#10B981" FontWeight="SemiBold" FontSize="11" Width="125" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{Binding EnhanceOutputFolderPath}" IsEnabled="{Binding !EnhanceOverwriteOriginal}" PlaceholderText="Chọn thư mục lưu ảnh (mặc định: thư mục con 'Enhanced' bên trong nguồn)..." Height="34" CornerRadius="4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#10B981" BorderThickness="1" FontSize="11" Margin="0,0,6,0" VerticalContentAlignment="Center" Padding="8,4" />
                                                <Button Grid.Column="2" Command="{Binding BrowseEnhanceOutputFolderCommand}" IsEnabled="{Binding !EnhanceOverwriteOriginal}" Content="📁 Chọn Thư Mục" Background="#059669" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="12,5" Height="34" CornerRadius="4" Margin="0,0,6,0" />
                                                <Button Grid.Column="3" Command="{Binding OpenEnhanceOutputFolderCommand}" Content="📂 Mở" Background="#1E293B" Foreground="#10B981" FontWeight="SemiBold" FontSize="11" Padding="10,5" Height="34" CornerRadius="4" Margin="0,0,8,0" ToolTip.Tip="Mở thư mục lưu ảnh trên thiết bị" />
                                                <CheckBox Grid.Column="4" IsChecked="{Binding EnhanceOverwriteOriginal}" Content="⚡ Ghi đè file gốc" Foreground="#F59E0B" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" ToolTip.Tip="Nếu chọn, ảnh sẽ được ghi đè trực tiếp vào vị trí gốc. Nếu bỏ chọn, ảnh lưu vào thư mục đích." />
                                            </Grid>

                                            <!-- Hàng 3: Bộ 5 thông số (Sliders & Numeric) - Căn giữa dọc và tăng chiều cao chuẩn đẹp -->
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Contrast -->
                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,6" MinHeight="68" VerticalAlignment="Center">
                                                    <StackPanel Width="155" Spacing="4" VerticalAlignment="Center">
                                                        <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                                            <TextBlock Grid.Column="0" Text="Tương phản (Contrast):" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding EnhanceContrast, StringFormat='{}{0:0}%'}" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <Slider Value="{Binding EnhanceContrast}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Height="26" VerticalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Brightness -->
                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,6" MinHeight="68" VerticalAlignment="Center">
                                                    <StackPanel Width="155" Spacing="4" VerticalAlignment="Center">
                                                        <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                                            <TextBlock Grid.Column="0" Text="Độ sáng (Brightness):" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding EnhanceBrightness, StringFormat='{}{0:0}'}" Foreground="#FCD34D" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <Slider Value="{Binding EnhanceBrightness}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Height="26" VerticalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Saturation -->
                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,6" MinHeight="68" VerticalAlignment="Center">
                                                    <StackPanel Width="155" Spacing="4" VerticalAlignment="Center">
                                                        <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                                            <TextBlock Grid.Column="0" Text="Độ bão hòa (Saturation):" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding EnhanceSaturation, StringFormat='{}{0:0}%'}" Foreground="#EC4899" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <Slider Value="{Binding EnhanceSaturation}" Minimum="0" Maximum="200" SmallChange="1" LargeChange="10" Height="26" VerticalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Sharpness -->
                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,6" MinHeight="68" VerticalAlignment="Center">
                                                    <StackPanel Width="155" Spacing="4" VerticalAlignment="Center">
                                                        <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                                            <TextBlock Grid.Column="0" Text="Độ nét (Sharpness):" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding EnhanceSharpness, StringFormat='{}{0:0.0}'}" Foreground="#10B981" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <Slider Value="{Binding EnhanceSharpness}" Minimum="0" Maximum="10" SmallChange="0.5" LargeChange="1" Height="26" VerticalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Noise Reduce -->
                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,6" MinHeight="68" VerticalAlignment="Center">
                                                    <StackPanel Width="155" Spacing="4" VerticalAlignment="Center">
                                                        <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                                            <TextBlock Grid.Column="0" Text="Khử nhiễu (Noise):" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding EnhanceNoiseReduce, StringFormat='{}Mức {0}'}" Foreground="#A855F7" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <Slider Value="{Binding EnhanceNoiseReduce}" Minimum="0" Maximum="5" SmallChange="1" LargeChange="1" Height="26" VerticalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Quality -->
                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,6" MinHeight="68" VerticalAlignment="Center">
                                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="Chất lượng ảnh:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                            <NumericUpDown Value="{Binding EnhanceQuality}" Minimum="10" Maximum="100" Increment="5" FormatString="0" Width="105" Height="28" FontSize="11" Foreground="#38BDF8" Background="#0B0F19" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                            <TextBlock Text="%" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Threads -->
                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,6" MinHeight="68" VerticalAlignment="Center">
                                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="Số luồng CPU:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                                                        <NumericUpDown Value="{Binding EnhanceThreads}" Minimum="1" Maximum="16" Increment="1" FormatString="0" Width="95" Height="28" FontSize="11" Foreground="#F59E0B" Background="#0B0F19" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Đặt lại mặc định -->
                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6" MinHeight="68" VerticalAlignment="Center">
                                                    <Button Command="{Binding ResetEnhanceSettingsCommand}" Background="#1E293B" Foreground="#94A3B8" FontSize="10" Padding="10,6" Height="32" CornerRadius="4" VerticalAlignment="Center" ToolTip.Tip="Khôi phục toàn bộ thông số về mặc định">
                                                        <TextBlock Text="🔄 Đặt lại" VerticalAlignment="Center" />
                                                    </Button>
                                                </Border>
                                            </WrapPanel>

                                            <!-- Hàng 4: Các nút hành động chính (Bắt đầu, Dừng, Đổi ảnh mẫu, Toàn màn hình đối chiếu, Mở cửa sổ riêng) -->
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Command="{Binding StartEnhanceCommand}" IsEnabled="{Binding !IsEnhancing}"
                                                        Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="14,6" Height="32" CornerRadius="4" Margin="0,0,8,6">
                                                    <TextBlock Text="▶ BẮT ĐẦU XỬ LÝ ẢNH" />
                                                </Button>

                                                <Button Command="{Binding StopEnhanceCommand}" IsEnabled="{Binding IsEnhancing}"
                                                        Background="#DC2626" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="12,6" Height="32" CornerRadius="4" Margin="0,0,8,6">
                                                    <TextBlock Text="⏹ DỪNG" />
                                                </Button>

                                                <Button Command="{Binding PickSampleImageCommand}"
                                                        Background="#4F46E5" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="12,6" Height="32" CornerRadius="4" Margin="0,0,8,6" ToolTip.Tip="Chọn một ảnh cụ thể để xem trước Before / After">
                                                    <TextBlock Text="👁️ Chọn ảnh mẫu xem trước" />
                                                </Button>

                                                <Button Command="{Binding ToggleFullscreenPreviewCommand}"
                                                        Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="12,6" Height="32" CornerRadius="4" Margin="0,0,8,6" ToolTip.Tip="Mở chế độ đối chiếu toàn màn hình trực tiếp trong ứng dụng">
                                                    <TextBlock Text="⛶ TOÀN MÀN HÌNH ĐỐI CHIẾU" />
                                                </Button>

                                                <Button Command="{Binding OpenComparisonWindowCommand}"
                                                        Background="#374151" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" Padding="10,6" Height="32" CornerRadius="4" Margin="0,0,8,6" ToolTip.Tip="Mở cửa sổ đối chiếu độc lập trên Desktop (hỗ trợ kéo sang màn hình thứ 2)">
                                                    <TextBlock Text="🪟 Mở Cửa Sổ Riêng" />
                                                </Button>

                                                <Button Command="{Binding ClearEnhanceLogsCommand}"
                                                        Background="#1E293B" Foreground="#94A3B8" FontSize="11" Padding="10,6" Height="32" CornerRadius="4" Margin="0,0,0,6">
                                                    <TextBlock Text="🧹 Xóa log" />
                                                </Button>
                                            </WrapPanel>

                                            <!-- Thanh tiến trình & Trạng thái -->
                                            <Grid ColumnDefinitions="*, Auto" Margin="0,2,0,0">
                                                <StackPanel Grid.Column="0" Spacing="3">
                                                    <ProgressBar Value="{Binding EnhanceProgress}" Maximum="100" Height="6" CornerRadius="3" Foreground="#38BDF8" Background="#0F172A" />
                                                    <TextBlock Text="{Binding EnhanceCurrentFileText}" Foreground="#64748B" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding EnhanceProgressText}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" />
                                                    <TextBlock Text="{Binding EnhanceCountText, StringFormat='{}Đã xong: {0}'}" Foreground="#10B981" FontWeight="SemiBold" FontSize="10" />
                                                    <TextBlock Text="{Binding EnhanceErrorCountText, StringFormat='{}Lỗi: {0}'}" Foreground="#F43F5E" FontWeight="SemiBold" FontSize="10" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Khung nội dung dưới: Live Preview Before / After có Zoom & Pan & Log -->
                                    <Grid Grid.Row="1" RowDefinitions="Auto, *">
                                        <!-- Khung so sánh trực quan Trước & Sau (Live Preview có Zoom, Pan, Navigation & Stats) -->
                                        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="10,8">
                                            <StackPanel Spacing="6">
                                                <!-- Hàng 1: Tiêu đề, Duyệt ảnh, Zoom & Thao tác -->
                                                <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                                                    <TextBlock Grid.Column="0" Text="⚡ Xem trước trực tiếp (Live Preview):" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    
                                                    <!-- Navigation Previous / Next -->
                                                    <Border Grid.Column="1" Background="#1E293B" CornerRadius="4" Padding="4,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <Button Command="{Binding PreviousImageCommand}" IsEnabled="{Binding CanGoPrevious}" Content="⬅" Background="#0F172A" Foreground="#38BDF8" FontWeight="Bold" Padding="6,2" FontSize="10" CornerRadius="3" ToolTip.Tip="Ảnh trước" />
                                                            <TextBlock Text="{Binding EnhanceImageIndexText}" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" Margin="4,0" />
                                                            <Button Command="{Binding NextImageCommand}" IsEnabled="{Binding CanGoNext}" Content="➡" Background="#0F172A" Foreground="#38BDF8" FontWeight="Bold" Padding="6,2" FontSize="10" CornerRadius="3" ToolTip.Tip="Ảnh tiếp theo" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Presets nhanh -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="⚡ Presets:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0" />
                                                        <Button Command="{Binding ApplyPresetDefaultCommand}" Content="🔘 Gốc" Background="#1E293B" Foreground="#E2E8F0" FontSize="9" Padding="6,2" CornerRadius="3" ToolTip.Tip="Thông số gốc" />
                                                        <Button Command="{Binding ApplyPresetOldScanCommand}" Content="📜 Khử ố scan" Background="#854D0E" Foreground="#FEF08A" FontWeight="Bold" FontSize="9" Padding="6,2" CornerRadius="3" ToolTip.Tip="Làm trắng nền giấy scan cũ" />
                                                        <Button Command="{Binding ApplyPresetWebtoonCommand}" Content="🎨 Webtoon" Background="#831843" Foreground="#FBCFE8" FontWeight="Bold" FontSize="9" Padding="6,2" CornerRadius="3" ToolTip.Tip="Rực rỡ màu sắc webtoon" />
                                                        <Button Command="{Binding ApplyPresetNightCommand}" Content="🌙 Đọc đêm" Background="#1E1B4B" Foreground="#C7D2FE" FontWeight="Bold" FontSize="9" Padding="6,2" CornerRadius="3" ToolTip.Tip="Hạ sáng dịu mắt" />
                                                    </StackPanel>
                                                    
                                                    <!-- Bộ điều khiển Zoom -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <Button Command="{Binding ResetZoomPreviewCommand}" Content="1:1" Background="#1E293B" Foreground="#10B981" Padding="5,2" FontSize="10" CornerRadius="3" ToolTip.Tip="Tỷ lệ 100%" />
                                                        <Button Command="{Binding ZoomFitPreviewCommand}" Content="⛶ Fit" Background="#1E293B" Foreground="#F59E0B" Padding="5,2" FontSize="10" CornerRadius="3" ToolTip.Tip="Tự co vừa khung" />
                                                        <Button Command="{Binding ZoomOutPreviewCommand}" Content="➖" Background="#1E293B" Foreground="#94A3B8" Padding="5,2" FontSize="11" CornerRadius="3" ToolTip.Tip="Thu nhỏ" />
                                                        <Border Background="#1E293B" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding EnhancePreviewZoomText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" Width="36" TextAlignment="Center" />
                                                        </Border>
                                                        <Button Command="{Binding ZoomInPreviewCommand}" Content="➕" Background="#1E293B" Foreground="#38BDF8" Padding="5,2" FontSize="11" CornerRadius="3" ToolTip.Tip="Phóng to" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Hàng 2: FastStone Info Bar (Dung lượng Before vs After) -->
                                                <Grid ColumnDefinitions="Auto, Auto, Auto, *">
                                                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding EnhanceBeforeInfoText}" Foreground="#94A3B8" FontSize="10" />
                                                    </Border>
                                                    <Border Grid.Column="1" Background="#0C4A6E" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding EnhanceAfterInfoText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" />
                                                    </Border>
                                                    <Border Grid.Column="2" Background="#1E293B" CornerRadius="3" Padding="6,2">
                                                        <TextBlock Text="{Binding EnhanceClippingInfoText}" Foreground="#FCD34D" FontWeight="Bold" FontSize="10" />
                                                    </Border>
                                                </Grid>

                                                <Grid ColumnDefinitions="*, *" Margin="0,4,0,0">
                                                    <!-- Before -->
                                                    <Border Grid.Column="0" Background="#090D16" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,5,0">
                                                        <StackPanel Spacing="4">
                                                            <Border Background="#1E293B" CornerRadius="3" Padding="4,2" HorizontalAlignment="Left">
                                                                <TextBlock Text="📷 ẢNH GỐC (BEFORE)" Foreground="#94A3B8" FontWeight="Bold" FontSize="9" />
                                                            </Border>
                                                            <ScrollViewer Height="260" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#050811" CornerRadius="4">
                                                                <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <LayoutTransformControl.LayoutTransform>
                                                                        <ScaleTransform ScaleX="{Binding EnhancePreviewZoom}" ScaleY="{Binding EnhancePreviewZoom}" />
                                                                    </LayoutTransformControl.LayoutTransform>
                                                                    <Image Source="{Binding EnhancePreviewOriginal}" Stretch="None" />
                                                                </LayoutTransformControl>
                                                            </ScrollViewer>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- After -->
                                                    <Border Grid.Column="1" Background="#090D16" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" Padding="6" Margin="5,0,0,0">
                                                        <StackPanel Spacing="4">
                                                            <Border Background="#0284C7" CornerRadius="3" Padding="4,2" HorizontalAlignment="Left">
                                                                <TextBlock Text="✨ ĐÃ TỐI ƯU (AFTER)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9" />
                                                            </Border>
                                                            <ScrollViewer Height="260" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#050811" CornerRadius="4">
                                                                <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <LayoutTransformControl.LayoutTransform>
                                                                        <ScaleTransform ScaleX="{Binding EnhancePreviewZoom}" ScaleY="{Binding EnhancePreviewZoom}" />
                                                                    </LayoutTransformControl.LayoutTransform>
                                                                    <Image Source="{Binding EnhancePreviewResult}" Stretch="None" />
                                                                </LayoutTransformControl>
                                                            </ScrollViewer>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Khung log chi tiết -->
                                        <Border Grid.Row="1" Background="#0A0E17" Padding="6" MinHeight="140">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding EnhanceLogs}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" Foreground="#CBD5E1" FontSize="10" FontFamily="Consolas, Monospace" Margin="2,1" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- 4. FOOTER STATUS BAR -->
            <Border Grid.Row="3" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="12,5">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalBooks, StringFormat='{}Tổng: {0}'}" FontSize="10" Foreground="#94A3B8" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding DownloadingCount, StringFormat='{}Đang tải: {0}'}" FontSize="10" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding CompletedCount, StringFormat='{}Hoàn tất: {0}'}" FontSize="10" Foreground="#10B981" FontWeight="SemiBold" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding ErrorCount, StringFormat='{}Lỗi: {0}'}" FontSize="10" Foreground="#F43F5E" FontWeight="SemiBold" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding DownloadSpeedText, StringFormat='{}Tốc độ: {0}'}" FontSize="10" Foreground="#F59E0B" />
                </WrapPanel>
            </Border>
        </Grid>
    </ScrollViewer>

        <!-- 5. MODAL POPUP: MANGADEX LANGUAGE SELECTION DIALOG -->
        <Border Background="#CC000000" IsVisible="{Binding IsMangadexPromptVisible}" ZIndex="999" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="#111827" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="10" 
                    Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" MaxWidth="450"
                    BoxShadow="0 10 25 #80000000">
                <StackPanel Spacing="14">
                    <!-- Title Header -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Background="#38BDF8" CornerRadius="4" Width="24" Height="24">
                            <TextBlock Text="🌐" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="MangaDex - Chọn Ngôn Ngữ Tải" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Phát hiện liên kết MangaDex. Vui lòng chọn ngôn ngữ bản dịch của các chương bạn muốn tải về:" 
                               Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />

                    <!-- Options -->
                    <Border Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <StackPanel Spacing="10">
                            <!-- Tiếng Việt -->
                            <Button Command="{Binding SelectMangadexViCommand}" Background="Transparent" Padding="0" Cursor="Hand" HorizontalAlignment="Stretch">
                                <Grid ColumnDefinitions="Auto, *">
                                    <RadioButton Grid.Column="0" IsChecked="{Binding MangadexLangVi}" GroupName="mdLang" IsHitTestVisible="False" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="🇻🇳 Tiếng Việt (Vietnamese)" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" />
                                        <TextBlock Text="Ưu tiên tải các chương truyện bản dịch tiếng Việt" FontSize="10" Foreground="#64748B" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Border Height="1" Background="#1E293B" />

                            <!-- Tiếng Anh -->
                            <Button Command="{Binding SelectMangadexEnCommand}" Background="Transparent" Padding="0" Cursor="Hand" HorizontalAlignment="Stretch">
                                <Grid ColumnDefinitions="Auto, *">
                                    <RadioButton Grid.Column="0" IsChecked="{Binding MangadexLangEn}" GroupName="mdLang" IsHitTestVisible="False" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="🇬🇧 Tiếng Anh (English)" FontWeight="Bold" FontSize="12" Foreground="#F59E0B" />
                                        <TextBlock Text="Ưu tiên tải các chương truyện bản dịch tiếng Anh" FontSize="10" Foreground="#64748B" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Fallback Option -->
                    <CheckBox IsChecked="{Binding MangadexFallback}" Margin="2,0,0,0">
                        <TextBlock Text="Tự động tải ngôn ngữ còn lại nếu không có bản dịch đã chọn" FontSize="10.5" Foreground="#CBD5E1" TextWrapping="Wrap" />
                    </CheckBox>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*, *" Margin="0,6,0,0">
                        <Button Grid.Column="0" Command="{Binding CancelMangadexLanguageCommand}" 
                                Background="#1E293B" BorderBrush="#334155" BorderThickness="1" 
                                Foreground="#94A3B8" Padding="12,7" CornerRadius="6" HorizontalAlignment="Stretch" Margin="0,0,6,0">
                            <TextBlock Text="❌ HỦY BỎ" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </Button>

                        <Button Grid.Column="1" Command="{Binding ConfirmMangadexLanguageCommand}" 
                                Background="#0284C7" BorderBrush="#38BDF8" BorderThickness="1" 
                                Foreground="#FFFFFF" Padding="12,7" CornerRadius="6" HorizontalAlignment="Stretch" Margin="6,0,0,0">
                            <TextBlock Text="✅ XÁC NHẬN" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- 6. MODAL POPUP: TOÀN MÀN HÌNH ĐỐI CHIẾU ẢNH BEFORE / AFTER (FASTSTONE CONVERSION PREVIEW) -->
        <Border Background="#F20B0F19" IsVisible="{Binding IsEnhanceFullscreenVisible}" ZIndex="1000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid RowDefinitions="Auto, Auto, Auto, *">
                <!-- ROW 0: Header Toolbar (FastStone Style) -->
                <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="12,8">
                    <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                        <!-- Cột 0: Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Border Background="#38BDF8" CornerRadius="4" Width="26" Height="26">
                                <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="CONVERSION PREVIEW (TOÀN MÀN HÌNH)" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Cột 1: Navigation Previous / Next -->
                        <Border Grid.Column="1" Background="#1E293B" CornerRadius="5" Padding="4,2" Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Command="{Binding PreviousImageCommand}" IsEnabled="{Binding CanGoPrevious}"
                                        Content="⬅" Background="#0F172A" Foreground="#38BDF8" FontWeight="Bold" Padding="8,4" FontSize="12" CornerRadius="3" ToolTip.Tip="Ảnh trước" />
                                <TextBlock Text="{Binding EnhanceImageIndexText}" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="4,0" />
                                <Button Command="{Binding NextImageCommand}" IsEnabled="{Binding CanGoNext}"
                                        Content="➡" Background="#0F172A" Foreground="#38BDF8" FontWeight="Bold" Padding="8,4" FontSize="12" CornerRadius="3" ToolTip.Tip="Ảnh tiếp theo" />
                            </StackPanel>
                        </Border>

                        <!-- Cột 2: Chế độ xem & Bộ Zoom FastStone -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" VerticalAlignment="Center">
                            <!-- Chế độ xem -->
                            <Border Background="#1E293B" CornerRadius="5" Padding="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Command="{Binding SetViewModeDualCommand}" Content="⏸ Song song"
                                            Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" Padding="8,4" CornerRadius="3" ToolTip.Tip="Xem 2 ảnh Trước / Sau song song" />
                                    <Button Command="{Binding SetViewModeSplitCommand}" Content="⮂ Rèm trượt"
                                            Foreground="#A855F7" FontWeight="SemiBold" FontSize="11" Padding="8,4" CornerRadius="3" ToolTip.Tip="Thanh rèm đối chiếu Before / After" />
                                    <Button Command="{Binding SetViewModeSingleCommand}" Content="⏹ Ảnh đơn"
                                            Foreground="#10B981" FontWeight="SemiBold" FontSize="11" Padding="8,4" CornerRadius="3" ToolTip.Tip="Ảnh đơn: Xem After hoặc hoán đổi Before" />
                                </StackPanel>
                            </Border>

                            <!-- Bộ công cụ Zoom -->
                            <Border Background="#1E293B" CornerRadius="5" Padding="4,2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Command="{Binding ResetZoomPreviewCommand}" Content="1:1" Background="#0F172A" Foreground="#10B981" FontWeight="Bold" Padding="7,4" FontSize="11" CornerRadius="3" ToolTip.Tip="Kích thước thực 100%" />
                                    <Button Command="{Binding ZoomFitPreviewCommand}" Content="⛶ Vừa khung" Background="#0F172A" Foreground="#F59E0B" FontWeight="Bold" Padding="7,4" FontSize="11" CornerRadius="3" ToolTip.Tip="Tự co vừa cửa sổ" />
                                    <Button Command="{Binding ZoomOutPreviewCommand}" Content="➖" Background="#0F172A" Foreground="#94A3B8" Padding="7,4" FontSize="12" CornerRadius="3" ToolTip.Tip="Thu nhỏ" />
                                    <TextBlock Text="{Binding EnhancePreviewZoomText}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="11" Width="44" TextAlignment="Center" VerticalAlignment="Center" />
                                    <Button Command="{Binding ZoomInPreviewCommand}" Content="➕" Background="#0F172A" Foreground="#38BDF8" Padding="7,4" FontSize="12" CornerRadius="3" ToolTip.Tip="Phóng to" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Cột 3: Đổi ảnh mẫu & Đóng -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Command="{Binding PickSampleImageCommand}" Background="#4F46E5" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="10,6" CornerRadius="4">
                                <TextBlock Text="🖼️ Đổi ảnh mẫu" />
                            </Button>
                            <Button Command="{Binding CloseFullscreenPreviewCommand}" Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="12,6" CornerRadius="4">
                                <TextBlock Text="✕ ĐÓNG" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ROW 1: FastStone Info Bar (Dung lượng Before/After & One-Click Comic Presets) -->
                <Border Grid.Row="1" Background="#0E1626" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="#1E293B" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="{Binding EnhanceBeforeInfoText}" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11" />
                            </Border>
                            <Border Background="#0C4A6E" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="{Binding EnhanceAfterInfoText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" />
                            </Border>
                            <Border Background="#1E293B" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="{Binding EnhanceClippingInfoText}" Foreground="#FCD34D" FontWeight="Bold" FontSize="11" />
                            </Border>
                        </StackPanel>

                        <!-- One-Click Presets -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="⚡ Presets truyện:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <Button Command="{Binding ApplyPresetDefaultCommand}" Content="🔘 Mặc định" Background="#1E293B" Foreground="#E2E8F0" FontSize="10" Padding="8,4" CornerRadius="4" ToolTip.Tip="Khôi phục thông số gốc" />
                            <Button Command="{Binding ApplyPresetOldScanCommand}" Content="📜 Khử ố scan" Background="#854D0E" Foreground="#FEF08A" FontWeight="Bold" FontSize="10" Padding="8,4" CornerRadius="4" ToolTip.Tip="Tăng sáng nền, tương phản mạnh khử vàng giấy cũ" />
                            <Button Command="{Binding ApplyPresetWebtoonCommand}" Content="🎨 Webtoon rực rỡ" Background="#831843" Foreground="#FBCFE8" FontWeight="Bold" FontSize="10" Padding="8,4" CornerRadius="4" ToolTip.Tip="Tăng bão hòa màu và độ sắc nét viền vẽ truyện tranh màu" />
                            <Button Command="{Binding ApplyPresetNightCommand}" Content="🌙 Đọc đêm dịu mắt" Background="#1E1B4B" Foreground="#C7D2FE" FontWeight="Bold" FontSize="10" Padding="8,4" CornerRadius="4" ToolTip.Tip="Hạ sáng nền, tăng nét chữ giúp đỡ mỏi mắt" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ROW 2: Quick Adjustment Sliders -->
                <Border Grid.Row="2" Background="#161F30" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="12,6">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Contrast -->
                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,8,3" VerticalAlignment="Center">
                            <StackPanel Width="135" Spacing="1" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Tương phản:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding EnhanceContrast, StringFormat='{}{0:0}%'}" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                                </Grid>
                                <Slider Value="{Binding EnhanceContrast}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Height="20" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Brightness -->
                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,8,3" VerticalAlignment="Center">
                            <StackPanel Width="135" Spacing="1" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Độ sáng:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding EnhanceBrightness, StringFormat='{}{0:0}'}" Foreground="#FCD34D" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                                </Grid>
                                <Slider Value="{Binding EnhanceBrightness}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Height="20" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Saturation -->
                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,8,3" VerticalAlignment="Center">
                            <StackPanel Width="135" Spacing="1" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Bão hòa:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding EnhanceSaturation, StringFormat='{}{0:0}%'}" Foreground="#EC4899" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                                </Grid>
                                <Slider Value="{Binding EnhanceSaturation}" Minimum="0" Maximum="200" SmallChange="1" LargeChange="10" Height="20" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Sharpness -->
                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,8,3" VerticalAlignment="Center">
                            <StackPanel Width="135" Spacing="1" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Độ nét:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding EnhanceSharpness, StringFormat='{}{0:0.0}'}" Foreground="#10B981" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                                </Grid>
                                <Slider Value="{Binding EnhanceSharpness}" Minimum="0" Maximum="10" SmallChange="0.5" LargeChange="1" Height="20" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Noise Reduce -->
                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,8,3" VerticalAlignment="Center">
                            <StackPanel Width="135" Spacing="1" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Khử nhiễu:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding EnhanceNoiseReduce, StringFormat='{}Mức {0}'}" Foreground="#A855F7" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                                </Grid>
                                <Slider Value="{Binding EnhanceNoiseReduce}" Minimum="0" Maximum="5" SmallChange="1" LargeChange="1" Height="20" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Button Command="{Binding ResetEnhanceSettingsCommand}" Background="#1E293B" Foreground="#94A3B8" FontSize="10" Padding="8,3" Height="26" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,0,3">
                            <TextBlock Text="🔄 Đặt lại" VerticalAlignment="Center" />
                        </Button>
                    </WrapPanel>
                </Border>

                <!-- ROW 3: Vùng hiển thị đối chiếu 3 chế độ (Dual, Split, Single) -->
                <Grid Grid.Row="3" Margin="6">
                    <!-- CHẾ ĐỘ 1: DUAL VIEW -->
                    <Grid ColumnDefinitions="*, *" IsVisible="{Binding IsDualView}">
                        <!-- Before -->
                        <Border Grid.Column="0" Background="#090D16" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,3,0">
                            <Grid RowDefinitions="Auto, *">
                                <Border Grid.Row="0" Background="#1E293B" CornerRadius="3" Padding="6,3" HorizontalAlignment="Left" Margin="0,0,0,4">
                                    <TextBlock Text="📷 ẢNH GỐC (BEFORE)" Foreground="#94A3B8" FontWeight="Bold" FontSize="10" />
                                </Border>
                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#050811" CornerRadius="4">
                                    <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <LayoutTransformControl.LayoutTransform>
                                            <ScaleTransform ScaleX="{Binding EnhancePreviewZoom}" ScaleY="{Binding EnhancePreviewZoom}" />
                                        </LayoutTransformControl.LayoutTransform>
                                        <Image Source="{Binding EnhancePreviewOriginal}" Stretch="None" />
                                    </LayoutTransformControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- After -->
                        <Border Grid.Column="1" Background="#090D16" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" Padding="4" Margin="3,0,0,0">
                            <Grid RowDefinitions="Auto, *">
                                <Border Grid.Row="0" Background="#0284C7" CornerRadius="3" Padding="6,3" HorizontalAlignment="Left" Margin="0,0,0,4">
                                    <TextBlock Text="✨ ĐÃ TỐI ƯU (AFTER)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" />
                                </Border>
                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#050811" CornerRadius="4">
                                    <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <LayoutTransformControl.LayoutTransform>
                                            <ScaleTransform ScaleX="{Binding EnhancePreviewZoom}" ScaleY="{Binding EnhancePreviewZoom}" />
                                        </LayoutTransformControl.LayoutTransform>
                                        <Image Source="{Binding EnhancePreviewResult}" Stretch="None" />
                                    </LayoutTransformControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- CHẾ ĐỘ 2: SPLIT VIEW -->
                    <Border Background="#090D16" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="6" Padding="4" IsVisible="{Binding IsSplitView}">
                        <Grid RowDefinitions="Auto, *">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="4,0,4,4">
                                <Border Grid.Column="0" Background="#1E293B" CornerRadius="3" Padding="6,3">
                                    <TextBlock Text="⮂ RÈM TRƯỢT ĐỐI CHIẾU: Kéo thanh chia đôi để so sánh Trước / Sau trực quan" Foreground="#A855F7" FontWeight="Bold" FontSize="10" />
                                </Border>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Vị trí rèm:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                                    <Slider Width="140" Minimum="0" Maximum="1" Value="{Binding EnhanceSplitRatio}" Height="20" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#050811" CornerRadius="4">
                                <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <LayoutTransformControl.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding EnhancePreviewZoom}" ScaleY="{Binding EnhancePreviewZoom}" />
                                    </LayoutTransformControl.LayoutTransform>
                                    <Panel>
                                        <Image Source="{Binding EnhancePreviewOriginal}" Stretch="None" />
                                        <Grid ColumnDefinitions="*, Auto, *">
                                            <Border Grid.Column="0" ClipToBounds="True">
                                                <Image Source="{Binding EnhancePreviewResult}" Stretch="None" HorizontalAlignment="Left" />
                                            </Border>
                                            <GridSplitter Grid.Column="1" Width="4" Background="#38BDF8" ResizeDirection="Columns" />
                                            <Border Grid.Column="2" Background="Transparent" />
                                        </Grid>
                                    </Panel>
                                </LayoutTransformControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- CHẾ ĐỘ 3: SINGLE VIEW -->
                    <Border Background="#090D16" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="4" IsVisible="{Binding IsSingleView}">
                        <Grid RowDefinitions="Auto, *">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="4,0,0,4">
                                <Border Grid.Column="0" Background="#064E3B" CornerRadius="3" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="💡 ĐANG HIỂN THỊ ẢNH ĐƠN • Click nút bên phải để hoán đổi xem ảnh Trước / Sau" Foreground="#6EE7B7" FontWeight="Bold" FontSize="10" />
                                </Border>
                                <Button Grid.Column="1" Command="{Binding ToggleCompareModeCommand}" Content="🔄 Hoán đổi Before / After" Background="#1E293B" Foreground="#38BDF8" FontSize="10" Padding="8,4" CornerRadius="4" HorizontalAlignment="Right" Margin="0,0,4,0" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#050811" CornerRadius="4">
                                <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <LayoutTransformControl.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding EnhancePreviewZoom}" ScaleY="{Binding EnhancePreviewZoom}" />
                                    </LayoutTransformControl.LayoutTransform>
                                    <Panel>
                                        <Image Source="{Binding EnhancePreviewResult}" Stretch="None" IsVisible="{Binding !IsSingleShowingBefore}" />
                                        <Image Source="{Binding EnhancePreviewOriginal}" Stretch="None" IsVisible="{Binding IsSingleShowingBefore}" />
                                    </Panel>
                                </LayoutTransformControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
