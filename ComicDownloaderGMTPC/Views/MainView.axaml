                                                        <TextBlock Text="🏠 Trang chủ (Home)" FontSize="10" FontWeight="SemiBold" />
                                                    </Button>
                                                    <Button Command="{Binding RestoreDefaultTagCommand}" CommandParameter="daomeoden" Background="#1E293B" Foreground="#94A3B8" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">
                                                        <TextBlock Text="🔄 Khôi phục Tag mặc định" FontSize="10" />
