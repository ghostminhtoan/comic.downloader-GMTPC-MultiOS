<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ComicDownloaderGMTPC.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="750"
             x:Class="ComicDownloaderGMTPC.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="#0B0F19">

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
        <!-- HEADER / BRAND BAR -->
        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="#6366F1" CornerRadius="6" Width="28" Height="28">
                        <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="COMIC DOWNLOADER GMTPC" FontWeight="Bold" FontSize="16" Foreground="#F3F4F6" VerticalAlignment="Center" />
                    <Border Background="#312E81" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="AVALONIA XPLAT" FontSize="10" FontWeight="SemiBold" Foreground="#A5B4FC" />
                    </Border>
                </StackPanel>

                <!-- MODE SELECTOR & LANGUAGE SWITCHER -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="📁 Folder:" Foreground="#9CA3AF" VerticalAlignment="Center" FontSize="12" />
                        <ComboBox SelectedItem="{Binding ModeSelection}" Width="140" Height="30" FontSize="12">
                            <x:String>Single comic</x:String>
                            <x:String>Multi-comic</x:String>
                        </ComboBox>
                    </StackPanel>

                    <Button Command="{Binding ToggleLanguageCommand}"
                            Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                            CornerRadius="6" Padding="10,4" Height="30">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding CurrentLanguage, StringFormat='{}🌐 {0}'}" FontWeight="SemiBold" Foreground="#38BDF8" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- STEP 1: SOURCE / LINK INPUT -->
        <Border Grid.Row="1" Background="#131B2E" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Background="#0EA5E9" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                        <TextBlock Text="BƯỚC 1 / STEP 1" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                    </Border>
                    <TextBlock Text="Nguồn / Source" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                </StackPanel>

                <TextBox Grid.Column="1" Text="{Binding UrlInput}"
                         PlaceholderText="Dán link truyện tại đây (hỗ trợ nhiều dòng link: TruyenQQ, MangaDex, NetTruyen, ThuVienSach...)"
                         Height="36" CornerRadius="6" VerticalContentAlignment="Center"
                         Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" FontSize="12"
                         Margin="0,0,12,0" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding GetLinkCommand}"
                            Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold"
                            CornerRadius="6" Padding="14,6" Height="36">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔍 LẤY LINK" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding GetMoreCommand}"
                            Background="#059669" Foreground="#FFFFFF" FontWeight="SemiBold"
                            CornerRadius="6" Padding="12,6" Height="36">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="➕ THÊM" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ClearLinksCommand}"
                            Background="#1E293B" Foreground="#94A3B8"
                            CornerRadius="6" Padding="10,6" Height="36">
                        <TextBlock Text="🗑️" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- STEP 2: DOWNLOAD & QUEUE CONTROLS -->
        <Border Grid.Row="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Background="#6366F1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                        <TextBlock Text="BƯỚC 2 / STEP 2" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                    </Border>
                    <TextBlock Text="Tải về / Download" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                </StackPanel>

                <!-- MAIN ACTIONS -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding DownloadAllCommand}"
                            Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold"
                            CornerRadius="6" Padding="14,6" Height="32">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="⬇️ TẢI TẤT CẢ" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding StopCommand}"
                            Background="#DC2626" Foreground="#FFFFFF" FontWeight="SemiBold"
                            CornerRadius="6" Padding="12,6" Height="32">
                        <TextBlock Text="⏹️ DỪNG" FontSize="12" />
                    </Button>
                    <Button Command="{Binding RetryCommand}"
                            Background="#D97706" Foreground="#FFFFFF" FontWeight="SemiBold"
                            CornerRadius="6" Padding="12,6" Height="32">
                        <TextBlock Text="🔄 THỬ LẠI" FontSize="12" />
                    </Button>
                    <Button Command="{Binding ClearQueueCommand}"
                            Background="#374151" Foreground="#E5E7EB"
                            CornerRadius="6" Padding="10,6" Height="32">
                        <TextBlock Text="🧹 XÓA QUEUE" FontSize="12" />
                    </Button>
                </StackPanel>

                <!-- TOGGLES & OPTIONS -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding IsAutoDownload}" Content="⚡ Tự động tải" FontSize="11" Foreground="#D1D5DB" />
                    <CheckBox IsChecked="{Binding IsAutoRetry}" Content="🔁 Tự thử lại" FontSize="11" Foreground="#D1D5DB" />
                    <CheckBox IsChecked="{Binding IsCompactRow}" Content="📏 Nén dòng" FontSize="11" Foreground="#D1D5DB" />
                    <CheckBox IsChecked="{Binding IsThumbnailMode}" Content="🖼️ Thumbnail mode" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT TABS -->
        <TabControl Grid.Row="3" Margin="0" Background="Transparent">
            <!-- TAB 1: COMIC LIST -->
            <TabItem Header="📋 Danh Sách Truyện (Queue)" FontSize="12" FontWeight="SemiBold">
                <Grid RowDefinitions="Auto, *">
                    <!-- SUB TOOLBAR -->
                    <Border Grid.Row="0" Background="#161F30" Padding="16,6" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding SelectAllCommand}" Content="✓ Chọn tất cả" Background="#1E293B" Foreground="#94A3B8" FontSize="11" Padding="8,4" CornerRadius="4" />
                                <Button Command="{Binding UnselectAllCommand}" Content="✗ Bỏ chọn" Background="#1E293B" Foreground="#94A3B8" FontSize="11" Padding="8,4" CornerRadius="4" />
                                <Button Command="{Binding InvertSelectionCommand}" Content="⇄ Đảo chọn" Background="#1E293B" Foreground="#94A3B8" FontSize="11" Padding="8,4" CornerRadius="4" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalBooks, StringFormat='{}Tổng: {0} truyện'}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DETAILS VIEW -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ComicBooks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="12,8">
                                        <Grid ColumnDefinitions="Auto, Auto, 2*, 1*, 2*, 1*, Auto" VerticalAlignment="Center">
                                            <!-- Checkbox & Index -->
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Index, StringFormat='{}#{0}'}" Foreground="#64748B" FontSize="11" Width="30" VerticalAlignment="Center" />

                                            <!-- Title & Message -->
                                            <StackPanel Grid.Column="2" Margin="4,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F1F5F9" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding StatusMessage}" Foreground="#94A3B8" FontSize="10" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Domain -->
                                            <Border Grid.Column="3" Background="#1E293B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Domain}" FontSize="10" Foreground="#38BDF8" FontWeight="SemiBold" />
                                            </Border>

                                            <!-- Progress -->
                                            <StackPanel Grid.Column="4" Margin="10,0" VerticalAlignment="Center">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:0}%'}" FontSize="10" Foreground="#94A3B8" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DownloadedChapters, StringFormat='{}{0} chap'}" FontSize="10" Foreground="#94A3B8" />
                                                </Grid>
                                                <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="4" CornerRadius="2" Foreground="#38BDF8" Background="#0F172A" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Total Chapters -->
                                            <TextBlock Grid.Column="5" Text="{Binding TotalChapters, StringFormat='{}{0} chaps'}" Foreground="#CBD5E1" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                            <!-- Status Badge -->
                                            <Border Grid.Column="6" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" MinWidth="75" Background="#1E293B">
                                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#FCD34D" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 2: SCAN MISSING CHAPTERS -->
            <TabItem Header="🔍 Scan Chap Số Nguyên Thiếu" FontSize="12" FontWeight="SemiBold">
                <Grid RowDefinitions="Auto, *">
                    <Border Grid.Row="0" Background="#161F30" Padding="16,8" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Command="{Binding StartScanMissingCommand}" Content="▶ Quét ngay" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="12,5" CornerRadius="4" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="Số tác vụ song song:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                <NumericUpDown Value="{Binding ParallelCheckCount}" Minimum="1" Maximum="16" Width="100" Height="28" FontSize="11" />
                            </StackPanel>

                            <TextBlock Grid.Column="3" Text="{Binding ScanResults.Count, StringFormat='{}Đã quét: {0} truyện'}" Foreground="#10B981" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ScanResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="12,8">
                                        <Grid ColumnDefinitions="40, 100, 2*, 120, 2*, Auto" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='{}#{0}'}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Background="#1E293B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Domain}" FontSize="10" Foreground="#38BDF8" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F1F5F9" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0" />
                                            <TextBlock Grid.Column="3" Text="{Binding LatestChapter, StringFormat='{}Mới nhất: {0}'}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="4" Background="#2A1B0E" BorderBrush="#78350F" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MissingIntegerChapters, StringFormat='{}Thiếu: {0}'}" Foreground="#FDE047" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Border Grid.Column="5" Background="#1E293B" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#10B981" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- TAB 3: LOGS -->
            <TabItem Header="📜 Nhật Ký Hoạt Động" FontSize="12" FontWeight="SemiBold">
                <Grid RowDefinitions="Auto, *">
                    <Border Grid.Row="0" Background="#161F30" Padding="16,6" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Nhật ký các sự kiện trích xuất, scan và tải xuống" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{Binding ClearLogsCommand}" Content="🧹 Xóa nhật ký" Background="#1E293B" Foreground="#94A3B8" FontSize="11" Padding="8,4" CornerRadius="4" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#0A0E17" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Logs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="65, 75, *" Margin="0,2">
                                            <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="#64748B" FontSize="11" FontFamily="Consolas, Monospace" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" Background="#1E293B" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Level}" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="#E2E8F0" FontSize="11" FontFamily="Consolas, Monospace" TextWrapping="Wrap" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- STATUS BAR -->
        <Border Grid.Row="4" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalBooks, StringFormat='{}Tổng: {0}'}" FontSize="11" Foreground="#94A3B8" />
                    <TextBlock Text="{Binding DownloadingCount, StringFormat='{}Đang tải: {0}'}" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CompletedCount, StringFormat='{}Hoàn tất: {0}'}" FontSize="11" Foreground="#10B981" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ErrorCount, StringFormat='{}Lỗi: {0}'}" FontSize="11" Foreground="#F43F5E" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DownloadSpeedText, StringFormat='{}Tốc độ: {0}'}" FontSize="11" Foreground="#F59E0B" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="📁 Lưu tại:" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DownloadPathText}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
