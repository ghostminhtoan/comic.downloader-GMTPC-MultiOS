<UserControl xmlns="https://github.com/avaloniaui"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             xmlns:vm="using:ComicDownloaderGMTPC.ViewModels"

             xmlns:views="using:ComicDownloaderGMTPC.Views"

             xmlns:services="using:ComicDownloaderGMTPC.Services"

             xmlns:models="using:ComicDownloaderGMTPC.Models"

             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="850"

             x:Class="ComicDownloaderGMTPC.Views.MainView"

             x:DataType="vm:MainViewModel"

             Background="#0B0F19">



        <UserControl.Resources>
        <!-- TEMPLATE THẺ TRUYỆN DÙNG CHUNG CHO CẢ CHẾ ĐỘ 1 CỘT VÀ CHẾ ĐỘ LƯỚI ẢO HÓA SIÊU MƯỢT -->
        <DataTemplate x:Key="ComicQueueCardTemplate" DataType="models:ComicBookItem">
<Border IsVisible="{Binding !IsFilteredOut}"
                                                            
                                                            Margin="0,0,0,2"
                                                            Background="{Binding QueueRowBackground}" BorderBrush="{Binding QueueRowBorderBrush}" BorderThickness="{Binding QueueRowBorderThickness}" CornerRadius="4" ClipToBounds="True"

                                                            AttachedToVisualTree="OnThumbnailElementAttached"

                                                            DataContextChanged="OnThumbnailElementDataContextChanged"

                                                            PointerEntered="OnQueueItemPointerEntered"

                                                            PointerExited="OnQueueItemPointerExited"

                                                            PointerPressed="OnQueueItemPointerPressed"

                                                            PointerMoved="OnQueueItemPointerMoved"

                                                            PointerReleased="OnQueueItemPointerReleased"

                                                            PointerCaptureLost="OnQueueItemPointerCaptureLost">

                                                        <Border.ContextMenu>

                                                            <ContextMenu>

                                                                <MenuItem Header="Tích chọn truyện này (Check)"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CheckSingleBookCommand}"

                                                                          CommandParameter="{Binding .}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="✔" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <MenuItem Header="Bỏ chọn truyện này (Uncheck)"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).UncheckSingleBookCommand}"

                                                                          CommandParameter="{Binding .}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="✕" Foreground="#64748B" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <MenuItem Header="Đảo chọn truyện này (Toggle)"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ToggleCheckSingleBookCommand}"

                                                                          CommandParameter="{Binding .}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="🔄" Foreground="#F59E0B" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <Separator Background="#334155" />

                                                                <MenuItem Header="Chọn tất cả truyện (Check All)"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SelectAllCommand}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="☑" Foreground="#34D399" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <MenuItem Header="Bỏ chọn tất cả (Uncheck All)"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).UnselectAllCommand}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="☐" Foreground="#94A3B8" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <MenuItem Header="Đảo chọn tất cả (Invert All)"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).InvertSelectionCommand}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="🔀" Foreground="#A78BFA" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <Separator Background="#334155" />

                                                                <MenuItem Header="Đưa lên đầu hàng đợi (Move to Top)"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MoveToTopCommand}"

                                                                          CommandParameter="{Binding .}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="▲" Foreground="#34D399" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <MenuItem Header="Đưa xuống cuối hàng đợi (Move to Bottom)"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MoveToBottomCommand}"

                                                                          CommandParameter="{Binding .}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="▼" Foreground="#F87171" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <MenuItem Header="🔤 Sắp xếp theo tên alphabet (A-Z / Z-A)"
                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SortByNameAlphabetCommand}">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="🔤" Foreground="#FDE047" FontSize="12" VerticalAlignment="Center" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>

                                                                <MenuItem Header="⏮️ Khôi phục thứ tự gốc từ web (Restore Order)"
                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RestoreOriginalOrderCommand}">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="⏮️" Foreground="#38BDF8" FontSize="12" VerticalAlignment="Center" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>

                                                                <MenuItem Header="🔃 Đảo ngược toàn bộ danh sách (Reverse Queue)"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ReverseQueueCommand}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="🔃" Foreground="#38BDF8" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <Separator Background="#334155" />

                                                                <MenuItem Header="🔍 Đưa tên truyện vào Tab Search (Tìm truyện)"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SendTitleToSearchCommand}"

                                                                          CommandParameter="{Binding .}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="🔍" Foreground="#F59E0B" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <MenuItem Header="🌐 Mở link trong trình duyệt (Browser)"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenInBrowserCommand}"

                                                                          CommandParameter="{Binding .}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="🌐" Foreground="#38BDF8" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <MenuItem Header="📁 Mở thư mục truyện (Open Folder)"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenBookFolderCommand}"

                                                                          CommandParameter="{Binding .}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="📁" Foreground="#FDE047" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <MenuItem Header="📖 Đọc truyện ngay (Open in Reader)"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ReadBookInLibraryCommand}"

                                                                          CommandParameter="{Binding .}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="📖" Foreground="#10B981" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <Separator Background="#334155" />

                                                                <MenuItem Header="📋 Sao chép link truyện (Copy Link)"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CopyBookLinkCommand}"

                                                                          CommandParameter="{Binding .}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="🔗" Foreground="#38BDF8" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <MenuItem Header="📋 Sao chép Tên + Link truyện"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CopyNameAndLinkCommand}"

                                                                          CommandParameter="{Binding .}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="📑" Foreground="#F59E0B" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <MenuItem Header="📋 Sao chép link các Chapter"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CopyChaptersLinkCommand}"

                                                                          CommandParameter="{Binding .}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="📚" Foreground="#A78BFA" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <MenuItem Header="📋 Sao chép toàn bộ link đã tick"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CopySelectedLinksCommand}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="📋" Foreground="#34D399" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <Separator Background="#334155" />

                                                                <MenuItem Header="🔒/🔓 Khóa / Mở khóa Subfolder"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ToggleLockSubfolderCommand}"

                                                                          CommandParameter="{Binding .}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="🔐" Foreground="#F59E0B" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <MenuItem Header="🧩 Tách chương song song (Parallel Split)">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="🧩" Foreground="#F472B6" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                    <MenuItem Header="50 chapters / nhánh"

                                                                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SplitChapters50Command}"

                                                                              CommandParameter="{Binding .}" />

                                                                    <MenuItem Header="100 chapters / nhánh"

                                                                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SplitChapters100Command}"

                                                                              CommandParameter="{Binding .}" />

                                                                    <MenuItem Header="200 chapters / nhánh"

                                                                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SplitChapters200Command}"

                                                                              CommandParameter="{Binding .}" />

                                                                    <MenuItem Header="300 chapters / nhánh"

                                                                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SplitChapters300Command}"

                                                                              CommandParameter="{Binding .}" />

                                                                    <MenuItem Header="400 chapters / nhánh"

                                                                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SplitChapters400Command}"

                                                                              CommandParameter="{Binding .}" />

                                                                </MenuItem>

                                                                <Separator Background="#334155" />

                                                                <MenuItem Header="🧹 Xóa STT tên truyện này (Clear STT)"
                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ClearSingleBookOrderPrefixCommand}"
                                                                          CommandParameter="{Binding .}">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="🧹" Foreground="#F87171" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <Separator Background="#334155" />
                                                                <MenuItem Header="❌ Xóa khỏi hàng đợi"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DeleteItemCommand}"

                                                                          CommandParameter="{Binding .}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="✕" Foreground="#EF4444" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                            </ContextMenu>

                                                        </Border.ContextMenu>

                                                        <Grid ColumnDefinitions="Auto, *">

                                                            <!-- Cột THUMBNAIL (Hiển thị khi chọn chế độ List + thumbnail column) -->

                                                            <Border Grid.Column="0"

                                                                    IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsThumbnailColumnVisible}"

                                                                    Width="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).QueueRowThumbnailWidth}"
                                                                    Height="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).QueueRowThumbnailHeight}"
                                                                    Margin="8,6,2,6"

                                                                    Background="#091018" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="3" ClipToBounds="True"

                                                                    VerticalAlignment="Center"

                                                                    AttachedToVisualTree="OnThumbnailElementAttached"

                                                                    DataContextChanged="OnThumbnailElementDataContextChanged"

                                                                    PointerPressed="OnQueueThumbnailPointerPressed">

                                                                <Grid>

                                                                    <TextBlock Text="NO IMG" FontSize="8" FontWeight="Bold" Foreground="#475569"

                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"

                                                                               IsVisible="{Binding ThumbnailBitmap, Converter={x:Static ObjectConverters.IsNull}}" />

                                                                    <Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill"

                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"

                                                                           RenderOptions.BitmapInterpolationMode="HighQuality" />

                                                                    <Border Background="#80000000" IsVisible="{Binding IsThumbnailLoading}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                                                                        <TextBlock Text="⏳" FontSize="12" Foreground="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                                    </Border>

                                                                </Grid>

                                                            </Border>



                                                            <Grid Grid.Column="1" RowDefinitions="Auto, Auto, Auto, Auto, Auto">

                                                                <!-- Hàng 0: Header dành trọn chiều ngang cho Tiêu đề truyện (↳, Checkbox, Index, Tiêu đề) -->

                                                                <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, Auto, *" VerticalAlignment="Center" Margin="8,6,8,2">

                                                                    <TextBlock Grid.Column="0" Text="↳ " IsVisible="{Binding IsParallelSplitChild}"

                                                                               Foreground="#F472B6" FontWeight="ExtraBold" FontSize="14"

                                                                               VerticalAlignment="Center" Margin="14,0,2,0" ToolTip.Tip="Nhánh con tách chương" />

                                                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsChecked}" PointerPressed="OnQueueItemCheckBoxPointerPressed" Margin="0,0,6,0" VerticalAlignment="Center" />

                                                                    <TextBlock Grid.Column="2" Text="{Binding Index, StringFormat='{}#{0}'}" Foreground="#64748B" FontSize="10" Width="26" VerticalAlignment="Center" />



                                                                    <!-- Tiêu đề truyện chiếm 100% chiều ngang còn lại, cho phép hiển thị tối đa 2 dòng -->

                                                                    <TextBlock Grid.Column="3" Text="{Binding Title}"

                                                                               FontWeight="Bold" Foreground="{Binding TitleBrush}" FontSize="11.5"

                                                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"

                                                                               VerticalAlignment="Center" Margin="2,0,0,0"

                                                                               ToolTip.Tip="{Binding Title}" />

                                                                </Grid>



                                                                <!-- Hàng 1: Các nút thao tác hàng (🔍, 📂, 📖, ▲, ▼, ✕) & Badges nằm ngay bên dưới tên truyện -->

                                                                <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="38,0,8,3">

                                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,2">

                                                                        <Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SendTitleToSearchCommand}"

                                                                                CommandParameter="{Binding .}" ToolTip.Tip="Chuyển tên truyện này sang Tab Search (Tìm truyện)"

                                                                                Background="#1E293B" Foreground="#F59E0B" Padding="6,2" FontSize="9.5" CornerRadius="3">

                                                                            <TextBlock Text="🔍" />

                                                                        </Button>

                                                                        <Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenBookFolderCommand}"

                                                                                CommandParameter="{Binding .}" ToolTip.Tip="Mở thư mục"

                                                                                Background="#1E293B" Foreground="#38BDF8" Padding="6,2" FontSize="9.5" CornerRadius="3">

                                                                            <TextBlock Text="📂" />

                                                                        </Button>

                                                                        <Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ReadBookInLibraryCommand}"

                                                                                CommandParameter="{Binding .}" ToolTip.Tip="Đọc truyện đã tải trong Trình Đọc Truyện"

                                                                                Background="#1E293B" Foreground="#10B981" Padding="6,2" FontSize="9.5" CornerRadius="3">

                                                                            <TextBlock Text="📖" />

                                                                        </Button>

                                                                        <Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MoveUpCommand}"

                                                                                CommandParameter="{Binding .}"

                                                                                Background="#1E293B" Foreground="#94A3B8" Padding="6,2" FontSize="9.5" CornerRadius="3">

                                                                            <TextBlock Text="▲" />

                                                                        </Button>

                                                                        <Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MoveDownCommand}"

                                                                                CommandParameter="{Binding .}"

                                                                                Background="#1E293B" Foreground="#94A3B8" Padding="6,2" FontSize="9.5" CornerRadius="3">

                                                                            <TextBlock Text="▼" />

                                                                        </Button>

                                                                        <Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DeleteItemCommand}"

                                                                                CommandParameter="{Binding .}"

                                                                                Background="#1E293B" Foreground="#EF4444" Padding="6,2" FontSize="9.5" CornerRadius="3">

                                                                            <TextBlock Text="✕" />

                                                                        </Button>

                                                                    </StackPanel>



                                                                    <Border IsVisible="{Binding IsDuplicate}" Background="#78350F" CornerRadius="2" Padding="3,1" VerticalAlignment="Center" Margin="0,0,4,2">

                                                                        <TextBlock Text="TRÙNG" FontSize="8" FontWeight="Bold" Foreground="#FDE047" />

                                                                    </Border>

                                                                    <Border IsVisible="{Binding IsImageDuplicate}" Background="#831843" BorderBrush="#F43F5E" BorderThickness="1" CornerRadius="2" Padding="3,1" VerticalAlignment="Center" Margin="0,0,4,2" ToolTip.Tip="Truyện trùng ảnh bìa với truyện khác">

                                                                        <TextBlock Text="TRÙNG ẢNH" FontSize="8" FontWeight="Bold" Foreground="#FDA4AF" />

                                                                    </Border>

                                                                    <!-- Badge Thư mục gốc cho truyện cha đã tách -->

                                                                    <Border IsVisible="{Binding IsParallelSplitParent}" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="2" Padding="4,1" VerticalAlignment="Center" Margin="0,0,4,2">

                                                                        <TextBlock Text="📁 THƯ MỤC GỐC" FontSize="8" FontWeight="Bold" Foreground="#34D399" />

                                                                    </Border>

                                                                    <!-- Nút Thu gọn / Mở rộng cây thư mục con -->

                                                                    <Button IsVisible="{Binding HasParallelSplitChildren}"

                                                                            Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ToggleSplitCollapseCommand}"

                                                                            CommandParameter="{Binding .}"

                                                                            Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold"

                                                                            Padding="6,1" Height="20" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,4,2"

                                                                            ToolTip.Tip="Thu gọn hoặc mở rộng danh sách các nhánh con đã tách để theo dõi">

                                                                        <TextBlock Text="{Binding ParallelSplitToggleText}" FontSize="8" FontWeight="ExtraBold" VerticalAlignment="Center" />

                                                                    </Button>

                                                                    <!-- Badge Nhánh con cho task con -->

                                                                    <Border IsVisible="{Binding IsParallelSplitChild}" Background="#831843" BorderBrush="#DB2777" BorderThickness="1" CornerRadius="2" Padding="4,1" VerticalAlignment="Center" Margin="0,0,4,2">

                                                                        <TextBlock Text="{Binding ChapterSelectionText, StringFormat='{}↳ NHÁNH: {0}'}" FontSize="8" FontWeight="Bold" Foreground="#F472B6" />

                                                                    </Border>

                                                                </WrapPanel>



                                                                <!-- Hàng 2: Sub-info & Status (Domain, Subfolder, Latest Chapter, Missing Chapter, Trạng thái, Tiến trình) -->

                                                                <WrapPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="38,0,8,3">

                                                                    <Border Background="#1E293B" CornerRadius="2" Padding="4,1" Margin="0,0,6,2">

                                                                        <TextBlock Text="{Binding Domain}" FontSize="8" Foreground="#38BDF8" FontWeight="SemiBold" />

                                                                    </Border>

                                                                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,0,6,2" ToolTip.Tip="Subfolder lưu truyện">

                                                                        <TextBlock Text="{Binding DisplaySubfolder, StringFormat='{}📁 {0}'}" FontSize="8" Foreground="#FDE047" FontWeight="SemiBold" />

                                                                    </Border>

                                                                    <TextBlock Text="{Binding DisplayChaptersCount}" Foreground="#94A3B8" FontSize="9" VerticalAlignment="Center" Margin="0,0,8,2" />

                                                                    <TextBlock FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,2">
                                                                        <Run Text="{Binding LatestChapterLabel}" Foreground="#94A3B8" />
                                                                        <Run Text="{Binding LocalizedLatestChapter}" Foreground="#00E5FF" />
                                                                    </TextBlock>

                                                                    <TextBlock FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,2">
                                                                        <Run Text="{Binding MissingChapterLabel}" Foreground="#94A3B8" />
                                                                        <Run Text="{Binding LocalizedMissingChapter}" Foreground="{Binding MissingChapterBrush}" />
                                                                    </TextBlock>

                                                                    <TextBlock Text="{Binding LocalizedStatus}" Foreground="#00E5FF" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,2" />

                                                                    <TextBlock Text="{Binding DetailProgressText}" Foreground="#34D399" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,2" />

                                                                </WrapPanel>



                                                                <!-- Hàng 3: Nhập liệu (2 dòng riêng biệt, co giãn 100% không gian card, không bị chèn ép) -->

                                                                <StackPanel Grid.Row="3" Margin="38,0,8,4" Spacing="3">

                                                                    <!-- Dòng 3A: Chọn chap -->

                                                                    <Grid ColumnDefinitions="Auto, *">

                                                                        <TextBlock Grid.Column="0" Text="{Binding ChapterSelectionLabel}" Foreground="#94A3B8" FontSize="9" VerticalAlignment="Center" Width="68" />

                                                                        <TextBox Grid.Column="1" Text="{Binding ChapterSelectionText}" PlaceholderText="{Binding ChapterSelectionPlaceholder}" FontSize="9" Height="24" Background="#0B0F19" Foreground="#F8FAFC" BorderBrush="#334155" CornerRadius="3" VerticalContentAlignment="Center" Padding="5,1" />

                                                                    </Grid>



                                                                    <!-- Dòng 3B: Subfolder + Nút Khóa + Nút Áp dụng -->

                                                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto">

                                                                        <TextBlock Grid.Column="0" Text="📁 Subfolder:" Foreground="#F59E0B" FontSize="9" VerticalAlignment="Center" Width="68" />

                                                                        <TextBox Grid.Column="1" Text="{Binding Subfolder}" PlaceholderText="[default]" FontSize="9" Height="24" Background="#0B0F19" Foreground="#FDE047" BorderBrush="#334155" CornerRadius="3" VerticalContentAlignment="Center" Padding="5,1" ToolTip.Tip="Tên thư mục con tải về của truyện này (Ví dụ: chizuru). Để trống sẽ tự động vào '[default]'" />

                                                                        <Button Grid.Column="2" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ToggleLockSubfolderCommand}"

                                                                                CommandParameter="{Binding .}"

                                                                                Background="#1E293B" BorderBrush="#334155" BorderThickness="1"

                                                                                Padding="6,1" Height="24" CornerRadius="3" Margin="4,0,0,0"

                                                                                ToolTip.Tip="{Binding SubfolderLockTooltip}">

                                                                            <TextBlock Text="{Binding SubfolderLockIcon}" FontSize="10" VerticalAlignment="Center" />

                                                                        </Button>

                                                                        <Button Grid.Column="3" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ApplySingleBookSubfolderCommand}"

                                                                                CommandParameter="{Binding .}"

                                                                                Background="#065F46" BorderBrush="#10B981" BorderThickness="1" Foreground="#34D399"

                                                                                Padding="6,1" Height="24" CornerRadius="3" Margin="4,0,0,0"

                                                                                ToolTip.Tip="Áp dụng tên Subfolder này, tự động chuyển toàn bộ file đã tải sang thư mục mới và khóa cố định">

                                                                            <TextBlock Text="✓ ÁP" FontSize="8.5" FontWeight="Bold" VerticalAlignment="Center" />

                                                                        </Button>

                                                                    </Grid>

                                                                </StackPanel>



                                                                <!-- Hàng 4: THANH PROGRESS BAR SÁT MÉP GÓC ĐÁY CARD 100% VỚI SỐ % OVERLAP NỔI BẬT KHÁC MÀU -->

                                                                <Grid Grid.Row="4" Height="14" HorizontalAlignment="Stretch" Margin="0,2,0,0">

                                                                    <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="14"

                                                                                 CornerRadius="0" Foreground="{Binding ProgressBarBrush}" Background="#0B132B"

                                                                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0" Margin="0" />

                                                                    <TextBlock Text="{Binding ProgressPercentageText}"

                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"

                                                                               Foreground="#FDE047" FontWeight="ExtraBold" FontSize="9" />

                                                                </Grid>

                                                            </Grid>

                                                        </Grid>

                                                    </Border>
        </DataTemplate>
    </UserControl.Resources>

<UserControl.Styles>

        <!-- Style ScrollBar dọc to bản cho Dual Picture Sort hỗ trợ chạm vuốt cảm ứng ngón tay -->

        <!-- Style ScrollBar dọc tự động phóng to 3 giây khi cuộn cho Dual Picture Sort - Toàn bộ mép phải đều hẹp (6px), chỉ ở phạm vi slider (thumb) mới rộng để không che nút -->
        <Style Selector="ScrollViewer.dualSortScroll /template/ ScrollBar:vertical">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ScrollViewer.dualSortScroll /template/ ScrollBar:vertical /template/ Thumb">
            <Setter Property="Height" Value="40" />
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Background" Value="#64748B" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.2" />
                    <DoubleTransition Property="MinWidth" Duration="0:0:0.2" />
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <!-- Khi phóng to (cuộn hoặc hover hoặc pressed) - Chỉ riêng con trượt (Thumb) nở rộng sang trái -->
        <Style Selector="ScrollViewer.dualSortScroll /template/ ScrollBar:vertical.scroll-active, ScrollViewer.dualSortScroll.scroll-active /template/ ScrollBar:vertical, ScrollViewer.dualSortScroll /template/ ScrollBar:vertical:pointerover, ScrollViewer.dualSortScroll /template/ ScrollBar:vertical:pressed">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Opacity" Value="1.0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
        <Style Selector="ScrollViewer.dualSortScroll /template/ ScrollBar:vertical.scroll-active /template/ Thumb, ScrollViewer.dualSortScroll.scroll-active /template/ Thumb, ScrollViewer.dualSortScroll /template/ ScrollBar:vertical:pointerover /template/ Thumb, ScrollViewer.dualSortScroll /template/ ScrollBar:vertical /template/ Thumb:pointerover">
            <Setter Property="Width" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Background" Value="#38BDF8" />
            <Setter Property="CornerRadius" Value="16, 0, 0, 16" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="ScrollViewer.dualSortScroll /template/ ScrollBar:vertical /template/ Thumb:pressed, ScrollViewer.dualSortScroll.scroll-active /template/ Thumb:pressed">
            <Setter Property="Width" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="CornerRadius" Value="16, 0, 0, 16" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <!-- Style cho các nút Toggle Lọc trong Hàng đợi -->
        <Style Selector="ToggleButton.filter-toggle">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#94A3B8" />
        </Style>
        <Style Selector="ToggleButton.filter-name-dup:checked">
            <Setter Property="Background" Value="#D97706" />
            <Setter Property="BorderBrush" Value="#F59E0B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="ToggleButton.filter-name-dup:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D97706" />
            <Setter Property="BorderBrush" Value="#F59E0B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="ToggleButton.filter-image-dup:checked">
            <Setter Property="Background" Value="#BE185D" />
            <Setter Property="BorderBrush" Value="#F43F5E" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="ToggleButton.filter-image-dup:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#BE185D" />
            <Setter Property="BorderBrush" Value="#F43F5E" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="ToggleButton.filter-uncen:checked">
            <Setter Property="Background" Value="#7C3AED" />
            <Setter Property="BorderBrush" Value="#A855F7" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="ToggleButton.filter-uncen:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#7C3AED" />
            <Setter Property="BorderBrush" Value="#A855F7" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="ToggleButton.queue-grid-toggle:checked">
            <Setter Property="Background" Value="#0D9488" />
            <Setter Property="BorderBrush" Value="#14B8A6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="ToggleButton.queue-grid-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0D9488" />
            <Setter Property="BorderBrush" Value="#14B8A6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
    </UserControl.Styles>



    <Grid>

        <!-- GIAO DIỆN CHÍNH -->

        <Panel>

            <!-- KHUNG CUỘN CHÍNH HỖ TRỢ ĐA NỀN TẢNG (DESKTOP & MOBILE/ANDROID) -->

            <ScrollViewer x:Name="MainRootScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BringIntoViewOnFocusChange="False">

            <Grid RowDefinitions="Auto, Auto, *, Auto" MinHeight="650">



            <!-- 1. HEADER / BRAND BAR -->

            <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="10,6">

                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,12,4">

                        <Border Background="#6366F1" CornerRadius="6" Width="24" Height="24">

                            <TextBlock Text="⚡" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <TextBlock Text="COMIC DOWNLOADER GMTPC" FontWeight="Bold" FontSize="14" Foreground="#F3F4F6" VerticalAlignment="Center" />

                        <Border Background="#312E81" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">

                            <TextBlock Text="XPLAT" FontSize="9" FontWeight="SemiBold" Foreground="#A5B4FC" />

                        </Border>

                    </StackPanel>



                    <!-- Folder Mode Selector & Action Buttons in WrapPanel for Mobile & Desktop -->

                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">

                        <!-- Chọn kiểu thư mục -->

                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,4">

                            <TextBlock Text="📁 Thư mục:" Foreground="#9CA3AF" VerticalAlignment="Center" FontSize="11" />

                            <ComboBox ItemsSource="{Binding ModeSelections}" SelectedItem="{Binding ModeSelection, Mode=TwoWay}" Width="120" Height="28" FontSize="11" />

                        </StackPanel>



                        <!-- Đổi ngôn ngữ -->

                        <Button Command="{Binding ToggleLanguageCommand}"

                                Background="#1E293B" BorderBrush="#334155" BorderThickness="1"

                                CornerRadius="6" Padding="8,3" Height="28" Margin="0,0,6,4">

                            <TextBlock x:Name="LanguageToggleTextBlock" Text="{Binding CurrentLanguage, StringFormat='{}🌐 {0}'}" FontWeight="SemiBold" Foreground="#38BDF8" FontSize="11" />

                        </Button>



                        <!-- Google Drive Cloud Sync Nổi Bật Cho Android & Desktop -->

                        <Button Command="{Binding OpenGoogleDriveModalCommand}"

                                Background="#4338CA" BorderBrush="#6366F1" BorderThickness="1"

                                CornerRadius="6" Padding="8,3" Height="28" Margin="0,0,6,4"

                                ToolTip.Tip="Đồng bộ Cloud đa thiết bị qua Google Drive (Hàng chờ, Dấu trang, Lịch sử đọc)">

                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                                <TextBlock Text="☁️" FontSize="11" />

                                <TextBlock Text="DRIVE" FontWeight="Bold" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center" />

                            </StackPanel>

                        </Button>



                        <!-- NÚT THOÁT HOÀN TOÀN (BÊN TRÁI NÚT CẬP NHẬT) -->

                        <Button Command="{Binding OpenExitConfirmCommand}"

                                Background="#991B1B" BorderBrush="#DC2626" BorderThickness="1"

                                CornerRadius="6" Padding="10,3" Height="28" Margin="0,0,6,4"

                                ToolTip.Tip="Đóng hoặc force stop chương trình hoàn toàn">

                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                                <TextBlock Text="⛔" FontSize="11" />

                                <TextBlock Text="THOÁT" FontWeight="Bold" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center" />

                            </StackPanel>

                        </Button>



                        <!-- Nút Tự Động Cập Nhật Release -->

                        <Button IsEnabled="{Binding !IsUpdating}"

                                Background="#059669" BorderBrush="#10B981" BorderThickness="1"

                                CornerRadius="6" Padding="10,3" Height="28" Margin="0,0,6,4"

                                ToolTip.Tip="Bấm để chọn: Kiểm tra cập nhật (Đối chiếu mã hash) hoặc Cập nhật Release ngay">

                            <Button.Flyout>

                                <MenuFlyout Placement="BottomEdgeAlignedLeft">

                                    <MenuItem Header="🔍 Kiểm tra cập nhật Release" Command="{Binding CheckUpdateReleaseCommand}" />

                                    <MenuItem Header="⬇️ Cập nhật Release ngay" Command="{Binding AutoUpdateCommand}" />

                                </MenuFlyout>

                            </Button.Flyout>

                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                                <TextBlock Text="{Binding UpdateButtonLabel}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center" />

                                <TextBlock Text="▾" Foreground="#A7F3D0" FontSize="9" VerticalAlignment="Center" />

                            </StackPanel>

                        </Button>



                        <!-- Nút Tự Động Cập Nhật Beta -->

                        <Button IsEnabled="{Binding !IsUpdating}"

                                Background="#D97706" BorderBrush="#F59E0B" BorderThickness="1"

                                CornerRadius="6" Padding="10,3" Height="28" Margin="0,0,6,4"

                                ToolTip.Tip="Bấm để chọn: Kiểm tra cập nhật (Đối chiếu mã hash) hoặc Cập nhật Beta ngay">

                            <Button.Flyout>

                                <MenuFlyout Placement="BottomEdgeAlignedLeft">

                                    <MenuItem Header="🔍 Kiểm tra cập nhật Beta" Command="{Binding CheckUpdateBetaCommand}" />

                                    <MenuItem Header="⬇️ Cập nhật Beta ngay" Command="{Binding AutoUpdateBetaCommand}" />

                                    <MenuItem Header="⏪ Quay lại bản backup (Reverse to backup)" Command="{Binding ReverseToBackupBetaCommand}" />

                                </MenuFlyout>

                            </Button.Flyout>

                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                                <TextBlock Text="{Binding UpdateBetaButtonLabel}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center" />

                                <TextBlock Text="▾" Foreground="#FDE68A" FontSize="9" VerticalAlignment="Center" />

                            </StackPanel>

                        </Button>



                        <!-- Nút Cập Nhật Release Trực Tiếp (Xuất hiện ngay khi check update phát hiện có bản mới) -->

                        <Button IsVisible="{Binding HasAvailableReleaseUpdate}"

                                IsEnabled="{Binding !IsUpdating}"

                                Command="{Binding AutoUpdateCommand}"

                                Background="#047857" BorderBrush="#34D399" BorderThickness="1.5"

                                CornerRadius="6" Padding="10,3" Height="28" Margin="0,0,6,4"

                                ToolTip.Tip="Bấm để tải và cài đặt phiên bản Release mới nhất ngay lập tức!">

                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                                <TextBlock Text="⚡" FontSize="11" Foreground="#FEF08A" VerticalAlignment="Center" />

                                <TextBlock Text="CẬP NHẬT RELEASE NGAY" FontWeight="ExtraBold" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center" />

                            </StackPanel>

                        </Button>



                        <!-- Nút Cập Nhật Beta Trực Tiếp (Xuất hiện ngay khi check update phát hiện có bản mới) -->

                        <Button IsVisible="{Binding HasAvailableBetaUpdate}"

                                IsEnabled="{Binding !IsUpdating}"

                                Command="{Binding AutoUpdateBetaCommand}"

                                Background="#B45309" BorderBrush="#FBBF24" BorderThickness="1.5"

                                CornerRadius="6" Padding="10,3" Height="28" Margin="0,0,6,4"

                                ToolTip.Tip="Bấm để tải và cài đặt phiên bản Beta mới nhất ngay lập tức!">

                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                                <TextBlock Text="⚡" FontSize="11" Foreground="#FEF08A" VerticalAlignment="Center" />

                                <TextBlock Text="CẬP NHẬT BETA NGAY" FontWeight="ExtraBold" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center" />

                            </StackPanel>

                        </Button>

                    </WrapPanel>

                </WrapPanel>

            </Border>



            <!-- 2. QUICK DIRECT LINK BAR (TIỆN ÍCH DÁN LINK NHANH TOÀN CỤC: 2 ROW RESPONSIVE) -->

            <Border Grid.Row="1" Background="#131B2E" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="12,6">

                <Grid RowDefinitions="Auto, Auto">

                    <!-- Row 0: Đường dẫn dán link để riêng một row chiếm 100% bề ngang -->

                    <TextBox Grid.Row="0" Text="{Binding UrlInput}"

                             PlaceholderText="⚡ Dán link truyện tại đây (TruyenQQ, MangaDex, NetTruyen, Vi-Hentai, Đảo Mèo Đen, Dâm Cô Nương, SayHentai...)"

                             Height="34" CornerRadius="5" VerticalContentAlignment="Center"

                             Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" FontSize="11"

                             Margin="0,0,0,6" />



                    <!-- Row 1: Lấy link, thêm, xóa, dán link và auto dán -->

                    <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">

                        <Button Command="{Binding GetLinkCommand}"

                                Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold"

                                CornerRadius="5" Padding="12,4" Height="30" Margin="0,0,6,4">

                            <TextBlock Text="🔍 LẤY LINK" FontSize="11" />

                        </Button>

                        <Button Command="{Binding GetMoreCommand}"

                                Background="#059669" Foreground="#FFFFFF" FontWeight="SemiBold"

                                CornerRadius="5" Padding="10,4" Height="30" Margin="0,0,6,4">

                            <TextBlock Text="➕ THÊM" FontSize="11" />

                        </Button>

                        <Button Command="{Binding ClearLinksCommand}"

                                Background="#1E293B" Foreground="#94A3B8"

                                CornerRadius="5" Padding="8,4" Height="30" Margin="0,0,6,4">

                            <TextBlock Text="🗑️ XÓA" FontSize="11" />

                        </Button>

                        <Button Command="{Binding PasteLinkCommand}"

                                Background="#334155" Foreground="#38BDF8" FontWeight="SemiBold"

                                CornerRadius="5" Padding="10,4" Height="30" Margin="0,0,8,4"

                                ToolTip.Tip="Dán trực tiếp liên kết từ bộ nhớ tạm (Clipboard) và nạp vào danh sách">

                            <TextBlock Text="📋 DÁN LINK" FontSize="11" />

                        </Button>

                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Padding="6,2" Height="30" Margin="0,0,8,4"

                                ToolTip.Tip="Giới hạn số luồng CPU xử lý link/thumbnail/quét chương (Android mặc định 3, tối đa 6; Windows/Linux mặc định 4, tối đa bằng tổng số luồng CPU)">

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">

                                <TextBlock Text="Số luồng CPU:" FontSize="11" Foreground="#CBD5E1" FontWeight="SemiBold" VerticalAlignment="Center" />

                                <Button Command="{Binding DecreaseLinkCpuThreadsCommand}"

                                        Background="#1E293B" Foreground="#38BDF8" FontWeight="ExtraBold"

                                        Padding="5,0" Height="22" MinWidth="22" CornerRadius="3"

                                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center"

                                        ToolTip.Tip="Giảm 1 luồng CPU">

                                    <TextBlock Text="−" FontSize="13" FontWeight="Bold" />

                                </Button>

                                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="3" Padding="4,0" MinWidth="26" Height="22">

                                    <TextBlock Text="{Binding LinkCpuThreads}" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8"

                                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                                </Border>

                                <Button Command="{Binding IncreaseLinkCpuThreadsCommand}"

                                        Background="#1E293B" Foreground="#38BDF8" FontWeight="ExtraBold"

                                        Padding="5,0" Height="22" MinWidth="22" CornerRadius="3"

                                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center"

                                        ToolTip.Tip="Tăng 1 luồng CPU">

                                    <TextBlock Text="+" FontSize="13" FontWeight="Bold" />

                                </Button>

                            </StackPanel>

                        </Border>

                        <CheckBox IsChecked="{Binding IsAutoPasteClipboard}"

                                  VerticalAlignment="Center" Margin="0,0,0,4"

                                  ToolTip.Tip="Tự động theo dõi Clipboard: mỗi khi copy link truyện sẽ tự động nạp">

                            <TextBlock Text="⚡ Tự dán" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center" />

                        </CheckBox>

                    </WrapPanel>

                </Grid>

            </Border>



            <!-- 3. HAI TAB GỐC CHÍNH: TAB SOURCE & TAB DOWNLOAD (GIỐNG 100% WPF GỐC) -->

            <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedRootTabIndex}" Margin="0" Background="Transparent" MinHeight="480">



                <!-- ========================================================================= -->

                <!-- [TAB 3 LỚN] TAB DOWNLOAD: DOWNLOAD MANGA, SCAN, LOGS -->

                <!-- ========================================================================= -->

                <TabItem Header="📥 Tải về" FontSize="12" FontWeight="Bold">

                    <Grid RowDefinitions="Auto, *">

                        <!-- Toolbar điều khiển tải chung -->

                        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="6,4">

                            <Grid RowDefinitions="Auto, Auto, Auto">

                                <!-- Main Download Action Buttons -->

                                <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">

                                    <!-- Nút Toggle TẢI / DỪNG TẢI (Gộp chung thành 1 Toggle Button) -->

                                    <Button Command="{Binding DownloadAllCommand}" IsVisible="{Binding !IsDownloading}"

                                            Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold"

                                            CornerRadius="5" Padding="12,5" Height="30" Margin="0,0,6,3"

                                            ToolTip.Tip="Bắt đầu tải toàn bộ danh sách truyện đã chọn">

                                        <TextBlock Text="⬇️ TẢI" FontSize="11" />

                                    </Button>

                                    <Button Command="{Binding StopCommand}" IsVisible="{Binding IsDownloading}"

                                            Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold"

                                            CornerRadius="5" Padding="12,5" Height="30" Margin="0,0,6,3"

                                            ToolTip.Tip="Dừng tiến trình tải truyện đang chạy">

                                        <TextBlock Text="⏹️ DỪNG" FontSize="11" />

                                    </Button>



                                    <!-- Nút TẢI TIẾP (Tiếp tục nạp truyện mới thêm vào queue mà không ngắt tiến trình đang chạy) -->

                                    <Button Command="{Binding DownloadNewCommand}" Background="#0D9488" BorderBrush="#14B8A6" BorderThickness="1" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="5" Padding="12,5" Height="30" Margin="0,0,6,3" ToolTip.Tip="Tiếp tục tải các truyện mới vừa thêm vào danh sách mà không ngắt tiến trình đang chạy">

                                        <TextBlock Text="➕ TẢI TIẾP" FontSize="11" />

                                    </Button>



                                    <!-- Nút TẠM DỪNG (Hiển thị khi chưa Pause) -->

                                    <Button Command="{Binding PauseDownloadCommand}" IsVisible="{Binding !IsPaused}"

                                            Background="#D97706" BorderBrush="#F59E0B" BorderThickness="1"

                                            Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="5" Padding="10,5" Height="30" Margin="0,0,6,3"

                                            ToolTip.Tip="Tạm dừng tiến trình tải hiện tại">

                                        <TextBlock Text="⏸️ TẠM DỪNG" FontSize="11" />

                                    </Button>



                                    <!-- Nút TIẾP TỤC (Hiển thị khi đang Pause) -->

                                    <Button Command="{Binding ResumeDownloadCommand}" IsVisible="{Binding IsPaused}"

                                            Background="#059669" BorderBrush="#10B981" BorderThickness="1"

                                            Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="5" Padding="10,5" Height="30" Margin="0,0,6,3"

                                            ToolTip.Tip="Tiếp tục tải các truyện đang tạm dừng">

                                        <TextBlock Text="▶️ TIẾP TỤC" FontSize="11" />

                                    </Button>

                                    <Button Command="{Binding RetryCommand}" Background="#7C3AED" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="5" Padding="10,5" Height="30" Margin="0,0,6,3">

                                        <TextBlock Text="🔄 THỬ LẠI" FontSize="11" />

                                    </Button>

                                    <Button Command="{Binding ClearQueueCommand}" Background="#374151" Foreground="#E5E7EB" CornerRadius="5" Padding="10,5" Height="30" Margin="0,0,6,3">

                                        <TextBlock Text="🧹 XÓA QUEUE" FontSize="11" />

                                    </Button>

                                    <Button Command="{Binding ReverseQueueCommand}" Background="#0284C7" BorderBrush="#38BDF8" BorderThickness="1" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="5" Padding="10,5" Height="30" Margin="0,0,6,3" ToolTip.Tip="Đảo ngược thứ tự toàn bộ hàng chờ tải xuống (truyện cuối lên đầu, truyện đầu xuống cuối)">

                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                                            <TextBlock Text="🔃" FontSize="11" VerticalAlignment="Center" />

                                            <TextBlock Text="ĐẢO NGƯỢC DANH SÁCH" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />

                                        </StackPanel>

                                    </Button>

                                    <Button Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="5" Padding="10,5" Height="30" Margin="0,0,6,3" ToolTip.Tip="Sao lưu danh sách hàng chờ và tiến độ (Cục bộ hoặc Google Drive)">

                                        <Button.Flyout>

                                            <MenuFlyout Placement="Bottom">

                                                <MenuItem Header="📁 Cục bộ (Local autosave.md)" Command="{Binding BackupQueueCommand}" />

                                                <MenuItem Header="☁️ Google Drive" Command="{Binding BackupQueueToGoogleDriveCommand}" />

                                            </MenuFlyout>

                                        </Button.Flyout>

                                        <StackPanel Orientation="Horizontal" Spacing="4">

                                            <TextBlock Text="💾 SAO LƯU MD" FontSize="11" />

                                            <TextBlock Text="▼" FontSize="8" VerticalAlignment="Center" Foreground="#E0F2FE" />

                                        </StackPanel>

                                    </Button>

                                    <Button Background="#0D9488" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="5" Padding="10,5" Height="30" Margin="0,0,6,3" ToolTip.Tip="Phục hồi danh sách hàng chờ và tiến độ (Cục bộ hoặc Google Drive)">

                                        <Button.Flyout>

                                            <MenuFlyout Placement="Bottom">

                                                <MenuItem Header="📁 Cục bộ (Local autosave.md)" Command="{Binding RestoreQueueCommand}" />

                                                <MenuItem Header="☁️ Google Drive" Command="{Binding RestoreQueueFromGoogleDriveCommand}" />

                                            </MenuFlyout>

                                        </Button.Flyout>

                                        <StackPanel Orientation="Horizontal" Spacing="4">

                                            <TextBlock Text="📂 PHỤC HỒI MD" FontSize="11" />

                                            <TextBlock Text="▼" FontSize="8" VerticalAlignment="Center" Foreground="#CCFBF1" />

                                        </StackPanel>

                                    </Button>

                                    <Button Command="{Binding OpenGoogleDriveModalCommand}" Background="#4F46E5" BorderBrush="#818CF8" BorderThickness="1" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="5" Padding="10,5" Height="30" Margin="0,0,6,3" ToolTip.Tip="Đồng bộ Hàng chờ tải &amp; Dấu trang / Lịch sử đọc lên Google Drive (\GMTPC\Comic Downloader GMTPC\)">

                                        <TextBlock Text="☁️ GOOGLE DRIVE" FontSize="11" />

                                    </Button>

                                    <Button Command="{Binding OpenDownloadCacheModalCommand}" Background="#0284C7" BorderBrush="#38BDF8" BorderThickness="1" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="5" Padding="10,5" Height="30" Margin="0,0,6,3" ToolTip.Tip="Quản lý bộ nhớ đệm ảnh bìa (Thumbnails) và tệp nén (Zip file cache) của Tab Download">

                                        <TextBlock Text="💾 BỘ NHỚ ĐỆM" FontSize="11" />

                                    </Button>

                                    <Button Command="{Binding ChangeDownloadFolderCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="5" Padding="10,5" Height="30" Margin="0,0,6,3">

                                        <TextBlock Text="📁 ĐỔI THƯ MỤC" FontSize="11" />

                                    </Button>

                                    <Button Command="{Binding OpenDownloadRootCommand}" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Padding="10,5" Height="30" Margin="0,0,0,3">

                                        <TextBlock Text="📂 MỞ THƯ MỤC" FontSize="11" />

                                    </Button>

                                </WrapPanel>



                                <!-- Thư mục lưu hiện tại & Subfolder (Hàng riêng cho Subfolder, Áp dụng truyện mới và Áp dụng tất cả & khóa) -->

                                <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,0,0,6">

                                    <StackPanel Spacing="5">

                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                            <TextBlock Text="📁 Thư mục lưu truyện hiện tại:" FontSize="10" Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />

                                            <Button Command="{Binding CopyDownloadPathCommand}" Background="#1E293B" Foreground="#38BDF8" Padding="6,2" FontSize="9" CornerRadius="3" Margin="0,0,10,0">

                                                <TextBlock Text="📋 Chép đường dẫn" />

                                            </Button>

                                        </WrapPanel>

                                        <TextBox Text="{Binding DownloadPathText}" IsReadOnly="True" Background="#0B0F19" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" Height="28" CornerRadius="3" BorderBrush="#1E293B" BorderThickness="1" VerticalContentAlignment="Center" Padding="6,2" />



                                        <!-- Hàng riêng cho Subfolder, Áp dụng truyện mới và Áp dụng tất cả & khóa -->

                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">

                                            <TextBlock Text="📁 Subfolder:" FontSize="10.5" Foreground="#F59E0B" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,2" />

                                            <TextBox Text="{Binding SubfolderInput}" PlaceholderText="[default]" Width="130" Height="26" CornerRadius="3" Background="#0B0F19" BorderBrush="#334155" Foreground="#FDE047" FontSize="10.5" VerticalContentAlignment="Center" Padding="6,1" Margin="0,0,6,2" ToolTip.Tip="Tên Subfolder lưu truyện (Mặc định: [default])." />

                                            <Button Command="{Binding ApplySubfolderToNewCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" BorderBrush="#38BDF8" BorderThickness="1" Padding="8,3" Height="26" FontSize="9.5" CornerRadius="3" Margin="0,0,6,2" ToolTip.Tip="Thiết lập tên Subfolder này làm mặc định cho các truyện mới thêm vào sau (Không thay đổi các truyện đang có trong hàng đợi)">

                                                <TextBlock Text="📁 ÁP DỤNG TRUYỆN MỚI" VerticalAlignment="Center" />

                                            </Button>

                                            <Button Command="{Binding ApplySubfolderToAllCommand}" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" BorderBrush="#10B981" BorderThickness="1" Padding="8,3" Height="26" FontSize="9.5" CornerRadius="3" Margin="0,0,0,2" ToolTip.Tip="Áp dụng Subfolder này cho TOÀN BỘ truyện trong hàng đợi: tạm dừng tải nếu đang chạy, di chuyển toàn bộ thư mục sang subfolder mới, chờ xong hoàn toàn rồi khóa cố định toàn bộ và tiếp tục tải">

                                                <TextBlock Text="🔒 ÁP DỤNG TẤT CẢ &amp; KHÓA" VerticalAlignment="Center" />

                                            </Button>

                                        </WrapPanel>



                                        <!-- Thanh Báo Hiệu Tiến Trình Di Chuyển Subfolder Rõ Ràng & Trực Quan -->

                                        <Border IsVisible="{Binding IsSubfolderMoving}" Background="#1E293B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,2,0,0">

                                            <Grid RowDefinitions="Auto, Auto">

                                                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,3">

                                                    <TextBlock Grid.Column="0" Text="{Binding SubfolderMoveStatusText}" Foreground="#FDE047" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                                    <TextBlock Grid.Column="1" Text="{Binding SubfolderMoveProgressText}" Foreground="#34D399" FontSize="10" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="6,0,0,0" />

                                                </Grid>

                                                <ProgressBar Grid.Row="1" Value="{Binding SubfolderMoveProgress}" Maximum="100" Height="8" CornerRadius="3" Foreground="#F59E0B" Background="#0F172A" />

                                            </Grid>

                                        </Border>

                                    </StackPanel>

                                </Border>



                                <!-- Toggles Checkboxes, Concurrency & Threads -->

                                <WrapPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">

                                    <!-- Số truyện tải cùng lúc -->

                                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center">

                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                            <TextBlock Text="⚡ Số truyện cùng lúc:" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />

                                            <NumericUpDown Value="{Binding ConcurrentComicDownloads}" Minimum="1" Maximum="8" Increment="1" FormatString="0" Width="120" Height="28" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                                        </StackPanel>

                                    </Border>



                                    <!-- Connection tải ảnh -->

                                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center">

                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                            <TextBlock Text="🌐 Connection tải ảnh:" Foreground="#10B981" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />

                                            <NumericUpDown Value="{Binding ImageDownloadThreads}" Minimum="1" Maximum="16" Increment="1" FormatString="0" Width="110" Height="28" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTip.Tip="Số connection tải ảnh đồng thời (Tùy chọn từ 1 đến 16)" />

                                        </StackPanel>

                                    </Border>



                                    <!-- TỰ ĐỘNG TÁCH CHƯƠNG (Port từ WPF: Chia nhỏ tải song song siêu tốc) -->

                                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center">

                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                            <TextBlock Text="⚡ TỰ ĐỘNG TÁCH CHƯƠNG:" Foreground="#F59E0B" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />

                                            <ComboBox SelectedItem="{Binding AutoSplitChaptersSelection}" Width="85" Height="28" FontSize="11" VerticalContentAlignment="Center">

                                                <x:String>OFF</x:String>

                                                <x:String>50</x:String>

                                                <x:String>100</x:String>

                                                <x:String>200</x:String>

                                                <x:String>300</x:String>

                                                <x:String>400</x:String>

                                            </ComboBox>

                                            <Button Command="{Binding ApplyAutoSplitChaptersCommand}"

                                                    Background="#0284C7" Foreground="#FFFFFF" FontWeight="ExtraBold"

                                                    Padding="10,3" Height="28" CornerRadius="4"

                                                    ToolTip.Tip="Tự động chia nhỏ các bộ truyện nhiều chương thành các dải chương (1-50, 51-100...) để tải song song nhiều luồng siêu nhanh">

                                                <TextBlock Text="ÁP" FontSize="11" FontWeight="ExtraBold" VerticalAlignment="Center" />

                                            </Button>

                                        </StackPanel>

                                    </Border>



                                    <!-- CHẾ ĐỘ TẢI THỦ CÔNG (TRỰC TIẾP / NHÚNG) -->

                                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="0,0,8,4" VerticalAlignment="Center">

                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                            <CheckBox IsChecked="{Binding IsManualDownloadMode}" 

                                                      Content="🛠️ Tải thủ công" 

                                                      FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" 

                                                      VerticalAlignment="Center"

                                                      ToolTip.Tip="Bật/tắt chế độ tải thủ công (mặc định TẮT). Khi tắt, app sẽ tải mặc định theo từng web như hiện có. Khi bật, bất kể web gì cũng sẽ tự động tải theo chế độ cài sẵn bên cạnh." />

                                            <ComboBox ItemsSource="{Binding ManualDownloadModes}" SelectedItem="{Binding SelectedManualDownloadMode, Mode=TwoWay}"

                                                      Width="140" Height="28" FontSize="11" VerticalContentAlignment="Center"

                                                      ToolTip.Tip="Chế độ tải cài sẵn khi bật tải thủ công:&#x0a;• Trực tiếp: Tải trực tiếp các ảnh/thumbnail có sẵn trên trang.&#x0a;• Nhúng: Tải bóc tách sâu qua các trang viewer/reader nhúng để lấy ảnh gốc độ phân giải cao nhất." />

                                        </StackPanel>

                                    </Border>



                                    <CheckBox IsChecked="{Binding IsAutoDownload}" Content="⚡ Tự động tải" FontSize="11" Foreground="#D1D5DB" Margin="0,0,10,4" />

                                    <CheckBox IsChecked="{Binding IsAutoRetry}" Content="🔁 Tự thử lại" FontSize="11" Foreground="#D1D5DB" Margin="0,0,10,4" />

                                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="0,0,8,4" VerticalAlignment="Center">
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding IsAddOrderPrefix}" Content="🔢 Đánh STT tên truyện" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip.Tip="Đánh số thứ tự (001., 002., 003...) ở đầu tên truyện khi tải theo đúng thứ tự trong danh sách" />
                                            <TextBlock Text="từ:" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <NumericUpDown Value="{Binding OrderPrefixStartIndex}" Minimum="1" Maximum="9999" Increment="1" FormatString="0" Width="68" Height="28" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Background="#0B0F19" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTip.Tip="Số thứ tự bắt đầu đánh (Mặc định: 1 -> 001., 002...)" />
                                            <Button Command="{Binding ClearOrderPrefixCommand}"
                                                    Background="#1E293B" BorderBrush="#EF4444" BorderThickness="1"
                                                    Foreground="#F87171" FontWeight="Bold" FontSize="10.5"
                                                    Padding="8,3" Height="26" CornerRadius="4" Margin="4,0,0,0"
                                                    ToolTip.Tip="Xóa sạch số thứ tự ở đầu tên truyện (001., 01., 1., 01 -, [01]...) của toàn bộ danh sách để đưa tên truyện về dạng gốc sạch sẽ">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="🧹" FontSize="10" VerticalAlignment="Center" />
                                                    <TextBlock Text="Xóa STT" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </Border>

                                    <Button Command="{Binding ReverseQueueCommand}" Background="#0F172A" BorderBrush="#0284C7" BorderThickness="1" Foreground="#38BDF8" FontWeight="Bold" FontSize="10.5" Padding="8,3" Height="26" CornerRadius="4" Margin="0,0,10,4" ToolTip.Tip="Đảo ngược thứ tự toàn bộ danh sách hàng chờ tải (truyện cuối lên đầu, truyện đầu xuống cuối) để tải theo thứ tự ngược lại">

                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                                            <TextBlock Text="🔃" FontSize="11" VerticalAlignment="Center" />

                                            <TextBlock Text="Đảo ngược danh sách" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" />

                                        </StackPanel>

                                    </Button>

                                    <CheckBox IsChecked="{Binding IsCompactRow}" Content="📏 Nén dòng" FontSize="11" Foreground="#D1D5DB" Margin="0,0,10,4" />

                                    <CheckBox IsChecked="{Binding IsBubbleMode, Mode=TwoWay}" Click="OnBubbleCheckBoxClicked" Content="🫧 Bong bóng" FontSize="11" Foreground="#C084FC" FontWeight="Bold" Margin="0,0,10,4" ToolTip.Tip="Bật bong bóng nổi chạy ngầm: tự động thụt vào mép và làm mờ khi nhàn rỗi (hỗ trợ Overlay &amp; Android Bubble API)" />

                                    <CheckBox IsChecked="{Binding IsAutoScrollToActive}" Click="OnAutoScrollCheckBoxClicked" Content="📜 Auto Scroll (10s)" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,10,4" ToolTip.Tip="Mỗi 10 giây tự động cuộn danh sách hàng đợi xuống vị trí truyện đang tải nằm ở vị trí thấp nhất" />

                                    <CheckBox IsChecked="{Binding IsAutoDeleteCompleted}" Content="🧹 Tự xóa đã xong" FontSize="11" Foreground="#10B981" FontWeight="SemiBold" Margin="0,0,10,4" ToolTip.Tip="Tự động dọn dẹp xóa truyện hoặc dải chương khỏi hàng đợi ngay khi tải xong 100%" />

                                    <CheckBox IsChecked="{Binding IsAutoProcessImages}" Content="✨ Xử lý ảnh khi tải" FontSize="11" Foreground="#EC4899" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,4" ToolTip.Tip="Vừa tải vừa tự động nâng cấp và chuyển đổi định dạng ảnh (JPG/WebP/Original) theo chất lượng đã chọn" />

                                    <!-- Cụm tuỳ chọn nhanh khi bật Xử lý ảnh (Định dạng xuất, Chất lượng, Nút mở bộ lọc) -->
                                    <Border IsVisible="{Binding IsAutoProcessImages}" Background="#0B0F19" BorderBrush="#EC4899" BorderThickness="1" CornerRadius="4" Padding="5,2" VerticalAlignment="Center" Margin="0,0,8,4">
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Định dạng:" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <ComboBox SelectedIndex="{Binding DownloadEnhanceFormatIndex}" Width="82" Height="24" FontSize="10" Background="#1E293B" Foreground="#38BDF8" BorderThickness="0" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip.Tip="Định dạng xuất file ảnh khi tải về (JPG nén siêu nhẹ, WebP hiện đại, hoặc Giữ nguyên gốc)">
                                                <ComboBoxItem Content="JPG" />
                                                <ComboBoxItem Content="WebP" />
                                                <ComboBoxItem Content="Gốc" />
                                            </ComboBox>

                                            <TextBlock Text="CL:" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <NumericUpDown Value="{Binding EnhanceQuality}" Minimum="10" Maximum="100" Increment="5" FormatString="0" Width="68" Height="24" FontSize="10" Foreground="#F59E0B" Background="#1E293B" BorderThickness="0" CornerRadius="3" VerticalAlignment="Center" HorizontalContentAlignment="Center" Margin="0,0,6,0" ToolTip.Tip="Chất lượng nén ảnh (10 - 100, khuyên dùng 45-80 để nén siêu nhẹ)" />

                                            <Button Command="{Binding OpenEnhanceSettingsTabCommand}" Background="#831843" Foreground="#F472B6" FontSize="10" FontWeight="Bold" Padding="6,2" Height="22" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip.Tip="Mở tab Công cụ -> Nâng cấp ảnh để chỉnh chuyên sâu bộ lọc (Tương phản, Độ sáng, Bão hòa, Khử nhiễu, Presets)">
                                                <TextBlock Text="⚙️ Bộ lọc" />
                                            </Button>

                                            <TextBlock Text="{Binding EnhanceFilterSummaryText}" FontSize="9.5" Foreground="#34D399" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,2,0" ToolTip.Tip="Thông số bộ lọc hình ảnh đang được đồng bộ và áp dụng trực tiếp từ Tab Công cụ -> Xử lý ảnh" />
                                        </WrapPanel>
                                    </Border>

                                    <CheckBox IsChecked="{Binding IsAutoSplitLongImages}" Content="✂️ Tự cắt ảnh dài"  FontSize="11" Foreground="#F43F5E" FontWeight="SemiBold" Margin="0,0,6,4" ToolTip.Tip="Tự động cắt ảnh có chiều cao lớn hơn ngưỡng chỉ định thành các mảnh nhỏ trong khi tải" />

                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding IsAutoSplitLongImages}" Margin="0,0,0,4">

                                        <TextBlock Text="Cao:" FontSize="11" Foreground="#F43F5E" FontWeight="SemiBold" VerticalAlignment="Center" />

                                        <NumericUpDown Value="{Binding AutoSplitHeight}" Minimum="500" Maximum="50000" Increment="500" FormatString="0" Width="140" Height="28" FontSize="11" Foreground="#38BDF8" Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                                        <TextBlock Text="px" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />

                                    </StackPanel>

                                </WrapPanel>

                            </Grid>

                        </Border>



                        <!-- Subtabs bên trong Download Panel -->

                        <TabControl Grid.Row="1" Background="Transparent" Margin="0">



                            <!-- SUBTAB 2.1: DOWNLOAD MANGA QUEUE LIST -->

                            <TabItem Header="📋 Hàng Chờ" FontSize="12" FontWeight="SemiBold">

                                <Grid RowDefinitions="Auto, *">

                                    <!-- Toolbar chọn hàng -->

                                    <Border Grid.Row="0" Background="#161F30" Padding="10,5" BorderBrush="#1E293B" BorderThickness="0,0,0,1">

                                        <WrapPanel Orientation="Horizontal">

                                            <!-- 🔍 Ô TÌM KIẾM LỌC TRUYỆN THEO TÊN TRONG HÀNG CHỜ -->
                                            <!-- 🔍 Ô TÌM KIẾM LỌC TRUYỆN THEO TÊN, LINK, TAG TRONG HÀNG CHỜ -->
                                            <Border Background="#091018" BorderBrush="#334155" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,6,2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="🔍" FontSize="10" Foreground="#38BDF8" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                    <TextBox Text="{Binding QueueSearchFilter}" PlaceholderText="Tìm tên, link, tag, prefix..."
                                                             Background="Transparent" BorderThickness="0" Foreground="#E2E8F0" FontSize="10"
                                                             Width="140" Height="22" Padding="2,2" VerticalContentAlignment="Center"
                                                             ToolTip.Tip="Tìm kiếm theo Tên, Link, Tag, Trạng thái... Hỗ trợ prefix 'name:', 'link:', 'tag:'"/>
                                                    <Button Command="{Binding ClearQueueFilterCommand}" IsVisible="{Binding QueueSearchFilter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                            Background="Transparent" BorderThickness="0" Foreground="#94A3B8" Padding="2" FontSize="9" VerticalAlignment="Center" ToolTip.Tip="Xóa bộ lọc nhanh">
                                                        <TextBlock Text="✕" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>

                                            <!-- ⏚ NÚT ADVANCED SEARCH FILTER (CHUẨN MOBILE NAME CARD GỌN GÀNG ĐA NỀN TẢNG) -->
                                            <Button Background="#091018" BorderBrush="{Binding AdvancedSearch.FilterIconBrush}" BorderThickness="1"
                                                    CornerRadius="3" Padding="6,2" Margin="0,0,6,2" VerticalAlignment="Center"
                                                    ToolTip.Tip="Bộ lọc nâng cao đa điều kiện: Bắt buộc có (+), Có thể có (OR), Loại trừ (-), Khớp chính xác từ">
                                                <Button.Flyout>
                                                    <Flyout Placement="Bottom">
                                                        <Border Background="#0B0F19" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="8" Padding="8,8"
                                                                Width="315" HorizontalAlignment="Center">
                                                            <ScrollViewer MaxHeight="450" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                                <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" DataContext="{Binding AdvancedSearch}">
                                                                    
                                                                    <!-- Tiêu đề Header chuẩn Mobile Name Card có nút CLEAR góc phải -->
                                                                    <Border Grid.Row="0" Background="#111827" CornerRadius="5" Padding="6,3" Margin="0,0,0,6">
                                                                        <Grid ColumnDefinitions="*, Auto">
                                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                <TextBlock Text="⚡" FontSize="11" Foreground="#00E5FF"/>
                                                                                <TextBlock Text="BỘ LỌC TÌM KIẾM NÂNG CAO" Foreground="#00E5FF" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                            <!-- Nút CLEAR nhỏ gọn ngay Header Name Card -->
                                                                            <Button Grid.Column="1" Command="{Binding ClearCommand}" Content="🗑️ CLEAR"
                                                                                    Background="#991B1B" BorderBrush="#DC2626" BorderThickness="1" Foreground="#FFFFFF"
                                                                                    FontWeight="Bold" FontSize="9" Padding="6,2" CornerRadius="3" ToolTip.Tip="Xóa sạch điều kiện lọc"/>
                                                                        </Grid>
                                                                    </Border>

                                                                    <!-- HÀNG 1: BẮT BUỘC CÓ (+) & CÓ THỂ CÓ (OR) (2 cột Name Card) -->
                                                                    <Grid Grid.Row="1" ColumnDefinitions="*, *" Margin="0,0,0,2">
                                                                        <TextBlock Grid.Column="0" Text="BẮT BUỘC (+)" Foreground="#10B981" FontSize="9" FontWeight="Bold" Margin="0,0,2,0"/>
                                                                        <TextBlock Grid.Column="1" Text="CÓ THỂ (OR)" Foreground="#F59E0B" FontSize="9" FontWeight="Bold" Margin="2,0,0,0"/>
                                                                    </Grid>
                                                                    <Grid Grid.Row="2" ColumnDefinitions="*, *" Margin="0,0,0,6">
                                                                        <!-- Cột 1: Positive Keywords (AND) -->
                                                                        <TextBox Grid.Column="0" Text="{Binding PositiveText}" PlaceholderText="từ 1; từ 2..."
                                                                                 Background="#091018" BorderBrush="#10B981" BorderThickness="1" Foreground="#F3F4F6"
                                                                                 Height="25" FontSize="9.5" Margin="0,0,2,0" Padding="4,2" VerticalContentAlignment="Center"
                                                                                 ToolTip.Tip="Bắt buộc phải chứa TẤT CẢ các từ khóa này (phân tách bằng dấu ;)"/>

                                                                        <!-- Cột 2: Non-Negative Keywords (OR) -->
                                                                        <TextBox Grid.Column="1" Text="{Binding NonNegativeText}" PlaceholderText="từ 1; từ 2..."
                                                                                 Background="#091018" BorderBrush="#F59E0B" BorderThickness="1" Foreground="#F3F4F6"
                                                                                 Height="25" FontSize="9.5" Margin="2,0,0,0" Padding="4,2" VerticalContentAlignment="Center"
                                                                                 ToolTip.Tip="Phải chứa ÍT NHẤT MỘT trong các từ khóa này (phân tách bằng dấu ;)"/>
                                                                    </Grid>

                                                                    <!-- HÀNG 2: BẮT BUỘC KHÔNG CÓ (-) & LOẠI TRỪ (-) (2 cột Name Card) -->
                                                                    <Grid Grid.Row="3" ColumnDefinitions="*, *" Margin="0,0,0,2">
                                                                        <TextBlock Grid.Column="0" Text="CẤM CÓ (-)" Foreground="#00E5FF" FontSize="9" FontWeight="Bold" Margin="0,0,2,0"/>
                                                                        <TextBlock Grid.Column="1" Text="LOẠI TRỪ (-)" Foreground="#F43F5E" FontSize="9" FontWeight="Bold" Margin="2,0,0,0"/>
                                                                    </Grid>
                                                                    <Grid Grid.Row="4" ColumnDefinitions="*, *" Margin="0,0,0,6">
                                                                        <!-- Cột 3: Non-Positive Keywords (Exclude 1) -->
                                                                        <TextBox Grid.Column="0" Text="{Binding NonPositiveText}" PlaceholderText="cấm 1; cấm 2..."
                                                                                 Background="#091018" BorderBrush="#00E5FF" BorderThickness="1" Foreground="#F3F4F6"
                                                                                 Height="25" FontSize="9.5" Margin="0,0,2,0" Padding="4,2" VerticalContentAlignment="Center"
                                                                                 ToolTip.Tip="Tuyệt đối KHÔNG ĐƯỢC CHỨA bất kỳ từ khóa nào trong danh sách này"/>

                                                                        <!-- Cột 4: Negative Keywords (Exclude 2) -->
                                                                        <TextBox Grid.Column="1" Text="{Binding NegativeText}" PlaceholderText="loại trừ..."
                                                                                 Background="#091018" BorderBrush="#F43F5E" BorderThickness="1" Foreground="#F3F4F6"
                                                                                 Height="25" FontSize="9.5" Margin="2,0,0,0" Padding="4,2" VerticalContentAlignment="Center"
                                                                                 ToolTip.Tip="Loại trừ triệt để các từ khóa này khỏi kết quả tìm kiếm"/>
                                                                    </Grid>

                                                                    <!-- HÀNG 3: BỘ ĐIỀU KHIỂN CHÂN TRANG GỌN GÀNG CHUẨN NAME CARD -->
                                                                    <Grid Grid.Row="5" ColumnDefinitions="Auto, *">
                                                                        <!-- Nút Undo & Redo -->
                                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="0,0,4,0">
                                                                            <Button Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"
                                                                                    Content="↶ Undo" Background="#1E293B" Foreground="#38BDF8" FontSize="9" Padding="5,2" CornerRadius="3"/>
                                                                            <Button Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"
                                                                                    Content="↷ Redo" Background="#1E293B" Foreground="#38BDF8" FontSize="9" Padding="5,2" CornerRadius="3"/>
                                                                        </StackPanel>

                                                                        <!-- Chế độ so khớp Match Mode -->
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                                                                            <RadioButton GroupName="MatchModeGroup" Content="Chứa từ" IsChecked="{Binding IsContainsMode, Mode=TwoWay}"
                                                                                         Foreground="#E2E8F0" FontSize="9" VerticalContentAlignment="Center"
                                                                                         ToolTip.Tip="Khớp chuỗi con ở bất kỳ vị trí nào trong từ"/>
                                                                            <RadioButton GroupName="MatchModeGroup" Content="Từ chính xác" IsChecked="{Binding IsExactWord, Mode=TwoWay}"
                                                                                         Foreground="#00E5FF" FontWeight="Bold" FontSize="9" VerticalContentAlignment="Center"
                                                                                         ToolTip.Tip="Khớp nguyên từ hoàn chỉnh (ngăn cách bởi dấu cách hoặc dấu câu)"/>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                </Grid>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </Flyout>
                                                </Button.Flyout>
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Path Data="M3,4 L17,4 L12,10 L12,17 L8,15 L8,10 Z" Stroke="{Binding AdvancedSearch.FilterIconBrush}" Fill="Transparent" StrokeThickness="1.5" Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Lọc nâng cao" Foreground="{Binding AdvancedSearch.FilterIconBrush}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="{Binding FilteredQueueCountText}" Foreground="#FDE047" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,2" IsVisible="{Binding IsFilterActive}"/>
                                            <!-- NÚT TOGGLE LỌC TRUYỆN TRÙNG (TÊN TRÙNG) -->
                                            <ToggleButton Classes="filter-toggle filter-name-dup" IsChecked="{Binding IsFilterDuplicatesOnly}" CornerRadius="3" Margin="0,0,4,2" Padding="6,2" FontSize="10"
                                                          ToolTip.Tip="Chỉ hiển thị các truyện trùng tên trong hàng đợi (Click để lọc, chuột phải để chọn bản trùng)">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="🔍" FontSize="10"/>
                                                    <TextBlock Text="Tên trùng" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding DuplicateBooksCount, StringFormat='({0})'}" Foreground="#00E5FF" FontWeight="Bold" IsVisible="{Binding DuplicateBooksCount}"/>
                                                </StackPanel>
                                                <ToggleButton.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Tích chọn tất cả truyện trùng tên" Command="{Binding CheckAllDuplicatesCommand}"/>
                                                        <MenuItem Header="✨ Tự chọn bản sao trùng tên (Giữ 1 bản tốt nhất)" Command="{Binding CheckNameDuplicatesKeepOneCommand}"/>
                                                        <MenuItem Header="Bỏ tích chọn truyện trùng tên" Command="{Binding UncheckAllDuplicatesCommand}"/>
                                                    </ContextMenu>
                                                </ToggleButton.ContextMenu>
                                            </ToggleButton>

                                            <!-- NÚT TOGGLE LỌC TRUYỆN TRÙNG ẢNH BÌA -->
                                            <ToggleButton Classes="filter-toggle filter-image-dup" IsChecked="{Binding IsFilterImageDuplicatesOnly}" CornerRadius="3" Margin="0,0,4,2" Padding="6,2" FontSize="10"
                                                          ToolTip.Tip="Chỉ hiển thị các truyện có ảnh bìa trùng nhau (dù khác tên, khác ngôn ngữ dịch). Chuột phải để chọn bản trùng.">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="🖼️" FontSize="10"/>
                                                    <TextBlock Text="Trùng ảnh" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding ImageDuplicateBooksCount, StringFormat='({0})'}" Foreground="#F43F5E" FontWeight="Bold" IsVisible="{Binding ImageDuplicateBooksCount}"/>
                                                    <ProgressBar Width="24" Height="4" IsIndeterminate="True" Margin="2,0,0,0" IsVisible="{Binding IsScanningImageDuplicates}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ToggleButton.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Quét lại toàn bộ mã băm ảnh bìa" Command="{Binding ScanAndFilterImageDuplicatesCommand}"/>
                                                        <MenuItem Header="Tích chọn tất cả truyện trùng ảnh" Command="{Binding CheckAllImageDuplicatesCommand}"/>
                                                        <MenuItem Header="✨ Tự chọn bản sao trùng ảnh (Giữ 1 bản tốt nhất)" Command="{Binding CheckImageDuplicatesKeepOneCommand}"/>
                                                    </ContextMenu>
                                                </ToggleButton.ContextMenu>
                                            </ToggleButton>

                                            <!-- NÚT TOGGLE LỌC TRUYỆN UNCEN -->
                                            <ToggleButton Classes="filter-toggle filter-uncen" IsChecked="{Binding IsFilterUncenOnly}" CornerRadius="3" Margin="0,0,4,2" Padding="6,2" FontSize="10"
                                                          ToolTip.Tip="Chỉ hiển thị các truyện bản không che (Uncensored / Decensored)">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="🔞" FontSize="10"/>
                                                    <TextBlock Text="Uncen" FontWeight="Bold"/>
                                                </StackPanel>
                                            </ToggleButton>

                                            <!-- NÚT BẢNG MÀU COLOR RULES VỚI POPUP FLYOUT -->
                                            <Button Background="#1E293B" BorderBrush="#EC4899" BorderThickness="1" Foreground="#F43F5E" FontWeight="Bold" FontSize="10" Padding="6,2" CornerRadius="3" Margin="0,0,6,2"
                                                    ToolTip.Tip="Xem giải thích quy tắc mã màu truyện trùng &amp; biến thể">
                                                <Button.Flyout>
                                                    <Flyout Placement="Bottom">
                                                        <Border Background="#0B0F19" BorderBrush="#00E5FF" BorderThickness="1" CornerRadius="4" Padding="12" Width="360">
                                                            <StackPanel Spacing="6">
                                                                <TextBlock Text="🎨 BẢNG QUY TẮC MÀU SẮC (COLOR RULES)" Foreground="#00E5FF" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center"/>
                                                                <Separator Background="#1E293B"/>
                                                                <Grid ColumnDefinitions="20, *" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                                                    <Rectangle Grid.Row="0" Grid.Column="0" Width="12" Height="12" Fill="#FDE047" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Vàng: Truyện độc lập bình thường (không trùng)" Foreground="#FDE047" FontSize="10.5" Margin="6,2"/>

                                                                    <Rectangle Grid.Row="1" Grid.Column="0" Width="12" Height="12" Fill="#00E5FF" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Cyan: Truyện trùng tên hoặc trùng nhóm" Foreground="#00E5FF" FontSize="10.5" Margin="6,2"/>

                                                                    <Rectangle Grid.Row="2" Grid.Column="0" Width="12" Height="12" Fill="#2DD4BF" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Mint (Xanh ngọc): Biến thể có đánh số (Part 1, 2...)" Foreground="#2DD4BF" FontSize="10.5" Margin="6,2"/>

                                                                    <Rectangle Grid.Row="3" Grid.Column="0" Width="12" Height="12" Fill="#FFE600" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Vàng sáng: Bản không che (Uncensored / Decensored)" Foreground="#FFE600" FontSize="10.5" Margin="6,2"/>

                                                                    <Rectangle Grid.Row="4" Grid.Column="0" Width="12" Height="12" Fill="#E879F9" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Tím nhạt: Bản có màu (Full Color / Colorized)" Foreground="#E879F9" FontSize="10.5" Margin="6,2"/>

                                                                    <Rectangle Grid.Row="5" Grid.Column="0" Width="12" Height="12" Fill="#F43F5E" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Hồng (Pink): Vừa không che vừa có màu (Uncen + Color)" Foreground="#F43F5E" FontSize="10.5" Margin="6,2"/>

                                                                    <Rectangle Grid.Row="6" Grid.Column="0" Width="12" Height="12" Fill="#A3E635" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Lime (Xanh chuối): Biến thể số + Không che" Foreground="#A3E635" FontSize="10.5" Margin="6,2"/>

                                                                    <Rectangle Grid.Row="7" Grid.Column="0" Width="12" Height="12" Fill="#38BDF8" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="Xanh biển: Biến thể số + Có màu" Foreground="#38BDF8" FontSize="10.5" Margin="6,2"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </Flyout>
                                                </Button.Flyout>
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="🎨" FontSize="10"/>
                                                    <TextBlock Text="COLOR RULES" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- NÚT SẮP XẾP THEO TÊN ALPHABET (A-Z / Z-A) -->
                                            <Button Command="{Binding SortByNameAlphabetCommand}" Background="#1E293B" BorderBrush="#EAB308" BorderThickness="1" Foreground="#FDE047" FontWeight="Bold" FontSize="10" Padding="6,2" CornerRadius="3" Margin="0,0,4,2"
                                                    ToolTip.Tip="Sắp xếp danh sách truyện theo bảng chữ cái alphabet (A-Z hoặc Z-A)">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="🔤" FontSize="10"/>
                                                    <TextBlock Text="{Binding SortByNameButtonText}" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- NÚT KHÔI PHỤC THỨ TỰ GỐC TỪ WEB -->
                                            <Button Command="{Binding RestoreOriginalOrderCommand}" Background="#1E293B" BorderBrush="#0284C7" BorderThickness="1" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" Padding="6,2" CornerRadius="3" Margin="0,0,4,2"
                                                    ToolTip.Tip="Khôi phục lại thứ tự ban đầu khi cào truyện từ web (Restore original order)">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="⏮️" FontSize="10"/>
                                                    <TextBlock Text="Thứ tự gốc từ web" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Command="{Binding SelectAllCommand}" Content="✓ Tất cả" Background="#1E293B" Foreground="#94A3B8" FontSize="10" Padding="5,2" CornerRadius="3" Margin="0,0,4,2" />

                                            <Button Command="{Binding UnselectAllCommand}" Content="✗ Bỏ chọn" Background="#1E293B" Foreground="#94A3B8" FontSize="10" Padding="5,2" CornerRadius="3" Margin="0,0,4,2" />

                                            <Button Command="{Binding InvertSelectionCommand}" Content="⇄ Đảo chọn" Background="#1E293B" Foreground="#94A3B8" FontSize="10" Padding="5,2" CornerRadius="3" Margin="0,0,4,2" />

                                            <Button Command="{Binding ReverseQueueCommand}" Background="#0284C7" BorderBrush="#38BDF8" BorderThickness="1" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" Padding="8,2" CornerRadius="3" Margin="0,0,4,2" ToolTip.Tip="Đảo ngược thứ tự toàn bộ danh sách hàng chờ tải (truyện cuối lên đầu, truyện đầu xuống cuối)">

                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                                                    <TextBlock Text="🔃" FontSize="10" VerticalAlignment="Center" />

                                                    <TextBlock Text="Đảo ngược danh sách" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />

                                                </StackPanel>

                                            </Button>

                                            <Button Command="{Binding CheckSelectedRowsCommand}" Content="☑ Tích" Background="#1E293B" Foreground="#38BDF8" FontSize="10" Padding="5,2" CornerRadius="3" Margin="0,0,4,2" />

                                            <Button Command="{Binding CheckErrorsCommand}" Content="⚠️ Lỗi" Background="#1E293B" Foreground="#F43F5E" FontSize="10" Padding="5,2" CornerRadius="3" Margin="0,0,4,2" />

                                            <Button Command="{Binding CheckDuplicatesCommand}" Content="🔍 Trùng" Background="#1E293B" Foreground="#F59E0B" FontSize="10" Padding="5,2" CornerRadius="3" Margin="0,0,4,2" ToolTip.Tip="Tích chọn toàn bộ các truyện trùng tên trong hàng đợi" />

                                            <Button Command="{Binding CheckImageDuplicatesKeepOneCommand}" Background="#1E293B" BorderBrush="#EC4899" BorderThickness="1" Foreground="#FB7185" FontSize="10" Padding="5,2" CornerRadius="3" Margin="0,0,4,2" ToolTip.Tip="Tự động tích chọn các bản sao trùng ảnh để xóa nhanh (giữ lại 1 bản tốt nhất cho mỗi nhóm)">
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <TextBlock Text="🖼️ Giữ 1 ảnh" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Command="{Binding ToggleLockAllSubfoldersCommand}" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Foreground="#F59E0B" FontSize="10" Padding="6,2" CornerRadius="3" Margin="0,0,4,2" ToolTip.Tip="Khóa hoặc mở khóa toàn bộ Subfolder của tất cả các truyện trong hàng đợi">

                                                <StackPanel Orientation="Horizontal" Spacing="3">

                                                    <TextBlock Text="🔒 KHÓA TẤT CẢ SUBFOLDER" IsVisible="{Binding !IsAllSubfoldersLocked}" />

                                                    <TextBlock Text="🔓 MỞ TẤT CẢ SUBFOLDER" IsVisible="{Binding IsAllSubfoldersLocked}" Foreground="#34D399" />

                                                </StackPanel>

                                            </Button>

                                            <Button Command="{Binding ClearCompletedCommand}" Content="🧹 Xóa đã xong" Background="#1E293B" Foreground="#10B981" FontWeight="Bold" FontSize="10" Padding="5,2" CornerRadius="3" Margin="0,0,4,2" ToolTip.Tip="Tự động dọn dẹp tất cả các bộ truyện và dải chương đã tải xong (Completed / Hoàn tất) khỏi hàng đợi" />

                                            <Button Command="{Binding DeleteSelectedCommand}" Content="🗑️ Xóa" Background="#1E293B" Foreground="#EF4444" FontSize="10" Padding="5,2" CornerRadius="3" Margin="0,0,6,2" />



                                            <!-- CHẾ ĐỘ HIỂN THỊ (VIEW MODE: List view / Thumbnail view / List + thumbnail column) GIỐNG HỆT WPF -->

                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,6,2">

                                                <TextBlock Text="VIEW MODE:" Foreground="#00E5FF" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />

                                                <ComboBox ItemsSource="{Binding QueueViewModes}"

                                                          SelectedItem="{Binding SelectedQueueViewMode}"

                                                          Width="168" Height="24" FontSize="10" FontWeight="SemiBold"

                                                          Background="#091018" Foreground="#00E5FF" BorderBrush="#00E5FF" BorderThickness="1"

                                                          Padding="6,1" VerticalAlignment="Center"

                                                          ToolTip.Tip="Chuyển đổi giữa 3 chế độ hiển thị: List view, Thumbnail view, List + thumbnail column" />

                                            </StackPanel>

                                            <!-- NÚT TOGGLE LƯỚI ĐA CỘT CHO LIST VIEW & LIST + THUMBNAIL (3 CỘT PC / 2 CỘT ANDROID) -->
                                            <ToggleButton Classes="filter-toggle queue-grid-toggle" IsChecked="{Binding IsQueueGridMode}"
                                                          CornerRadius="3" Margin="0,0,6,2" Padding="6,2" FontSize="10"
                                                          ToolTip.Tip="Chuyển đổi chế độ Lưới đa cột (3 cột trên Windows/Linux, 2 cột trên Android) cho List view &amp; List + thumbnail column">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="⊞" FontSize="11" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding GridButtonText}" FontWeight="Bold"/>
                                                </StackPanel>
                                            </ToggleButton>



                                            <!-- NÚT POPUP PREVIEW (BẬT / TẮT) -->

                                            <Button Command="{Binding TogglePopupPreviewCommand}"

                                                    Background="{Binding PopupPreviewButtonBackground}"

                                                    BorderBrush="{Binding PopupPreviewButtonBorder}"

                                                    BorderThickness="1"

                                                    Foreground="{Binding PopupPreviewButtonForeground}"

                                                    FontSize="10" Padding="6,2" CornerRadius="3" Margin="0,0,4,2"

                                                    ToolTip.Tip="Bật / Tắt cửa sổ Popup xem trước ảnh bìa và chi tiết khi di chuột hoặc chọn truyện">

                                                <TextBlock Text="{Binding PopupPreviewButtonText}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />

                                            </Button>



                                            <!-- NÚT QUÉT LẠI THUMBNAIL -->

                                            <Button Command="{Binding RescanThumbnailsCommand}"

                                                    Background="#1E293B" BorderBrush="#334155" BorderThickness="1"

                                                    Foreground="#34D399" FontSize="10" Padding="6,2" CornerRadius="3" Margin="0,0,4,2"

                                                    ToolTip.Tip="Tải lại toàn bộ ảnh thumbnail cho các truyện đã chọn hoặc tất cả truyện">

                                                <StackPanel Orientation="Horizontal" Spacing="3">

                                                    <TextBlock Text="🔄" FontSize="10" />

                                                    <TextBlock Text="QUÉT LẠI THUMBNAIL" FontWeight="Bold" FontSize="10" />

                                                </StackPanel>

                                            </Button>



                                        </WrapPanel>

                                    </Border>





                                    <!-- 1. DANH SÁCH 1 CỘT (LIST VIEW & LIST + THUMBNAIL) - VIRTUALIZING ẢO HÓA 60FPS -->
                                    <ItemsControl x:Name="QueueItemsControl" Grid.Row="1" ItemsSource="{Binding ActiveQueueItemsSource}" MinHeight="260" Padding="0,0,0,70" IsVisible="{Binding IsQueueSingleColumnDisplayActive}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.Template>
                                            <ControlTemplate>
                                                <ScrollViewer x:Name="QueueScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="{TemplateBinding Padding}" BringIntoViewOnFocusChange="False">
                                                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:ComicBookItem">
                                                <ContentControl Content="{Binding .}" ContentTemplate="{StaticResource ComicQueueCardTemplate}" Margin="0,0,0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 2. DANH SÁCH LƯỚI ĐA CỘT (3 CỘT PC / 2 CỘT ANDROID) - VIRTUALIZING ẢO HÓA 60FPS TRIỆT TIÊU LAG -->
                                    <ItemsControl x:Name="GridQueueItemsControl" Grid.Row="1" ItemsSource="{Binding GridQueueRows}" MinHeight="260" Padding="4,4,4,70" IsVisible="{Binding IsQueueGridDisplayActive}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.Template>
                                            <ControlTemplate>
                                                <ScrollViewer x:Name="GridQueueScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="{TemplateBinding Padding}" BringIntoViewOnFocusChange="False">
                                                    <ItemsPresenter Name="PART_GridItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:QueueGridRow">
                                                <UniformGrid Rows="1" Columns="{Binding ColumnsCount}" Margin="0,0,0,4">
                                                    <ContentControl Grid.Column="0" Content="{Binding Col1}" ContentTemplate="{StaticResource ComicQueueCardTemplate}" Margin="3,1" IsVisible="{Binding HasCol1}" />
                                                    <ContentControl Grid.Column="1" Content="{Binding Col2}" ContentTemplate="{StaticResource ComicQueueCardTemplate}" Margin="3,1" IsVisible="{Binding HasCol2}" />
                                                    <ContentControl Grid.Column="2" Content="{Binding Col3}" ContentTemplate="{StaticResource ComicQueueCardTemplate}" Margin="3,1" IsVisible="{Binding HasCol3}" />
                                                </UniformGrid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- LƯỚI THẺ ẢNH THUMBNAIL (THUMBNAIL VIEW MODE - CHUẨN GIAO DIỆN WPF) -->

                                    <ScrollViewer x:Name="ThumbnailScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" MinHeight="260" Padding="8,8,8,70" IsVisible="{Binding IsThumbnailMode}" BringIntoViewOnFocusChange="False">

                                        <ItemsControl x:Name="ThumbnailItemsControl" ItemsSource="{Binding ActiveThumbnailItemsSource}">

                                            <ItemsControl.ItemsPanel>

                                                <ItemsPanelTemplate>

                                                    <WrapPanel Orientation="Horizontal" />

                                                </ItemsPanelTemplate>

                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <Border IsVisible="{Binding !IsFilteredOut}" Width="195" Height="280" Margin="6" Background="{Binding ThumbnailCardBackground}" BorderBrush="{Binding ThumbnailCardBorderBrush}" BorderThickness="{Binding ThumbnailCardBorderThickness}" CornerRadius="3" Padding="8,6" ClipToBounds="True"

                                                            AttachedToVisualTree="OnThumbnailElementAttached"

                                                            DataContextChanged="OnThumbnailElementDataContextChanged"

                                                            PointerEntered="OnThumbnailItemPointerEntered"

                                                            PointerMoved="OnThumbnailItemPointerMoved"

                                                            PointerExited="OnThumbnailItemPointerExited"

                                                            PointerPressed="OnThumbnailItemPointerPressed"

                                                            PointerReleased="OnThumbnailItemPointerReleased">

                                                        <Border.ContextMenu>

                                                            <ContextMenu>

                                                                <MenuItem Header="Tích chọn truyện này (Check)"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CheckSingleBookCommand}"

                                                                          CommandParameter="{Binding .}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="✔" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <MenuItem Header="Bỏ chọn truyện này (Uncheck)"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).UncheckSingleBookCommand}"

                                                                          CommandParameter="{Binding .}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="✕" Foreground="#64748B" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <Separator Background="#334155" />

                                                                <MenuItem Header="Đưa lên đầu hàng đợi (Move to Top)"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MoveToTopCommand}"

                                                                          CommandParameter="{Binding .}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="▲" Foreground="#34D399" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <MenuItem Header="Đưa xuống cuối hàng đợi (Move to Bottom)"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MoveToBottomCommand}"

                                                                          CommandParameter="{Binding .}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="▼" Foreground="#F87171" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <MenuItem Header="🔤 Sắp xếp theo tên alphabet (A-Z / Z-A)"
                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SortByNameAlphabetCommand}">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="🔤" Foreground="#FDE047" FontSize="12" VerticalAlignment="Center" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>

                                                                <MenuItem Header="⏮️ Khôi phục thứ tự gốc từ web (Restore Order)"
                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RestoreOriginalOrderCommand}">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="⏮️" Foreground="#38BDF8" FontSize="12" VerticalAlignment="Center" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>

                                                                <MenuItem Header="🔃 Đảo ngược toàn bộ danh sách (Reverse Queue)"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ReverseQueueCommand}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="🔃" Foreground="#38BDF8" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <Separator Background="#334155" />

                                                                <MenuItem Header="📁 Mở thư mục truyện (Open Folder)"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenBookFolderCommand}"

                                                                          CommandParameter="{Binding .}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="📁" Foreground="#FDE047" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                                <MenuItem Header="🧹 Xóa STT tên truyện này (Clear STT)"
                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ClearSingleBookOrderPrefixCommand}"
                                                                          CommandParameter="{Binding .}">
                                                                    <MenuItem.Icon>
                                                                        <TextBlock Text="🧹" Foreground="#F87171" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <Separator Background="#334155" />
                                                                <MenuItem Header="❌ Xóa khỏi hàng đợi"

                                                                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DeleteItemCommand}"

                                                                          CommandParameter="{Binding .}">

                                                                    <MenuItem.Icon>

                                                                        <TextBlock Text="✕" Foreground="#EF4444" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />

                                                                    </MenuItem.Icon>

                                                                </MenuItem>

                                                            </ContextMenu>

                                                        </Border.ContextMenu>

                                                        <Grid RowDefinitions="142, *, Auto">

                                                            <!-- Hàng 0: Checkbox góc trái + Ảnh bìa dọc ở giữa + Icon ☰ góc phải (Giống hệt WPF) -->

                                                            <Grid Grid.Row="0">

                                                                <CheckBox IsChecked="{Binding IsChecked}" PointerPressed="OnQueueItemCheckBoxPointerPressed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0" />



                                                                <Border Width="105" Height="138" Background="#05080D" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">

                                                                    <Grid>

                                                                        <TextBlock Text="NO IMG" FontSize="9" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"

                                                                                   IsVisible="{Binding ThumbnailBitmap, Converter={x:Static ObjectConverters.IsNull}}" />

                                                                        <Image Source="{Binding ThumbnailBitmap}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"

                                                                               RenderOptions.BitmapInterpolationMode="HighQuality" />

                                                                        <Border Background="#80000000" IsVisible="{Binding IsThumbnailLoading}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                                                                            <TextBlock Text="⏳" FontSize="14" Foreground="#00E5FF" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                                        </Border>

                                                                    </Grid>

                                                                </Border>



                                                                <TextBlock Text="☰" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" HorizontalAlignment="Right" VerticalAlignment="Top" />

                                                            </Grid>



                                                            <!-- Hàng 1: Tiêu đề vàng đậm + Missing chapter + Status + Process (Giống hệt WPF) -->

                                                            <StackPanel Grid.Row="1" Margin="0,6,0,4" Spacing="2">

                                                                <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding TitleBrush}"

                                                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />

                                                                <TextBlock FontSize="10" TextTrimming="CharacterEllipsis">

                                                                    <Run Text="Missing chapter: " Foreground="#94A3B8" />

                                                                    <Run Text="{Binding MissingChapterDisplay}" Foreground="{Binding MissingChapterBrush}" FontWeight="SemiBold" />

                                                                </TextBlock>

                                                                <TextBlock FontSize="10" TextTrimming="CharacterEllipsis">

                                                                    <Run Text="Status: " Foreground="#94A3B8" />

                                                                    <Run Text="{Binding DisplayStatusVi}" Foreground="#00E5FF" FontWeight="SemiBold" />

                                                                </TextBlock>

                                                                <TextBlock FontSize="10" TextTrimming="CharacterEllipsis">

                                                                    <Run Text="Process: " Foreground="#94A3B8" />

                                                                    <Run Text="{Binding ThumbnailProcessDisplay}" Foreground="#CBD5E1" />

                                                                </TextBlock>

                                                            </StackPanel>



                                                            <!-- Hàng 2: Thanh ProgressBar bên trái + Số % bên phải (Giống hệt WPF) -->

                                                            <Grid Grid.Row="2" ColumnDefinitions="*, Auto" VerticalAlignment="Bottom" Margin="0,2,0,0">

                                                                <ProgressBar Grid.Column="0" Value="{Binding ProgressPercentage}" Maximum="100" Height="8"

                                                                             CornerRadius="2" Foreground="#00E5FF" Background="#111C2D"

                                                                             HorizontalAlignment="Stretch" VerticalAlignment="Center" BorderThickness="0" Margin="0,0,8,0" />

                                                                <TextBlock Grid.Column="1" Text="{Binding ProgressPercentageText}"

                                                                           VerticalAlignment="Center" Foreground="#00E5FF" FontWeight="Bold" FontSize="10" />

                                                            </Grid>

                                                        </Grid>

                                                    </Border>

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </ScrollViewer>



                                </Grid>

                            </TabItem>



                            <!-- SUBTAB 2.2: SCAN MISSING INTEGER CHAPTER -->

                            <TabItem Header="🔍 Scan Thiếu Chap" FontSize="12" FontWeight="SemiBold">

                                <Grid RowDefinitions="Auto, *">

                                    <Border Grid.Row="0" Background="#161F30" Padding="10,5" BorderBrush="#1E293B" BorderThickness="0,0,0,1">

                                        <WrapPanel Orientation="Horizontal">

                                            <Button Command="{Binding StartScanMissingCommand}" Content="▶ Quét ngay" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" Padding="8,3" CornerRadius="3" Margin="0,0,8,2" />

                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,2">

                                                <TextBlock Text="Số connection:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />

                                                <NumericUpDown Value="{Binding ParallelCheckCount}" Minimum="1" Maximum="16" Increment="1" FormatString="0" Width="110" Height="28" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTip.Tip="Số connection scan song song (Tùy chọn từ 1 đến 16)" />

                                            </StackPanel>

                                            <TextBlock Text="{Binding ScanResults.Count, StringFormat='{}Đã quét: {0}'}" Foreground="#10B981" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" />

                                        </WrapPanel>

                                    </Border>



                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ScanResults}" MinHeight="260" Padding="0,0,0,70">

                                        <ItemsControl.ItemsPanel>

                                            <ItemsPanelTemplate>

                                                <VirtualizingStackPanel />

                                            </ItemsPanelTemplate>

                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.Template>

                                            <ControlTemplate>

                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="{TemplateBinding Padding}">

                                                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />

                                                </ScrollViewer>

                                            </ControlTemplate>

                                        </ItemsControl.Template>

                                        <ItemsControl.ItemTemplate>

                                            <DataTemplate>

                                                <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="8,5">

                                                    <Grid ColumnDefinitions="25, 75, *, Auto" VerticalAlignment="Center">

                                                        <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='{}#{0}'}" Foreground="#64748B" FontSize="10" VerticalAlignment="Center" />

                                                        <Border Grid.Column="1" Background="#1E293B" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">

                                                            <TextBlock Text="{Binding Domain}" FontSize="8" Foreground="#38BDF8" FontWeight="SemiBold" />

                                                        </Border>

                                                        <StackPanel Grid.Column="2" Margin="4,0" VerticalAlignment="Center">

                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F1F5F9" FontSize="11" TextTrimming="CharacterEllipsis" />

                                                            <TextBlock Text="{Binding MissingIntegerChapters, StringFormat='{}Thiếu: {0}'}" Foreground="#FDE047" FontSize="10" TextTrimming="CharacterEllipsis" />

                                                        </StackPanel>

                                                        <Border Grid.Column="3" Background="#1E293B" CornerRadius="3" Padding="5,2" VerticalAlignment="Center">

                                                            <TextBlock Text="{Binding Status}" FontSize="9" Foreground="#10B981" FontWeight="SemiBold" />

                                                        </Border>

                                                    </Grid>

                                                </Border>

                                            </DataTemplate>

                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </Grid>

                            </TabItem>



                            <!-- SUBTAB 2.3: REALTIME LOGS -->

                            <TabItem Header="📜 Nhật Ký" FontSize="12" FontWeight="SemiBold">

                                <Grid RowDefinitions="Auto, *">

                                    <Border Grid.Row="0" Background="#161F30" Padding="10,4" BorderBrush="#1E293B" BorderThickness="0,0,0,1">

                                        <Grid ColumnDefinitions="*, Auto">

                                            <TextBlock Grid.Column="0" Text="Nhật ký các sự kiện tải xuống &amp; scan" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />

                                            <Button Grid.Column="1" Command="{Binding ClearLogsCommand}" Content="🧹 Xóa log" Background="#1E293B" Foreground="#94A3B8" FontSize="9" Padding="6,2" CornerRadius="3" />

                                        </Grid>

                                    </Border>



                                    <Border Grid.Row="1" Background="#0A0E17" Padding="6" MinHeight="260">

                                        <ItemsControl ItemsSource="{Binding Logs}" Padding="0,0,0,70">

                                            <ItemsControl.ItemsPanel>

                                                <ItemsPanelTemplate>

                                                    <WrapPanel Orientation="Horizontal" />

                                                </ItemsPanelTemplate>

                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.Template>

                                                <ControlTemplate>

                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="{TemplateBinding Padding}">

                                                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />

                                                    </ScrollViewer>

                                                </ControlTemplate>

                                            </ItemsControl.Template>

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <Grid ColumnDefinitions="50, 55, *" Margin="0,1">

                                                        <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="#64748B" FontSize="9" FontFamily="Consolas, Monospace" VerticalAlignment="Center" />

                                                        <Border Grid.Column="1" CornerRadius="2" Padding="2,1" HorizontalAlignment="Left" Background="#1E293B" VerticalAlignment="Center">

                                                            <TextBlock Text="{Binding Level}" FontSize="8" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" />

                                                        </Border>

                                                        <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="#E2E8F0" FontSize="9" FontFamily="Consolas, Monospace" TextWrapping="Wrap" VerticalAlignment="Center" Margin="3,0,0,0" />

                                                    </Grid>

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </Border>

                                </Grid>

                            </TabItem>



                            <!-- SUBTAB 2.4: REVERSE QUEUE ORDER -->

                            <TabItem Header="🔃 Đảo Ngược Danh Sách" FontSize="12" FontWeight="SemiBold">

                                <Grid RowDefinitions="Auto, *">

                                    <!-- Toolbar điều khiển đảo ngược -->

                                    <Border Grid.Row="0" Background="#161F30" Padding="10,6" BorderBrush="#1E293B" BorderThickness="0,0,0,1">

                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                            <Button Command="{Binding ReverseQueueCommand}" Background="#0284C7" BorderBrush="#38BDF8" BorderThickness="1" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="12,5" CornerRadius="4" Margin="0,0,10,2" ToolTip.Tip="Đảo ngược thứ tự toàn bộ danh sách hàng chờ tải (mục cuối lên đầu, mục đầu xuống cuối)">

                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                                    <TextBlock Text="🔃" FontSize="12" />

                                                    <TextBlock Text="ĐẢO NGƯỢC THỨ TỰ HÀNG CHỜ" FontWeight="Bold" FontSize="11" />

                                                </StackPanel>

                                            </Button>



                                            <Border Background="#1E293B" CornerRadius="3" Padding="8,3" Margin="0,0,6,2" VerticalAlignment="Center">

                                                <TextBlock Text="{Binding ComicBooks.Count, StringFormat='{}Tổng số truyện: {0}'}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" />

                                            </Border>



                                            <Border Background="#1E293B" CornerRadius="3" Padding="8,3" Margin="0,0,10,2" VerticalAlignment="Center">

                                                <TextBlock Text="{Binding DownloadingCount, StringFormat='{}Đang tải: {0}'}" Foreground="#10B981" FontWeight="SemiBold" FontSize="10" />

                                            </Border>



                                            <TextBlock Text="💡 Bấm nút 'ĐẢO NGƯỢC THỨ TỰ HÀNG CHỜ' để chuyển các truyện ở cuối danh sách lên đầu hoặc ngược lại." Foreground="#94A3B8" FontSize="10" FontStyle="Italic" VerticalAlignment="Center" Margin="0,0,0,2" />

                                        </WrapPanel>

                                    </Border>



                                    <!-- Danh sách các truyện trong hàng chờ theo thứ tự hiện tại -->

                                    <Border Grid.Row="1" Background="#0F172A" Padding="6,4">

                                        <ItemsControl ItemsSource="{Binding ComicBooks}" Padding="0,0,0,70">

                                            <ItemsControl.ItemsPanel>

                                                <ItemsPanelTemplate>

                                                    <VirtualizingStackPanel />

                                                </ItemsPanelTemplate>

                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.Template>

                                                <ControlTemplate>

                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="{TemplateBinding Padding}">

                                                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />

                                                    </ScrollViewer>

                                                </ControlTemplate>

                                            </ItemsControl.Template>

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="8,5" Margin="0,1">

                                                        <Grid ColumnDefinitions="45, 90, *, 120, Auto" VerticalAlignment="Center">

                                                            <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='{}#{0}'}" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />

                                                            <Border Grid.Column="1" Background="#1E293B" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">

                                                                <TextBlock Text="{Binding Domain}" FontSize="9" Foreground="#94A3B8" FontWeight="SemiBold" />

                                                            </Border>

                                                            <StackPanel Grid.Column="2" Margin="6,0" VerticalAlignment="Center">

                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F1F5F9" FontSize="11" TextTrimming="CharacterEllipsis" />

                                                                <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" FontSize="9" TextTrimming="CharacterEllipsis" />

                                                            </StackPanel>

                                                            <StackPanel Grid.Column="3" Margin="4,0" VerticalAlignment="Center">

                                                                <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="5" CornerRadius="2" Foreground="{Binding ProgressBarBrush}" Background="#1E293B" />

                                                                <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:F1}%'}" Foreground="#94A3B8" FontSize="8" HorizontalAlignment="Right" Margin="0,1,0,0" />

                                                            </StackPanel>

                                                            <Border Grid.Column="4" Background="#1E293B" CornerRadius="3" Padding="6,2" VerticalAlignment="Center" Margin="6,0,0,0">

                                                                <TextBlock Text="{Binding DisplayStatusVi}" FontSize="9" FontWeight="SemiBold" Foreground="#38BDF8" />

                                                            </Border>

                                                        </Grid>

                                                    </Border>

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </Border>

                                </Grid>

                            </TabItem>

                        </TabControl>

                    </Grid>

                </TabItem>



                <!-- ========================================================================= -->

                <!-- [TAB 1 LỚN] TAB SOURCE: MANGA SOURCE, SOURCE HENTAI, NOVEL SOURCE, SEARCH, PASSWORD -->

                <!-- ========================================================================= -->

                <TabItem Header="🌐 Nguồn" FontSize="12" FontWeight="Bold">

                    <Border Background="#0F172A" CornerRadius="6" Padding="6,3" Margin="0,2,0,0">

                        <TabControl Background="Transparent">

                            <!-- 1.1 MANGA SOURCE (SUBTABS DOMAIN) -->

                            <TabItem Header="📖 Manga Source" FontSize="11.5" FontWeight="SemiBold">

                                <Border Background="#131B2E" CornerRadius="6" Padding="10" Margin="0,4,0,0">

                                    <TabControl Background="Transparent">

                                        <!-- TruyenQQ -->

                                        <TabItem Header="truyenqq" FontSize="11">

                                            <StackPanel Spacing="10" Margin="0,8,0,0">

                                                <!-- Toolbar Navigation & Bookmarks -->

                                                <WrapPanel Orientation="Horizontal">

                                                    <Button Command="{Binding OpenDomainHomeCommand}" CommandParameter="truyenqq" Background="#1E293B" Foreground="#38BDF8" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">

                                                        <TextBlock Text="🌐 Mở Web" FontSize="10" FontWeight="SemiBold" />

                                                    </Button>

                                                    <Button Command="{Binding RestoreDefaultTagCommand}" CommandParameter="truyenqq" Background="#1E293B" Foreground="#94A3B8" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">

                                                        <TextBlock Text="🔄 Khôi phục Tag mặc định" FontSize="10" />

                                                    </Button>

                                                    <Button Command="{Binding OpenDomainHistoryCommand}" CommandParameter="truyenqq" Background="#1E293B" Foreground="#F59E0B" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">

                                                        <TextBlock Text="📜 Lịch sử duyệt" FontSize="10" />

                                                    </Button>

                                                    <Button Command="{Binding OpenDomainBookmarksCommand}" CommandParameter="truyenqq" Background="#1E293B" Foreground="#EC4899" Padding="8,4" CornerRadius="4" Margin="0,0,0,4">

                                                        <TextBlock Text="⭐ Lưu Bookmark" FontSize="10" />

                                                    </Button>

                                                </WrapPanel>



                                                <!-- Panel Analyze & Cào hàng loạt theo dải trang -->

                                                <Border Background="#161F30" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10">

                                                    <StackPanel Spacing="6">

                                                        <TextBlock Text="🔍 Phân Tích Tag / Thể Loại / Tác Giả / Nhóm Dịch (Lấy Truyện Hàng Loạt):" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" />

                                                        <TextBox Text="{Binding DomainTruyenqqTagUrl}" PlaceholderText="Dán 1 hoặc nhiều link thể loại / tag / tác giả / nhóm dịch TruyenQQ (mỗi dòng 1 link)..." AcceptsReturn="True" MinHeight="34" MaxHeight="80" TextWrapping="Wrap" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />

                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                            <Button Command="{Binding AnalyzeDomainTagCommand}" CommandParameter="truyenqq" IsEnabled="{Binding !IsDomainAnalyzing}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,5" CornerRadius="4" Margin="0,0,8,4" ToolTip.Tip="Phân tích kiểm tra số trang hoặc phân tích hàng loạt URL">

