<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ComicDownloaderGMTPC.ViewModels"
             xmlns:services="using:ComicDownloaderGMTPC.Services"
             xmlns:models="using:ComicDownloaderGMTPC.Models"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="850"
             x:Class="ComicDownloaderGMTPC.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="#0B0F19">

    <Grid>
        <!-- GIAO DIỆN CHÍNH -->
        <Panel>
            <!-- KHUNG CUỘN CHÍNH HỖ TRỢ ĐA NỀN TẢNG (DESKTOP & MOBILE/ANDROID) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid RowDefinitions="Auto, Auto, *, Auto" MinHeight="650">

            <!-- 1. HEADER / BRAND BAR -->
            <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="10,6">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,12,4">
                        <Border Background="#6366F1" CornerRadius="6" Width="24" Height="24">
                            <TextBlock Text="⚡" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="COMIC DOWNLOADER GMTPC" FontWeight="Bold" FontSize="14" Foreground="#F3F4F6" VerticalAlignment="Center" />
                        <Border Background="#312E81" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                            <TextBlock Text="XPLAT" FontSize="9" FontWeight="SemiBold" Foreground="#A5B4FC" />
                        </Border>
                    </StackPanel>

                    <!-- Folder Mode Selector & Action Buttons in WrapPanel for Mobile & Desktop -->
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                        <!-- Chọn kiểu thư mục -->
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,4">
                            <TextBlock Text="📁 Thư mục:" Foreground="#9CA3AF" VerticalAlignment="Center" FontSize="11" />
                            <ComboBox SelectedItem="{Binding ModeSelection}" Width="120" Height="28" FontSize="11">
                                <x:String>Single comic</x:String>
                                <x:String>Multi-comic</x:String>
                            </ComboBox>
                        </StackPanel>

                        <!-- Đổi ngôn ngữ -->
                        <Button Command="{Binding ToggleLanguageCommand}"
                                Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                CornerRadius="6" Padding="8,3" Height="28" Margin="0,0,6,4">
                            <TextBlock Text="{Binding CurrentLanguage, StringFormat='{}🌐 {0}'}" FontWeight="SemiBold" Foreground="#38BDF8" FontSize="11" />
                        </Button>

                        <!-- NÚT THOÁT HOÀN TOÀN (BÊN TRÁI NÚT CẬP NHẬT) -->
                        <Button Command="{Binding OpenExitConfirmCommand}"
                                Background="#991B1B" BorderBrush="#DC2626" BorderThickness="1"
                                CornerRadius="6" Padding="10,3" Height="28" Margin="0,0,6,4"
                                ToolTip.Tip="Đóng hoặc force stop chương trình hoàn toàn">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="⛔" FontSize="11" />
                                <TextBlock Text="THOÁT" FontWeight="Bold" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Nút Tự Động Cập Nhật Stable -->
                        <Button Command="{Binding AutoUpdateCommand}"
                                IsEnabled="{Binding !IsUpdating}"
                                Background="#059669" BorderBrush="#10B981" BorderThickness="1"
                                CornerRadius="6" Padding="10,3" Height="28" Margin="0,0,6,4"
                                ToolTip.Tip="Tự động tải ngầm và cài đặt phiên bản phát hành chính thức (Stable)">
                            <TextBlock Text="{Binding UpdateButtonLabel}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center" />
                        </Button>

                        <!-- Nút Tự Động Cập Nhật Beta -->
                        <Button Command="{Binding AutoUpdateBetaCommand}"
                                IsEnabled="{Binding !IsUpdating}"
                                Background="#D97706" BorderBrush="#F59E0B" BorderThickness="1"
                                CornerRadius="6" Padding="10,3" Height="28" Margin="0,0,6,4"
                                ToolTip.Tip="Tự động tải ngầm và cài đặt phiên bản thử nghiệm mới nhất (Beta)">
                            <TextBlock Text="{Binding UpdateBetaButtonLabel}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="11" VerticalAlignment="Center" />
                        </Button>
                    </WrapPanel>
                </WrapPanel>
            </Border>

            <!-- 2. QUICK DIRECT LINK BAR (TIỆN ÍCH DÁN LINK NHANH TOÀN CỤC: 2 ROW RESPONSIVE) -->
            <Border Grid.Row="1" Background="#131B2E" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="12,6">
                <Grid RowDefinitions="Auto, Auto">
                    <!-- Row 0: Đường dẫn dán link để riêng một row chiếm 100% bề ngang -->
                    <TextBox Grid.Row="0" Text="{Binding UrlInput}"
                             PlaceholderText="⚡ Dán link truyện tại đây (TruyenQQ, MangaDex, NetTruyen, Vi-Hentai, Đảo Mèo Đen, Dâm Cô Nương, SayHentai...)"
                             Height="34" CornerRadius="5" VerticalContentAlignment="Center"
                             Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC" FontSize="11"
                             Margin="0,0,0,6" />

                    <!-- Row 1: Lấy link, thêm, xóa, dán link và auto dán kế bên nút xóa -->
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding GetLinkCommand}"
                                Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold"
                                CornerRadius="5" Padding="12,4" Height="30" Margin="0,0,6,4">
                            <TextBlock Text="🔍 LẤY LINK" FontSize="11" />
                        </Button>
                        <Button Command="{Binding GetMoreCommand}"
                                Background="#059669" Foreground="#FFFFFF" FontWeight="SemiBold"
                                CornerRadius="5" Padding="10,4" Height="30" Margin="0,0,6,4">
                            <TextBlock Text="➕ THÊM" FontSize="11" />
                        </Button>
                        <Button Command="{Binding ClearLinksCommand}"
                                Background="#1E293B" Foreground="#94A3B8"
                                CornerRadius="5" Padding="8,4" Height="30" Margin="0,0,6,4">
                            <TextBlock Text="🗑️ XÓA" FontSize="11" />
                        </Button>
                        <Button Command="{Binding PasteLinkCommand}"
                                Background="#334155" Foreground="#38BDF8" FontWeight="SemiBold"
                                CornerRadius="5" Padding="10,4" Height="30" Margin="0,0,8,4"
                                ToolTip.Tip="Dán trực tiếp liên kết từ bộ nhớ tạm (Clipboard) và nạp vào danh sách">
                            <TextBlock Text="📋 DÁN LINK" FontSize="11" />
                        </Button>
                        <CheckBox IsChecked="{Binding IsAutoPasteClipboard}"
                                  VerticalAlignment="Center" Margin="0,0,0,4"
                                  ToolTip.Tip="Tự động theo dõi Clipboard: mỗi khi copy link truyện sẽ tự động nạp">
                            <TextBlock Text="⚡ Tự dán" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </CheckBox>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- 3. HAI TAB GỐC CHÍNH: TAB SOURCE & TAB DOWNLOAD (GIỐNG 100% WPF GỐC) -->
            <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedRootTabIndex}" Margin="0" Background="Transparent" MinHeight="480">

                <!-- ========================================================================= -->
                <!-- [TAB 1 LỚN] TAB SOURCE: MANGA SOURCE, SOURCE HENTAI, NOVEL SOURCE, SEARCH, PASSWORD -->
                <!-- ========================================================================= -->
                <TabItem Header="🌐 TAB SOURCE (NGUỒN TRUYỆN)" FontSize="13" FontWeight="Bold">
                    <Border Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,6,0,0">
                        <TabControl Background="Transparent">
                            <!-- 1.1 MANGA SOURCE (SUBTABS DOMAIN) -->
                            <TabItem Header="📖 Manga Source" FontSize="12" FontWeight="SemiBold">
                                <Border Background="#131B2E" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                                    <TabControl Background="Transparent">
                                        <!-- TruyenQQ -->
                                        <TabItem Header="truyenqq" FontSize="11">
                                            <StackPanel Spacing="10" Margin="0,8,0,0">
                                                <!-- Toolbar Navigation & Bookmarks -->
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Command="{Binding OpenDomainHomeCommand}" CommandParameter="truyenqq" Background="#1E293B" Foreground="#38BDF8" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">
                                                        <TextBlock Text="🏠 Trang chủ (Home)" FontSize="10" FontWeight="SemiBold" />
                                                    </Button>
                                                    <Button Command="{Binding RestoreDefaultTagCommand}" CommandParameter="truyenqq" Background="#1E293B" Foreground="#94A3B8" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">
                                                        <TextBlock Text="🔄 Khôi phục Tag mặc định" FontSize="10" />
                                                    </Button>
                                                    <Button Command="{Binding OpenDomainHistoryCommand}" CommandParameter="truyenqq" Background="#1E293B" Foreground="#F59E0B" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">
                                                        <TextBlock Text="📜 Lịch sử duyệt" FontSize="10" />
                                                    </Button>
                                                    <Button Command="{Binding OpenDomainBookmarksCommand}" CommandParameter="truyenqq" Background="#1E293B" Foreground="#EC4899" Padding="8,4" CornerRadius="4" Margin="0,0,0,4">
                                                        <TextBlock Text="⭐ Lưu Bookmark" FontSize="10" />
                                                    </Button>
                                                </WrapPanel>

                                                <!-- Panel Analyze & Cào hàng loạt theo dải trang -->
                                                <Border Background="#161F30" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="🔍 Phân Tích Tag / Thể Loại / Tác Giả / Nhóm Dịch (Lấy Truyện Hàng Loạt):" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" />
                                                        <TextBox Text="{Binding DomainTruyenqqTagUrl}" PlaceholderText="Dán 1 hoặc nhiều link thể loại / tag / tác giả / nhóm dịch TruyenQQ (mỗi dòng 1 link)..." AcceptsReturn="True" MinHeight="34" MaxHeight="80" TextWrapping="Wrap" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Command="{Binding AnalyzeDomainTagCommand}" CommandParameter="truyenqq" IsEnabled="{Binding !IsDomainAnalyzing}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,5" CornerRadius="4" Margin="0,0,8,4" ToolTip.Tip="Phân tích kiểm tra số trang hoặc phân tích hàng loạt URL">
                                                                <TextBlock Text="🔍 ANALYZE (KIỂM TRA TRANG)" FontSize="10" />
                                                            </Button>
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,6,4">
                                                                <TextBlock Text="Từ:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Value="{Binding DomainPageFrom}" Minimum="1" Maximum="9999" Increment="1" FormatString="0" Width="105" Height="28" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,6,4">
                                                                <TextBlock Text="Đến:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Value="{Binding DomainPageTo}" Minimum="1" Maximum="9999" Increment="1" FormatString="0" Width="105" Height="28" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding DomainTotalPages, StringFormat='{}(Tổng: {0} trang)'}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,4" />
                                                            <Button Command="{Binding ScrapeDomainBatchPagesCommand}" CommandParameter="truyenqq" IsEnabled="{Binding !IsDomainBatchScraping}" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,5" CornerRadius="4" Margin="0,0,6,4" ToolTip.Tip="Cào danh sách từ đầu (xóa danh sách queue cũ)">
                                                                <TextBlock Text="📥 CÀO MỚI (CRAWL)" FontSize="10" />
                                                            </Button>
                                                            <Button Command="{Binding CrawlMoreDomainBatchPagesCommand}" CommandParameter="truyenqq" IsEnabled="{Binding !IsDomainBatchScraping}" Background="#0D9488" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,5" CornerRadius="4" Margin="0,0,6,4" ToolTip.Tip="Cào thêm vào danh sách hiện tại (giữ nguyên queue cũ)">
                                                                <TextBlock Text="➕ CÀO THÊM (CRAWL MORE)" FontSize="10" />
                                                            </Button>
                                                            <Button Command="{Binding StopDomainBatchScrapeCommand}" IsEnabled="{Binding IsDomainBatchScraping}" Background="#DC2626" Foreground="#FFFFFF" Padding="8,5" CornerRadius="4" Margin="0,0,0,4">
                                                                <TextBlock Text="⏹ Dừng cào" FontSize="10" />
                                                            </Button>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding DomainAnalyzeStatusText}" Foreground="#10B981" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Nhập Link Truyện Trực Tiếp -->
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="⚡ Hoặc Dán Link Truyện Trực Tiếp Để Tải Từng Bộ:" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="11" />
                                                    <TextBox Text="{Binding UrlInput}" PlaceholderText="Dán link truyện TruyenQQ..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                    <WrapPanel Orientation="Horizontal">
                                                        <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4" Margin="0,0,6,0">
                                                            <TextBlock Text="🔍 LẤY LINK &amp; XEM TIẾN TRÌNH" FontSize="11" />
                                                        </Button>
                                                        <Button Command="{Binding GetMoreCommand}" Background="#059669" Foreground="#FFFFFF" Padding="10,5" CornerRadius="4">
                                                            <TextBlock Text="➕ Thêm vào Queue" FontSize="11" />
                                                        </Button>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </TabItem>

                                        <!-- nettruyenviet10.com -->
                                        <TabItem Header="nettruyenviet10.com" FontSize="11">
                                            <StackPanel Spacing="10" Margin="0,8,0,0">
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Command="{Binding OpenDomainHomeCommand}" CommandParameter="nettruyen" Background="#1E293B" Foreground="#38BDF8" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">
                                                        <TextBlock Text="🏠 Trang chủ (Home)" FontSize="10" FontWeight="SemiBold" />
                                                    </Button>
                                                    <Button Command="{Binding RestoreDefaultTagCommand}" CommandParameter="nettruyen" Background="#1E293B" Foreground="#94A3B8" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">
                                                        <TextBlock Text="🔄 Khôi phục Tag mặc định" FontSize="10" />
                                                    </Button>
                                                    <Button Command="{Binding OpenDomainHistoryCommand}" CommandParameter="nettruyen" Background="#1E293B" Foreground="#F59E0B" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">
                                                        <TextBlock Text="📜 Lịch sử duyệt" FontSize="10" />
                                                    </Button>
                                                    <Button Command="{Binding OpenDomainBookmarksCommand}" CommandParameter="nettruyen" Background="#1E293B" Foreground="#EC4899" Padding="8,4" CornerRadius="4" Margin="0,0,0,4">
                                                        <TextBlock Text="⭐ Lưu Bookmark" FontSize="10" />
                                                    </Button>
                                                </WrapPanel>

                                                <Border Background="#161F30" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="🔍 Phân Tích Tag / Thể Loại / Tác Giả / Nhóm Dịch NetTruyen (Lấy Truyện Hàng Loạt):" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" />
                                                        <TextBox Text="{Binding DomainNettruyenTagUrl}" PlaceholderText="Dán 1 hoặc nhiều link thể loại / tác giả / nhóm dịch NetTruyen (mỗi dòng 1 link)..." AcceptsReturn="True" MinHeight="34" MaxHeight="80" TextWrapping="Wrap" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Command="{Binding AnalyzeDomainTagCommand}" CommandParameter="nettruyen" IsEnabled="{Binding !IsDomainAnalyzing}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,5" CornerRadius="4" Margin="0,0,8,4" ToolTip.Tip="Phân tích kiểm tra số trang hoặc phân tích hàng loạt URL">
                                                                <TextBlock Text="🔍 ANALYZE (KIỂM TRA TRANG)" FontSize="10" />
                                                            </Button>
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,6,4">
                                                                <TextBlock Text="Từ:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Value="{Binding DomainPageFrom}" Minimum="1" Maximum="9999" Increment="1" FormatString="0" Width="105" Height="28" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,6,4">
                                                                <TextBlock Text="Đến:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Value="{Binding DomainPageTo}" Minimum="1" Maximum="9999" Increment="1" FormatString="0" Width="105" Height="28" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding DomainTotalPages, StringFormat='{}(Tổng: {0} trang)'}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,4" />
                                                            <Button Command="{Binding ScrapeDomainBatchPagesCommand}" CommandParameter="nettruyen" IsEnabled="{Binding !IsDomainBatchScraping}" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,5" CornerRadius="4" Margin="0,0,6,4" ToolTip.Tip="Cào danh sách từ đầu (xóa danh sách queue cũ)">
                                                                <TextBlock Text="📥 CÀO MỚI (CRAWL)" FontSize="10" />
                                                            </Button>
                                                            <Button Command="{Binding CrawlMoreDomainBatchPagesCommand}" CommandParameter="nettruyen" IsEnabled="{Binding !IsDomainBatchScraping}" Background="#0D9488" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,5" CornerRadius="4" Margin="0,0,6,4" ToolTip.Tip="Cào thêm vào danh sách hiện tại (giữ nguyên queue cũ)">
                                                                <TextBlock Text="➕ CÀO THÊM (CRAWL MORE)" FontSize="10" />
                                                            </Button>
                                                            <Button Command="{Binding StopDomainBatchScrapeCommand}" IsEnabled="{Binding IsDomainBatchScraping}" Background="#DC2626" Foreground="#FFFFFF" Padding="8,5" CornerRadius="4" Margin="0,0,0,4">
                                                                <TextBlock Text="⏹ Dừng cào" FontSize="10" />
                                                            </Button>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding DomainAnalyzeStatusText}" Foreground="#10B981" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>

                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="⚡ Hoặc Dán Link Truyện Trực Tiếp Để Tải Từng Bộ:" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="11" />
                                                    <TextBox Text="{Binding UrlInput}" PlaceholderText="Dán link truyện NetTruyen Viet 10..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                    <WrapPanel Orientation="Horizontal">
                                                        <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4" Margin="0,0,6,0">
                                                            <TextBlock Text="🔍 LẤY LINK &amp; XEM TIẾN TRÌNH" FontSize="11" />
                                                        </Button>
                                                        <Button Command="{Binding GetMoreCommand}" Background="#059669" Foreground="#FFFFFF" Padding="10,5" CornerRadius="4">
                                                            <TextBlock Text="➕ Thêm vào Queue" FontSize="11" />
                                                        </Button>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </TabItem>

                                        <!-- loppytoonn.com -->
                                        <TabItem Header="loppytoonn.com" FontSize="11">
                                            <StackPanel Spacing="10" Margin="0,8,0,0">
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Command="{Binding OpenDomainHomeCommand}" CommandParameter="loppy" Background="#1E293B" Foreground="#38BDF8" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">
                                                        <TextBlock Text="🏠 Trang chủ (Home)" FontSize="10" FontWeight="SemiBold" />
                                                    </Button>
                                                    <Button Command="{Binding RestoreDefaultTagCommand}" CommandParameter="loppy" Background="#1E293B" Foreground="#94A3B8" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">
                                                        <TextBlock Text="🔄 Khôi phục Tag mặc định" FontSize="10" />
                                                    </Button>
                                                    <Button Command="{Binding OpenDomainHistoryCommand}" CommandParameter="loppy" Background="#1E293B" Foreground="#F59E0B" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">
                                                        <TextBlock Text="📜 Lịch sử duyệt" FontSize="10" />
                                                    </Button>
                                                    <Button Command="{Binding OpenDomainBookmarksCommand}" CommandParameter="loppy" Background="#1E293B" Foreground="#EC4899" Padding="8,4" CornerRadius="4" Margin="0,0,0,4">
                                                        <TextBlock Text="⭐ Lưu Bookmark" FontSize="10" />
                                                    </Button>
                                                </WrapPanel>

                                                <Border Background="#161F30" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="🔍 Phân Tích Tag / Thể Loại / Tác Giả / Nhóm Dịch LoppyToon (Lấy Truyện Hàng Loạt):" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" />
                                                        <TextBox Text="{Binding DomainLoppyTagUrl}" PlaceholderText="Dán 1 hoặc nhiều link thể loại / tác giả / nhóm dịch LoppyToon (mỗi dòng 1 link)..." AcceptsReturn="True" MinHeight="34" MaxHeight="80" TextWrapping="Wrap" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Command="{Binding AnalyzeDomainTagCommand}" CommandParameter="loppy" IsEnabled="{Binding !IsDomainAnalyzing}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,5" CornerRadius="4" Margin="0,0,8,4" ToolTip.Tip="Phân tích kiểm tra số trang hoặc phân tích hàng loạt URL">
                                                                <TextBlock Text="🔍 ANALYZE (KIỂM TRA TRANG)" FontSize="10" />
                                                            </Button>
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,6,4">
                                                                <TextBlock Text="Từ:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Value="{Binding DomainPageFrom}" Minimum="1" Maximum="9999" Increment="1" FormatString="0" Width="105" Height="28" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,6,4">
                                                                <TextBlock Text="Đến:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Value="{Binding DomainPageTo}" Minimum="1" Maximum="9999" Increment="1" FormatString="0" Width="105" Height="28" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding DomainTotalPages, StringFormat='{}(Tổng: {0} trang)'}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,4" />
                                                            <Button Command="{Binding ScrapeDomainBatchPagesCommand}" CommandParameter="loppy" IsEnabled="{Binding !IsDomainBatchScraping}" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,5" CornerRadius="4" Margin="0,0,6,4" ToolTip.Tip="Cào danh sách từ đầu (xóa danh sách queue cũ)">
                                                                <TextBlock Text="📥 CÀO MỚI (CRAWL)" FontSize="10" />
                                                            </Button>
                                                            <Button Command="{Binding CrawlMoreDomainBatchPagesCommand}" CommandParameter="loppy" IsEnabled="{Binding !IsDomainBatchScraping}" Background="#0D9488" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,5" CornerRadius="4" Margin="0,0,6,4" ToolTip.Tip="Cào thêm vào danh sách hiện tại (giữ nguyên queue cũ)">
                                                                <TextBlock Text="➕ CÀO THÊM (CRAWL MORE)" FontSize="10" />
                                                            </Button>
                                                            <Button Command="{Binding StopDomainBatchScrapeCommand}" IsEnabled="{Binding IsDomainBatchScraping}" Background="#DC2626" Foreground="#FFFFFF" Padding="8,5" CornerRadius="4" Margin="0,0,0,4">
                                                                <TextBlock Text="⏹ Dừng cào" FontSize="10" />
                                                            </Button>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding DomainAnalyzeStatusText}" Foreground="#10B981" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>

                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="⚡ Hoặc Dán Link Truyện Trực Tiếp Để Tải Từng Bộ:" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="11" />
                                                    <TextBox Text="{Binding UrlInput}" PlaceholderText="Dán link truyện LoppyToon..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                    <WrapPanel Orientation="Horizontal">
                                                        <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4" Margin="0,0,6,0">
                                                            <TextBlock Text="🔍 LẤY LINK &amp; XEM TIẾN TRÌNH" FontSize="11" />
                                                        </Button>
                                                        <Button Command="{Binding GetMoreCommand}" Background="#059669" Foreground="#FFFFFF" Padding="10,5" CornerRadius="4">
                                                            <TextBlock Text="➕ Thêm vào Queue" FontSize="11" />
                                                        </Button>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </TabItem>

                                        <!-- thuviensach.vn -->
                                        <TabItem Header="thuviensach.vn" FontSize="11">
                                            <StackPanel Spacing="10" Margin="0,8,0,0">
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Command="{Binding OpenDomainHomeCommand}" CommandParameter="thuviensach" Background="#1E293B" Foreground="#38BDF8" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">
                                                        <TextBlock Text="🏠 Trang chủ (Home)" FontSize="10" FontWeight="SemiBold" />
                                                    </Button>
                                                    <Button Command="{Binding RestoreDefaultTagCommand}" CommandParameter="thuviensach" Background="#1E293B" Foreground="#94A3B8" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">
                                                        <TextBlock Text="🔄 Khôi phục Tag mặc định" FontSize="10" />
                                                    </Button>
                                                    <Button Command="{Binding OpenDomainHistoryCommand}" CommandParameter="thuviensach" Background="#1E293B" Foreground="#F59E0B" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">
                                                        <TextBlock Text="📜 Lịch sử duyệt" FontSize="10" />
                                                    </Button>
                                                    <Button Command="{Binding OpenDomainBookmarksCommand}" CommandParameter="thuviensach" Background="#1E293B" Foreground="#EC4899" Padding="8,4" CornerRadius="4" Margin="0,0,0,4">
                                                        <TextBlock Text="⭐ Lưu Bookmark" FontSize="10" />
                                                    </Button>
                                                </WrapPanel>

                                                <!-- Cảnh Báo Server Thu Viện Sách Đang Lỗi -->
                                                <Border Background="#331818" BorderBrush="#EF4444" BorderThickness="1.5" CornerRadius="6" Padding="12,8" Margin="0,0,0,2">
                                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                        <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center" />
                                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="Server đang lỗi, hiện tại chưa tải được" Foreground="#F87171" FontWeight="Bold" FontSize="11.5" />
                                                            <TextBlock Text="Máy chủ thuviensach.vn hiện phản hồi trống hoặc lỗi kết nối. Vui lòng quay lại sau." Foreground="#CBD5E1" FontSize="10" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <Border Background="#161F30" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="🔍 Phân Tích Thể Loại Thư Viện Sách / Dilib:" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" />
                                                        <TextBox Text="{Binding DomainThuviensachTagUrl}" PlaceholderText="Dán 1 hoặc nhiều link thể loại Thư Viện Sách (mỗi dòng 1 link)..." AcceptsReturn="True" MinHeight="34" MaxHeight="80" TextWrapping="Wrap" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Command="{Binding AnalyzeDomainTagCommand}" CommandParameter="thuviensach" IsEnabled="{Binding !IsDomainAnalyzing}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,5" CornerRadius="4" Margin="0,0,8,4" ToolTip.Tip="Phân tích kiểm tra số trang hoặc phân tích hàng loạt URL">
                                                                <TextBlock Text="🔍 ANALYZE (KIỂM TRA TRANG)" FontSize="10" />
                                                            </Button>
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,6,4">
                                                                <TextBlock Text="Từ:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Value="{Binding DomainPageFrom}" Minimum="1" Maximum="9999" Increment="1" FormatString="0" Width="105" Height="28" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,6,4">
                                                                <TextBlock Text="Đến:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Value="{Binding DomainPageTo}" Minimum="1" Maximum="9999" Increment="1" FormatString="0" Width="105" Height="28" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding DomainTotalPages, StringFormat='{}(Tổng: {0} trang)'}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,4" />
                                                            <Button Command="{Binding ScrapeDomainBatchPagesCommand}" CommandParameter="thuviensach" IsEnabled="{Binding !IsDomainBatchScraping}" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,5" CornerRadius="4" Margin="0,0,6,4" ToolTip.Tip="Cào danh sách từ đầu (xóa danh sách queue cũ)">
                                                                <TextBlock Text="📥 CÀO MỚI (CRAWL)" FontSize="10" />
                                                            </Button>
                                                            <Button Command="{Binding CrawlMoreDomainBatchPagesCommand}" CommandParameter="thuviensach" IsEnabled="{Binding !IsDomainBatchScraping}" Background="#0D9488" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,5" CornerRadius="4" Margin="0,0,6,4" ToolTip.Tip="Cào thêm vào danh sách hiện tại (giữ nguyên queue cũ)">
                                                                <TextBlock Text="➕ CÀO THÊM (CRAWL MORE)" FontSize="10" />
                                                            </Button>
                                                            <Button Command="{Binding StopDomainBatchScrapeCommand}" IsEnabled="{Binding IsDomainBatchScraping}" Background="#DC2626" Foreground="#FFFFFF" Padding="8,5" CornerRadius="4" Margin="0,0,0,4">
                                                                <TextBlock Text="⏹ Dừng cào" FontSize="10" />
                                                            </Button>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding DomainAnalyzeStatusText}" Foreground="#10B981" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>

