                                                            <TextBlock Text="➕ Thêm vào Queue" FontSize="11" />
                                                        </Button>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </TabItem>

                                        <!-- daomeoden -->
                                        <TabItem Header="daomeoden" FontSize="11">
                                            <StackPanel Spacing="10" Margin="0,8,0,0">
                                                <WrapPanel Orientation="Horizontal">
