                            <!-- 1.2 MANGA SOURCE ENGLISH (SUBTABS DOMAIN) -->
                            <TabItem Header="🌐 Source Manga English" FontSize="11.5" FontWeight="SemiBold">
                                <Border Background="#131B2E" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                                    <TabControl Background="Transparent">
                                        <!-- comix.to -->
                                        <TabItem Header="comix.to" FontSize="11">
                                            <StackPanel Spacing="10" Margin="0,8,0,0">
                                                <!-- Toolbar Navigation & Bookmarks -->
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Command="{Binding OpenDomainHomeCommand}" CommandParameter="comix.to" Background="#1E293B" Foreground="#38BDF8" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">
                                                        <TextBlock Text="🌐 Mở Web" FontSize="10" FontWeight="SemiBold" />
                                                    </Button>
                                                    <Button Command="{Binding RestoreDefaultTagCommand}" CommandParameter="comix.to" Background="#1E293B" Foreground="#94A3B8" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">
                                                        <TextBlock Text="🔄 Khôi phục Tag mặc định" FontSize="10" />
                                                    </Button>
                                                    <Button Command="{Binding OpenDomainHistoryCommand}" CommandParameter="comix.to" Background="#1E293B" Foreground="#F59E0B" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">
                                                        <TextBlock Text="📜 Lịch sử duyệt" FontSize="10" />
                                                    </Button>
                                                    <Button Command="{Binding OpenDomainBookmarksCommand}" CommandParameter="comix.to" Background="#1E293B" Foreground="#EC4899" Padding="8,4" CornerRadius="4" Margin="0,0,0,4">
                                                        <TextBlock Text="⭐ Lưu Bookmark" FontSize="10" />
                                                    </Button>
                                                </WrapPanel>

                                                <!-- Panel Analyze & Cào hàng loạt theo dải trang -->
                                                <Border Background="#161F30" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="🔍 Phân Tích Tag / Browse / Thể Loại (Lấy Truyện Hàng Loạt):" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" />
                                                        <TextBox Text="{Binding DomainComixtoTagUrl}" PlaceholderText="Dán 1 hoặc nhiều link Browse / Thể loại Comix.to (ví dụ: https://comix.to/browse?genres_in=98897)..." AcceptsReturn="True" MinHeight="34" MaxHeight="80" TextWrapping="Wrap" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Command="{Binding AnalyzeDomainTagCommand}" CommandParameter="comix.to" IsEnabled="{Binding !IsDomainAnalyzing}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,5" CornerRadius="4" Margin="0,0,8,4" ToolTip.Tip="Phân tích kiểm tra số trang hoặc phân tích hàng loạt URL">
                                                                <TextBlock Text="🔍 PHÂN TÍCH" FontSize="10" />
                                                            </Button>
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,6,4">
                                                                <TextBlock Text="Từ:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Value="{Binding DomainPageFrom}" Minimum="1" Maximum="9999" Increment="1" FormatString="0" Width="105" Height="28" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,6,4">
                                                                <TextBlock Text="Đến:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Value="{Binding DomainPageTo}" Minimum="1" Maximum="9999" Increment="1" FormatString="0" Width="105" Height="28" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding DomainTotalPages, StringFormat='{}(Tổng: {0} trang)'}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,4" />
                                                            <Button Command="{Binding ScrapeDomainBatchPagesCommand}" CommandParameter="comix.to" IsEnabled="{Binding !IsDomainBatchScraping}" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,5" CornerRadius="4" Margin="0,0,6,4" ToolTip.Tip="Cào danh sách từ đầu (xóa danh sách queue cũ)">
                                                                <TextBlock Text="📥 CÀO MỚI" FontSize="10" />
                                                            </Button>
                                                            <Button Command="{Binding CrawlMoreDomainBatchPagesCommand}" CommandParameter="comix.to" IsEnabled="{Binding !IsDomainBatchScraping}" Background="#0D9488" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,5" CornerRadius="4" Margin="0,0,6,4" ToolTip.Tip="Cào thêm vào danh sách hiện tại (giữ nguyên queue cũ)">
                                                                <TextBlock Text="➕ CÀO THÊM" FontSize="10" />
                                                            </Button>
                                                            <Button Command="{Binding StopDomainBatchScrapeCommand}" IsEnabled="{Binding IsDomainBatchScraping}" Background="#DC2626" Foreground="#FFFFFF" Padding="8,5" CornerRadius="4" Margin="0,0,0,4">
                                                                <TextBlock Text="⏹ Dừng cào" FontSize="10" />
                                                            </Button>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </TabItem>
                                    </TabControl>
                                </Border>
                            </TabItem>

