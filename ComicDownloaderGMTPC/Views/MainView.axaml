                                                        <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4" Margin="0,0,6,0">
                                                            <TextBlock Text="🔍 LẤY LINK &amp; XEM TIẾN TRÌNH" FontSize="11" />
                                                        </Button>
                                                        <Button Command="{Binding GetMoreCommand}" Background="#059669" Foreground="#FFFFFF" Padding="10,5" CornerRadius="4">
                                                            <TextBlock Text="➕ Thêm vào Queue" FontSize="11" />
                                                        </Button>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </TabItem>

                                        <!-- sayhentai -->
                                        <TabItem Header="sayhentai" FontSize="11">
                                            <StackPanel Spacing="10" Margin="0,8,0,0">
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Command="{Binding OpenDomainHomeCommand}" CommandParameter="sayhentai" Background="#1E293B" Foreground="#F43F5E" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">
                                                        <TextBlock Text="🏠 Trang chủ (Home)" FontSize="10" FontWeight="SemiBold" />
                                                    </Button>
                                                    <Button Command="{Binding RestoreDefaultTagCommand}" CommandParameter="sayhentai" Background="#1E293B" Foreground="#94A3B8" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">
                                                        <TextBlock Text="🔄 Khôi phục Tag mặc định" FontSize="10" />
                                                    </Button>
                                                    <Button Command="{Binding OpenDomainHistoryCommand}" CommandParameter="sayhentai" Background="#1E293B" Foreground="#F59E0B" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">
                                                        <TextBlock Text="📜 Lịch sử duyệt" FontSize="10" />
                                                    </Button>
                                                    <Button Command="{Binding OpenDomainBookmarksCommand}" CommandParameter="sayhentai" Background="#1E293B" Foreground="#EC4899" Padding="8,4" CornerRadius="4" Margin="0,0,0,4">
                                                        <TextBlock Text="⭐ Lưu Bookmark" FontSize="10" />
                                                    </Button>
                                                </WrapPanel>

                                                <Border Background="#161F30" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="🔍 Phân Tích Thể Loại SayHentai:" Foreground="#F43F5E" FontWeight="Bold" FontSize="11" />
                                                        <TextBox Text="{Binding DomainSayhentaiTagUrl}" PlaceholderText="Dán link thể loại SayHentai..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Command="{Binding AnalyzeDomainTagCommand}" CommandParameter="sayhentai" IsEnabled="{Binding !IsDomainAnalyzing}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,5" CornerRadius="4" Margin="0,0,8,4">
                                                                <TextBlock Text="🔍 ANALYZE (KIỂM TRA TRANG)" FontSize="10" />
                                                            </Button>
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,4">
                                                                <TextBlock Text="Từ:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Value="{Binding DomainPageFrom}" Minimum="1" Maximum="9999" Increment="1" FormatString="0" Width="140" Height="28" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                                <TextBlock Text="Đến:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Value="{Binding DomainPageTo}" Minimum="1" Maximum="9999" Increment="1" FormatString="0" Width="140" Height="28" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                                <TextBlock Text="{Binding DomainTotalPages, StringFormat='{}(Tổng: {0} trang)'}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                            </StackPanel>
                                                            <Button Command="{Binding ScrapeDomainBatchPagesCommand}" CommandParameter="sayhentai" IsEnabled="{Binding !IsDomainBatchScraping}" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,5" CornerRadius="4" Margin="0,0,6,4">
                                                                <TextBlock Text="📥 CÀO DANH SÁCH THEO TRANG" FontSize="10" />
                                                            </Button>
                                                            <Button Command="{Binding StopDomainBatchScrapeCommand}" IsEnabled="{Binding IsDomainBatchScraping}" Background="#DC2626" Foreground="#FFFFFF" Padding="8,5" CornerRadius="4" Margin="0,0,0,4">
                                                                <TextBlock Text="⏹ Dừng cào" FontSize="10" />
                                                            </Button>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding DomainAnalyzeStatusText}" Foreground="#10B981" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>

                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="⚡ Hoặc Dán Link Truyện Trực Tiếp Để Tải Từng Bộ:" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="11" />
                                                    <TextBox Text="{Binding UrlInput}" PlaceholderText="Dán link SayHentai..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                    <WrapPanel Orientation="Horizontal">
                                                        <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4" Margin="0,0,6,0">
                                                            <TextBlock Text="🔍 LẤY LINK &amp; XEM TIẾN TRÌNH" FontSize="11" />
                                                        </Button>
                                                        <Button Command="{Binding GetMoreCommand}" Background="#059669" Foreground="#FFFFFF" Padding="10,5" CornerRadius="4">
                                                            <TextBlock Text="➕ Thêm vào Queue" FontSize="11" />
                                                        </Button>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </TabItem>

                                        <!-- hentai2read -->
                                        <TabItem Header="hentai2read" FontSize="11">
                                            <StackPanel Spacing="10" Margin="0,8,0,0">
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Command="{Binding OpenDomainHomeCommand}" CommandParameter="hentai2read" Background="#1E293B" Foreground="#F43F5E" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">
                                                        <TextBlock Text="🏠 Trang chủ (Home)" FontSize="10" FontWeight="SemiBold" />
                                                    </Button>
                                                    <Button Command="{Binding RestoreDefaultTagCommand}" CommandParameter="hentai2read" Background="#1E293B" Foreground="#94A3B8" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">
                                                        <TextBlock Text="🔄 Khôi phục Tag mặc định" FontSize="10" />
                                                    </Button>
                                                    <Button Command="{Binding OpenDomainHistoryCommand}" CommandParameter="hentai2read" Background="#1E293B" Foreground="#F59E0B" Padding="8,4" CornerRadius="4" Margin="0,0,6,4">
                                                        <TextBlock Text="📜 Lịch sử duyệt" FontSize="10" />
                                                    </Button>
                                                    <Button Command="{Binding OpenDomainBookmarksCommand}" CommandParameter="hentai2read" Background="#1E293B" Foreground="#EC4899" Padding="8,4" CornerRadius="4" Margin="0,0,0,4">
                                                        <TextBlock Text="⭐ Lưu Bookmark" FontSize="10" />
                                                    </Button>
                                                </WrapPanel>

                                                <Border Background="#161F30" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="🔍 Phân Tích Thể Loại Hentai2Read:" Foreground="#F43F5E" FontWeight="Bold" FontSize="11" />
                                                        <TextBox Text="{Binding DomainHentai2readTagUrl}" PlaceholderText="Dán link thể loại Hentai2Read..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Command="{Binding AnalyzeDomainTagCommand}" CommandParameter="hentai2read" IsEnabled="{Binding !IsDomainAnalyzing}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,5" CornerRadius="4" Margin="0,0,8,4">
                                                                <TextBlock Text="🔍 ANALYZE (KIỂM TRA TRANG)" FontSize="10" />
                                                            </Button>
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,4">
                                                                <TextBlock Text="Từ:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Value="{Binding DomainPageFrom}" Minimum="1" Maximum="9999" Increment="1" FormatString="0" Width="140" Height="28" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                                <TextBlock Text="Đến:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Value="{Binding DomainPageTo}" Minimum="1" Maximum="9999" Increment="1" FormatString="0" Width="140" Height="28" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                                <TextBlock Text="{Binding DomainTotalPages, StringFormat='{}(Tổng: {0} trang)'}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                            </StackPanel>
                                                            <Button Command="{Binding ScrapeDomainBatchPagesCommand}" CommandParameter="hentai2read" IsEnabled="{Binding !IsDomainBatchScraping}" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" Padding="10,5" CornerRadius="4" Margin="0,0,6,4">
                                                                <TextBlock Text="📥 CÀO DANH SÁCH THEO TRANG" FontSize="10" />
                                                            </Button>
                                                            <Button Command="{Binding StopDomainBatchScrapeCommand}" IsEnabled="{Binding IsDomainBatchScraping}" Background="#DC2626" Foreground="#FFFFFF" Padding="8,5" CornerRadius="4" Margin="0,0,0,4">
                                                                <TextBlock Text="⏹ Dừng cào" FontSize="10" />
                                                            </Button>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding DomainAnalyzeStatusText}" Foreground="#10B981" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>

                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="⚡ Hoặc Dán Link Truyện Trực Tiếp Để Tải Từng Bộ:" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="11" />
                                                    <TextBox Text="{Binding UrlInput}" PlaceholderText="Dán link Hentai2Read..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                                    <WrapPanel Orientation="Horizontal">
                                                        <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4" Margin="0,0,6,0">
                                                            <TextBlock Text="🔍 LẤY LINK &amp; XEM TIẾN TRÌNH" FontSize="11" />
                                                        </Button>
                                                        <Button Command="{Binding GetMoreCommand}" Background="#059669" Foreground="#FFFFFF" Padding="10,5" CornerRadius="4">
                                                            <TextBlock Text="➕ Thêm vào Queue" FontSize="11" />
                                                        </Button>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </TabItem>
                                    </TabControl>
                                </Border>
                            </TabItem>

                            <!-- 1.3 NOVEL SOURCE -->
                            <TabItem Header="📚 Novel Source" FontSize="12" FontWeight="SemiBold">
                                <Border Background="#131B2E" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Nguồn Tiểu Thuyết (Hako / Docln)" FontWeight="Bold" Foreground="#10B981" FontSize="12" />
                                        <TextBlock Text="Ví dụ: https://docln.net/truyen/..." Foreground="#94A3B8" FontSize="11" />
                                        <TextBox Text="{Binding UrlInput}" PlaceholderText="Dán link truyện chữ Hako / Docln..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                        <Button Command="{Binding GetLinkCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Padding="12,5" CornerRadius="4">
                                            <TextBlock Text="🔍 LẤY LINK NOVEL" FontSize="11" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </TabItem>

                            <!-- 1.4 SEARCH (TÌM KIẾM ĐA NGUỒN) -->
                            <TabItem Header="🔍 Tìm Kiếm (Search)" FontSize="12" FontWeight="SemiBold">
                                <Grid RowDefinitions="Auto, *" Margin="0,4,0,0">
                                    <Border Grid.Row="0" Background="#161F30" Padding="10" CornerRadius="6" BorderBrush="#1E293B" BorderThickness="1">
                                        <Grid RowDefinitions="Auto, Auto, Auto">
                                            <TextBox Grid.Row="0" Text="{Binding SourceSearchKeyword}" PlaceholderText="Nhập tên truyện cần tìm..." Height="34" CornerRadius="4" Background="#0F172A" Foreground="#F8FAFC" FontSize="11" Margin="0,0,0,6" />
                                            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                                                <Button Command="{Binding SearchSourceCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="4" Padding="10,5" Height="30" Margin="0,0,6,0">
                                                    <TextBlock Text="🔍 TÌM KIẾM" FontSize="11" />
                                                </Button>
                                                <Button Command="{Binding ImportSelectedSearchToQueueCommand}" Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="4" Padding="10,5" Height="30" Margin="0,0,6,0">
                                                    <TextBlock Text="📥 NẠP VÀO QUEUE" FontSize="11" />
                                                </Button>
                                                <Button Command="{Binding OpenExternalSearchCommand}" CommandParameter="False" Background="#1E293B" Foreground="#38BDF8" CornerRadius="4" Padding="8,5" Height="30">
                                                    <TextBlock Text="🌐 Google site: search" FontSize="11" />
                                                </Button>
                                            </WrapPanel>
                                            <WrapPanel Grid.Row="2" Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding SearchTruyenqq}" Content="TruyenQQ" FontSize="10" Foreground="#D1D5DB" Margin="0,0,10,0" />
                                                <CheckBox IsChecked="{Binding SearchMangaDex}" Content="MangaDex" FontSize="10" Foreground="#D1D5DB" Margin="0,0,10,0" />
                                                <CheckBox IsChecked="{Binding SearchNettruyen}" Content="NetTruyen" FontSize="10" Foreground="#D1D5DB" Margin="0,0,10,0" />
                                                <CheckBox IsChecked="{Binding SearchHako}" Content="Hako" FontSize="10" Foreground="#D1D5DB" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Kết quả tìm kiếm -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MinHeight="260" Margin="0,6,0,0">
                                        <ItemsControl ItemsSource="{Binding SearchResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="8,5">
                                                        <Grid ColumnDefinitions="Auto, 75, *, Auto" VerticalAlignment="Center">
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <Border Grid.Column="1" Background="#1E293B" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Domain}" FontSize="9" Foreground="#38BDF8" FontWeight="SemiBold" />
                                                            </Border>
                                                            <StackPanel Grid.Column="2" Margin="4,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F1F5F9" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding LatestChapter}" Foreground="#94A3B8" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Border Grid.Column="3" Background="#064E3B" CornerRadius="3" Padding="5,2" VerticalAlignment="Center">
                                                                <TextBlock Text="Sẵn sàng" FontSize="9" Foreground="#34D399" FontWeight="SemiBold" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>

                            <!-- 1.5 PASSWORD / MẬT KHẨU -->
                            <TabItem Header="🔑 Password" FontSize="12" FontWeight="SemiBold">
                                <Border Background="#131B2E" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                                    <StackPanel Spacing="10" MaxWidth="500" HorizontalAlignment="Left">
                                        <TextBlock Text="Quản lý Mật khẩu &amp; Tài khoản VIP" FontWeight="Bold" Foreground="#F59E0B" FontSize="13" />
                                        <TextBlock Text="Lưu trữ tài khoản hoặc cookie dành cho các trang yêu cầu đăng nhập." Foreground="#94A3B8" FontSize="11" />
                                        <TextBox PlaceholderText="Tên đăng nhập / Email..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                        <TextBox PasswordChar="●" PlaceholderText="Mật khẩu..." Height="34" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" FontSize="11" />
                                        <Button Content="💾 Lưu cấu hình mật khẩu" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="12,5" CornerRadius="4" />
                                    </StackPanel>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </Border>
                </TabItem>

                <!-- ========================================================================= -->
                <!-- [TAB 2 LỚN] TAB DOWNLOAD: DOWNLOAD MANGA, SCAN, LOGS -->
                <!-- ========================================================================= -->
                <TabItem Header="📥 TAB DOWNLOAD (TẢI VỀ &amp; QUẢN LÝ)" FontSize="13" FontWeight="Bold">
                    <Grid RowDefinitions="Auto, *">
                        <!-- Toolbar điều khiển tải chung -->
                        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="12,8">
                            <Grid RowDefinitions="Auto, Auto, Auto">
                                <!-- Main Download Action Buttons -->
                                <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Command="{Binding DownloadAllCommand}" Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="5" Padding="12,5" Height="30" Margin="0,0,6,3">
                                        <TextBlock Text="⬇️ TẢI TẤT CẢ" FontSize="11" />
                                    </Button>

                                    <!-- Nút TẠM DỪNG (Hiển thị khi chưa Pause) -->
                                    <Button Command="{Binding PauseDownloadCommand}" IsVisible="{Binding !IsPaused}"
                                            Background="#D97706" BorderBrush="#F59E0B" BorderThickness="1"
                                            Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="5" Padding="10,5" Height="30" Margin="0,0,6,3"
                                            ToolTip.Tip="Tạm dừng tiến trình tải hiện tại">
                                        <TextBlock Text="⏸️ TẠM DỪNG" FontSize="11" />
                                    </Button>

                                    <!-- Nút TIẾP TỤC (Hiển thị khi đang Pause) -->
                                    <Button Command="{Binding ResumeDownloadCommand}" IsVisible="{Binding IsPaused}"
                                            Background="#059669" BorderBrush="#10B981" BorderThickness="1"
                                            Foreground="#FFFFFF" FontWeight="Bold" CornerRadius="5" Padding="10,5" Height="30" Margin="0,0,6,3"
                                            ToolTip.Tip="Tiếp tục tải các truyện đang tạm dừng">
                                        <TextBlock Text="▶️ TIẾP TỤC" FontSize="11" />
                                    </Button>

                                    <Button Command="{Binding StopCommand}" Background="#DC2626" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="5" Padding="10,5" Height="30" Margin="0,0,6,3">
                                        <TextBlock Text="⏹️ DỪNG" FontSize="11" />
                                    </Button>
                                    <Button Command="{Binding RetryCommand}" Background="#7C3AED" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="5" Padding="10,5" Height="30" Margin="0,0,6,3">
                                        <TextBlock Text="🔄 THỬ LẠI" FontSize="11" />
                                    </Button>
                                    <Button Command="{Binding ClearQueueCommand}" Background="#374151" Foreground="#E5E7EB" CornerRadius="5" Padding="10,5" Height="30" Margin="0,0,6,3">
                                        <TextBlock Text="🧹 XÓA QUEUE" FontSize="11" />
                                    </Button>
                                    <Button Command="{Binding ChangeDownloadFolderCommand}" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" CornerRadius="5" Padding="10,5" Height="30" Margin="0,0,6,3">
                                        <TextBlock Text="📁 ĐỔI THƯ MỤC" FontSize="11" />
                                    </Button>
                                    <Button Command="{Binding OpenDownloadRootCommand}" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Padding="10,5" Height="30" Margin="0,0,0,3">
                                        <TextBlock Text="📂 MỞ THƯ MỤC" FontSize="11" />
                                    </Button>
                                </WrapPanel>

                                <!-- Thư mục lưu hiện tại (Bố cục 2 tầng xem Full Path trên Android) -->
                                <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,0,0,6">
                                    <StackPanel Spacing="3">
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📁 Thư mục lưu truyện hiện tại:" FontSize="10" Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Button Command="{Binding CopyDownloadPathCommand}" Background="#1E293B" Foreground="#38BDF8" Padding="6,2" FontSize="9" CornerRadius="3" Margin="0,0,6,0">
                                                <TextBlock Text="📋 Chép đường dẫn" />
                                            </Button>
                                        </WrapPanel>
                                        <TextBox Text="{Binding DownloadPathText}" IsReadOnly="True" Background="#0B0F19" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" Height="28" CornerRadius="3" BorderBrush="#1E293B" BorderThickness="1" VerticalContentAlignment="Center" Padding="6,2" />
                                    </StackPanel>
                                </Border>

                                <!-- Toggles Checkboxes, Concurrency & Threads -->
                                <WrapPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Số truyện tải cùng lúc -->
                                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="⚡ Số truyện cùng lúc:" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <NumericUpDown Value="{Binding ConcurrentComicDownloads}" Minimum="1" Maximum="8" Increment="1" FormatString="0" Width="120" Height="28" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Số luồng tải ảnh -->
                                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="🧵 Số luồng tải ảnh:" Foreground="#10B981" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <NumericUpDown Value="{Binding ImageDownloadThreads}" Minimum="1" Maximum="16" Increment="1" FormatString="0" Width="120" Height="28" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <CheckBox IsChecked="{Binding IsAutoDownload}" Content="⚡ Tự động tải" FontSize="11" Foreground="#D1D5DB" Margin="0,0,10,4" />
                                    <CheckBox IsChecked="{Binding IsAutoRetry}" Content="🔁 Tự thử lại" FontSize="11" Foreground="#D1D5DB" Margin="0,0,10,4" />
                                    <CheckBox IsChecked="{Binding IsCompactRow}" Content="📏 Nén dòng" FontSize="11" Foreground="#D1D5DB" Margin="0,0,10,4" />
                                    <CheckBox IsChecked="{Binding IsAutoSplitLongImages}" Content="✂️ Tự cắt ảnh dài" FontSize="11" Foreground="#F43F5E" FontWeight="SemiBold" Margin="0,0,6,4" ToolTip.Tip="Tự động cắt ảnh có chiều cao lớn hơn ngưỡng chỉ định thành các mảnh nhỏ trong khi tải" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding IsAutoSplitLongImages}" Margin="0,0,0,4">
                                        <TextBlock Text="Cao:" FontSize="11" Foreground="#F43F5E" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <NumericUpDown Value="{Binding AutoSplitHeight}" Minimum="500" Maximum="50000" Increment="500" FormatString="0" Width="140" Height="28" FontSize="11" Foreground="#38BDF8" Background="#0F172A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                        <TextBlock Text="px" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    </StackPanel>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Subtabs bên trong Download Panel -->
                        <TabControl Grid.Row="1" Background="Transparent" Margin="0">

                            <!-- SUBTAB 2.1: DOWNLOAD MANGA QUEUE LIST -->
                            <TabItem Header="📋 Chờ Tải (Queue)" FontSize="12" FontWeight="SemiBold">
                                <Grid RowDefinitions="Auto, *">
                                    <!-- Toolbar chọn hàng -->
                                    <Border Grid.Row="0" Background="#161F30" Padding="10,5" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Command="{Binding SelectAllCommand}" Content="✓ Tất cả" Background="#1E293B" Foreground="#94A3B8" FontSize="10" Padding="5,2" CornerRadius="3" Margin="0,0,4,2" />
                                            <Button Command="{Binding UnselectAllCommand}" Content="✗ Bỏ chọn" Background="#1E293B" Foreground="#94A3B8" FontSize="10" Padding="5,2" CornerRadius="3" Margin="0,0,4,2" />
                                            <Button Command="{Binding InvertSelectionCommand}" Content="⇄ Đảo chọn" Background="#1E293B" Foreground="#94A3B8" FontSize="10" Padding="5,2" CornerRadius="3" Margin="0,0,4,2" />
                                            <Button Command="{Binding CheckSelectedRowsCommand}" Content="☑ Tích" Background="#1E293B" Foreground="#38BDF8" FontSize="10" Padding="5,2" CornerRadius="3" Margin="0,0,4,2" />
                                            <Button Command="{Binding CheckErrorsCommand}" Content="⚠️ Lỗi" Background="#1E293B" Foreground="#F43F5E" FontSize="10" Padding="5,2" CornerRadius="3" Margin="0,0,4,2" />
                                            <Button Command="{Binding CheckDuplicatesCommand}" Content="🔍 Trùng" Background="#1E293B" Foreground="#F59E0B" FontSize="10" Padding="5,2" CornerRadius="3" Margin="0,0,4,2" />
                                            <Button Command="{Binding DeleteSelectedCommand}" Content="🗑️ Xóa" Background="#1E293B" Foreground="#EF4444" FontSize="10" Padding="5,2" CornerRadius="3" Margin="0,0,0,2" />
                                        </WrapPanel>
                                    </Border>

                                    <!-- Danh sách các hàng truyện -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MinHeight="260">
                                        <ItemsControl ItemsSource="{Binding ComicBooks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Margin="0,0,0,2" CornerRadius="4" ClipToBounds="True">
                                                        <Grid RowDefinitions="Auto, Auto">
                                                            <!-- Hàng 0: Toàn bộ thông tin truyện & Nút thao tác -->
                                                            <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, *, Auto" VerticalAlignment="Center" Margin="8,6,8,4">
                                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Index, StringFormat='{}#{0}'}" Foreground="#64748B" FontSize="10" Width="24" VerticalAlignment="Center" />

                                                                <!-- Thông tin truyện & Tiến trình -->
                                                                <StackPanel Grid.Column="2" Margin="4,0,8,0" VerticalAlignment="Center" Spacing="3">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F1F5F9" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                        <Border IsVisible="{Binding IsDuplicate}" Background="#78350F" CornerRadius="2" Padding="3,1" VerticalAlignment="Center">
                                                                            <TextBlock Text="TRÙNG" FontSize="8" FontWeight="Bold" Foreground="#FDE047" />
                                                                        </Border>
                                                                    </StackPanel>

                                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Border Background="#1E293B" CornerRadius="2" Padding="4,1" Margin="0,0,6,2">
                                                                            <TextBlock Text="{Binding Domain}" FontSize="8" Foreground="#38BDF8" FontWeight="SemiBold" />
                                                                        </Border>
                                                                        <TextBlock Text="{Binding TotalChapters, StringFormat='{}{0} chaps'}" Foreground="#94A3B8" FontSize="9" VerticalAlignment="Center" Margin="0,0,8,2" />
                                                                        <TextBlock Text="{Binding Status}" Foreground="#FCD34D" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,2" />
                                                                        <!-- Chuỗi chi tiết tiến trình: Chương X/Y (Trang A/B) • Z.Z% -->
                                                                        <TextBlock Text="{Binding DetailProgressText}" Foreground="#34D399" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,2" />
                                                                    </WrapPanel>

                                                                    <!-- Ô chọn Chapter (hỗ trợ chữ, số nguyên, số thập phân: vd 1-10, 15.5, oneshot) -->
                                                                    <Grid ColumnDefinitions="Auto, *">
                                                                        <TextBlock Grid.Column="0" Text="📑 Chọn chap:" Foreground="#94A3B8" FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                        <TextBox Grid.Column="1" Text="{Binding ChapterSelectionText}" PlaceholderText="VD: 1-10, 15.5, oneshot (để trống = tải hết)" FontSize="9" Height="22" Background="#0B0F19" Foreground="#F8FAFC" BorderBrush="#334155" CornerRadius="3" VerticalContentAlignment="Center" Padding="4,1" />
                                                                    </Grid>
                                                                </StackPanel>

                                                                <!-- Nút thao tác hàng -->
                                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                                    <Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenBookFolderCommand}"
                                                                            CommandParameter="{Binding .}" ToolTip.Tip="Mở thư mục"
                                                                            Background="#1E293B" Foreground="#38BDF8" Padding="4,2" FontSize="9" CornerRadius="3">
                                                                        <TextBlock Text="📂" />
                                                                    </Button>
                                                                    <Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MoveUpCommand}"
                                                                            CommandParameter="{Binding .}"
                                                                            Background="#1E293B" Foreground="#94A3B8" Padding="4,2" FontSize="9" CornerRadius="3">
                                                                        <TextBlock Text="▲" />
                                                                    </Button>
                                                                    <Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MoveDownCommand}"
                                                                            CommandParameter="{Binding .}"
                                                                            Background="#1E293B" Foreground="#94A3B8" Padding="4,2" FontSize="9" CornerRadius="3">
                                                                        <TextBlock Text="▼" />
                                                                    </Button>
                                                                    <Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).DeleteItemCommand}"
                                                                            CommandParameter="{Binding .}"
                                                                            Background="#1E293B" Foreground="#EF4444" Padding="4,2" FontSize="9" CornerRadius="3">
                                                                        <TextBlock Text="✕" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Hàng 1: THANH PROGRESS BAR SÁT MÉP GÓC ĐÁY CARD 100% VỚI SỐ % OVERLAP NỔI BẬT KHÁC MÀU -->
                                                            <Grid Grid.Row="1" Height="14" HorizontalAlignment="Stretch" Margin="0,2,0,0">
                                                                <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="14"
                                                                             CornerRadius="0" Foreground="#0284C7" Background="#0B132B"
                                                                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="0" Margin="0" />
                                                                <!-- Con số % overlap nổi bật với màu vàng dạ quang sắc nét -->
                                                                <TextBlock Text="{Binding ProgressPercentageText}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="#FDE047" FontWeight="ExtraBold" FontSize="9" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>

                            <!-- SUBTAB 2.2: SCAN MISSING INTEGER CHAPTER -->
                            <TabItem Header="🔍 Scan Thiếu Chap" FontSize="12" FontWeight="SemiBold">
                                <Grid RowDefinitions="Auto, *">
                                    <Border Grid.Row="0" Background="#161F30" Padding="10,5" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Command="{Binding StartScanMissingCommand}" Content="▶ Quét ngay" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" Padding="8,3" CornerRadius="3" Margin="0,0,8,2" />
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,2">
                                                <TextBlock Text="Song song:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                <NumericUpDown Value="{Binding ParallelCheckCount}" Minimum="1" Maximum="16" Increment="1" FormatString="0" Width="110" Height="28" FontSize="11" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ScanResults.Count, StringFormat='{}Đã quét: {0}'}" Foreground="#10B981" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" />
                                        </WrapPanel>
                                    </Border>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MinHeight="260">
                                        <ItemsControl ItemsSource="{Binding ScanResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="8,5">
                                                        <Grid ColumnDefinitions="25, 75, *, Auto" VerticalAlignment="Center">
                                                            <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat='{}#{0}'}" Foreground="#64748B" FontSize="10" VerticalAlignment="Center" />
                                                            <Border Grid.Column="1" Background="#1E293B" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Domain}" FontSize="8" Foreground="#38BDF8" FontWeight="SemiBold" />
                                                            </Border>
                                                            <StackPanel Grid.Column="2" Margin="4,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F1F5F9" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding MissingIntegerChapters, StringFormat='{}Thiếu: {0}'}" Foreground="#FDE047" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Border Grid.Column="3" Background="#1E293B" CornerRadius="3" Padding="5,2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Status}" FontSize="9" Foreground="#10B981" FontWeight="SemiBold" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>

                            <!-- SUBTAB 2.3: REALTIME LOGS -->
                            <TabItem Header="📜 Nhật Ký (Logs)" FontSize="12" FontWeight="SemiBold">
                                <Grid RowDefinitions="Auto, *">
                                    <Border Grid.Row="0" Background="#161F30" Padding="10,4" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Grid.Column="0" Text="Nhật ký các sự kiện tải xuống &amp; scan" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Command="{Binding ClearLogsCommand}" Content="🧹 Xóa log" Background="#1E293B" Foreground="#94A3B8" FontSize="9" Padding="6,2" CornerRadius="3" />
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1" Background="#0A0E17" Padding="6" MinHeight="260">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Logs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="50, 55, *" Margin="0,1">
                                                            <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="#64748B" FontSize="9" FontFamily="Consolas, Monospace" VerticalAlignment="Center" />
                                                            <Border Grid.Column="1" CornerRadius="2" Padding="2,1" HorizontalAlignment="Left" Background="#1E293B" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Level}" FontSize="8" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="#E2E8F0" FontSize="9" FontFamily="Consolas, Monospace" TextWrapping="Wrap" VerticalAlignment="Center" Margin="3,0,0,0" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>

                <!-- ========================================================================= -->
                <!-- [TAB 3 LỚN] TAB TOOL: CÔNG CỤ (SPLIT/MERGE, CẮT ẢNH DÀI, XỬ LÝ ẢNH, ĐÓNG GÓI) -->
                <!-- ========================================================================= -->
                <TabItem Header="🛠️ TAB TOOL (CÔNG CỤ)" FontSize="13" FontWeight="Bold">
                    <Border Background="#0F172A" Padding="8">
                        <TabControl Background="Transparent" Margin="0">

                            <!-- CHILD TAB 3.1: FOLDER TOOLS (TÁCH / GỘP FOLDER) -->
                            <TabItem Header="📁 Tách / Gộp Folder" FontSize="12" FontWeight="SemiBold">
                                <Grid RowDefinitions="Auto, *">
                                    <!-- Panel cấu hình tác vụ Tách / Gộp Folder -->
                                    <Border Grid.Row="0" Background="#161F30" Padding="12,10" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                                        <StackPanel Spacing="12">
                                            <!-- KHU VỰC 1: TÁCH / GỘP THEO SỐ LƯỢNG CHAPTER -->
                                            <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="1. Tách / Gộp Thư Mục Theo Số Lượng Chapter (Ví dụ: Nhóm 200 chap/folder)" FontWeight="Bold" Foreground="#38BDF8" FontSize="12" />
                                                    
                                                    <!-- Thư mục gốc theo Chapter (Bố cục 2 tầng xem Full Path trên Android) -->
                                                    <StackPanel Spacing="3">
                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="📁 Thư mục truyện gốc (Root Single Comic):" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <Button Command="{Binding BrowseFolderSplitRootCommand}" Content="📁 Chọn Thư Mục" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" />
                                                            <Button Command="{Binding OpenFolderSplitRootCommand}" Content="📂 Mở" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" ToolTip.Tip="Mở thư mục trên thiết bị" />
                                                        </WrapPanel>
                                                        <TextBox Text="{Binding FolderSplitRootPath}" PlaceholderText="Chọn thư mục truyện gốc cần tách hoặc gộp..." Height="30" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" BorderBrush="#38BDF8" BorderThickness="1" FontSize="10" VerticalContentAlignment="Center" Padding="8,2" />
                                                    </StackPanel>

                                                    <!-- Cấu hình số chapter mỗi nhóm & kiểu tách -->
                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <TextBlock Text="Số chap/folder:" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <NumericUpDown Value="{Binding FolderSplitGroupSize}" Minimum="1" Maximum="5000" Increment="50" FormatString="0" Width="130" Height="28" FontSize="11" Foreground="#38BDF8" Background="#0B0F19" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>

                                                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="0,0,8,4" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <TextBlock Text="Kiểu tên folder:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                                                                <ComboBox SelectedItem="{Binding FolderSplitType}" Width="160" Height="26" FontSize="10">
                                                                    <x:String>chapter</x:String>
                                                                    <x:String>book-chapter</x:String>
                                                                </ComboBox>
                                                            </StackPanel>
                                                        </Border>

                                                        <CheckBox IsChecked="{Binding IsMergeRemainderFolder}" Content="Gộp cả nhóm lẻ còn lại" FontSize="10" Foreground="#D1D5DB" Margin="0,0,8,4" />

                                                        <Button Command="{Binding SplitByChapterCountCommand}" IsEnabled="{Binding !IsFolderToolRunning}"
                                                                Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" Padding="12,5" Height="28" CornerRadius="4" Margin="0,0,6,4">
                                                            <TextBlock Text="📂 TÁCH THEO SỐ LƯỢNG CHAPTER" />
                                                        </Button>

                                                        <Button Command="{Binding MergeByChapterCountCommand}" IsEnabled="{Binding !IsFolderToolRunning}"
                                                                Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" Padding="12,5" Height="28" CornerRadius="4" Margin="0,0,0,4">
                                                            <TextBlock Text="🔄 GỘP CHAPTER VỀ GỐC" />
                                                        </Button>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- KHU VỰC 2: TÁCH / GỘP THEO BẢNG CHỮ CÁI (ALPHABET) -->
                                            <Border Background="#131B2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="2. Tách / Gộp Thư Mục Theo Bảng Chữ Cái (Alphabet A-G, H-P, Q-Z...)" FontWeight="Bold" Foreground="#F59E0B" FontSize="12" />

                                                    <!-- Thư mục gốc theo Alphabet (Bố cục 2 tầng xem Full Path trên Android) -->
                                                    <StackPanel Spacing="3">
                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="📁 Thư mục gốc chứa nhiều bộ truyện (Multi-Comic Root):" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <Button Command="{Binding BrowseFolderAlphabetRootCommand}" Content="📁 Chọn Thư Mục" Background="#D97706" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" />
                                                            <Button Command="{Binding OpenFolderAlphabetRootCommand}" Content="📂 Mở" Background="#1E293B" Foreground="#F59E0B" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" ToolTip.Tip="Mở thư mục trên thiết bị" />
                                                        </WrapPanel>
                                                        <TextBox Text="{Binding FolderAlphabetRootPath}" PlaceholderText="Chọn thư mục chứa nhiều bộ truyện cần phân loại theo chữ cái..." Height="30" CornerRadius="4" Background="#0B0F19" Foreground="#F8FAFC" BorderBrush="#F59E0B" BorderThickness="1" FontSize="10" VerticalContentAlignment="Center" Padding="8,2" />
                                                    </StackPanel>

                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <CheckBox IsChecked="{Binding IsAlphabetIgnoreLeadingTags}" Content="Bỏ qua tiền tố tag [...]" FontSize="10" Foreground="#D1D5DB" Margin="0,0,10,4" />

                                                        <!-- Quản lý dải chữ cái -->
                                                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="0,0,8,4" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <TextBlock Text="Dải:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                                <TextBox Text="{Binding NewAlphabetRangeInput}" PlaceholderText="VD: A-C" Width="80" Height="28" FontSize="11" Background="#0B0F19" Foreground="#F8FAFC" BorderBrush="#334155" CornerRadius="3" VerticalContentAlignment="Center" Padding="6,2" />
                                                                <Button Command="{Binding AddAlphabetRangeCommand}" Content="➕ Thêm" Background="#1E293B" Foreground="#38BDF8" FontSize="10" Padding="8,4" CornerRadius="3" />
                                                            </StackPanel>
                                                        </Border>

                                                        <Button Command="{Binding SplitByAlphabetCommand}" IsEnabled="{Binding !IsFolderToolRunning}"
                                                                Background="#D97706" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" Padding="12,5" Height="28" CornerRadius="4" Margin="0,0,6,4">
                                                            <TextBlock Text="🔤 TÁCH THEO ALPHABET" />
                                                        </Button>

                                                        <Button Command="{Binding MergeByAlphabetCommand}" IsEnabled="{Binding !IsFolderToolRunning}"
                                                                Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" Padding="12,5" Height="28" CornerRadius="4" Margin="0,0,6,4">
                                                            <TextBlock Text="🔄 GỘP TỪ ALPHABET VỀ GỐC" />
                                                        </Button>

                                                        <Button Command="{Binding StopFolderToolCommand}" IsEnabled="{Binding IsFolderToolRunning}"
                                                                Background="#DC2626" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="10,5" Height="28" CornerRadius="4" Margin="0,0,6,4">
                                                            <TextBlock Text="⏹ DỪNG" />
                                                        </Button>

                                                        <Button Command="{Binding ClearFolderToolLogsCommand}"
                                                                Background="#1E293B" Foreground="#94A3B8" FontSize="10" Padding="8,5" Height="28" CornerRadius="4" Margin="0,0,0,4">
                                                            <TextBlock Text="🧹 Xóa log" />
                                                        </Button>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Thanh tiến trình & Trạng thái (Bố cục thông minh chống Overlap 100%) -->
                                            <Border Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="Auto, *">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <TextBlock Text="📊 Tiến độ xử lý:" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding FolderToolProgressText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding FolderToolStatusText}" Foreground="#10B981" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <ProgressBar Value="{Binding FolderToolProgress}" Maximum="100" Height="8" CornerRadius="4" Foreground="#38BDF8" Background="#1E293B" BorderBrush="#0284C7" BorderThickness="1" />
                                                    <TextBlock Text="{Binding FolderToolStatusText}" Foreground="#34D399" FontSize="10.5" TextWrapping="Wrap" IsVisible="{Binding IsFolderToolRunning}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Log chi tiết -->
                                    <Border Grid.Row="1" Background="#0A0E17" Padding="6" MinHeight="160">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False">
                                            <ItemsControl ItemsSource="{Binding FolderToolLogs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Foreground="#CBD5E1" FontSize="10" FontFamily="Consolas, Monospace" Margin="2,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- CHILD TAB 3.2: SPLIT LONG IMAGES (CẮT ẢNH DÀI) -->
                            <TabItem Header="✂️ Cắt Ảnh Dài" FontSize="12" FontWeight="SemiBold">
                                <Grid RowDefinitions="Auto, *">
                                    <!-- Panel cấu hình -->
                                    <Border Grid.Row="0" Background="#161F30" Padding="12,10" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                                        <StackPanel Spacing="10">
                                            <!-- Chọn thư mục (Bố cục 2 tầng xem Full Path trên Android) -->
                                            <StackPanel Spacing="3">
                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📁 Thư mục chứa ảnh dài để cắt:" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <Button Command="{Binding BrowseManualSplitFolderCommand}" Content="📁 Chọn Thư Mục" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" />
                                                    <Button Command="{Binding OpenManualSplitFolderCommand}" Content="📂 Mở" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" ToolTip.Tip="Mở thư mục trên thiết bị" />
                                                </WrapPanel>
                                                <TextBox Text="{Binding ManualSplitFolderPath}" PlaceholderText="Chọn thư mục chứa ảnh dài để cắt..." Height="30" CornerRadius="4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#38BDF8" BorderThickness="1" FontSize="10" VerticalContentAlignment="Center" Padding="8,2" />
                                            </StackPanel>

                                            <!-- Cấu hình Height, Quality, Threads & Nút Bắt đầu -->
                                            <WrapPanel Orientation="Horizontal">
                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,8,6" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="Chiều cao cắt:" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Value="{Binding ManualSplitHeight}" Minimum="500" Maximum="50000" Increment="500" FormatString="0" Width="140" Height="28" FontSize="11" Foreground="#38BDF8" Background="#0B0F19" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                        <TextBlock Text="px" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>

                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,8,6" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="Chất lượng:" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Value="{Binding ManualSplitQuality}" Minimum="10" Maximum="100" Increment="5" FormatString="0" Width="130" Height="28" FontSize="11" Foreground="#10B981" Background="#0B0F19" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                        <TextBlock Text="%" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>

                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,8,6" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="Số luồng CPU:" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Value="{Binding ManualSplitThreads}" Minimum="1" Maximum="16" Increment="1" FormatString="0" Width="120" Height="28" FontSize="11" Foreground="#F59E0B" Background="#0B0F19" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                                    </StackPanel>
                                                </Border>

                                                <Button Command="{Binding StartManualSplitCommand}" IsEnabled="{Binding !IsManualSplitting}"
                                                        Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="14,6" Height="34" CornerRadius="4" Margin="0,0,6,6">
                                                    <TextBlock Text="▶ BẮT ĐẦU CẮT ẢNH" />
                                                </Button>

                                                <Button Command="{Binding StopManualSplitCommand}" IsEnabled="{Binding !IsManualSplitting, Converter={x:Static BoolConverters.Not}}"
                                                        Background="#DC2626" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="12,6" Height="34" CornerRadius="4" Margin="0,0,6,6">
                                                    <TextBlock Text="⏹ DỪNG" />
                                                </Button>

                                                <Button Command="{Binding ClearManualSplitLogsCommand}"
                                                        Background="#1E293B" Foreground="#94A3B8" FontSize="11" Padding="10,6" Height="34" CornerRadius="4" Margin="0,0,0,6">
                                                    <TextBlock Text="🧹 Xóa log" />
                                                </Button>
                                            </WrapPanel>

                                            <!-- Thanh tiến trình & Trạng thái -->
                                            <StackPanel Spacing="4">
                                                <ProgressBar Value="{Binding ManualSplitProgress}" Maximum="100" Height="6" CornerRadius="3" Foreground="#10B981" Background="#0F172A" />
                                                <WrapPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ManualSplitCurrentFileText}" Foreground="#64748B" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="400" Margin="0,0,12,0" />
                                                    <TextBlock Text="{Binding ManualSplitProgressText}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding ManualSplitCountText, StringFormat='{}Đã cắt: {0}'}" Foreground="#10B981" FontWeight="SemiBold" FontSize="10" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding ManualSplitErrorCountText, StringFormat='{}Lỗi: {0}'}" Foreground="#F43F5E" FontWeight="SemiBold" FontSize="10" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Log chi tiết -->
                                    <Border Grid.Row="1" Background="#0A0E17" Padding="6" MinHeight="180">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False">
                                            <ItemsControl ItemsSource="{Binding ManualSplitLogs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Foreground="#CBD5E1" FontSize="10" FontFamily="Consolas, Monospace" Margin="2,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- CHILD TAB 3.3: BATCH IMAGE ENHANCEMENT (XỬ LÝ ẢNH) -->
                            <TabItem Header="🎨 Xử Lý Ảnh" FontSize="12" FontWeight="SemiBold">
                                <Grid RowDefinitions="Auto, *">
                                    <!-- Panel cấu hình bộ lọc & tác vụ -->
                                    <Border Grid.Row="0" Background="#161F30" Padding="12,10" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                                        <StackPanel Spacing="10">
                                            <!-- Hàng 1: Thư mục nguồn (Bố cục 2 tầng xem Full Path trên Android) -->
                                            <StackPanel Spacing="3">
                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📥 Thư mục nguồn chứa ảnh (hỗ trợ quét đệ quy đa tầng):" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <Button Command="{Binding BrowseEnhanceFolderCommand}" Content="📁 Chọn Thư Mục" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" />
                                                    <Button Command="{Binding OpenEnhanceFolderCommand}" Content="📂 Mở" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" ToolTip.Tip="Mở thư mục nguồn trên thiết bị" />
                                                </WrapPanel>
                                                <TextBox Text="{Binding EnhanceFolderPath}" PlaceholderText="Chọn thư mục nguồn chứa ảnh..." Height="30" CornerRadius="4" Background="#0F172A" Foreground="#F8FAFC" FontSize="11" VerticalContentAlignment="Center" Padding="8,0" IsReadOnly="True" />
                                            </StackPanel>

                                            <!-- Hàng 2: Thư mục lưu ảnh đã xử lý (Bố cục 2 tầng xem Full Path trên Android) -->
                                            <StackPanel Spacing="3">
                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📤 Thư mục lưu ảnh đã xử lý (Mặc định: thư mục 'enhanced' cùng cấp với nguồn):" Foreground="#10B981" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <Button Command="{Binding BrowseEnhanceOutputFolderCommand}" Content="📁 Chọn Thư Mục" Background="#059669" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" />
                                                    <Button Command="{Binding OpenEnhanceOutputFolderCommand}" Content="📂 Mở" Background="#1E293B" Foreground="#10B981" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" ToolTip.Tip="Mở thư mục lưu ảnh đã xử lý trên thiết bị" />
                                                    <CheckBox IsChecked="{Binding EnhanceOverwriteOriginal}" Content="Chỉ đè trực tiếp lên file gốc" Foreground="#F59E0B" FontWeight="SemiBold" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Nếu chọn, ảnh sau xử lý sẽ lưu đè trực tiếp lên file ảnh gốc thay vì tạo thư mục mới" />
                                                </WrapPanel>
                                                <TextBox Text="{Binding EnhanceOutputFolderPath}" IsEnabled="{Binding !EnhanceOverwriteOriginal}" PlaceholderText="Chọn thư mục lưu ảnh đã xử lý..." Height="30" CornerRadius="4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#10B981" BorderThickness="1" FontSize="10" VerticalContentAlignment="Center" Padding="8,2" />
                                            </StackPanel>

                                            <!-- Hàng 3: Bộ thông số tinh chỉnh (Chuẩn bố cục XnConvert: Slider ngang mỏng, NumericUpDown 3-digit nhỏ gọn, Nút Reset riêng ↺) -->
                                            <UniformGrid Columns="{Binding EnhanceDualColumns}" HorizontalAlignment="Stretch">
                                                <UniformGrid.Resources>
                                                    <x:Double x:Key="SliderHorizontalThumbWidth">8</x:Double>
                                                    <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
                                                    <x:Double x:Key="SliderHorizontalTrackHeight">3</x:Double>
                                                </UniformGrid.Resources>
                                                <UniformGrid.Styles>
                                                    <!-- Slider phong cách XnConvert: Thanh mỏng, con trỏ hình chữ nhật nhỏ xám sang trọng -->
                                                    <Style Selector="Slider">
                                                        <Setter Property="Height" Value="18" />
                                                        <Setter Property="MinHeight" Value="18" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Margin" Value="4,0,6,0" />
                                                    </Style>
                                                    <Style Selector="Slider:horizontal Thumb">
                                                        <Setter Property="Width" Value="8" />
                                                        <Setter Property="Height" Value="14" />
                                                        <Setter Property="MinWidth" Value="8" />
                                                        <Setter Property="MinHeight" Value="14" />
                                                        <Setter Property="CornerRadius" Value="2" />
                                                        <Setter Property="Background" Value="#64748B" />
                                                        <Setter Property="BorderBrush" Value="#475569" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                    </Style>
                                                    <Style Selector="Slider:horizontal:pointerover Thumb">
                                                        <Setter Property="Background" Value="#94A3B8" />
                                                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                                                    </Style>
                                                    <Style Selector="Slider:horizontal:pressed Thumb">
                                                        <Setter Property="Background" Value="#38BDF8" />
                                                    </Style>
                                                    <Style Selector="Slider:horizontal Track#PART_Track">
                                                        <Setter Property="MinHeight" Value="3" />
                                                    </Style>

                                                    <!-- NumericUpDown phong cách XnConvert: Số hiển thị rõ nét căn phải, 2 nút mũi tên dọc mép phải, không bị che khuất -->
                                                    <Style Selector="NumericUpDown">
                                                        <Setter Property="Height" Value="22" />
                                                        <Setter Property="MinHeight" Value="22" />
                                                        <Setter Property="Width" Value="52" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="FontSize" Value="11" />
                                                        <Setter Property="CornerRadius" Value="3" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="BorderBrush" Value="#334155" />
                                                        <Setter Property="Background" Value="#0B0F19" />
                                                        <Setter Property="Foreground" Value="#F8FAFC" />
                                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Right" />
                                                    </Style>
                                                    <Style Selector="NumericUpDown:pointerover">
                                                        <Setter Property="BorderBrush" Value="#38BDF8" />
                                                    </Style>
                                                    <Style Selector="NumericUpDown:focus-within">
                                                        <Setter Property="BorderBrush" Value="#38BDF8" />
                                                        <Setter Property="Background" Value="#0B0F19" />
                                                    </Style>
                                                    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
                                                        <Setter Property="Height" Value="20" />
                                                        <Setter Property="MinHeight" Value="18" />
                                                        <Setter Property="Padding" Value="3,0,1,0" />
                                                        <Setter Property="FontSize" Value="11" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Foreground" Value="#F8FAFC" />
                                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Right" />
                                                    </Style>
                                                    <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0" />
                                                    </Style>
                                                    <Style Selector="ButtonSpinner">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Template">
                                                            <ControlTemplate TargetType="ButtonSpinner">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="{TemplateBinding CornerRadius}">
                                                                    <Grid ColumnDefinitions="*, 14">
                                                                        <ContentPresenter Name="PART_ContentPresenter"
                                                                                          Grid.Column="0"
                                                                                          Content="{TemplateBinding Content}"
                                                                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                                          Padding="{TemplateBinding Padding}" />
                                                                        <Grid Grid.Column="1" RowDefinitions="*,*" Width="14" Margin="0" VerticalAlignment="Stretch">
                                                                            <RepeatButton Name="PART_IncreaseButton"
                                                                                          Grid.Row="0" Width="14" Padding="0" Margin="0,0,0,0.5"
                                                                                          BorderThickness="0" Background="#1E293B" Foreground="#94A3B8"
                                                                                          CornerRadius="0,2,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                                                <Path Data="M 0 3.5 L 3 0.5 L 6 3.5 Z" Fill="#94A3B8" Width="6" Height="3.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </RepeatButton>
                                                                            <RepeatButton Name="PART_DecreaseButton"
                                                                                          Grid.Row="1" Width="14" Padding="0" Margin="0,0.5,0,0"
                                                                                          BorderThickness="0" Background="#1E293B" Foreground="#94A3B8"
                                                                                          CornerRadius="0,0,2,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                                                <Path Data="M 0 0.5 L 3 3.5 L 6 0.5 Z" Fill="#94A3B8" Width="6" Height="3.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </RepeatButton>
                                                                        </Grid>
                                                                    </Grid>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter>
                                                    </Style>
                                                    <Style Selector="ButtonSpinner /template/ RepeatButton:pointerover">
                                                        <Setter Property="Background" Value="#334155" />
                                                    </Style>
                                                    <Style Selector="ButtonSpinner /template/ RepeatButton:pointerover Path">
                                                        <Setter Property="Fill" Value="#38BDF8" />
                                                    </Style>
                                                    <Style Selector="ButtonSpinner /template/ RepeatButton:pressed">
                                                        <Setter Property="Background" Value="#0284C7" />
                                                    </Style>
                                                    <Style Selector="ButtonSpinner /template/ RepeatButton:pressed Path">
                                                        <Setter Property="Fill" Value="#FFFFFF" />
                                                    </Style>
                                                </UniformGrid.Styles>

                                                <!-- 1. Tương phản (Contrast) -->
                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="2,1">
                                                    <Grid ColumnDefinitions="74, *, 22, 52" VerticalAlignment="Center">
                                                        <TextBlock Grid.Column="0" Text="Tương phản:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                        <Slider Grid.Column="1" Value="{Binding EnhanceContrast}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" />
                                                        <Button Grid.Column="2" Command="{Binding ResetContrastCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Tương phản về mặc định (0)" Margin="2,0,2,0">
                                                            <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                                        </Button>
                                                        <NumericUpDown Grid.Column="3" Value="{Binding EnhanceContrast}" Minimum="-100" Maximum="100" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ToolTip.Tip="Tương phản (-100 đến 100)" />
                                                    </Grid>
                                                </Border>

                                                <!-- 2. Độ sáng (Brightness) -->
                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="2,1">
                                                    <Grid ColumnDefinitions="74, *, 22, 52" VerticalAlignment="Center">
                                                        <TextBlock Grid.Column="0" Text="Độ sáng:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                        <Slider Grid.Column="1" Value="{Binding EnhanceBrightness}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" />
                                                        <Button Grid.Column="2" Command="{Binding ResetBrightnessCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Độ sáng về mặc định (0)" Margin="2,0,2,0">
                                                            <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                                        </Button>
                                                        <NumericUpDown Grid.Column="3" Value="{Binding EnhanceBrightness}" Minimum="-100" Maximum="100" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ToolTip.Tip="Độ sáng (-100 đến 100)" />
                                                    </Grid>
                                                </Border>

                                                <!-- 3. Bão hòa (Saturation) -->
                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="2,1">
                                                    <Grid ColumnDefinitions="74, *, 22, 52" VerticalAlignment="Center">
                                                        <TextBlock Grid.Column="0" Text="Bão hòa:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                        <Slider Grid.Column="1" Value="{Binding EnhanceSaturation}" Minimum="0" Maximum="200" SmallChange="1" LargeChange="10" />
                                                        <Button Grid.Column="2" Command="{Binding ResetSaturationCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Bão hòa về mặc định (100%)" Margin="2,0,2,0">
                                                            <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                                        </Button>
                                                        <NumericUpDown Grid.Column="3" Value="{Binding EnhanceSaturation}" Minimum="0" Maximum="200" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ToolTip.Tip="Bão hòa màu (0 đến 200%)" />
                                                    </Grid>
                                                </Border>

                                                <!-- 4. Độ nét (Sharpness) -->
                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="2,1">
                                                    <Grid ColumnDefinitions="74, *, 22, 52" VerticalAlignment="Center">
                                                        <TextBlock Grid.Column="0" Text="Độ nét:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                        <Slider Grid.Column="1" Value="{Binding EnhanceSharpness}" Minimum="0" Maximum="10" SmallChange="0.5" LargeChange="1" />
                                                        <Button Grid.Column="2" Command="{Binding ResetSharpnessCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Độ nét về mặc định (0.0)" Margin="2,0,2,0">
                                                            <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                                        </Button>
                                                        <NumericUpDown Grid.Column="3" Value="{Binding EnhanceSharpness}" Minimum="0" Maximum="10" Increment="0.5" FormatString="0.0" ToolTip.Tip="Độ nét (0.0 đến 10.0)" />
                                                    </Grid>
                                                </Border>

                                                <!-- 5. Khử nhiễu (Noise Reduce) -->
                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="2,1">
                                                    <Grid ColumnDefinitions="74, *, 22, 52" VerticalAlignment="Center">
                                                        <TextBlock Grid.Column="0" Text="Khử nhiễu:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                        <Slider Grid.Column="1" Value="{Binding EnhanceNoiseReduce}" Minimum="0" Maximum="5" SmallChange="1" LargeChange="1" />
                                                        <Button Grid.Column="2" Command="{Binding ResetNoiseReduceCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Khử nhiễu về mặc định (0)" Margin="2,0,2,0">
                                                            <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                                        </Button>
                                                        <NumericUpDown Grid.Column="3" Value="{Binding EnhanceNoiseReduce}" Minimum="0" Maximum="5" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ToolTip.Tip="Khử nhiễu (0 đến 5)" />
                                                    </Grid>
                                                </Border>

                                                <!-- 6. Chất lượng ảnh (Quality) -->
                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="2,1">
                                                    <Grid ColumnDefinitions="74, *, 22, 52" VerticalAlignment="Center">
                                                        <TextBlock Grid.Column="0" Text="Chất lượng:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                        <Slider Grid.Column="1" Value="{Binding EnhanceQuality}" Minimum="10" Maximum="100" SmallChange="5" LargeChange="10" />
                                                        <Button Grid.Column="2" Command="{Binding ResetQualityCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Chất lượng ảnh về mặc định (90%)" Margin="2,0,2,0">
                                                            <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                                        </Button>
                                                        <NumericUpDown Grid.Column="3" Value="{Binding EnhanceQuality}" Minimum="10" Maximum="100" Increment="5" FormatString="0" ParsingNumberStyle="Integer" ToolTip.Tip="Chất lượng ảnh JPG/WEBP %" />
                                                    </Grid>
                                                </Border>

                                                <!-- 7. Số luồng (Threads) -->
                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="2,1">
                                                    <Grid ColumnDefinitions="74, *, 22, 52" VerticalAlignment="Center">
                                                        <TextBlock Grid.Column="0" Text="Số luồng:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                        <Slider Grid.Column="1" Value="{Binding EnhanceThreads}" Minimum="1" Maximum="16" SmallChange="1" LargeChange="2" />
                                                        <Button Grid.Column="2" Command="{Binding ResetThreadsCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Số luồng CPU về mặc định (4)" Margin="2,0,2,0">
                                                            <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                                        </Button>
                                                        <NumericUpDown Grid.Column="3" Value="{Binding EnhanceThreads}" Minimum="1" Maximum="16" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ToolTip.Tip="Luồng xử lý CPU" />
                                                    </Grid>
                                                </Border>

                                                <!-- 8. Reset toàn bộ (Reset all) -->
                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="2,1">
                                                    <Button Command="{Binding ResetEnhanceSettingsCommand}" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Height="22" HorizontalAlignment="Stretch" VerticalAlignment="Center" ToolTip.Tip="Khôi phục toàn bộ thông số về giá trị mặc định">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                                            <TextBlock Text="🔄" FontSize="11" VerticalAlignment="Center" />
                                                            <TextBlock Text="Khôi phục tất cả mặc định" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </Border>
                                            </UniformGrid>

                                            <!-- Hàng 4: Các nút hành động chính -->
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Command="{Binding StartEnhanceCommand}" IsEnabled="{Binding !IsEnhancing}"
                                                        Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="14,6" Height="34" CornerRadius="4" Margin="0,0,8,6">
                                                    <TextBlock Text="▶ BẮT ĐẦU XỬ LÝ ẢNH" />
                                                </Button>

                                                <Button Command="{Binding StopEnhanceCommand}" IsEnabled="{Binding IsEnhancing}"
                                                        Background="#DC2626" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="12,6" Height="34" CornerRadius="4" Margin="0,0,8,6">
                                                    <TextBlock Text="⏹ DỪNG" />
                                                </Button>

                                                <Button Command="{Binding PickSampleImageCommand}"
                                                        Background="#4F46E5" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="12,6" Height="34" CornerRadius="4" Margin="0,0,8,6" ToolTip.Tip="Chọn một ảnh cụ thể để xem trước Before / After">
                                                    <TextBlock Text="👁️ Chọn ảnh mẫu xem trước" />
                                                </Button>

                                                <Button Command="{Binding ToggleFullscreenPreviewCommand}"
                                                        Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="12,6" Height="34" CornerRadius="4" Margin="0,0,8,6" ToolTip.Tip="Mở chế độ đối chiếu toàn màn hình trực tiếp trong ứng dụng">
                                                    <TextBlock Text="⛶ TOÀN MÀN HÌNH ĐỐI CHIẾU" />
                                                </Button>

                                                <!-- Nút Mở Cửa Sổ Riêng Tím Nổi Bật -->
                                                <Button Command="{Binding OpenComparisonWindowCommand}" IsVisible="{Binding IsDesktopLifetime}"
                                                        Background="#7C3AED" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="12,6" Height="34" CornerRadius="4" Margin="0,0,8,6" ToolTip.Tip="Mở cửa sổ đối chiếu độc lập phong cách FastStone trên Desktop (hỗ trợ kéo sang màn hình thứ 2)">
                                                    <TextBlock Text="🗖 MỞ TRONG CỬA SỔ MỚI" />
                                                </Button>

                                                <Button Command="{Binding ClearEnhanceLogsCommand}"
                                                        Background="#1E293B" Foreground="#94A3B8" FontSize="11" Padding="10,6" Height="34" CornerRadius="4" Margin="0,0,0,6">
                                                    <TextBlock Text="🧹 Xóa log" />
                                                </Button>
                                            </WrapPanel>

                                            <!-- Thanh tiến trình & Trạng thái -->
                                            <StackPanel Spacing="4">
                                                <ProgressBar Value="{Binding EnhanceProgress}" Maximum="100" Height="6" CornerRadius="3" Foreground="#38BDF8" Background="#0F172A" />
                                                <WrapPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding EnhanceCurrentFileText}" Foreground="#64748B" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="400" Margin="0,0,12,0" />
                                                    <TextBlock Text="{Binding EnhanceProgressText}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding EnhanceCountText, StringFormat='{}Đã xong: {0}'}" Foreground="#10B981" FontWeight="SemiBold" FontSize="10" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding EnhanceErrorCountText, StringFormat='{}Lỗi: {0}'}" Foreground="#F43F5E" FontWeight="SemiBold" FontSize="10" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Khung nội dung dưới: Live Preview Before / After có Zoom & Pan & Log -->
                                    <Grid Grid.Row="1" RowDefinitions="Auto, *">
                                        <!-- Khung so sánh trực quan Trước & Sau (Live Preview có Zoom, Pan, Navigation & Stats) -->
                                        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="10,8">
                                            <StackPanel Spacing="6">
                                                <!-- Toolbar Preview: Sử dụng WrapPanel chống overlap/tràn mép trên Android -->
                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Cụm 1: Tiêu đề & Duyệt ảnh Previous / Next to rõ cho Android & Desktop -->
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,12,6">
                                                        <TextBlock Text="⚡ Preview:" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                                        <Button Command="{Binding PreviousImageCommand}" IsEnabled="{Binding CanGoPrevious}"
                                                                Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" Padding="10,5" Height="32" CornerRadius="4" ToolTip.Tip="Ảnh trước (◀)">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="◀" FontSize="10" VerticalAlignment="Center" />
                                                                <TextBlock Text="Trước" FontSize="11" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="8,4" Height="32" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding EnhanceImageCounterText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" TextAlignment="Center" />
                                                        </Border>
                                                        <Button Command="{Binding NextImageCommand}" IsEnabled="{Binding CanGoNext}"
                                                                Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" Padding="10,5" Height="32" CornerRadius="4" ToolTip.Tip="Ảnh tiếp theo (▶)">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="Sau" FontSize="11" VerticalAlignment="Center" />
                                                                <TextBlock Text="▶" FontSize="10" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <TextBlock Text="{Binding EnhanceImageFileNameText}" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding EnhanceImageFileNameText}" Margin="4,0,0,0" />
                                                    </StackPanel>

                                                    <!-- Cụm 2: Presets nhanh dạng WrapPanel chống tràn mép -->
                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,6">
                                                        <TextBlock Text="⚡ Presets:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                        <Button Command="{Binding ApplyPresetDefaultCommand}" Content="🔘 Gốc" Background="#1E293B" Foreground="#E2E8F0" FontSize="9" Padding="6,2" CornerRadius="3" ToolTip.Tip="Thông số gốc" Margin="0,0,4,2" />
                                                        <Button Command="{Binding ApplyPresetOldScanCommand}" Content="📜 Khử ố scan" Background="#854D0E" Foreground="#FEF08A" FontWeight="Bold" FontSize="9" Padding="6,2" CornerRadius="3" ToolTip.Tip="Làm trắng nền giấy scan cũ" Margin="0,0,4,2" />
                                                        <Button Command="{Binding ApplyPresetWebtoonCommand}" Content="🎨 Webtoon" Background="#831843" Foreground="#FBCFE8" FontWeight="Bold" FontSize="9" Padding="6,2" CornerRadius="3" ToolTip.Tip="Rực rỡ màu sắc webtoon" Margin="0,0,4,2" />
                                                        <Button Command="{Binding ApplyPresetNightCommand}" Content="🌙 Đọc đêm" Background="#1E1B4B" Foreground="#C7D2FE" FontWeight="Bold" FontSize="9" Padding="6,2" CornerRadius="3" ToolTip.Tip="Hạ sáng dịu mắt" Margin="0,0,0,2" />
                                                    </WrapPanel>
                                                    
                                                    <!-- Cụm 3: Bộ điều khiển Zoom & Nút Mở Cửa Sổ Mới -->
                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                                        <Button Command="{Binding ResetZoomPreviewCommand}" Content="1:1" Background="#1E293B" Foreground="#10B981" Padding="5,2" FontSize="10" CornerRadius="3" ToolTip.Tip="Tỷ lệ 100%" Margin="0,0,4,0" />
                                                        <Button Command="{Binding ZoomFitPreviewCommand}" Content="⛶ Fit" Background="#1E293B" Foreground="#F59E0B" Padding="5,2" FontSize="10" CornerRadius="3" ToolTip.Tip="Tự co vừa khung" Margin="0,0,4,0" />
                                                        <Button Command="{Binding ZoomOutPreviewCommand}" Content="➖" Background="#1E293B" Foreground="#94A3B8" Padding="5,2" FontSize="11" CornerRadius="3" ToolTip.Tip="Thu nhỏ" Margin="0,0,4,0" />
                                                        <Border Background="#1E293B" CornerRadius="3" Padding="6,2" VerticalAlignment="Center" Margin="0,0,4,0">
                                                            <TextBlock Text="{Binding EnhancePreviewZoomText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" Width="36" TextAlignment="Center" />
                                                        </Border>
                                                        <Button Command="{Binding ZoomInPreviewCommand}" Content="➕" Background="#1E293B" Foreground="#38BDF8" Padding="5,2" FontSize="11" CornerRadius="3" ToolTip.Tip="Phóng to" Margin="0,0,4,0" />
                                                        <Button Command="{Binding OpenComparisonWindowCommand}" IsVisible="{Binding IsDesktopLifetime}" Content="🗖 Cửa sổ riêng" Background="#7C3AED" Foreground="#FFFFFF" FontWeight="Bold" Padding="8,3" FontSize="10" CornerRadius="3" ToolTip.Tip="Mở đối chiếu Before/After trong cửa sổ riêng biệt" />
                                                    </WrapPanel>
                                                </WrapPanel>

                                                <!-- FastStone Info Bar (Dung lượng Before vs After) -->
                                                <WrapPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                    <Border Background="#1E293B" CornerRadius="3" Padding="6,2" Margin="0,0,6,4">
                                                        <TextBlock Text="{Binding EnhanceBeforeInfoText}" Foreground="#94A3B8" FontSize="10" />
                                                    </Border>
                                                    <Border Background="#0C4A6E" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,6,4">
                                                        <TextBlock Text="{Binding EnhanceAfterInfoText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" />
                                                    </Border>
                                                    <Border Background="#1E293B" CornerRadius="3" Padding="6,2" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding EnhanceClippingInfoText}" Foreground="#FCD34D" FontWeight="Bold" FontSize="10" />
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Vùng hiển thị Before & After có đồng bộ Pan/Scroll & Responsive Portrait/Landscape -->
                                                <Panel Margin="0,2,0,0">
                                                    <UniformGrid Columns="{Binding EnhanceDualColumns}" Rows="{Binding EnhanceDualRows}">
                                                        <!-- Before -->
                                                        <Border Background="#090D16" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="6" Margin="2">
                                                            <StackPanel Spacing="4">
                                                                <Border Background="#1E293B" CornerRadius="3" Padding="4,2" HorizontalAlignment="Left">
                                                                    <TextBlock Text="📷 ẢNH GỐC (BEFORE)" Foreground="#94A3B8" FontWeight="Bold" FontSize="9" />
                                                                </Border>
                                                                <ScrollViewer x:Name="LiveBeforeScrollViewer" Height="220" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False" IsScrollInertiaEnabled="True" Background="#050811" CornerRadius="4">
                                                                    <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <LayoutTransformControl.LayoutTransform>
                                                                            <ScaleTransform ScaleX="{Binding EnhancePreviewZoom}" ScaleY="{Binding EnhancePreviewZoom}" />
                                                                        </LayoutTransformControl.LayoutTransform>
                                                                        <Image Source="{Binding EnhancePreviewOriginal}" Width="{Binding EnhanceImagePixelWidth}" Height="{Binding EnhanceImagePixelHeight}" Stretch="Fill" />
                                                                    </LayoutTransformControl>
                                                                </ScrollViewer>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- After -->
                                                        <Border Background="#090D16" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" Padding="6" Margin="2">
                                                            <StackPanel Spacing="4">
                                                                <Border Background="#0284C7" CornerRadius="3" Padding="4,2" HorizontalAlignment="Left">
                                                                    <TextBlock Text="✨ ĐÃ TỐI ƯU (AFTER)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9" />
                                                                </Border>
                                                                <ScrollViewer x:Name="LiveAfterScrollViewer" Height="220" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False" IsScrollInertiaEnabled="True" Background="#050811" CornerRadius="4">
                                                                    <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <LayoutTransformControl.LayoutTransform>
                                                                            <ScaleTransform ScaleX="{Binding EnhancePreviewZoom}" ScaleY="{Binding EnhancePreviewZoom}" />
                                                                        </LayoutTransformControl.LayoutTransform>
                                                                        <Image Source="{Binding EnhancePreviewResult}" Width="{Binding EnhanceImagePixelWidth}" Height="{Binding EnhanceImagePixelHeight}" Stretch="Fill" />
                                                                    </LayoutTransformControl>
                                                                </ScrollViewer>
                                                            </StackPanel>
                                                        </Border>
                                                    </UniformGrid>

                                                    <!-- Nút chuyển ảnh trước nổi trên ảnh -->
                                                    <Button Command="{Binding PreviousImageCommand}" IsEnabled="{Binding CanGoPrevious}"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"
                                                            Width="34" Height="48" CornerRadius="6"
                                                            Background="#B30F172A" BorderBrush="#38BDF8" BorderThickness="1"
                                                            Foreground="#38BDF8" FontWeight="Bold" FontSize="16"
                                                            ToolTip.Tip="Ảnh trước (◀)">
                                                        <TextBlock Text="❮" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>

                                                    <!-- Nút chuyển ảnh sau nổi trên ảnh -->
                                                    <Button Command="{Binding NextImageCommand}" IsEnabled="{Binding CanGoNext}"
                                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                                            Width="34" Height="48" CornerRadius="6"
                                                            Background="#B30F172A" BorderBrush="#38BDF8" BorderThickness="1"
                                                            Foreground="#38BDF8" FontWeight="Bold" FontSize="16"
                                                            ToolTip.Tip="Ảnh tiếp theo (▶)">
                                                        <TextBlock Text="❯" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                </Panel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Khung log chi tiết -->
                                        <Border Grid.Row="1" Background="#0A0E17" Padding="6" MinHeight="120">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False">
                                                <ItemsControl ItemsSource="{Binding EnhanceLogs}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" Foreground="#CBD5E1" FontSize="10" FontFamily="Consolas, Monospace" Margin="2,1" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </TabItem>

                            <!-- CHILD TAB 3.4: PACKAGE / ARCHIVE TOOLS (ĐÓNG GÓI FILE ZIP, CBZ, PDF) -->
                            <TabItem Header="📦 Đóng Gói File" FontSize="12" FontWeight="SemiBold">
                                <Grid RowDefinitions="Auto, *">
                                    <Border Grid.Row="0" Background="#161F30" Padding="12,10" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                                        <StackPanel Spacing="10">
                                            <!-- Hàng 1: Thư mục nguồn (Bố cục 2 tầng xem Full Path trên Android) -->
                                            <StackPanel Spacing="3">
                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📥 Thư mục nguồn chứa ảnh hoặc các thư mục chapter cần đóng gói:" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <Button Command="{Binding BrowsePackerInputFolderCommand}" Content="📁 Chọn Thư Mục" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" />
                                                    <Button Command="{Binding OpenPackerInputFolderCommand}" Content="📂 Mở" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" ToolTip.Tip="Mở thư mục nguồn trên thiết bị" />
                                                </WrapPanel>
                                                <TextBox Text="{Binding PackerInputFolderPath}" PlaceholderText="Chọn thư mục chứa ảnh hoặc các thư mục chapter cần đóng gói..." Height="30" CornerRadius="4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#38BDF8" BorderThickness="1" FontSize="10" VerticalContentAlignment="Center" Padding="8,2" />
                                            </StackPanel>

                                            <!-- Hàng 2: Thư mục lưu (Bố cục 2 tầng xem Full Path trên Android) -->
                                            <StackPanel Spacing="3">
                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📤 Thư mục lưu file đóng gói (Mặc định: thư mục 'packed' cùng cấp với nguồn):" Foreground="#10B981" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <Button Command="{Binding BrowsePackerOutputFolderCommand}" Content="📁 Chọn Thư Mục" Background="#059669" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" Margin="0,0,6,0" />
                                                    <Button Command="{Binding OpenPackerOutputFolderCommand}" Content="📂 Mở" Background="#1E293B" Foreground="#10B981" FontWeight="SemiBold" FontSize="10" Padding="8,3" CornerRadius="4" ToolTip.Tip="Mở thư mục lưu file đóng gói trên thiết bị" />
                                                </WrapPanel>
                                                <TextBox Text="{Binding PackerOutputFolderPath}" PlaceholderText="Chọn thư mục lưu file đóng gói..." Height="30" CornerRadius="4" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#10B981" BorderThickness="1" FontSize="10" VerticalContentAlignment="Center" Padding="8,2" />
                                            </StackPanel>

                                            <!-- Hàng 3: Tùy chọn định dạng đóng gói & chế độ quét -->
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,8,6" VerticalAlignment="Center">
                                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Định dạng đóng gói:" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <CheckBox IsChecked="{Binding IsPackerCbz}" Content="CBZ (.cbz)" Foreground="#F59E0B" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip.Tip="Định dạng Comic Book Zip chuẩn quốc tế tương thích 100% Tachiyomi, Mihon, CDisplayEx" />
                                                        <CheckBox IsChecked="{Binding IsPackerZip}" Content="ZIP (.zip)" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip.Tip="File nén zip chuẩn có thể mở bằng bất kỳ ứng dụng nào" />
                                                        <CheckBox IsChecked="{Binding IsPackerPdf}" Content="PDF (.pdf - kèm mục lục chương)" Foreground="#EC4899" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" ToolTip.Tip="Ghép các trang ảnh thành file PDF chất lượng cao có mục lục chương (bookmarks)" />
                                                    </WrapPanel>
                                                </Border>

                                                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,8,6" VerticalAlignment="Center">
                                                    <CheckBox IsChecked="{Binding IsPackerBatchSubfolders}" Content="📦 Đóng gói từng thư mục con (Chapter) thành 1 file riêng" Foreground="#10B981" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" ToolTip.Tip="Nếu chọn, mỗi thư mục con bên trong sẽ được đóng gói thành một file riêng mang tên thư mục đó. Nếu bỏ chọn, toàn bộ sẽ gom vào 1 file lớn kèm mục lục chương." />
                                                </Border>
                                            </WrapPanel>

                                            <!-- Hàng 4: Nút hành động -->
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Command="{Binding StartPackingCommand}" IsEnabled="{Binding !IsPacking}"
                                                        Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="14,6" Height="34" CornerRadius="4" Margin="0,0,8,6">
                                                    <TextBlock Text="▶ BẮT ĐẦU ĐÓNG GÓI" />
                                                </Button>

                                                <Button Command="{Binding StopPackingCommand}" IsEnabled="{Binding IsPacking}"
                                                        Background="#DC2626" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="12,6" Height="34" CornerRadius="4" Margin="0,0,8,6">
                                                    <TextBlock Text="⏹ DỪNG" />
                                                </Button>

                                                <Button Command="{Binding ClearPackerLogsCommand}"
                                                        Background="#1E293B" Foreground="#94A3B8" FontSize="11" Padding="10,6" Height="34" CornerRadius="4" Margin="0,0,0,6">
                                                    <TextBlock Text="🧹 Xóa log" />
                                                </Button>
                                            </WrapPanel>

                                            <!-- Thanh tiến trình & Trạng thái -->
                                            <StackPanel Spacing="4">
                                                <ProgressBar Value="{Binding PackerProgress}" Maximum="100" Height="6" CornerRadius="3" Foreground="#10B981" Background="#0F172A" />
                                                <WrapPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding PackerCurrentFileText}" Foreground="#64748B" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="400" Margin="0,0,12,0" />
                                                    <TextBlock Text="{Binding PackerProgressText}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="10" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding PackerCountText, StringFormat='{}Đã xong: {0}'}" Foreground="#10B981" FontWeight="SemiBold" FontSize="10" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding PackerErrorCountText, StringFormat='{}Lỗi: {0}'}" Foreground="#F43F5E" FontWeight="SemiBold" FontSize="10" />
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- Banner thông báo khi đóng gói hoàn tất -->
                                            <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="6" Padding="12,8" Margin="0,4,0,0" IsVisible="{Binding IsPackerCompletedVisible}">
                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,6">
                                                        <TextBlock Text="🎉" FontSize="18" VerticalAlignment="Center" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="ĐÓNG GÓI HOÀN TẤT THÀNH CÔNG!" FontWeight="Bold" FontSize="12" Foreground="#34D399" />
                                                            <TextBlock Text="{Binding PackerCompletedMessage}" FontSize="11" Foreground="#E2E8F0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,0,6">
                                                        <Button Command="{Binding OpenPackerOutputFolderCommand}" Content="📂 Mở Thư Mục Chứa File" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="10,6" CornerRadius="4" />
                                                        <Button Command="{Binding DismissPackerCompletedCommand}" Content="✕" Background="#1E293B" Foreground="#94A3B8" FontSize="11" Padding="8,6" CornerRadius="4" />
                                                    </StackPanel>
                                                </WrapPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Log chi tiết -->
                                    <Border Grid.Row="1" Background="#0A0E17" Padding="6" MinHeight="180">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False">
                                            <ItemsControl ItemsSource="{Binding PackerLogs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Foreground="#CBD5E1" FontSize="10" FontFamily="Consolas, Monospace" Margin="2,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </TabItem>

                        </TabControl>
                    </Border>
                </TabItem>
            </TabControl>

            <!-- 4. FOOTER STATUS BAR -->
            <Border Grid.Row="3" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="12,5">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalBooks, StringFormat='{}Tổng: {0}'}" FontSize="10.5" Foreground="#94A3B8" Margin="0,2,10,2" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DownloadingCount, StringFormat='{}Đang tải: {0}'}" FontSize="10.5" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,2,10,2" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CompletedCount, StringFormat='{}Hoàn tất: {0}'}" FontSize="10.5" Foreground="#10B981" FontWeight="SemiBold" Margin="0,2,10,2" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorCount, StringFormat='{}Lỗi: {0}'}" FontSize="10.5" Foreground="#F43F5E" FontWeight="SemiBold" Margin="0,2,10,2" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DownloadSpeedText, StringFormat='{}Tốc độ: {0}'}" FontSize="10.5" Foreground="#F59E0B" FontWeight="SemiBold" Margin="0,2,0,2" VerticalAlignment="Center" />
                </WrapPanel>
            </Border>
        </Grid>
    </ScrollViewer>

        <!-- 5. MODAL POPUP: MANGADEX LANGUAGE SELECTION DIALOG -->
        <Border Background="#CC000000" IsVisible="{Binding IsMangadexPromptVisible}" ZIndex="999" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="#111827" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="10" 
                    Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" MaxWidth="450"
                    BoxShadow="0 10 25 #80000000">
                <StackPanel Spacing="14">
                    <!-- Title Header -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Background="#38BDF8" CornerRadius="4" Width="24" Height="24">
                            <TextBlock Text="🌐" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="MangaDex - Chọn Ngôn Ngữ Tải" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Phát hiện liên kết MangaDex. Vui lòng chọn ngôn ngữ bản dịch của các chương bạn muốn tải về:" 
                               Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />

                    <!-- Options -->
                    <Border Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <StackPanel Spacing="10">
                            <!-- Tiếng Việt -->
                            <Button Command="{Binding SelectMangadexViCommand}" Background="Transparent" Padding="0" Cursor="Hand" HorizontalAlignment="Stretch">
                                <Grid ColumnDefinitions="Auto, *">
                                    <RadioButton Grid.Column="0" IsChecked="{Binding MangadexLangVi}" GroupName="mdLang" IsHitTestVisible="False" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="🇻🇳 Tiếng Việt (Vietnamese)" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" />
                                        <TextBlock Text="Ưu tiên tải các chương truyện bản dịch tiếng Việt" FontSize="10" Foreground="#64748B" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Border Height="1" Background="#1E293B" />

                            <!-- Tiếng Anh -->
                            <Button Command="{Binding SelectMangadexEnCommand}" Background="Transparent" Padding="0" Cursor="Hand" HorizontalAlignment="Stretch">
                                <Grid ColumnDefinitions="Auto, *">
                                    <RadioButton Grid.Column="0" IsChecked="{Binding MangadexLangEn}" GroupName="mdLang" IsHitTestVisible="False" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="🇬🇧 Tiếng Anh (English)" FontWeight="Bold" FontSize="12" Foreground="#F59E0B" />
                                        <TextBlock Text="Ưu tiên tải các chương truyện bản dịch tiếng Anh" FontSize="10" Foreground="#64748B" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Fallback Option -->
                    <CheckBox IsChecked="{Binding MangadexFallback}" Margin="2,0,0,0">
                        <TextBlock Text="Tự động tải ngôn ngữ còn lại nếu không có bản dịch đã chọn" FontSize="10.5" Foreground="#CBD5E1" TextWrapping="Wrap" />
                    </CheckBox>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*, *" Margin="0,6,0,0">
                        <Button Grid.Column="0" Command="{Binding CancelMangadexLanguageCommand}" 
                                Background="#1E293B" BorderBrush="#334155" BorderThickness="1" 
                                Foreground="#94A3B8" Padding="12,7" CornerRadius="6" HorizontalAlignment="Stretch" Margin="0,0,6,0">
                            <TextBlock Text="❌ HỦY BỎ" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        </Button>

                        <Button Grid.Column="1" Command="{Binding ConfirmMangadexLanguageCommand}" 
                                Background="#0284C7" BorderBrush="#38BDF8" BorderThickness="1" 
                                Foreground="#FFFFFF" Padding="12,7" CornerRadius="6" HorizontalAlignment="Stretch" Margin="6,0,0,0">
                            <TextBlock Text="✅ XÁC NHẬN" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- 6. MODAL POPUP: TOÀN MÀN HÌNH ĐỐI CHIẾU ẢNH BEFORE / AFTER (FASTSTONE CONVERSION PREVIEW) -->
        <Border Background="#F20B0F19" IsVisible="{Binding IsEnhanceFullscreenVisible}" ZIndex="1000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Panel>
                <!-- NÚT ĐÓNG NỔI TO RÕ LUÔN NẰM TRÊN CÙNG GÓC PHẢI (CHỐNG KẸT TRÊN ANDROID / MOBILE) -->
                <Button Command="{Binding CloseFullscreenPreviewCommand}"
                        ZIndex="3000" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="10" MinWidth="44" MinHeight="44" CornerRadius="22"
                        Background="#DC2626" Foreground="#FFFFFF"
                        FontWeight="ExtraBold" FontSize="18"
                        ToolTip.Tip="Đóng chế độ đối chiếu toàn màn hình (Esc)">
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,0">
                        <TextBlock Text="✕" FontWeight="ExtraBold" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="ĐÓNG" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Grid RowDefinitions="Auto, Auto, Auto, *">
                <!-- ROW 0: Header Toolbar (FastStone Style) -->
                <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="12,8">
                    <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                        <!-- Cột 0: Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Border Background="#38BDF8" CornerRadius="4" Width="26" Height="26">
                                <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="CONVERSION PREVIEW (TOÀN MÀN HÌNH)" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Cột 1: Navigation Previous / Next to rõ cho Android & Desktop -->
                        <Border Grid.Column="1" Background="#1E293B" CornerRadius="5" Padding="4,2" Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Command="{Binding PreviousImageCommand}" IsEnabled="{Binding CanGoPrevious}"
                                        Background="#0F172A" Foreground="#38BDF8" FontWeight="Bold" Padding="10,5" Height="32" CornerRadius="3" ToolTip.Tip="Ảnh trước (◀)">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="◀" FontSize="10" VerticalAlignment="Center" />
                                        <TextBlock Text="Trước" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border Background="#0B0F19" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="3" Padding="8,4" Height="32" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EnhanceImageCounterText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" TextAlignment="Center" />
                                </Border>
                                <Button Command="{Binding NextImageCommand}" IsEnabled="{Binding CanGoNext}"
                                        Background="#0F172A" Foreground="#38BDF8" FontWeight="Bold" Padding="10,5" Height="32" CornerRadius="3" ToolTip.Tip="Ảnh tiếp theo (▶)">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Sau" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Text="▶" FontSize="10" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding EnhanceImageFileNameText}" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding EnhanceImageFileNameText}" Margin="4,0,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Cột 2: Chế độ xem & Bộ Zoom FastStone -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" VerticalAlignment="Center">
                            <!-- Chế độ xem -->
                            <Border Background="#1E293B" CornerRadius="5" Padding="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Command="{Binding SetViewModeDualCommand}" Content="⏸ Song song"
                                            Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" Padding="8,4" CornerRadius="3" ToolTip.Tip="Xem 2 ảnh Trước / Sau song song" />
                                    <Button Command="{Binding SetViewModeSplitCommand}" Content="⮂ Rèm trượt"
                                            Foreground="#A855F7" FontWeight="SemiBold" FontSize="11" Padding="8,4" CornerRadius="3" ToolTip.Tip="Thanh rèm đối chiếu Before / After" />
                                    <Button Command="{Binding SetViewModeSingleCommand}" Content="⏹ Ảnh đơn"
                                            Foreground="#10B981" FontWeight="SemiBold" FontSize="11" Padding="8,4" CornerRadius="3" ToolTip.Tip="Ảnh đơn: Xem After hoặc hoán đổi Before" />
                                </StackPanel>
                            </Border>

                            <!-- Bộ công cụ Zoom -->
                            <Border Background="#1E293B" CornerRadius="5" Padding="4,2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Command="{Binding ResetZoomPreviewCommand}" Content="1:1" Background="#0F172A" Foreground="#10B981" FontWeight="Bold" Padding="8,5" FontSize="11" CornerRadius="3" ToolTip.Tip="Kích thước thực 100%" />
                                    <Button Command="{Binding ZoomFitPreviewCommand}" Content="⛶ Vừa khung" Background="#0F172A" Foreground="#F59E0B" FontWeight="Bold" Padding="8,5" FontSize="11" CornerRadius="3" ToolTip.Tip="Tự co vừa cửa sổ" />
                                    <Button Command="{Binding ZoomOutPreviewCommand}" Content="➖" Background="#0F172A" Foreground="#94A3B8" Padding="8,4" FontSize="13" FontWeight="Bold" CornerRadius="3" ToolTip.Tip="Thu nhỏ" />
                                    <NumericUpDown Value="{Binding EnhancePreviewZoomPercent}" Minimum="10" Maximum="1000" Increment="25" FormatString="0'%'" Width="110" Height="30" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Background="#0F172A" CornerRadius="3" ParsingNumberStyle="Integer" HorizontalContentAlignment="Center" ToolTip.Tip="Tỷ lệ phóng to % (Nhập số trực tiếp)" />
                                    <Button Command="{Binding ZoomInPreviewCommand}" Content="➕" Background="#0F172A" Foreground="#38BDF8" Padding="8,4" FontSize="13" FontWeight="Bold" CornerRadius="3" ToolTip.Tip="Phóng to" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Cột 3: Đổi ảnh mẫu, Cửa sổ riêng & Đóng -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Command="{Binding OpenComparisonWindowCommand}" IsVisible="{Binding IsDesktopLifetime}" Background="#7C3AED" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="10,6" CornerRadius="4" ToolTip.Tip="Mở cửa sổ đối chiếu độc lập phong cách FastStone">
                                <TextBlock Text="🗖 Cửa sổ riêng" />
                            </Button>
                            <Button Command="{Binding PickSampleImageCommand}" Background="#4F46E5" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="10,6" CornerRadius="4">
                                <TextBlock Text="🖼️ Đổi ảnh mẫu" />
                            </Button>
                            <Button Command="{Binding CloseFullscreenPreviewCommand}" Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" Padding="12,6" CornerRadius="4">
                                <TextBlock Text="✕ ĐÓNG" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ROW 1: FastStone Info Bar (Dung lượng Before/After & Presets) -->
                <Border Grid.Row="1" Background="#0E1626" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="#1E293B" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="{Binding EnhanceBeforeInfoText}" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11" />
                            </Border>
                            <Border Background="#0C4A6E" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="{Binding EnhanceAfterInfoText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" />
                            </Border>
                            <Border Background="#1E293B" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="{Binding EnhanceClippingInfoText}" Foreground="#FCD34D" FontWeight="Bold" FontSize="11" />
                            </Border>
                        </StackPanel>

                        <!-- One-Click Presets -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="⚡ Presets truyện:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <Button Command="{Binding ApplyPresetDefaultCommand}" Content="🔘 Mặc định" Background="#1E293B" Foreground="#E2E8F0" FontSize="10" Padding="8,4" CornerRadius="4" ToolTip.Tip="Khôi phục thông số gốc" />
                            <Button Command="{Binding ApplyPresetOldScanCommand}" Content="📜 Khử ố scan" Background="#854D0E" Foreground="#FEF08A" FontWeight="Bold" FontSize="10" Padding="8,4" CornerRadius="4" ToolTip.Tip="Tăng sáng nền, tương phản mạnh khử vàng giấy cũ" />
                            <Button Command="{Binding ApplyPresetWebtoonCommand}" Content="🎨 Webtoon rực rỡ" Background="#831843" Foreground="#FBCFE8" FontWeight="Bold" FontSize="10" Padding="8,4" CornerRadius="4" ToolTip.Tip="Tăng bão hòa màu và độ sắc nét viền vẽ truyện tranh màu" />
                            <Button Command="{Binding ApplyPresetNightCommand}" Content="🌙 Đọc đêm dịu mắt" Background="#1E1B4B" Foreground="#C7D2FE" FontWeight="Bold" FontSize="10" Padding="8,4" CornerRadius="4" ToolTip.Tip="Hạ sáng nền, tăng nét chữ giúp đỡ mỏi mắt" />
                        </StackPanel>
                    </Grid>
                </Border>

                                <!-- ROW 2: Sliders Toolbar & 3 Custom Presets (Chuẩn bố cục XnConvert: Slider ngang mỏng, NumericUpDown 3-digit nhỏ gọn, Nút Reset riêng ↺) -->
                <Border Grid.Row="2" Background="#161F30" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="8,3">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <WrapPanel.Resources>
                                <x:Double x:Key="SliderHorizontalThumbWidth">8</x:Double>
                                <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
                                <x:Double x:Key="SliderHorizontalTrackHeight">3</x:Double>
                            </WrapPanel.Resources>
                            <WrapPanel.Styles>
                                <!-- Slider phong cách XnConvert: Thanh mỏng, con trỏ hình chữ nhật nhỏ xám sang trọng -->
                                <Style Selector="Slider">
                                    <Setter Property="Height" Value="18" />
                                    <Setter Property="MinHeight" Value="18" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="4,0,6,0" />
                                </Style>
                                <Style Selector="Slider:horizontal Thumb">
                                    <Setter Property="Width" Value="8" />
                                    <Setter Property="Height" Value="14" />
                                    <Setter Property="MinWidth" Value="8" />
                                    <Setter Property="MinHeight" Value="14" />
                                    <Setter Property="CornerRadius" Value="2" />
                                    <Setter Property="Background" Value="#64748B" />
                                    <Setter Property="BorderBrush" Value="#475569" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </Style>
                                <Style Selector="Slider:horizontal:pointerover Thumb">
                                    <Setter Property="Background" Value="#94A3B8" />
                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                </Style>
                                <Style Selector="Slider:horizontal:pressed Thumb">
                                    <Setter Property="Background" Value="#38BDF8" />
                                </Style>
                                <Style Selector="Slider:horizontal Track#PART_Track">
                                    <Setter Property="MinHeight" Value="3" />
                                </Style>

                                <!-- NumericUpDown phong cách XnConvert: Số hiển thị rõ nét căn phải, 2 nút mũi tên dọc mép phải, không bị che khuất -->
                                <Style Selector="NumericUpDown">
                                    <Setter Property="Height" Value="22" />
                                    <Setter Property="MinHeight" Value="22" />
                                    <Setter Property="Width" Value="52" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="CornerRadius" Value="3" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="#334155" />
                                    <Setter Property="Background" Value="#0B0F19" />
                                    <Setter Property="Foreground" Value="#F8FAFC" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="HorizontalContentAlignment" Value="Right" />
                                </Style>
                                <Style Selector="NumericUpDown:pointerover">
                                    <Setter Property="BorderBrush" Value="#38BDF8" />
                                </Style>
                                <Style Selector="NumericUpDown:focus-within">
                                    <Setter Property="BorderBrush" Value="#38BDF8" />
                                    <Setter Property="Background" Value="#0B0F19" />
                                </Style>
                                <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
                                    <Setter Property="Height" Value="20" />
                                    <Setter Property="MinHeight" Value="18" />
                                    <Setter Property="Padding" Value="3,0,1,0" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Foreground" Value="#F8FAFC" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="HorizontalContentAlignment" Value="Right" />
                                </Style>
                                <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                                <Style Selector="ButtonSpinner">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Template">
                                        <ControlTemplate TargetType="ButtonSpinner">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="{TemplateBinding CornerRadius}">
                                                <Grid ColumnDefinitions="*, 14">
                                                    <ContentPresenter Name="PART_ContentPresenter"
                                                                      Grid.Column="0"
                                                                      Content="{TemplateBinding Content}"
                                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      Padding="{TemplateBinding Padding}" />
                                                    <Grid Grid.Column="1" RowDefinitions="*,*" Width="14" Margin="0" VerticalAlignment="Stretch">
                                                        <RepeatButton Name="PART_IncreaseButton"
                                                                      Grid.Row="0" Width="14" Padding="0" Margin="0,0,0,0.5"
                                                                      BorderThickness="0" Background="#1E293B" Foreground="#94A3B8"
                                                                      CornerRadius="0,2,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                            <Path Data="M 0 3.5 L 3 0.5 L 6 3.5 Z" Fill="#94A3B8" Width="6" Height="3.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </RepeatButton>
                                                        <RepeatButton Name="PART_DecreaseButton"
                                                                      Grid.Row="1" Width="14" Padding="0" Margin="0,0.5,0,0"
                                                                      BorderThickness="0" Background="#1E293B" Foreground="#94A3B8"
                                                                      CornerRadius="0,0,2,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                            <Path Data="M 0 0.5 L 3 3.5 L 6 0.5 Z" Fill="#94A3B8" Width="6" Height="3.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </RepeatButton>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter>
                                </Style>
                                <Style Selector="ButtonSpinner /template/ RepeatButton:pointerover">
                                    <Setter Property="Background" Value="#334155" />
                                </Style>
                                <Style Selector="ButtonSpinner /template/ RepeatButton:pointerover Path">
                                    <Setter Property="Fill" Value="#38BDF8" />
                                </Style>
                                <Style Selector="ButtonSpinner /template/ RepeatButton:pressed">
                                    <Setter Property="Background" Value="#0284C7" />
                                </Style>
                                <Style Selector="ButtonSpinner /template/ RepeatButton:pressed Path">
                                    <Setter Property="Fill" Value="#FFFFFF" />
                                </Style>
                            </WrapPanel.Styles>

                            <!-- Contrast -->
                            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,4" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="Auto, 100, 22, 52" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Tương phản:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <Slider Grid.Column="1" Value="{Binding EnhanceContrast}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" />
                                    <Button Grid.Column="2" Command="{Binding ResetContrastCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Tương phản về mặc định (0)" Margin="2,0,2,0">
                                        <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                    </Button>
                                    <NumericUpDown Grid.Column="3" Value="{Binding EnhanceContrast}" Minimum="-100" Maximum="100" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ToolTip.Tip="Tương phản (-100 đến 100)" />
                                </Grid>
                            </Border>

                            <!-- Brightness -->
                            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,4" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="Auto, 100, 22, 52" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Độ sáng:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <Slider Grid.Column="1" Value="{Binding EnhanceBrightness}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" />
                                    <Button Grid.Column="2" Command="{Binding ResetBrightnessCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Độ sáng về mặc định (0)" Margin="2,0,2,0">
                                        <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                    </Button>
                                    <NumericUpDown Grid.Column="3" Value="{Binding EnhanceBrightness}" Minimum="-100" Maximum="100" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ToolTip.Tip="Độ sáng (-100 đến 100)" />
                                </Grid>
                            </Border>

                            <!-- Saturation -->
                            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,4" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="Auto, 100, 22, 52" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Bão hòa:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <Slider Grid.Column="1" Value="{Binding EnhanceSaturation}" Minimum="0" Maximum="200" SmallChange="1" LargeChange="10" />
                                    <Button Grid.Column="2" Command="{Binding ResetSaturationCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Bão hòa về mặc định (100%)" Margin="2,0,2,0">
                                        <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                    </Button>
                                    <NumericUpDown Grid.Column="3" Value="{Binding EnhanceSaturation}" Minimum="0" Maximum="200" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ToolTip.Tip="Bão hòa màu (0 đến 200%)" />
                                </Grid>
                            </Border>

                            <!-- Sharpness -->
                            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,4" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="Auto, 100, 22, 52" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Độ nét:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <Slider Grid.Column="1" Value="{Binding EnhanceSharpness}" Minimum="0" Maximum="10" SmallChange="0.5" LargeChange="1" />
                                    <Button Grid.Column="2" Command="{Binding ResetSharpnessCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Độ nét về mặc định (0.0)" Margin="2,0,2,0">
                                        <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                    </Button>
                                    <NumericUpDown Grid.Column="3" Value="{Binding EnhanceSharpness}" Minimum="0" Maximum="10" Increment="0.5" FormatString="0.0" ToolTip.Tip="Độ nét (0.0 đến 10.0)" />
                                </Grid>
                            </Border>

                            <!-- Noise Reduce -->
                            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,4,4" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="Auto, 100, 22, 52" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0" Text="Khử nhiễu:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <Slider Grid.Column="1" Value="{Binding EnhanceNoiseReduce}" Minimum="0" Maximum="5" SmallChange="1" LargeChange="1" />
                                    <Button Grid.Column="2" Command="{Binding ResetNoiseReduceCommand}" Background="#EA580C" Foreground="#FFFFFF" Padding="0" Width="18" Height="18" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="Đặt lại Khử nhiễu về mặc định (0)" Margin="2,0,2,0">
                                        <TextBlock Text="↺" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                    </Button>
                                    <NumericUpDown Grid.Column="3" Value="{Binding EnhanceNoiseReduce}" Minimum="0" Maximum="5" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ToolTip.Tip="Khử nhiễu (0 đến 5)" />
                                </Grid>
                            </Border>

                            <!-- 3 Custom Presets -->
                            <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="0,0,4,4" VerticalAlignment="Center">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💾 Presets:" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,4,2">
                                        <TextBox Text="{Binding UserPreset1Name}" Width="65" Height="24" FontSize="9" Padding="3,1" VerticalAlignment="Center" Background="#1E293B" Foreground="#E2E8F0" CornerRadius="3" ToolTip.Tip="Tên Preset 1" />
                                        <Button Command="{Binding SaveUserPreset1Command}" Content="💾" Background="#0284C7" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="24" CornerRadius="3" ToolTip.Tip="Lưu vào Preset 1" />
                                        <Button Command="{Binding LoadUserPreset1Command}" Content="📂" Background="#0D9488" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="24" CornerRadius="3" ToolTip.Tip="Tải Preset 1" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,4,2">
                                        <TextBox Text="{Binding UserPreset2Name}" Width="65" Height="24" FontSize="9" Padding="3,1" VerticalAlignment="Center" Background="#1E293B" Foreground="#E2E8F0" CornerRadius="3" ToolTip.Tip="Tên Preset 2" />
                                        <Button Command="{Binding SaveUserPreset2Command}" Content="💾" Background="#0284C7" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="24" CornerRadius="3" ToolTip.Tip="Lưu vào Preset 2" />
                                        <Button Command="{Binding LoadUserPreset2Command}" Content="📂" Background="#0D9488" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="24" CornerRadius="3" ToolTip.Tip="Tải Preset 2" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,0,2">
                                        <TextBox Text="{Binding UserPreset3Name}" Width="65" Height="24" FontSize="9" Padding="3,1" VerticalAlignment="Center" Background="#1E293B" Foreground="#E2E8F0" CornerRadius="3" ToolTip.Tip="Tên Preset 3" />
                                        <Button Command="{Binding SaveUserPreset3Command}" Content="💾" Background="#0284C7" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="24" CornerRadius="3" ToolTip.Tip="Lưu vào Preset 3" />
                                        <Button Command="{Binding LoadUserPreset3Command}" Content="📂" Background="#0D9488" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="24" CornerRadius="3" ToolTip.Tip="Tải Preset 3" />
                                    </StackPanel>
                                </WrapPanel>
                            </Border>

                            <Button Command="{Binding ResetEnhanceSettingsCommand}" Background="#1E293B" Foreground="#94A3B8" FontSize="9" Padding="6,3" Height="26" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,0,4">
                                <TextBlock Text="🔄 Đặt lại" VerticalAlignment="Center" />
                            </Button>
                        </WrapPanel>
                    </ScrollViewer>
                </Border>

                <!-- ROW 3: Vùng hiển thị đối chiếu 3 chế độ (Dual, Split, Single) -->
                <Panel Grid.Row="3" Margin="6">
                    <!-- Nút chuyển ảnh trước nổi mép trái (To rõ cho Android) -->
                    <Button Command="{Binding PreviousImageCommand}" IsEnabled="{Binding CanGoPrevious}"
                            ZIndex="1500" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="8,0,0,0" Width="44" Height="60" CornerRadius="8"
                            Background="#B30F172A" BorderBrush="#38BDF8" BorderThickness="1"
                            Foreground="#38BDF8" FontWeight="Bold" FontSize="20"
                            ToolTip.Tip="Ảnh trước (◀)">
                        <TextBlock Text="❮" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <!-- Nút chuyển ảnh sau nổi mép phải (To rõ cho Android) -->
                    <Button Command="{Binding NextImageCommand}" IsEnabled="{Binding CanGoNext}"
                            ZIndex="1500" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,8,0" Width="44" Height="60" CornerRadius="8"
                            Background="#B30F172A" BorderBrush="#38BDF8" BorderThickness="1"
                            Foreground="#38BDF8" FontWeight="Bold" FontSize="20"
                            ToolTip.Tip="Ảnh tiếp theo (▶)">
                        <TextBlock Text="❯" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>

                    <Grid>
                    <!-- CHẾ ĐỘ 1: DUAL VIEW (Responsive Portrait / Landscape) -->
                    <UniformGrid Columns="{Binding EnhanceDualColumns}" Rows="{Binding EnhanceDualRows}" IsVisible="{Binding IsDualView}">
                        <!-- Before -->
                        <Border Background="#090D16" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="4" Margin="2">
                            <Grid RowDefinitions="Auto, *">
                                <Border Grid.Row="0" Background="#1E293B" CornerRadius="3" Padding="6,3" HorizontalAlignment="Left" Margin="0,0,0,4">
                                    <TextBlock Text="📷 ẢNH GỐC (BEFORE)" Foreground="#94A3B8" FontWeight="Bold" FontSize="10" />
                                </Border>
                                <ScrollViewer x:Name="ModalBeforeScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False" IsScrollInertiaEnabled="True" Background="#050811" CornerRadius="4">
                                    <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <LayoutTransformControl.LayoutTransform>
                                            <ScaleTransform ScaleX="{Binding EnhancePreviewZoom}" ScaleY="{Binding EnhancePreviewZoom}" />
                                        </LayoutTransformControl.LayoutTransform>
                                        <Image Source="{Binding EnhancePreviewOriginal}" Width="{Binding EnhanceImagePixelWidth}" Height="{Binding EnhanceImagePixelHeight}" Stretch="Fill" />
                                    </LayoutTransformControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- After -->
                        <Border Background="#090D16" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" Padding="4" Margin="2">
                            <Grid RowDefinitions="Auto, *">
                                <Border Grid.Row="0" Background="#0284C7" CornerRadius="3" Padding="6,3" HorizontalAlignment="Left" Margin="0,0,0,4">
                                    <TextBlock Text="✨ ĐÃ TỐI ƯU (AFTER)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" />
                                </Border>
                                <ScrollViewer x:Name="ModalAfterScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False" IsScrollInertiaEnabled="True" Background="#050811" CornerRadius="4">
                                    <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <LayoutTransformControl.LayoutTransform>
                                            <ScaleTransform ScaleX="{Binding EnhancePreviewZoom}" ScaleY="{Binding EnhancePreviewZoom}" />
                                        </LayoutTransformControl.LayoutTransform>
                                        <Image Source="{Binding EnhancePreviewResult}" Width="{Binding EnhanceImagePixelWidth}" Height="{Binding EnhanceImagePixelHeight}" Stretch="Fill" />
                                    </LayoutTransformControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <!-- CHẾ ĐỘ 2: SPLIT VIEW -->
                    <Border Background="#090D16" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="6" Padding="4" IsVisible="{Binding IsSplitView}">
                        <Grid RowDefinitions="Auto, *">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="4,0,4,4">
                                <Border Grid.Column="0" Background="#1E293B" CornerRadius="3" Padding="6,3">
                                    <TextBlock Text="⮂ RÈM TRƯỢT ĐỐI CHIẾU: Kéo thanh chia đôi để so sánh Trước / Sau trực quan" Foreground="#A855F7" FontWeight="Bold" FontSize="10" />
                                </Border>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Vị trí rèm:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                                    <Slider Width="140" Minimum="0" Maximum="1" Value="{Binding EnhanceSplitRatio}" Height="20" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <ScrollViewer x:Name="ModalSplitScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False" IsScrollInertiaEnabled="True" Background="#050811" CornerRadius="4">
                                <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <LayoutTransformControl.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding EnhancePreviewZoom}" ScaleY="{Binding EnhancePreviewZoom}" />
                                    </LayoutTransformControl.LayoutTransform>
                                    <Panel>
                                        <Image Source="{Binding EnhancePreviewOriginal}" Width="{Binding EnhanceImagePixelWidth}" Height="{Binding EnhanceImagePixelHeight}" Stretch="Fill" />
                                        <Grid ColumnDefinitions="*, Auto, *">
                                            <Border Grid.Column="0" ClipToBounds="True">
                                                <Image Source="{Binding EnhancePreviewResult}" Width="{Binding EnhanceImagePixelWidth}" Height="{Binding EnhanceImagePixelHeight}" Stretch="Fill" HorizontalAlignment="Left" />
                                            </Border>
                                            <GridSplitter Grid.Column="1" Width="4" Background="#38BDF8" ResizeDirection="Columns" />
                                            <Border Grid.Column="2" Background="Transparent" />
                                        </Grid>
                                    </Panel>
                                </LayoutTransformControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- CHẾ ĐỘ 3: SINGLE VIEW -->
                    <Border Background="#090D16" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="4" IsVisible="{Binding IsSingleView}">
                        <Grid RowDefinitions="Auto, *">
                            <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="4,0,0,4">
                                <Border Grid.Column="0" Background="#064E3B" CornerRadius="3" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="💡 ĐANG HIỂN THỊ ẢNH ĐƠN • Click nút bên phải để hoán đổi xem ảnh Trước / Sau" Foreground="#6EE7B7" FontWeight="Bold" FontSize="10" />
                                </Border>
                                <Button Grid.Column="1" Command="{Binding ToggleCompareModeCommand}" Content="🔄 Hoán đổi Before / After" Background="#1E293B" Foreground="#38BDF8" FontSize="10" Padding="8,4" CornerRadius="4" HorizontalAlignment="Right" Margin="0,0,4,0" />
                            </Grid>
                            <ScrollViewer x:Name="ModalSingleScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BringIntoViewOnFocusChange="False" IsScrollInertiaEnabled="True" Background="#050811" CornerRadius="4">
                                <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <LayoutTransformControl.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding EnhancePreviewZoom}" ScaleY="{Binding EnhancePreviewZoom}" />
                                    </LayoutTransformControl.LayoutTransform>
                                    <Panel>
                                        <Image Source="{Binding EnhancePreviewResult}" Width="{Binding EnhanceImagePixelWidth}" Height="{Binding EnhanceImagePixelHeight}" Stretch="Fill" IsVisible="{Binding !IsSingleShowingBefore}" />
                                        <Image Source="{Binding EnhancePreviewOriginal}" Width="{Binding EnhanceImagePixelWidth}" Height="{Binding EnhanceImagePixelHeight}" Stretch="Fill" IsVisible="{Binding IsSingleShowingBefore}" />
                                    </Panel>
                                </LayoutTransformControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    </Grid>
                </Panel>
            </Grid>
            </Panel>
        </Border>

        <!-- FLOATING MINI BADGE (HIỂN THỊ Ở GÓC DƯỚI KHI CÓ TÁC VỤ CHẠY NGẦM VÀ ĐANG Ở GIAO DIỆN CHÍNH) -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="12,0,12,34" CornerRadius="10" MaxWidth="480"
                Background="#1E1B4B" BorderBrush="#8B5CF6" BorderThickness="1.5"
                Padding="10,6" IsVisible="{Binding IsBackgroundWorking}" ZIndex="500"
                BoxShadow="0 8 24 0 #60000000">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="#10B981" VerticalAlignment="Center" Margin="0,0,8,0" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding BubbleStatusTitle}" FontWeight="Bold" FontSize="11" Foreground="#F3F4F6" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding BubbleStatusDetail}" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ProgressBar Grid.Column="2" Value="{Binding BubbleProgress}" Minimum="0" Maximum="100" Width="55" Height="6" CornerRadius="3" Foreground="#8B5CF6" Background="#0F172A" VerticalAlignment="Center" />
            </Grid>
        </Border>
        </Panel>

        <!-- MODAL POPUP CONFIRM KHI BẤM PHÍM BACK HOẶC NÚT THOÁT (2 OPTION: CHẠY NGẦM / THOÁT HOÀN TOÀN) -->
        <Border IsVisible="{Binding IsExitConfirmOpen}"
                Background="#B0050A15"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                ZIndex="999">
            <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1.5"
                    CornerRadius="16" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="320" MaxWidth="440" Margin="16"
                    BoxShadow="0 16 40 0 #A0000000">
                <StackPanel Spacing="16">
                    <!-- Header Dialog -->
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Border Background="#312E81" CornerRadius="10" Width="36" Height="36">
                            <TextBlock Text="⚙️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TÙY CHỌN ỨNG DỤNG" FontWeight="Bold" FontSize="15" Foreground="#F3F4F6" />
                            <TextBlock Text="Chọn cách đóng hoặc chạy ngầm:" FontSize="11" Foreground="#94A3B8" />
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="#1E293B" HorizontalAlignment="Stretch" />

                    <!-- Danh sách 2 Lựa chọn chính -->
                    <StackPanel Spacing="10">
                        <!-- Option 1: Ẩn / Tắt giao diện (Chạy ngầm mượt mà) -->
                        <Button Command="{Binding MinimizeOrHideAppCommand}"
                                Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1"
                                CornerRadius="10" Padding="14,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto, *">
                                <TextBlock Grid.Column="0" Text="🔘" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Chạy Ngầm (Ẩn Giao Diện)" FontWeight="Bold" Foreground="#38BDF8" FontSize="13" />
                                    <TextBlock Text="Thu ứng dụng xuống nền, tiếp tục chạy tải/xử lý ngầm mượt mà" FontSize="10" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Option 2: Thoát hoàn toàn (Force Stop) -->
                        <Button Command="{Binding ForceExitAppCommand}"
                                Background="#3B1219" BorderBrush="#EF4444" BorderThickness="1"
                                CornerRadius="10" Padding="14,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto, *">
                                <TextBlock Grid.Column="0" Text="⛔" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Thoát Hoàn Toàn (Force Stop)" FontWeight="Bold" Foreground="#F87171" FontSize="13" />
                                    <TextBlock Text="Dừng mọi tác vụ, tắt sạch tiến trình và giải phóng bộ nhớ" FontSize="10" Foreground="#FDA4AF" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Border Height="1" Background="#1E293B" HorizontalAlignment="Stretch" />

                    <!-- Nút Hủy / Đóng dialog -->
                    <Button Command="{Binding CancelExitConfirmCommand}"
                            Background="#0F172A" BorderBrush="#475569" BorderThickness="1"
                            Foreground="#94A3B8" FontWeight="SemiBold" FontSize="12"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="10,6" CornerRadius="8">
                        <TextBlock Text="✕ Hủy / Ở lại ứng dụng" />
                    </Button>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
