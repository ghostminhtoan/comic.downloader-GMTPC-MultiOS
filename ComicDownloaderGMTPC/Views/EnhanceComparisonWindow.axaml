<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ComicDownloaderGMTPC.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="850"
        Width="1280" Height="850"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        x:Class="ComicDownloaderGMTPC.Views.EnhanceComparisonWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="So Sánh Ảnh Trước &amp; Sau (Before &amp; After) - Comic Downloader GMTPC">

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- Header Toolbar -->
        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="#38BDF8" CornerRadius="4" Width="26" Height="26">
                        <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="ĐỐI CHIẾU ẢNH TRƯỚC &amp; SAU (BEFORE &amp; AFTER)" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Thông tin file và nút zoom -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding EnhancePreviewInfoText}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Command="{Binding ZoomOutPreviewCommand}" Content="➖" Background="#0F172A" Foreground="#94A3B8" Padding="6,2" FontSize="12" CornerRadius="3" ToolTip.Tip="Thu nhỏ" />
                            <TextBlock Text="{Binding EnhancePreviewZoomText}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="11" Width="45" TextAlignment="Center" VerticalAlignment="Center" />
                            <Button Command="{Binding ZoomInPreviewCommand}" Content="➕" Background="#0F172A" Foreground="#38BDF8" Padding="6,2" FontSize="12" CornerRadius="3" ToolTip.Tip="Phóng to" />
                            <Button Command="{Binding ResetZoomPreviewCommand}" Content="1:1" Background="#0F172A" Foreground="#10B981" Padding="6,2" FontSize="11" CornerRadius="3" ToolTip.Tip="Tỷ lệ 100%" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Đổi ảnh mẫu -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding PickSampleImageCommand}" Background="#4F46E5" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="10,5" CornerRadius="4">
                        <TextBlock Text="🖼️ Đổi ảnh mẫu" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Thanh tinh chỉnh thông số trực tiếp trong chế độ so sánh -->
        <Border Grid.Row="1" Background="#161F30" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="12,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Contrast -->
                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center">
                    <StackPanel Width="140" Spacing="2" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="Tương phản:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding EnhanceContrast, StringFormat='{}{0:0}%'}" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                        </Grid>
                        <Slider Value="{Binding EnhanceContrast}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Height="22" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Brightness -->
                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center">
                    <StackPanel Width="140" Spacing="2" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="Độ sáng:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding EnhanceBrightness, StringFormat='{}{0:0}'}" Foreground="#FCD34D" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                        </Grid>
                        <Slider Value="{Binding EnhanceBrightness}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Height="22" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Saturation -->
                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center">
                    <StackPanel Width="140" Spacing="2" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="Bão hòa:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding EnhanceSaturation, StringFormat='{}{0:0}%'}" Foreground="#EC4899" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                        </Grid>
                        <Slider Value="{Binding EnhanceSaturation}" Minimum="0" Maximum="200" SmallChange="1" LargeChange="10" Height="22" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Sharpness -->
                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center">
                    <StackPanel Width="140" Spacing="2" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="Độ nét:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding EnhanceSharpness, StringFormat='{}{0:0.0}'}" Foreground="#10B981" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                        </Grid>
                        <Slider Value="{Binding EnhanceSharpness}" Minimum="0" Maximum="10" SmallChange="0.5" LargeChange="1" Height="22" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Noise Reduce -->
                <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,8,4" VerticalAlignment="Center">
                    <StackPanel Width="140" Spacing="2" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="Khử nhiễu:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding EnhanceNoiseReduce, StringFormat='{}Mức {0}'}" Foreground="#A855F7" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                        </Grid>
                        <Slider Value="{Binding EnhanceNoiseReduce}" Minimum="0" Maximum="5" SmallChange="1" LargeChange="1" Height="22" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Button Command="{Binding ResetEnhanceSettingsCommand}" Background="#1E293B" Foreground="#94A3B8" FontSize="10" Padding="8,4" Height="28" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,0,4">
                    <TextBlock Text="🔄 Đặt lại" VerticalAlignment="Center" />
                </Button>
            </WrapPanel>
        </Border>

        <!-- Khung hiển thị 2 ảnh Before / After đối chiếu -->
        <Grid Grid.Row="2" ColumnDefinitions="*, *" Margin="8">
            <!-- Cột 1: Before -->
            <Border Grid.Column="0" Background="#090D16" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,4,0">
                <Grid RowDefinitions="Auto, *">
                    <Border Grid.Row="0" Background="#1E293B" CornerRadius="3" Padding="6,3" HorizontalAlignment="Left" Margin="0,0,0,6">
                        <TextBlock Text="📷 ẢNH GỐC (BEFORE)" Foreground="#94A3B8" FontWeight="Bold" FontSize="10" />
                    </Border>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#050811" CornerRadius="4">
                        <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                            <LayoutTransformControl.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding EnhancePreviewZoom}" ScaleY="{Binding EnhancePreviewZoom}" />
                            </LayoutTransformControl.LayoutTransform>
                            <Image Source="{Binding EnhancePreviewOriginal}" Stretch="None" />
                        </LayoutTransformControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Cột 2: After -->
            <Border Grid.Column="1" Background="#090D16" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" Padding="6" Margin="4,0,0,0">
                <Grid RowDefinitions="Auto, *">
                    <Border Grid.Row="0" Background="#0284C7" CornerRadius="3" Padding="6,3" HorizontalAlignment="Left" Margin="0,0,0,6">
                        <TextBlock Text="✨ ĐÃ TỐI ƯU (AFTER)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" />
                    </Border>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#050811" CornerRadius="4">
                        <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                            <LayoutTransformControl.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding EnhancePreviewZoom}" ScaleY="{Binding EnhancePreviewZoom}" />
                            </LayoutTransformControl.LayoutTransform>
                            <Image Source="{Binding EnhancePreviewResult}" Stretch="None" />
                        </LayoutTransformControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
