<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ComicDownloaderGMTPC.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1380" d:DesignHeight="880"
        Width="1380" Height="880"
        MinWidth="960" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        x:Class="ComicDownloaderGMTPC.Views.EnhanceComparisonWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="So Sánh Ảnh Đối Chiếu (Conversion Preview) - Comic Downloader GMTPC">

    <Grid RowDefinitions="Auto, Auto, Auto, *">
        <!-- ROW 0: FastStone Header Toolbar -->
        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                <!-- Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Background="#38BDF8" CornerRadius="4" Width="26" Height="26">
                        <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="CONVERSION PREVIEW" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Navigation Previous / Next to rõ cho mọi kích thước -->
                <Border Grid.Column="1" Background="#1E293B" CornerRadius="5" Padding="4,2" Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Command="{Binding PreviousImageCommand}" IsEnabled="{Binding CanGoPrevious}"
                                Background="#0F172A" Foreground="#38BDF8" FontWeight="Bold" Padding="10,5" Height="32" CornerRadius="3" ToolTip.Tip="Ảnh trước (Phím A hoặc Mũi tên trái)">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="◀" FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Text="Trước" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Background="#0B0F19" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="3" Padding="8,4" Height="32" VerticalAlignment="Center">
                            <TextBlock Text="{Binding EnhanceImageCounterText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" TextAlignment="Center" />
                        </Border>
                        <Button Command="{Binding NextImageCommand}" IsEnabled="{Binding CanGoNext}"
                                Background="#0F172A" Foreground="#38BDF8" FontWeight="Bold" Padding="10,5" Height="32" CornerRadius="3" ToolTip.Tip="Ảnh tiếp theo (Phím D hoặc Mũi tên phải)">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Sau" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="▶" FontSize="10" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding EnhanceImageFileNameText}" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding EnhanceImageFileNameText}" Margin="4,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- View Modes & Zoom Controls (Center) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" VerticalAlignment="Center">
                    <!-- Chế độ xem: Song song / Rèm trượt / Ảnh đơn -->
                    <Border Background="#1E293B" CornerRadius="5" Padding="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Command="{Binding SetViewModeDualCommand}" Content="⏸ Song song"
                                    Background="{Binding IsDualView, Converter={x:Null}}"
                                    Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" Padding="8,4" CornerRadius="3" ToolTip.Tip="Xem 2 ảnh Trước / Sau song song (FastStone Dual View)" />
                            <Button Command="{Binding SetViewModeSplitCommand}" Content="⮂ Rèm trượt"
                                    Foreground="#A855F7" FontWeight="SemiBold" FontSize="11" Padding="8,4" CornerRadius="3" ToolTip.Tip="Thanh trượt rèm đối chiếu Before / After trực tiếp trên cùng ảnh" />
                            <Button Command="{Binding SetViewModeSingleCommand}" Content="⏹ Ảnh đơn"
                                    Foreground="#10B981" FontWeight="SemiBold" FontSize="11" Padding="8,4" CornerRadius="3" ToolTip.Tip="Ảnh đơn tràn khung: Nhấn giữ Space hoặc Click chuột để so sánh ảnh gốc" />
                        </StackPanel>
                    </Border>

                    <!-- Bộ công cụ Zoom FastStone -->
                    <Border Background="#1E293B" CornerRadius="5" Padding="4,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Command="{Binding ResetZoomPreviewCommand}" Content="1:1" Background="#0F172A" Foreground="#10B981" FontWeight="Bold" Padding="8,5" FontSize="11" CornerRadius="3" ToolTip.Tip="Kích thước thực 100% (Phím 1)" />
                            <Button Command="{Binding ZoomFitPreviewCommand}" Content="⛶ Vừa khung" Background="#0F172A" Foreground="#F59E0B" FontWeight="Bold" Padding="8,5" FontSize="11" CornerRadius="3" ToolTip.Tip="Tự co vừa cửa sổ (Phím F)" />
                            <Button Command="{Binding ZoomOutPreviewCommand}" Content="➖" Background="#0F172A" Foreground="#94A3B8" Padding="8,4" FontSize="13" FontWeight="Bold" CornerRadius="3" ToolTip.Tip="Thu nhỏ (Phím - hoặc cuộn chuột)" />
                            <NumericUpDown Value="{Binding EnhancePreviewZoomPercent}" Minimum="10" Maximum="1000" Increment="25" FormatString="0'%'" Width="110" Height="30" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Background="#0F172A" CornerRadius="3" ParsingNumberStyle="Integer" HorizontalContentAlignment="Center" ToolTip.Tip="Tỷ lệ phóng to % (Nhập số trực tiếp)" />
                            <Button Command="{Binding ZoomInPreviewCommand}" Content="➕" Background="#0F172A" Foreground="#38BDF8" Padding="8,4" FontSize="13" FontWeight="Bold" CornerRadius="3" ToolTip.Tip="Phóng to (Phím + hoặc cuộn chuột)" />
                            <ToggleButton IsChecked="{Binding IsLoupeEnabled}" Content="🔍 Kính lúp" Background="#0F172A" Foreground="#EC4899" FontWeight="Bold" Padding="7,4" FontSize="11" CornerRadius="3" ToolTip.Tip="Bật / tắt kính lúp phóng đại nét vẽ tại chuột" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Đổi ảnh mẫu -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding PickSampleImageCommand}" Background="#4F46E5" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" Padding="12,6" CornerRadius="4">
                        <TextBlock Text="🖼️ Đổi ảnh mẫu" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: FastStone Info Bar (Dung lượng Before/After & One-Click Presets) -->
        <Border Grid.Row="1" Background="#0E1626" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <!-- Thông số dung lượng Trước & Sau chuẩn FastStone -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="4" Padding="8,3">
                        <TextBlock Text="{Binding EnhanceBeforeInfoText}" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11" />
                    </Border>
                    <Border Background="#0C4A6E" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="4" Padding="8,3">
                        <TextBlock Text="{Binding EnhanceAfterInfoText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" />
                    </Border>
                    <Border Background="#1E293B" CornerRadius="4" Padding="8,3">
                        <TextBlock Text="{Binding EnhanceClippingInfoText}" Foreground="#FCD34D" FontWeight="Bold" FontSize="11" />
                    </Border>
                </StackPanel>

                <!-- Bộ Presets tối ưu nhanh theo thể loại truyện tranh (One-Click Comic Presets) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="⚡ Presets truyện:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Button Command="{Binding ApplyPresetDefaultCommand}" Content="🔘 Mặc định" Background="#1E293B" Foreground="#E2E8F0" FontSize="10" Padding="8,4" CornerRadius="4" ToolTip.Tip="Khôi phục thông số gốc" />
                    <Button Command="{Binding ApplyPresetOldScanCommand}" Content="📜 Khử ố scan" Background="#854D0E" Foreground="#FEF08A" FontWeight="Bold" FontSize="10" Padding="8,4" CornerRadius="4" ToolTip.Tip="Tăng sáng nền, tương phản mạnh khử vàng giấy cũ" />
                    <Button Command="{Binding ApplyPresetWebtoonCommand}" Content="🎨 Webtoon rực rỡ" Background="#831843" Foreground="#FBCFE8" FontWeight="Bold" FontSize="10" Padding="8,4" CornerRadius="4" ToolTip.Tip="Tăng bão hòa màu và độ sắc nét viền vẽ truyện tranh màu" />
                    <Button Command="{Binding ApplyPresetNightCommand}" Content="🌙 Đọc đêm dịu mắt" Background="#1E1B4B" Foreground="#C7D2FE" FontWeight="Bold" FontSize="10" Padding="8,4" CornerRadius="4" ToolTip.Tip="Hạ sáng nền, tăng nét chữ giúp đỡ mỏi mắt" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 2: Sliders Toolbar & 3 Custom Presets (Tinh chỉnh trực tiếp) -->
        <Border Grid.Row="2" Background="#161F30" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="8,4">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="125">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Contrast -->
                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="5,3" Margin="0,0,4,4" VerticalAlignment="Center">
                        <StackPanel Width="140" Spacing="2" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Tương phản:" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding EnhanceContrast}" Minimum="-100" Maximum="100" Increment="1" FormatString="0" Width="60" Height="22" FontSize="10" Foreground="#38BDF8" Background="#1E293B" CornerRadius="3" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ParsingNumberStyle="Integer" ToolTip.Tip="Tương phản (-100 đến 100)" />
                            </Grid>
                            <Slider Value="{Binding EnhanceContrast}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Height="16" VerticalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Brightness -->
                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="5,3" Margin="0,0,4,4" VerticalAlignment="Center">
                        <StackPanel Width="140" Spacing="2" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Độ sáng:" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding EnhanceBrightness}" Minimum="-100" Maximum="100" Increment="1" FormatString="0" Width="60" Height="22" FontSize="10" Foreground="#FCD34D" Background="#1E293B" CornerRadius="3" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ParsingNumberStyle="Integer" ToolTip.Tip="Độ sáng (-100 đến 100)" />
                            </Grid>
                            <Slider Value="{Binding EnhanceBrightness}" Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Height="16" VerticalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Saturation -->
                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="5,3" Margin="0,0,4,4" VerticalAlignment="Center">
                        <StackPanel Width="140" Spacing="2" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Bão hòa:" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding EnhanceSaturation}" Minimum="0" Maximum="200" Increment="1" FormatString="0" Width="60" Height="22" FontSize="10" Foreground="#EC4899" Background="#1E293B" CornerRadius="3" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ParsingNumberStyle="Integer" ToolTip.Tip="Bão hòa màu (0 đến 200%)" />
                            </Grid>
                            <Slider Value="{Binding EnhanceSaturation}" Minimum="0" Maximum="200" SmallChange="1" LargeChange="10" Height="16" VerticalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Sharpness -->
                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="5,3" Margin="0,0,4,4" VerticalAlignment="Center">
                        <StackPanel Width="140" Spacing="2" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Độ nét:" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding EnhanceSharpness}" Minimum="0" Maximum="10" Increment="0.5" FormatString="0.0" Width="60" Height="22" FontSize="10" Foreground="#10B981" Background="#1E293B" CornerRadius="3" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTip.Tip="Độ nét (0.0 đến 10.0)" />
                            </Grid>
                            <Slider Value="{Binding EnhanceSharpness}" Minimum="0" Maximum="10" SmallChange="0.5" LargeChange="1" Height="16" VerticalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Noise Reduce -->
                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="5,3" Margin="0,0,4,4" VerticalAlignment="Center">
                        <StackPanel Width="140" Spacing="2" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                                <TextBlock Grid.Column="0" Text="Khử nhiễu:" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Value="{Binding EnhanceNoiseReduce}" Minimum="0" Maximum="5" Increment="1" FormatString="0" Width="60" Height="22" FontSize="10" Foreground="#A855F7" Background="#1E293B" CornerRadius="3" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ParsingNumberStyle="Integer" ToolTip.Tip="Khử nhiễu (0 đến 5)" />
                            </Grid>
                            <Slider Value="{Binding EnhanceNoiseReduce}" Minimum="0" Maximum="5" SmallChange="1" LargeChange="1" Height="16" VerticalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 3 Custom Presets (Preset 1, 2, 3 - Dạng WrapPanel tự xuống dòng) -->
                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="0,0,4,4" VerticalAlignment="Center">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💾 Presets:" Foreground="#38BDF8" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <!-- P1 -->
                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,4,2">
                                <TextBox Text="{Binding UserPreset1Name}" Width="65" Height="24" FontSize="9" Padding="3,1" VerticalAlignment="Center" Background="#1E293B" Foreground="#E2E8F0" CornerRadius="3" ToolTip.Tip="Tên Preset 1 (bấm đổi tên)" />
                                <Button Command="{Binding SaveUserPreset1Command}" Content="💾" Background="#0284C7" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="24" CornerRadius="3" ToolTip.Tip="Lưu vào Preset 1" />
                                <Button Command="{Binding LoadUserPreset1Command}" Content="📂" Background="#0D9488" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="24" CornerRadius="3" ToolTip.Tip="Tải Preset 1" />
                            </StackPanel>
                            <!-- P2 -->
                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,4,2">
                                <TextBox Text="{Binding UserPreset2Name}" Width="65" Height="24" FontSize="9" Padding="3,1" VerticalAlignment="Center" Background="#1E293B" Foreground="#E2E8F0" CornerRadius="3" ToolTip.Tip="Tên Preset 2 (bấm đổi tên)" />
                                <Button Command="{Binding SaveUserPreset2Command}" Content="💾" Background="#0284C7" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="24" CornerRadius="3" ToolTip.Tip="Lưu vào Preset 2" />
                                <Button Command="{Binding LoadUserPreset2Command}" Content="📂" Background="#0D9488" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="24" CornerRadius="3" ToolTip.Tip="Tải Preset 2" />
                            </StackPanel>
                            <!-- P3 -->
                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,0,2">
                                <TextBox Text="{Binding UserPreset3Name}" Width="65" Height="24" FontSize="9" Padding="3,1" VerticalAlignment="Center" Background="#1E293B" Foreground="#E2E8F0" CornerRadius="3" ToolTip.Tip="Tên Preset 3 (bấm đổi tên)" />
                                <Button Command="{Binding SaveUserPreset3Command}" Content="💾" Background="#0284C7" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="24" CornerRadius="3" ToolTip.Tip="Lưu vào Preset 3" />
                                <Button Command="{Binding LoadUserPreset3Command}" Content="📂" Background="#0D9488" Foreground="#FFFFFF" FontSize="9" Padding="4,1" Height="24" CornerRadius="3" ToolTip.Tip="Tải Preset 3" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <Button Command="{Binding ResetEnhanceSettingsCommand}" Background="#1E293B" Foreground="#94A3B8" FontSize="9" Padding="6,3" Height="26" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="🔄 Đặt lại" VerticalAlignment="Center" />
                    </Button>
                </WrapPanel>
            </ScrollViewer>
        </Border>

        <!-- ROW 3: Vùng hiển thị ảnh đối chiếu chính -->
        <Panel Grid.Row="3" Margin="6">
            <!-- Nút chuyển ảnh trước nổi mép trái -->
            <Button Command="{Binding PreviousImageCommand}" IsEnabled="{Binding CanGoPrevious}"
                    ZIndex="1500" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="8,0,0,0" Width="44" Height="60" CornerRadius="8"
                    Background="#B30F172A" BorderBrush="#38BDF8" BorderThickness="1"
                    Foreground="#38BDF8" FontWeight="Bold" FontSize="20"
                    ToolTip.Tip="Ảnh trước (◀)">
                <TextBlock Text="❮" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>

            <!-- Nút chuyển ảnh sau nổi mép phải -->
            <Button Command="{Binding NextImageCommand}" IsEnabled="{Binding CanGoNext}"
                    ZIndex="1500" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,8,0" Width="44" Height="60" CornerRadius="8"
                    Background="#B30F172A" BorderBrush="#38BDF8" BorderThickness="1"
                    Foreground="#38BDF8" FontWeight="Bold" FontSize="20"
                    ToolTip.Tip="Ảnh tiếp theo (▶)">
                <TextBlock Text="❯" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>

            <Grid>
            <!-- CHẾ ĐỘ 1: DUAL VIEW (Responsive Portrait / Landscape) -->
            <UniformGrid Columns="{Binding EnhanceDualColumns}" Rows="{Binding EnhanceDualRows}" IsVisible="{Binding IsDualView}">
                <!-- Cột Trước (Before) -->
                <Border Background="#090D16" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="4" Margin="2">
                    <Grid RowDefinitions="Auto, *">
                        <Border Grid.Row="0" Background="#1E293B" CornerRadius="3" Padding="6,3" HorizontalAlignment="Left" Margin="0,0,0,4">
                            <TextBlock Text="📷 ẢNH GỐC (BEFORE)" Foreground="#94A3B8" FontWeight="Bold" FontSize="10" />
                        </Border>
                        <ScrollViewer Grid.Row="1" x:Name="BeforeScrollViewer"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      Background="#050811" CornerRadius="4">
                            <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                                <LayoutTransformControl.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding EnhancePreviewZoom}" ScaleY="{Binding EnhancePreviewZoom}" />
                                </LayoutTransformControl.LayoutTransform>
                                <Image Source="{Binding EnhancePreviewOriginal}" Width="{Binding EnhanceImagePixelWidth}" Height="{Binding EnhanceImagePixelHeight}" Stretch="Fill" x:Name="BeforeImage" />
                            </LayoutTransformControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Cột Sau (After) -->
                <Border Background="#090D16" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" Padding="4" Margin="2">
                    <Grid RowDefinitions="Auto, *">
                        <Border Grid.Row="0" Background="#0284C7" CornerRadius="3" Padding="6,3" HorizontalAlignment="Left" Margin="0,0,0,4">
                            <TextBlock Text="✨ ĐÃ TỐI ƯU (AFTER)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" />
                        </Border>
                        <ScrollViewer Grid.Row="1" x:Name="AfterScrollViewer"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      Background="#050811" CornerRadius="4">
                            <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                                <LayoutTransformControl.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding EnhancePreviewZoom}" ScaleY="{Binding EnhancePreviewZoom}" />
                                </LayoutTransformControl.LayoutTransform>
                                <Image Source="{Binding EnhancePreviewResult}" Width="{Binding EnhanceImagePixelWidth}" Height="{Binding EnhanceImagePixelHeight}" Stretch="Fill" x:Name="AfterImage" />
                            </LayoutTransformControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- CHẾ ĐỘ 2: SPLIT VIEW (Thanh trèm đối chiếu Before / After trên cùng mặt ảnh) -->
            <Border Background="#090D16" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="6" Padding="4" IsVisible="{Binding IsSplitView}">
                <Grid RowDefinitions="Auto, *">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="4,0,4,4">
                        <Border Grid.Column="0" Background="#1E293B" CornerRadius="3" Padding="6,3">
                            <TextBlock Text="⮂ RÈM TRƯỢT ĐỐI CHIẾU: Kéo thanh chia đôi để so sánh Trước / Sau trực quan" Foreground="#A855F7" FontWeight="Bold" FontSize="10" />
                        </Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Vị trí rèm:" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" />
                            <Slider Width="140" Minimum="0" Maximum="1" Value="{Binding EnhanceSplitRatio}" Height="20" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" x:Name="SplitScrollViewer"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="#050811" CornerRadius="4">
                        <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                            <LayoutTransformControl.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding EnhancePreviewZoom}" ScaleY="{Binding EnhancePreviewZoom}" />
                            </LayoutTransformControl.LayoutTransform>
                            <!-- Container 2 ảnh xếp lớp -->
                            <Panel>
                                <!-- Lớp dưới: Ảnh gốc (Before) -->
                                <Image Source="{Binding EnhancePreviewOriginal}" Width="{Binding EnhanceImagePixelWidth}" Height="{Binding EnhanceImagePixelHeight}" Stretch="Fill" />
                                
                                <!-- Lớp trên: Ảnh tối ưu (After) với độ rộng chia đôi theo SplitRatio -->
                                <Grid ColumnDefinitions="*, Auto, *">
                                    <!-- Phần After bên trái -->
                                    <Border Grid.Column="0" ClipToBounds="True">
                                        <Image Source="{Binding EnhancePreviewResult}" Width="{Binding EnhanceImagePixelWidth}" Height="{Binding EnhanceImagePixelHeight}" Stretch="Fill" HorizontalAlignment="Left" />
                                    </Border>
                                    
                                    <!-- Đường ranh giới chia rèm -->
                                    <GridSplitter Grid.Column="1" Width="4" Background="#38BDF8" ResizeDirection="Columns" />
                                    
                                    <!-- Phần Before lộ ra bên phải -->
                                    <Border Grid.Column="2" Background="Transparent" />
                                </Grid>
                            </Panel>
                        </LayoutTransformControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- CHẾ ĐỘ 3: SINGLE VIEW (Ảnh đơn tràn khung với Click-and-Hold / Spacebar peek Before) -->
            <Border Background="#090D16" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="4" IsVisible="{Binding IsSingleView}">
                <Grid RowDefinitions="Auto, *">
                    <Border Grid.Row="0" Background="#064E3B" CornerRadius="3" Padding="8,4" HorizontalAlignment="Left" Margin="4,0,0,4">
                        <TextBlock Text="💡 ĐANG HIỂN THỊ ẢNH ĐƠN (AFTER) • Nhấn giữ chuột trái hoặc phím [SPACE] để xem ảnh gốc (BEFORE)" Foreground="#6EE7B7" FontWeight="Bold" FontSize="11" />
                    </Border>
                    <ScrollViewer Grid.Row="1" x:Name="SingleScrollViewer"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="#050811" CornerRadius="4">
                        <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                            <LayoutTransformControl.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding EnhancePreviewZoom}" ScaleY="{Binding EnhancePreviewZoom}" />
                            </LayoutTransformControl.LayoutTransform>
                            <!-- Tự động hoán đổi hiển thị Before / After -->
                            <Panel x:Name="SingleImagePanel">
                                <Image Source="{Binding EnhancePreviewResult}" Width="{Binding EnhanceImagePixelWidth}" Height="{Binding EnhanceImagePixelHeight}" Stretch="Fill" IsVisible="{Binding !IsSingleShowingBefore}" />
                                <Image Source="{Binding EnhancePreviewOriginal}" Width="{Binding EnhanceImagePixelWidth}" Height="{Binding EnhanceImagePixelHeight}" Stretch="Fill" IsVisible="{Binding IsSingleShowingBefore}" />
                            </Panel>
                        </LayoutTransformControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        </Panel>
    </Grid>
</Window>
