<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <_SuppressXcodeVersionCheck>true</_SuppressXcodeVersionCheck>
    <SuppressXcodeVersionCheck>true</SuppressXcodeVersionCheck>
    <!-- Ký ad-hoc chuẩn Apple (CodesignKey = -) cho phép đóng gói IPA không cần Apple Developer Account -->
    <CodesignKey>-</CodesignKey>
    <CodesignProvision></CodesignProvision>
    <EnableCodeSigning>true</EnableCodeSigning>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ComicDownloaderGMTPC\ComicDownloaderGMTPC.csproj" />
  </ItemGroup>

</Project>
